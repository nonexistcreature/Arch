{
	chapter.013D59C2990EDE7A.title: "Welcome to Arkhaven"
	chapter.013D59C2990EDE7A.chapter_subtitle: [
		"Where to start and how things work here"
	]
	quest.0B8F53D58538E0EF.title: "You're in the Haven"
	quest.0B8F53D58538E0EF.quest_subtitle: "Tick the box to begin"
	quest.0B8F53D58538E0EF.quest_desc: [
		"&lArkhaven&r is a pack for a group of friends where everyone finds their thing: cooking, gardening, animals, machines, magic, adventure, towns."
		"It's &lcalm&r here: hostile mobs don't spawn near spawn or inside your claims."
		"Danger is opt-in: the wilds, dungeons and other dimensions."
		"This book is your guide. Every quest answers three questions: &owhat is it, why care, how to start&r."
	]
	quest.04E0C8297145FA0D.title: "Who Are You Today?"
	quest.04E0C8297145FA0D.quest_subtitle: "Eight roles — pick one or all of them"
	quest.04E0C8297145FA0D.quest_desc: [
		"🍳 &lCook&r — Farmer's Delight, Let's Do wine and cheese. 🌱 &lGardener&r — seasons, greenhouses, essences."
		"🐄 &lBreeder&r — bees, dragons, fishing. ⚙️ &lEngineer&r — Create, airships, nuclear power."
		"🔮 &lMage&r — Ars Nouveau, Iron's Spells, Occultism. ⚔️ &lWarrior&r — dungeons and bosses."
		"🏛 &lTown builder&r — MineColonies. ⚗️ &lAlchemist&r — cauldrons and potions."
		"Every role works solo, but mid-game &lteaming up pays off&r: \"Valued by…\" hints show who needs your goods."
	]
	quest.5561BDBA9D7A940F.title: "How to Find Any Recipe"
	quest.5561BDBA9D7A940F.quest_subtitle: "EMI: the R and U keys"
	quest.5561BDBA9D7A940F.quest_desc: [
		"&lWhat:&r the list on the right of your inventory is every item in the pack (EMI)."
		"&lHow:&r hover an item and press &lR&r for how to make it, &lU&r for what it's used in."
		"The search bar understands &l@mod&r: &o@create&r shows only Create items."
		"&lTip:&r the loot tab shows where an item drops."
	]
	quest.7364572739F8EBFD.title: "Living Tooltips"
	quest.7364572739F8EBFD.quest_subtitle: "Ponder (W) and Jade"
	quest.7364572739F8EBFD.quest_desc: [
		"Hover a &lCreate&r block in your inventory and &lhold W&r — an animated scene shows how it works."
		"Look at any block in the world and the &lJade&r popup at the top tells you what it is and which mod it's from."
		"Many mods have their own guide book — quests will tell you where to get it."
	]
	quest.0CD6F0E34FDE881D.title: "Maps and Waypoints"
	quest.0CD6F0E34FDE881D.quest_subtitle: "M for the world map, B for a new waypoint"
	quest.0CD6F0E34FDE881D.quest_desc: [
		"The minimap lives in the corner of your screen. &lM&r opens the world map, &lB&r adds a waypoint."
		"Your death point is marked automatically and your items wait in a &lgravestone&r."
		"&lTip:&r you can share a waypoint with friends in chat from the waypoint menu."
	]
	quest.6AEEBF70D9410C91.title: "Mine the Whole Vein"
	quest.6AEEBF70D9410C91.quest_subtitle: "FTB Ultimine — hold ` (backtick)"
	quest.6AEEBF70D9410C91.quest_desc: [
		"&lHold the ` key&r (left of 1) and break a block — the whole ore vein or the whole tree goes at once."
		"It saves hours: no need to dig out every coal block one by one."
		"It also works with a hoe (till a field) and an axe."
	]
	quest.7D0113D5251D8308.title: "Talk Out Loud"
	quest.7D0113D5251D8308.quest_subtitle: "Simple Voice Chat — V"
	quest.7D0113D5251D8308.quest_desc: [
		"Proximity voice chat: people nearby hear you, quieter the farther they are."
		"&lV&r opens the voice menu (mic, volume, groups). By default you talk by holding &lCaps Lock&r."
		"&lTip:&r create a group and you'll hear each other at any distance."
	]
	quest.61956A5E82AB7C9F.title: "The Danger Atlas"
	quest.61956A5E82AB7C9F.quest_subtitle: "Where to stroll and where to keep your sword ready"
	quest.61956A5E82AB7C9F.quest_desc: [
		"&lZone 0 — safe:&r the Haven (256 blocks around spawn), your claims, colonies, Mega Torch radius. No enemies spawn."
		"&lZone 1 — calm:&r up to ~1500 blocks from spawn. A few vanilla mobs at night."
		"&lZone 2 — the wilds:&r beyond that, dark forests, swamps, deep caves. Modded enemies and elites."
		"&lZone 3 — dangerous:&r dungeons, the Nether, the Twilight Forest, blood moons. Bosses."
		"Entering a new place, the title card shows its danger level in stars ★."
	]
	quest.0AB73893D32D29B0.title: "A Living World That Plays Fair"
	quest.0AB73893D32D29B0.quest_subtitle: "Storms, meteors, blood moons"
	quest.0AB73893D32D29B0.quest_desc: [
		"Sometimes the world stages &levents&r: tornadoes, meteor showers, blood moons, rifts."
		"The rules are fair: events happen &lonly while you're online&r, come &lwith a warning&r, and each has a defence."
		"Before the first event of each kind, the \"Elements & Defence\" chapter teaches you how to stay safe."
		"The reward for bravery: meteoric iron, rare drops and great screenshots."
	]
	quest.6FCCA553E617BD3B.title: "One Team"
	quest.6FCCA553E617BD3B.quest_subtitle: "Shared quest progress"
	quest.6FCCA553E617BD3B.quest_desc: [
		"Everyone on the server is in one team, &lArkhaven&r: a quest your friend completes counts for you too."
		"Everyone claims rewards for themselves, so no one misses out."
		"Want to compete? An admin can split teams with &o/ftbteams&r."
	]
	quest.5921FC2BA0B77A22.title: "Pretty or Fast"
	quest.5921FC2BA0B77A22.quest_subtitle: "Shaders and graphics presets"
	quest.5921FC2BA0B77A22.quest_desc: [
		"Toggle shaders with &lK&r (Iris shader menu — &lO&r). Low FPS? Turn them off or pick a lighter preset."
		"Switch graphics presets with the \"Arkhaven — graphics\" desktop shortcut."
		"&lTip:&r if FPS is low, lower render distance to 8–10 chunks — it has the biggest impact."
	]
	quest.43626AEC27FFE561.title: "Language"
	quest.43626AEC27FFE561.quest_subtitle: "Russian by default, English in settings"
	quest.43626AEC27FFE561.quest_desc: [
		"Quests and hints are written in two languages. To switch: &lOptions → Language&r."
		"The quest book follows automatically."
	]
	quest.211FE5B4A21988C5.title: "Ready for the Road"
	quest.211FE5B4A21988C5.quest_subtitle: "Next: Origins and First Steps"
	quest.211FE5B4A21988C5.quest_desc: [
		"You know the essentials. Now pick your &lorigin&r (chapter \"Origin & Path\") and set up a first home (chapter \"First Steps\")."
		"Other chapters open up as soon as you get into their topic — or peek into any of them right now."
	]
	chapter.3FC26F62283432CD.title: "Player Memo"
	chapter.3FC26F62283432CD.chapter_subtitle: [
		"Short answers to common questions: a 5-minute read"
	]
	quest.797D0E483FA8CEEB.title: "Meteors, Tornadoes, Rifts"
	quest.797D0E483FA8CEEB.quest_subtitle: "How to protect yourself from disasters"
	quest.797D0E483FA8CEEB.quest_desc: [
		"&lWhen:&r only while someone is online; the first 7 in-game days are calm; big disasters come &lat most once every 3 real days&r. Each one first arrives as a tutorial, after the «First Meeting» quest in the «Elements» chapter."
		"&lWarning:&r 10 minutes before a meteor: a title, a bell and a glowing pillar over the impact site. The &lStar Atlas&r shows the night's forecast; so does `/arkhaven forecast`."
		"&l☄ Meteor:&r a ward generator (crystal: amethyst + meteor dust): within 32/64/128 blocks meteors burn up and explosions don't break blocks."
		"&l🌪 Tornadoes and storms:&r a weather deflector breaks them up near your base, a siren wakes you, a sensor gives a redstone signal (close shutters, park the airship). A lightning rod prevents fires."
		"&l🌀 Rifts:&r never open in the safe zone, near a Hearth Stone or next to a tier II ward."
		"&l🧟 Monsters:&r a Hearth Stone (48 blocks) and claims stop mobs from spawning. Creepers never break blocks anywhere."
		"Details: the «Elements» chapter."
	]
	quest.5A2C5F9CF1420CA0.title: "Can I Craft a Gun and a Plane?"
	quest.5A2C5F9CF1420CA0.quest_subtitle: "Yes: almost everything is craftable"
	quest.5A2C5F9CF1420CA0.quest_desc: [
		"&lGuns (TaCZ):&r gunsmith table → model → steel, gunpowder, parts. Ammo and attachments there too. «Firearms and War» chapter."
		"&lCannons:&r Create Big Cannons (on land), Small Ships broadside cannons, the Immersive Aircraft rotary cannon."
		"&lPlanes (Immersive Aircraft):&r biplane, gyrodyne, quadrocopter, airship: from an engine, hull and propeller at a crafting table. «Sky» chapter."
		"&lYour own aircraft (Create Aeronautics):&r build from blocks with propellers and a wheel, any shape. «Sky» chapter."
		"&lShips (Small Ships):&r cog, brig, galleon, drakkar. &lTrains:&r Create + Steam 'n' Rails. &lFPV drones:&r Create Droneworks. «Transport» chapter."
		"&lFinding a recipe:&r hover an item in EMI and press &lR&r (recipe) or &lU&r (uses)."
	]
	quest.1438069491CE0496.title: "Main Keys"
	quest.1438069491CE0496.quest_subtitle: "Cheat sheet"
	quest.1438069491CE0496.quest_desc: [
		"&lL&r quests · &lP&r skills · &lM&r map · &lB&r backpack · &lCaps Lock&r (hold) voice, &lV&r its settings"
		"&lW&r over a Create block: Ponder tutorial · &lR / U&r in EMI: recipe / uses"
		"&lUltimine&r: hold its key (see Controls) and mine: the whole vein"
		"&lYour character&r: change race/class with an Orb of Origin (costs XP)."
	]
	quest.00EB4BACA0AC0845.title: "If You Die"
	quest.00EB4BACA0AC0845.quest_subtitle: "Your items are safe"
	quest.00EB4BACA0AC0845.quest_desc: [
		"All your items stay in a &lgrave&r where you died: the death point is marked on the Xaero map."
		"Without a bed you respawn at spawn. If you appear in water, the pack moves you to the nearest dry land."
	]
	quest.6287ECAD55E7E7A0.title: "Claims and PvP"
	quest.6287ECAD55E7E7A0.quest_subtitle: "What's yours is protected"
	quest.6287ECAD55E7E7A0.quest_desc: [
		"&lClaim:&r map (M) → select chunks → «Claim». Inside a claim nobody breaks blocks, opens chests or uses machines without your permission. Add friends to a Party."
		"&lPvP is on&r, and guns hit through a crowd: mind your line of fire. Attacking players without agreement isn't nice."
		"&lDungeon chests&r are personal (Lootr): everyone gets their own loot."
	]
	quest.24DEEB4CF1811863.title: "Where It's Dangerous"
	quest.24DEEB4CF1811863.quest_subtitle: "A calm world, danger by choice"
	quest.24DEEB4CF1811863.quest_desc: [
		"&lNear spawn&r (up to ~250 blocks), inside claims and near a Hearth Stone monsters don't spawn. &lFurther out&r there are more, and bosses, gunners and &lelite mobs&r (armoured, triple health) live &lpast ~1500 blocks&r, in dungeons and other worlds."
		"Want a fight? Head into the wilds. Want to build? Settle closer to spawn."
	]
	quest.78F07D05EA3AF586.title: "Food and Seasons"
	quest.78F07D05EA3AF586.quest_subtitle: "Variety = health"
	quest.78F07D05EA3AF586.quest_desc: [
		"Try new dishes: every few &ldifferent&r foods grant +2 hearts of health (Spice of Life: Carrot Edition)."
		"&lSeasons&r change every few in-game weeks: in winter outdoor crops don't grow, so build a greenhouse (glass over your beds)."
	]
	quest.54FFA2AF231F36C6.title: "Playing Together"
	quest.54FFA2AF231F36C6.quest_subtitle: "Roles and quests"
	quest.54FFA2AF231F36C6.quest_desc: [
		"Quests can be done &las a team&r: create an FTB Teams party and progress is shared. Pick roles: engineer, mage, cook, warrior, builder, mayor."
		"«Handshake» quests need items from different branches: more fun that way."
	]
	quest.0C6CC72CF1D60E84.title: "Ready!"
	quest.0C6CC72CF1D60E84.quest_subtitle: "Next: «The Arkhaven Path»"
	quest.0C6CC72CF1D60E84.quest_desc: [
		"You know the essentials. Open &l«The Arkhaven Path»&r: it guides you through the pack step by step."
	]
	chapter.153AE3239EBFC45C.title: "The Arkhaven Path"
	chapter.153AE3239EBFC45C.chapter_subtitle: [
		"Where to go next: one line through every chapter"
	]
	quest.04E65EA9D232B59D.title: "How to Read the Path"
	quest.04E65EA9D232B59D.quest_subtitle: "One line, many roads"
	quest.04E65EA9D232B59D.quest_desc: [
		"&lWhat:&r the main line of the pack. Every step is a milestone that opens new chapters."
		"&lWhy:&r there are hundreds of mods; the Path shows a sensible order: food → tools → machines → electricity → networks → atoms → bosses and other worlds."
		"&lHow:&r do the steps here and read the details in the chapter named in each description. You can branch off any time: the Path never locks other chapters."
	]
	quest.5989F710ABA29FD2.title: "Settle Down"
	quest.5989F710ABA29FD2.quest_subtitle: "Chapter «First Steps»"
	quest.5989F710ABA29FD2.quest_desc: [
		"A bed, a chest, a claim and a waystone: your first home. Near spawn and bases the world is calm; fights are optional, out in the wilds."
		"&lNext:&r «First Steps» teaches claiming land (Open Parties and Claims) and carrying a backpack."
	]
	quest.14E673074E384ED8.title: "Well Fed Means Strong"
	quest.14E673074E384ED8.quest_subtitle: "Chapters «Kitchen» and «Garden»"
	quest.14E673074E384ED8.quest_desc: [
		"&lWhy:&r varied food grants extra health (Spice of Life), and dishes give buffs that last for hours."
		"&lHow:&r a Farmer's Delight cooking pot plus beds from «Garden». Seasons (Serene Seasons) change what grows: greenhouse in winter."
	]
	quest.006C91045BBCADB4.title: "The Iron Age"
	quest.006C91045BBCADB4.quest_subtitle: "Ores, furnaces, first tools"
	quest.006C91045BBCADB4.quest_desc: [
		"An iron pickaxe unlocks nearly every modded ore: zinc (Create), osmium (Mekanism), yellorite (Extreme Reactors), lead and bauxite (TFMG)."
		"&lTip:&r hold the Ultimine key to mine a whole vein."
	]
	quest.3CA4B560AE561B3E.title: "Pick a Calling"
	quest.3CA4B560AE561B3E.quest_subtitle: "Roles and skills"
	quest.3CA4B560AE561B3E.quest_desc: [
		"You don't have to do everything. &lEngineer&r: Create and Mekanism; &lmage&r: Ars Nouveau and Iron's Spells; &lcook/farmer&r: kitchen and garden; &lwarrior&r: weapons and bosses; &lmayor&r: a Minecolonies colony."
		"The best parts are where roles meet: «handshake» quests need a neighbour from another role. Skill points: &lP&r key."
	]
	quest.13E77B47518CF45C.title: "Mechanics"
	quest.13E77B47518CF45C.quest_subtitle: "Chapter «Create»"
	quest.13E77B47518CF45C.quest_desc: [
		"&lWhat:&r Create runs on rotation instead of electricity: shafts, cogs, press, mixer, belts."
		"&lWhy:&r almost the whole pack leans on Create: food, armour, guns, airships and even reactors are made on its lines."
		"&lHow:&r andesite alloy → casing → water wheel. Hold &lW&r over a block: Ponder shows how it works."
	]
	quest.68172BA2AE32DFEF.title: "Brass"
	quest.68172BA2AE32DFEF.quest_subtitle: "The key to tier two"
	quest.68172BA2AE32DFEF.quest_desc: [
		"Brass (copper + zinc in a heated mixer) unlocks smart machinery: precision assembly, deployers, logistics, trains."
		"&lNext:&r «Create: Add-ons»: batteries, Big Cannons steel, experience enchanting."
	]
	quest.21FBC8C7F82B336A.title: "Steel"
	quest.21FBC8C7F82B336A.quest_subtitle: "Chapter «Steel and Oil»"
	quest.21FBC8C7F82B336A.quest_desc: [
		"Steel has three roads: the Immersive Engineering coke oven and blast furnace, the TFMG steelworks, or Mekanism. Pick any: Almost Unified turns all steel into one ingot."
		"&lWhy:&r steel makes TaCZ guns, ship cannons, reactor casings and turbines."
	]
	quest.1A928072C549EAF5.title: "Electricity"
	quest.1A928072C549EAF5.quest_subtitle: "Chapters «Mekanism» and «Steel and Oil»"
	quest.1A928072C549EAF5.quest_desc: [
		"Energy (FE) powers Mekanism, Immersive Engineering and AE2 machines. Create Addition alternators turn rotation into power: the bridge between worlds."
		"&lTip:&r start with solar panels or a biofuel generator: they make no smog."
	]
	quest.39B9D7211C3AD114.title: "A Network of Things"
	quest.39B9D7211C3AD114.quest_subtitle: "Chapters «Storage» and «AE2: Deeper»"
	quest.39B9D7211C3AD114.quest_desc: [
		"&lWhy:&r when there are too many chests, AE2 turns them into one digital base with search and autocrafting."
		"&lHow:&r meteorite → presses → processors → controller. Channels are unlimited in Arkhaven: no wiring headaches."
	]
	quest.4693C34C08702F13.title: "The Atom"
	quest.4693C34C08702F13.quest_subtitle: "Chapter «The Atom»"
	quest.4693C34C08702F13.quest_desc: [
		"Reactors power the hungriest machines: the SPS, fusion, mega cells."
		"&lGentle road:&r Extreme Reactors: no radiation, no pollution. &lRisky road:&r the Mekanism fission reactor: stronger, but a meltdown contaminates the area (only that area)."
	]
	quest.5F1BA5A3E0A5735B.title: "Magic"
	quest.5F1BA5A3E0A5735B.quest_subtitle: "Chapters «Ars Nouveau», «Iron's Spells», «Occultism»"
	quest.5F1BA5A3E0A5735B.quest_desc: [
		"Magic runs parallel to tech: flight and teleport spells, automation by familiars and spirits."
		"It doesn't have to be yours, but a mage on the team makes an engineer's life easier (and vice versa)."
	]
	quest.050C8B0EB9425EC7.title: "Hit the Road"
	quest.050C8B0EB9425EC7.quest_subtitle: "Chapter «Transport»"
	quest.050C8B0EB9425EC7.quest_desc: [
		"Ships (Small Ships), trains (Steam 'n' Rails), planes (Immersive Aircraft), airships and FPV drones (Aeronautics): choose how you travel."
		"Far lands hold ores, dungeons and bosses."
	]
	quest.39A56463E8C5A7F8.title: "Arms"
	quest.39A56463E8C5A7F8.quest_subtitle: "Chapters «Weapons» and «Firearms»"
	quest.39A56463E8C5A7F8.quest_desc: [
		"The TaCZ gunsmith table builds firearms from steel and gunpowder. Bandit fortresses and illager camps hold shooters with the same guns, and their loot."
	]
	quest.576B9EB277FB4903.title: "The First Boss"
	quest.576B9EB277FB4903.quest_subtitle: "Chapters «Adventure» and «Bosses»"
	quest.576B9EB277FB4903.quest_desc: [
		"The Naga in the Twilight Forest is a fair first boss: slow, loud, it teaches you to dodge."
		"&lNext:&r the «Bosses» chapter lists them all by difficulty, from the Naga to the Leviathan."
	]
	quest.012668B87D0FA2D0.title: "Dungeons"
	quest.012668B87D0FA2D0.quest_subtitle: "Chapter «Dungeons and Structures»"
	quest.012668B87D0FA2D0.quest_desc: [
		"Dungeon chests are personal (Lootr): every player gets their own loot, nobody robs anybody."
		"Bandit Towers are a good start: shooters, traps, chests with gunpowder and steel."
	]
	quest.6767449E51F712DE.title: "Other Worlds"
	quest.6767449E51F712DE.quest_subtitle: "Chapter «Other Worlds»"
	quest.6767449E51F712DE.quest_desc: [
		"The Aether above, the Undergarden below, the Bumblezone, the Otherside past the Warden, the End: every world has its own ores and bosses."
	]
	quest.5BDC466474828798.title: "A Town"
	quest.5BDC466474828798.quest_subtitle: "Chapter «Town»"
	quest.5BDC466474828798.quest_desc: [
		"A Minecolonies colony works for you: builders, farmers, miners. It eats your resources and returns them many times over."
	]
	quest.63BC6F90D1FCE215.title: "Peaks Need Friends"
	quest.63BC6F90D1FCE215.quest_subtitle: "One part from another branch"
	quest.63BC6F90D1FCE215.quest_desc: [
		"The pack's strongest items ask for &lone&r part from another role: no long chains, but faster together:"
		"&lGunsmith table&r: steel and a Create precision mechanism (smelter + engineer)."
		"&lME controller&r (AE2): a Create precision mechanism."
		"&lAircraft engine&r: aero lubricant (the angler's fish oil or the oil worker's lubricant)."
		"&lReinforced reactor&r: a Mekanism elite circuit."
		"&lMEGA 256M cell&r: a reinforced echo shard from the Otherside (explorer)."
		"&lFusion controller&r: a nether star (beating the Wither, warrior)."
	]
	quest.4AD95969A43AE499.title: "Elites of the Wilds"
	quest.4AD95969A43AE499.quest_subtitle: "The further, the scarier"
	quest.4AD95969A43AE499.quest_desc: [
		"Beyond &l1500 blocks&r from spawn some monsters spawn as &lelites&r: in chainmail, with double or triple health and a heavy hit."
		"Beyond &l3000 blocks&r, in the Nether, Twilight Forest, Undergarden, Otherside and End there are more elites, in iron and tougher still."
		"&lReward:&r meteor dust, emeralds, sometimes a diamond or a rift shard, and plenty of XP. Elite armour never drops."
		"Spawners and eggs never make elites: only the wild does."
	]
	quest.1F4F10227DA0EDBC.title: "Great Works"
	quest.1F4F10227DA0EDBC.quest_subtitle: "Chapter «Great Works»"
	quest.1F4F10227DA0EDBC.quest_desc: [
		"You've walked every road. The finale: the server's shared projects: a sky citadel, a fusion plant, a nature reserve, a city."
		"It isn't a race: great works are built together, over months."
	]
	chapter.037CC61EABB1B7C0.title: "Origin & Path"
	chapter.037CC61EABB1B7C0.chapter_subtitle: [
		"Your race, your skills and how you grow"
	]
	quest.778DA091C9349444.title: "What You Were Born As"
	quest.778DA091C9349444.quest_subtitle: "An origin is a style, not a sentence"
	quest.778DA091C9349444.quest_desc: [
		"&lWhat:&r on first join you pick an &lorigin&r — a race with perks and drawbacks."
		"Some see in the dark, some breathe underwater, some are slower but sturdier."
		"&lWhy:&r it changes &ohow&r you play, not &ohow much&r you can do. No origin is weak."
		"No selection screen? Grab an &lOrb of Origin&r — this quest's reward."
	]
	quest.6914A21F92128873.title: "Changed Your Mind?"
	quest.6914A21F92128873.quest_subtitle: "Switching origins"
	quest.6914A21F92128873.quest_desc: [
		"The first switch is &lfree&r: use the Orb of Origin from the previous quest."
		"After that it costs an expensive rebirth potion (chapter \"Alchemy\")."
		"&lTip:&r play a couple of evenings before switching — many abilities take time to shine."
	]
	quest.73257FF3447BD0B1.title: "What Can I Do?"
	quest.73257FF3447BD0B1.quest_subtitle: "The origin info screen"
	quest.73257FF3447BD0B1.quest_desc: [
		"Active origin abilities sit on the &lskill&r keys (see &oOptions → Controls → NeoOrigins&r)."
		"There you'll also find \"View Origin Info\": every passive bonus and weakness in one list."
	]
	quest.465EB2685CD40729.title: "You Grow by Doing"
	quest.465EB2685CD40729.quest_subtitle: "Skill trees — the P key"
	quest.465EB2685CD40729.quest_desc: [
		"&lWhat:&r every activity has its own skill tree: miner, cook, farmer, warrior, mage…"
		"&lHow to level:&r just do the thing. Cooking grows Cooking, digging grows Mining."
		"Press &lP&r to open the trees and spend points. No class prisons: you can grow a bit of everything."
	]
	quest.1899A2B09262FA6D.title: "Your First Point"
	quest.1899A2B09262FA6D.quest_subtitle: "Open a tree and pick a skill"
	quest.1899A2B09262FA6D.quest_desc: [
		"Mine some stone or ore, cook something — then look at your trees (&lP&r)."
		"Pick a first skill near the centre. Tick the quest when it's done."
		"&lTip:&r skills can be reset — alchemists brew a special potion for that."
	]
	quest.7D83C31C7DE03358.title: "Trees of the Magic Schools"
	quest.7D83C31C7DE03358.quest_subtitle: "Fire, ice, nature, blood…"
	quest.7D83C31C7DE03358.quest_desc: [
		"If Iron's Spells is your thing, each school of magic has its own tree."
		"Cast that school's spells and its tree grows: more damage, less mana."
		"More in the \"Iron's Spells\" chapter."
	]
	quest.5E88CA63A0373FF4.title: "Peace Is Your Choice"
	quest.5E88CA63A0373FF4.quest_subtitle: "The Mega Torch and quiet places"
	quest.5E88CA63A0373FF4.quest_desc: [
		"Want a farm or the road to the next village to always be safe? Place a &lMega Torch&r —"
		"hostile mobs won't spawn in a big radius around it."
		"Your claims and the Haven are already protected — this is for new places."
	]
	quest.0EECEE5A77DBE4F4.title: "The Miner's Path"
	quest.0EECEE5A77DBE4F4.quest_desc: [
		"The mining tree: dig faster, more ore, night vision underground. Grows by mining ore."
	]
	quest.49A24043E10608D2.title: "The Cook's Path"
	quest.49A24043E10608D2.quest_desc: [
		"The cooking tree: dishes buff for longer, food fills more. Grows by cooking."
	]
	quest.0665A88330D8BDE5.title: "The Farmer's Path"
	quest.0665A88330D8BDE5.quest_desc: [
		"The farming tree: bigger harvests, double-drop chance, faster growth around you."
	]
	quest.417847C383096E06.title: "The Warrior's Path"
	quest.417847C383096E06.quest_desc: [
		"The combat tree: more damage, health and armour. Grows by fighting enemies."
	]
	quest.49609C8E1769CAB2.title: "The Traveler's Charm"
	quest.49609C8E1769CAB2.quest_desc: [
		"While the charm is in your inventory, enemies notice you at half the distance. For walkers, not fighters."
		"Recipe: string, lavender, emerald, feather."
	]
	chapter.189EA59915A6A7C6.title: "First Steps"
	chapter.189EA59915A6A7C6.chapter_subtitle: [
		"Home, food, tools — and no rush"
	]
	quest.71A312E68F5D5D95.title: "Log by Log"
	quest.71A312E68F5D5D95.quest_subtitle: "Any wood works… but the task wants oak"
	quest.71A312E68F5D5D95.quest_desc: [
		"Everything starts with wood. Hold &l`&r and break a trunk — the whole tree comes down."
		"No oak nearby? Come back later — use whatever wood you have for your own needs."
	]
	quest.25244ED318CF1CC2.title: "The Workbench"
	quest.25244ED318CF1CC2.quest_subtitle: "Where every craft begins"
	quest.25244ED318CF1CC2.quest_desc: [
		"Forgot a recipe? Hover the item in the EMI list on the right and press &lR&r."
		"EMI search understands both Russian and English names."
	]
	quest.0A20243FB3DE57EE.title: "The Stone Age"
	quest.0A20243FB3DE57EE.quest_subtitle: "Your first pickaxe"
	quest.0A20243FB3DE57EE.quest_desc: [
		"A stone pickaxe opens the way underground. Caves near spawn are calm, but a torch never hurts."
	]
	quest.493C04C72C252AE1.title: "Fire in the Hearth"
	quest.493C04C72C252AE1.quest_subtitle: "A furnace for ore and food"
	quest.493C04C72C252AE1.quest_desc: [
		"A furnace smelts ore and cooks meat. Later Create and Mekanism will do it dozens of times faster."
	]
	quest.21B4E617FBC154C7.title: "The Iron Age"
	quest.21B4E617FBC154C7.quest_subtitle: "Veins here run rich"
	quest.21B4E617FBC154C7.quest_desc: [
		"Find iron ore and break it with &l`&r — you'll dig out the whole vein."
		"Everyone needs iron: engineers, cooks (pots!), farmers."
	]
	quest.7D055965B59E433F.title: "A Serious Pickaxe"
	quest.7D055965B59E433F.quest_subtitle: "Diamonds, redstone, gold"
	quest.7D055965B59E433F.quest_desc: [
		"An iron pickaxe mines almost everything. Diamonds are deep — below height zero."
		"Remember: deep caves count as &lthe wilds&r (zone 2)."
	]
	quest.18F86F97AA42687E.title: "A Place of Your Own"
	quest.18F86F97AA42687E.quest_subtitle: "A bed sets your respawn point"
	quest.18F86F97AA42687E.quest_desc: [
		"You don't have to sleep — no mobs spawn near spawn. But a bed remembers where you respawn."
		"To skip the night, only &lhalf&r the players need to be in bed."
	]
	quest.4250898F27D30389.title: "A Sleeping Bag in Your Pack"
	quest.4250898F27D30389.quest_subtitle: "Camp out without moving your home point"
	quest.4250898F27D30389.quest_desc: [
		"A &lsleeping bag&r lets you sleep through the night on the road and &ldoesn't&r change your respawn point."
		"There's also a &lhammock&r for a daytime nap."
	]
	quest.7FFC8E5E8083B094.title: "This Is Mine"
	quest.7FFC8E5E8083B094.quest_subtitle: "Claiming land (Open Parties and Claims)"
	quest.7FFC8E5E8083B094.quest_desc: [
		"&lWhat:&r a claim protects your blocks from others and makes the place &lsafe&r: no enemies spawn there."
		"&lHow:&r open the map (&lM&r), right-click chunks → \"Claim\". Or press &l'&r for the claims menu."
		"Add friends to your &lparty&r so they can build at your place too."
	]
	quest.5FDAC3643835B9B1.title: "A Backpack"
	quest.5FDAC3643835B9B1.quest_subtitle: "You can never have too many pockets"
	quest.5FDAC3643835B9B1.quest_desc: [
		"A backpack sits on your back and takes &lupgrades&r: item pickup, auto-smelting, auto-feeding."
		"Upgrades go in the side slots — check them in EMI (&lU&r on the backpack)."
	]
	quest.2D3F975CD04C8DA2.title: "Order in the Chests"
	quest.2D3F975CD04C8DA2.quest_subtitle: "Sophisticated Storage"
	quest.2D3F975CD04C8DA2.quest_desc: [
		"Barrels and chests that upgrade just like the backpack: more space, sorting, filters."
		"Later you can wire it all into an AE2 digital network (chapter \"Storage\")."
	]
	quest.41D73599EA517F03.title: "Waystones"
	quest.41D73599EA517F03.quest_subtitle: "Teleport between places you've found"
	quest.41D73599EA517F03.quest_desc: [
		"&lWaystones&r stand in villages. Click one and it's remembered — you can travel back to it from any other."
		"You can also craft your own for your home. Return scrolls are a quick way home from a trip."
	]
	quest.641414C5D00BB68B.title: "If Things Go Wrong"
	quest.641414C5D00BB68B.quest_subtitle: "A gravestone keeps your items"
	quest.641414C5D00BB68B.quest_desc: [
		"When you die your items don't scatter — they rest in a &lgravestone&r. Its spot is marked on the map."
		"Walk up and click it — everything returns to your inventory. Other players can't open your grave."
	]
	quest.1E45B54AE1AE0643.title: "Variety Is the Heart"
	quest.1E45B54AE1AE0643.quest_subtitle: "Spice of Life: new dishes = new hearts"
	quest.1E45B54AE1AE0643.quest_desc: [
		"Every &lnew&r dish you taste brings you closer to an extra &lheart&r."
		"The food book shows what you've eaten. Your best friend here is your group's &lcook&r."
		"Valued by: everyone. Especially before bosses."
	]
	quest.13724199B13ED6C5.title: "Chests for Everyone"
	quest.13724199B13ED6C5.quest_subtitle: "Everyone gets their own loot"
	quest.13724199B13ED6C5.quest_desc: [
		"Chests in dungeons and ruins are &lper player&r: a friend opened it first — you still get yours."
		"So explore together without elbowing each other at the chest."
	]
	quest.3167C5A5C262D22D.title: "A Home, and a World Waiting"
	quest.3167C5A5C262D22D.quest_subtitle: "Pick your road"
	quest.3167C5A5C262D22D.quest_desc: [
		"The basics are done. Open any chapter next — kitchen, garden, machines, magic, adventure — each has its own thing."
		"You don't have to do everything. Do what you enjoy and &ldrop by your friends&r — they probably need your help."
	]
	quest.7BD784A262A4F208.title: "A Shield"
	quest.7BD784A262A4F208.quest_desc: [
		"A shield blocks hits and arrows. Useful even in the calm lands — just in case."
	]
	quest.04645A8752811DB8.title: "A Diamond Pickaxe"
	quest.04645A8752811DB8.quest_desc: [
		"Diamonds lie deep, below height zero. Remember: deep caves are &lthe wilds&r."
	]
	quest.1A2098FF68A8F3F1.title: "Backpack Upgrades"
	quest.1A2098FF68A8F3F1.quest_desc: [
		"Pickup puts loot straight into the backpack, the magnet pulls items in. Digging gets easier."
	]
	quest.73D46902670D5A7C.title: "Auto-Feeding"
	quest.73D46902670D5A7C.quest_desc: [
		"The backpack feeds you from its contents when you get hungry."
	]
	quest.4A13AADDAB2AE3C8.title: "The Iron Backpack"
	quest.4A13AADDAB2AE3C8.quest_desc: [
		"More slots and more upgrade space. Next come gold, diamond and netherite."
	]
	quest.7C58537A359FA5A6.title: "The Warp Stone"
	quest.7C58537A359FA5A6.quest_desc: [
		"A reusable teleport to any waystone you've found. The handiest way home."
	]
	quest.01DD1D53DF25CA6A.title: "Carry a Chest"
	quest.01DD1D53DF25CA6A.quest_desc: [
		"Carry On: crouch with empty hands and click a chest or animal — you'll pick it up whole."
	]
	quest.1D2C45BEDF6DAD9C.title: "The Hammock"
	quest.1D2C45BEDF6DAD9C.quest_desc: [
		"Nap through the day until evening. For night-walk lovers."
	]
	chapter.62C3EC2B524D9932.title: "Kitchen & Tavern"
	chapter.62C3EC2B524D9932.chapter_subtitle: [
		"Food that heals, energises and grants hearts"
	]
	quest.63A6743396745987.title: "The Cook's Knife"
	quest.63A6743396745987.quest_subtitle: "Where Farmer's Delight begins"
	quest.63A6743396745987.quest_desc: [
		"&lWhat:&r a knife cuts meat, veggies and fish on a cutting board and harvests straw from grass."
		"&lWhy:&r almost every dish starts with chopping. And dishes here mean &lbuffs&r and &lextra hearts&r."
		"&lTip:&r the flint knife is a starter; an iron one lasts much longer."
	]
	quest.7337BE2DD2237031.title: "The Cutting Board"
	quest.7337BE2DD2237031.quest_subtitle: "Place an ingredient and strike with a knife"
	quest.7337BE2DD2237031.quest_desc: [
		"Right-click an item onto the board, then click it with a knife to slice it."
		"That's how you get chicken cuts, fish slices, minced beef, cabbage leaves."
		"Later an &lautomatic slicer&r (Create: Slice & Dice) takes over."
	]
	quest.5238FD9DA6380669.title: "A Pot Over the Fire"
	quest.5238FD9DA6380669.quest_subtitle: "The heart of the kitchen"
	quest.5238FD9DA6380669.quest_desc: [
		"&lHow:&r set the pot on a heat source — a campfire, a Farmer's Delight stove or magma."
		"Add up to 6 ingredients plus a container — the pot cooks stews, soups and pasta by itself."
		"Recipes: press &lU&r on the pot in EMI. A heated pot shows steam underneath."
	]
	quest.35985DCC77D18802.title: "The Skillet"
	quest.35985DCC77D18802.quest_subtitle: "Fry — and defend yourself"
	quest.35985DCC77D18802.quest_desc: [
		"A skillet fries food held over fire or placed on a stove."
		"It's also a decent weapon. Tasty and loud."
	]
	quest.18D9ECC67E2FC089.title: "Your First Stew"
	quest.18D9ECC67E2FC089.quest_subtitle: "Fullness and Nourishment"
	quest.18D9ECC67E2FC089.quest_desc: [
		"Pot dishes grant &lNourishment&r: your hunger barely drops."
		"Soups grant &lComfort&r: shields you from cold and slowly heals."
		"&lValued by:&r miners and warriors — pack some for the road."
	]
	quest.559D4C6BCF8BCEB9.title: "Rice Grows in Water"
	quest.559D4C6BCF8BCEB9.quest_subtitle: "Plant it in shallow water"
	quest.559D4C6BCF8BCEB9.quest_desc: [
		"Rice is planted straight into one-block-deep water. Find wild rice near swamps and rivers."
		"It goes into rolls, fried rice and rice balls — and gardeners use it for compost."
	]
	quest.2ACE3EA7C75F5792.title: "A Feast for All"
	quest.2ACE3EA7C75F5792.quest_subtitle: "A block-sized dish that feeds the group"
	quest.2ACE3EA7C75F5792.quest_desc: [
		"&lFeasts&r are placed on a table as a block: everyone walks up and takes a serving."
		"Honey-glazed ham, stuffed pumpkin, roasts — one pot feeds the whole team before a boss."
	]
	quest.0501C9B22779C6E3.title: "Dream Kitchen"
	quest.0501C9B22779C6E3.quest_subtitle: "Cooking for Blockheads"
	quest.0501C9B22779C6E3.quest_desc: [
		"The &lcooking table&r sees everything in the adjacent cupboards, fridge and counters."
		"It shows only the dishes you can make &lright now&r and cooks them in one click."
		"Put a table, fridge, oven and sink together and you have a multiblock kitchen."
	]
	quest.1D2EF124557ECDB4.title: "The Fridge"
	quest.1D2EF124557ECDB4.quest_subtitle: "Your kitchen remembers its stock"
	quest.1D2EF124557ECDB4.quest_desc: [
		"A fridge stores ingredients and links to the cooking table. Stack two for a fridge-freezer."
		"&lTip:&r a sink gives endless water for recipes, an oven gives heat for frying."
	]
	quest.1BBF63337B27B478.title: "The Oven"
	quest.1BBF63337B27B478.quest_subtitle: "Nine dishes at once"
	quest.1BBF63337B27B478.quest_desc: [
		"The oven bakes nine items at once and links into the kitchen. Add a heating unit to speed it up."
	]
	quest.16CFEF89533B0A8C.title: "The Cheese That Waited"
	quest.16CFEF89533B0A8C.quest_subtitle: "Let's Do Meadow"
	quest.16CFEF89533B0A8C.quest_desc: [
		"&lWhat:&r a cheese form — pour in milk with rennet and some time later you have a whole wheel."
		"Goat, sheep and buffalo milk make different cheeses. Alpine animals are raised by &lbreeders&r."
		"&lWhy:&r cheese is a tavern staple and colonists love it."
	]
	quest.0466BE55A60FEE69.title: "A Whole Wheel"
	quest.0466BE55A60FEE69.quest_subtitle: "Slice it up"
	quest.0466BE55A60FEE69.quest_desc: [
		"Place the cheese wheel and slice it with a knife. Cheese goes into tarts, sandwiches, cheesy sausages."
		"&lValued by:&r everyone. Especially those collecting new dishes for hearts."
	]
	quest.45AAADFE7F430492.title: "The Vineyard"
	quest.45AAADFE7F430492.quest_subtitle: "Let's Do Vinery"
	quest.45AAADFE7F430492.quest_desc: [
		"&lWhat:&r grapes grow on trellises; the press turns them into juice, and a barrel turns juice into wine."
		"Different biomes, different grapes: red, white, savanna, taiga, jungle."
		"&lTip:&r wines grant special effects — from luck to night vision. Check them in EMI."
	]
	quest.54B6204A21417774.title: "The Fermentation Barrel"
	quest.54B6204A21417774.quest_subtitle: "Patience is the main ingredient"
	quest.54B6204A21417774.quest_desc: [
		"Put in juice, sugar and bottles — some time later you have wine. The longer wine ages on a rack, the stronger it gets."
	]
	quest.37C38BE393F08BE9.title: "The First Bottle"
	quest.37C38BE393F08BE9.quest_subtitle: "To friendship!"
	quest.37C38BE393F08BE9.quest_desc: [
		"Red wine is ready. Put it on a wine rack and let it age."
		"&lValued by:&r mages (some rituals like wine) and the mayor — colonists cheer up in the tavern."
	]
	quest.17AC84486D9AD8A3.title: "The Keg"
	quest.17AC84486D9AD8A3.quest_subtitle: "Brewin' and Chewin': beer, mead, cheese"
	quest.17AC84486D9AD8A3.quest_desc: [
		"The &lkeg&r brews drinks: beer, mead, cider. The surrounding temperature matters — see the hint in the keg window."
		"The Tipsy effect reduces accuracy — drink after work, not before."
	]
	quest.05D32CBE23FE1E77.title: "Something Frothy"
	quest.05D32CBE23FE1E77.quest_subtitle: "The tavern is open"
	quest.05D32CBE23FE1E77.quest_desc: [
		"Beer's ready. Put tankards on a table, call your friends — that's a tavern."
		"&lTip:&r Brewin' drinks grant Tipsy-adjacent buffs like damage resistance."
	]
	quest.5FDA2B7EE1F27453.title: "The Kettle"
	quest.5FDA2B7EE1F27453.quest_subtitle: "Farmer's Respite and HerbalBrews"
	quest.5FDA2B7EE1F27453.quest_desc: [
		"Tea and coffee grant handy effects: &lcoffee&r gives speed, &lgreen tea&r clears effects, &lrose hip&r gives regeneration."
		"Gardeners grow tea bushes. The kettle sits on heat just like the pot."
	]
	quest.4ACB5F2996AE60FF.title: "Mornings Start with Coffee"
	quest.4ACB5F2996AE60FF.quest_subtitle: "Speed, digging, energy"
	quest.4ACB5F2996AE60FF.quest_desc: [
		"One cup and the miner digs faster and the traveller runs farther."
		"&lValued by:&r engineers and miners. Make a stash — it'll be gone fast."
	]
	quest.7355D37F5F004689.title: "A Country Kitchen"
	quest.7355D37F5F004689.quest_subtitle: "Let's Do Farm & Charm"
	quest.7355D37F5F004689.quest_desc: [
		"Farm & Charm adds flour, dough, corn, oats, barley and rustic dishes."
		"A stove, a mixing bowl and a roaster — everything for a cosy farmhouse kitchen."
	]
	quest.37DF5212B0B993C4.title: "Farmer's Bread"
	quest.37DF5212B0B993C4.quest_subtitle: "Flour → dough → bread"
	quest.37DF5212B0B993C4.quest_desc: [
		"Grain becomes flour, flour with water becomes dough, dough in the oven becomes bread. Simple and filling."
	]
	quest.6D36E2C0372C448B.title: "Hell's Kitchen"
	quest.6D36E2C0372C448B.quest_subtitle: "My Nether's Delight"
	quest.6D36E2C0372C448B.quest_desc: [
		"You can cook the Nether too: hoglins, striders, ghasts, burning peppers."
		"Spicy dishes grant fire resistance — just what you need for a Nether trip."
	]
	quest.25B96A73086279BC.title: "Gifts of the Sea"
	quest.25B96A73086279BC.quest_subtitle: "Ocean's Delight"
	quest.25B96A73086279BC.quest_desc: [
		"Squid, guardians, pufferfish — seafood. Fish come from &langlers&r (chapter \"Fishing\")."
		"&lCareful:&r unskilled fugu is poison. Slice it on the board!"
	]
	quest.6365AAAF7F5090A9.title: "Dinner at the End of the World"
	quest.6365AAAF7F5090A9.quest_subtitle: "End's Delight"
	quest.6365AAAF7F5090A9.quest_desc: [
		"Chorus, shulkers and even dragon meat. The strongest dishes in the pack — for those who reached the End."
	]
	quest.0E783133843C22F0.title: "Gourmet"
	quest.0E783133843C22F0.quest_subtitle: "Taste 20 different dishes"
	quest.0E783133843C22F0.quest_desc: [
		"Open the food book (Spice of Life) and see how many dishes you've tried."
		"Each milestone grants a &lheart&r. Twenty dishes and you're noticeably tougher."
		"Tick the quest once the book shows 20+ dishes."
	]
	quest.22F67D677FBB6DC6.title: "A Kitchen of Cogs"
	quest.22F67D677FBB6DC6.quest_subtitle: "Create: Slice & Dice"
	quest.22F67D677FBB6DC6.quest_desc: [
		"The &lslicer&r is a mechanical cutting board: a knife on a Create shaft slices whatever passes by."
		"With a mechanical mixer and a Farmer's Delight pot, the kitchen runs itself."
		"&lWho helps:&r the engineer handles shafts, the cook handles recipes. A two-person job!"
	]
	quest.4F947AD7FACA9BC3.title: "A Better Knife"
	quest.4F947AD7FACA9BC3.quest_desc: [
		"An iron knife lasts longer and cuts faster. Later come diamond and netherite."
		"A knife is also a weapon: quick strikes, great against small critters."
	]
	quest.0C3B5AE748A47953.title: "The Stove"
	quest.0C3B5AE748A47953.quest_desc: [
		"A stove is an everlasting flame for the pot and skillet. You can also grill right on top: put meat on it."
		"Made of bricks and a furnace — pretty and safer than a campfire."
	]
	quest.4B552557EC185A3E.title: "Kitchen Cabinets"
	quest.4B552557EC185A3E.quest_desc: [
		"Cabinets are storage that looks like a real kitchen. Available in every wood type."
	]
	quest.00F65B21E2465E69.title: "Three Soups"
	quest.00F65B21E2465E69.quest_desc: [
		"Vegetable, pumpkin and chicken — soups grant Comfort: warmth and slow healing."
		"Perfect before a trip to snowy lands."
	]
	quest.45CEAF11E8EBFDB2.title: "Pasta with Meatballs"
	quest.45CEAF11E8EBFDB2.quest_desc: [
		"A hearty dish of raw pasta and minced beef. Grants &lHealth Boost&r for 10 minutes — a warrior favourite."
	]
	quest.5733BC9DDB8BF2F2.title: "The Miner's Pie"
	quest.5733BC9DDB8BF2F2.quest_desc: [
		"In Arkhaven shepherd's pie grants &lHaste II&r for 5 minutes — miners dig twice as fast."
		"Valued by: engineers and miners."
	]
	quest.2BD21258DE662010.title: "Rice Dishes"
	quest.2BD21258DE662010.quest_desc: [
		"Fried rice and mushroom rice. In Arkhaven mushroom rice grants night vision — a gift for cavers."
	]
	quest.76C0023FD5EBA6FC.title: "Rolls"
	quest.76C0023FD5EBA6FC.quest_desc: [
		"Rice + fish from the angler = rolls. Quick to make and varied — great for your food book."
	]
	quest.01C12854E8F1B593.title: "Pies"
	quest.01C12854E8F1B593.quest_desc: [
		"A pie is placed whole on a table and served in slices. A great treat for a shared kitchen."
	]
	quest.6DD2CF16ED7E2503.title: "Roast Chicken"
	quest.6DD2CF16ED7E2503.quest_desc: [
		"Another feast for the whole table. Lovely after coming back from a dungeon."
	]
	quest.5FAC855B23FEA2BD.title: "Stuffed Pumpkin"
	quest.5FAC855B23FEA2BD.quest_desc: [
		"An autumn dish and the star of the Harvest Festival. Pumpkins come from the gardener."
	]
	quest.49B4C548F631D1A2.title: "The Cheese Shop"
	quest.49B4C548F631D1A2.quest_desc: [
		"Goat, sheep and buffalo cheese — the milk of three alpine animals."
		"The breeder brings the herd, the cook makes the cheese. A job for two."
	]
	quest.414B31268F62EAEE.title: "Cheese Dishes"
	quest.414B31268F62EAEE.quest_desc: [
		"A cheese tart grants regeneration. A sandwich is quick food for the road."
	]
	quest.6B63BF6B84A13FC1.title: "The Wine List"
	quest.6B63BF6B84A13FC1.quest_desc: [
		"Noir, cherry, apple — each wine has its own effect. Check them in EMI and pick a favourite."
	]
	quest.29929BA10B235878.title: "The Wine Cellar"
	quest.29929BA10B235878.quest_desc: [
		"Wine on a rack grows stronger with age. Build a cellar under the tavern."
	]
	quest.5EBE9D2E71E7566A.title: "Mead"
	quest.5EBE9D2E71E7566A.quest_desc: [
		"Honey from the breeder's bees + a keg = mead. A drink for vikings and good parties."
	]
	quest.4C618506D5B94FF6.title: "Fiery Fondue"
	quest.4C618506D5B94FF6.quest_desc: [
		"Cheese + fire. Grants fire resistance for 8 minutes — just what you need before the Nether."
	]
	quest.618210C3D04CE26C.title: "The Tea Ceremony"
	quest.618210C3D04CE26C.quest_desc: [
		"In Arkhaven green tea restores Iron's Spells mana. Black tea perks you up, lavender calms you."
		"Valued by: mages."
	]
	quest.070D89334A3257F9.title: "The Sink"
	quest.070D89334A3257F9.quest_desc: [
		"Endless water for every kitchen recipe. No more running around with buckets."
	]
	quest.32F8FC9DC50D1AD8.title: "Counters"
	quest.32F8FC9DC50D1AD8.quest_desc: [
		"Counters are ingredient storage the cooking table can see. The more you have, the more one-click recipes."
	]
	quest.02DC973247274ED0.title: "Keeper of the Tavern"
	quest.02DC973247274ED0.quest_subtitle: "Wine, cheese, mead and a feast"
	quest.02DC973247274ED0.quest_desc: [
		"You have everything for a real tavern. Invite your friends and watch their hearts grow."
		"Next: the Grand Restaurant in Great Works."
	]
	chapter.6B2FA039D6C53884.title: "Brewery and Winery"
	chapter.6B2FA039D6C53884.chapter_subtitle: [
		"Beer, wine, rum and vodka: with buffs, in moderation"
	]
	quest.5486FB52402473EA.title: "How Drinking Works Here"
	quest.5486FB52402473EA.quest_subtitle: "Brewin' and Chewin', Vinery, Herbal Brews"
	quest.5486FB52402473EA.quest_desc: [
		"&lWhat:&r drinks are brewed in a keg (Brewin' and Chewin'), wine is aged in barrels (Vinery), tea and coffee in a kettle (Herbal Brews, Farmer's Respite)."
		"&lWhy:&r every drink grants its own buff (see the item tooltip): strength, resistance, speed, warmth in winter."
		"&lTipsiness:&r strong drinks make you Tipsy: a couple of mugs perk you up, too many sway the camera. Know your limit."
		"&lTip:&r a keg has a temperature: some drinks ferment warm (fire, heating cask), others cold (ice crate). The recipe in EMI shows which."
	]
	quest.7DD48C8425292F88.title: "Tankards"
	quest.7DD48C8425292F88.quest_subtitle: "No mug, no drink"
	quest.7DD48C8425292F88.quest_desc: [
		"Keg drinks are poured into tankards. Keep a stack, for yourself and for tavern guests."
	]
	quest.50F75DDCB799AF7E.title: "Steel Toe Stout"
	quest.50F75DDCB799AF7E.quest_subtitle: "A miner's drink"
	quest.50F75DDCB799AF7E.quest_desc: [
		"Dark beer for those who work with their hands. Its buff helps in the mine: check the tooltip for which one."
	]
	quest.32CE37C4439EBF06.title: "Strongroot Ale"
	quest.32CE37C4439EBF06.quest_subtitle: "A warrior's drink"
	quest.32CE37C4439EBF06.quest_desc: [
		"Brewed with root vegetables: drink a mug before a boss fight, together with a dish from «Kitchen»."
	]
	quest.62B9319C01B84D25.title: "Saccharine Rum"
	quest.62B9319C01B84D25.quest_subtitle: "A sailor's drink"
	quest.62B9319C01B84D25.quest_desc: [
		"Rum from sugar cane: no Small Ships captain sets sail without it."
	]
	quest.091CA59FFEDBA284.title: "Vodka"
	quest.091CA59FFEDBA284.quest_subtitle: "Strong stuff"
	quest.091CA59FFEDBA284.quest_desc: [
		"Made from potatoes. Strong: sip it, and check the tooltip for its buff."
	]
	quest.6910FEE1E367ED56.title: "Bloody Mary"
	quest.6910FEE1E367ED56.quest_subtitle: "A cocktail"
	quest.6910FEE1E367ED56.quest_desc: [
		"Vodka + tomatoes from «Garden». Your first cocktail, for the tavern bar."
	]
	quest.07CB93262CD3754E.title: "Rice Wine"
	quest.07CB93262CD3754E.quest_subtitle: "From Farmer's Delight rice"
	quest.07CB93262CD3754E.quest_desc: [
		"Rice from your paddy goes into the keg. «Garden» meets «Brewery»: no farmer, no wine."
	]
	quest.65E7D3DC2B1E7814.title: "Heating Cask"
	quest.65E7D3DC2B1E7814.quest_subtitle: "Warmth for the keg"
	quest.65E7D3DC2B1E7814.quest_desc: [
		"A heat source for the keg: warm-brewed drinks ferment even in winter. For cold ones, use an ice crate."
	]
	quest.61EBEE973BA8D5C1.title: "Cheese Wheel"
	quest.61EBEE973BA8D5C1.quest_subtitle: "It ferments too"
	quest.61EBEE973BA8D5C1.quest_desc: [
		"Brewin' and Chewin' cheese matures in the keg like beer. Sliced, it's the best snack for ale."
	]
	quest.191DFF76FFDB55DB.title: "Wine Box"
	quest.191DFF76FFDB55DB.quest_subtitle: "Vinery: ageing"
	quest.191DFF76FFDB55DB.quest_desc: [
		"Vinery wine improves with time: the longer a bottle rests, the stronger its effect. The box stores bottles and shows the vintage."
	]
	quest.5EEBE11F73184DB4.title: "Apple Cider"
	quest.5EEBE11F73184DB4.quest_subtitle: "From the Vinery press"
	quest.5EEBE11F73184DB4.quest_desc: [
		"Apples into the press, juice into the barrel: cider. Apples grow on Let's Do trees: plant an orchard."
	]
	quest.7DECAA9F406D6656.title: "Eiswein"
	quest.7DECAA9F406D6656.quest_subtitle: "A rare wine"
	quest.7DECAA9F406D6656.quest_desc: [
		"Eiswein is a rare, pricey Vinery wine. The recipe and grape variety are in EMI."
	]
	quest.6FE0B5D606E2BDD2.title: "Copper Tea Kettle"
	quest.6FE0B5D606E2BDD2.quest_subtitle: "Herbal Brews"
	quest.6FE0B5D606E2BDD2.quest_desc: [
		"The alcohol-free branch: green, oolong, rooibos, mate, hibiscus and lavender tea, each with its own buff. Coffee perks you up and speeds up work."
	]
	quest.427DBC1360C65E19.title: "Hot Chocolate"
	quest.427DBC1360C65E19.quest_subtitle: "Create Confectionery"
	quest.427DBC1360C65E19.quest_desc: [
		"Chocolate from a Create mixer, bottled. Restores you without tipsiness. The colony kids will love it."
	]
	quest.0E78C4B235C0F0A3.title: "Tavern Keeper"
	quest.0E78C4B235C0F0A3.quest_subtitle: "The drinks menu is ready"
	quest.0E78C4B235C0F0A3.quest_desc: [
		"Beer, wine, spirits, tea and chocolate. Open a tavern (Minecolonies or your own build) so players come to you after an expedition."
	]
	chapter.62164B6D488C1BD6.title: "Garden, Seasons, Harvest"
	chapter.62164B6D488C1BD6.chapter_subtitle: [
		"From a seed to resources for everyone"
	]
	quest.427EBED79260B8FF.title: "The First Bed"
	quest.427EBED79260B8FF.quest_subtitle: "A hoe and some water nearby"
	quest.427EBED79260B8FF.quest_desc: [
		"&lWhat:&r gardening here isn't just food. Through &lessences&r the garden yields iron, copper, even diamonds."
		"&lHow to start:&r till soil near water. Hold &l`&r and the hoe tills a whole field at once."
		"&lValued by:&r the cook (veggies), the breeder (feed), the mage (Source from plants)."
	]
	quest.7241DEBF5CA44DB8.title: "The Seasons"
	quest.7241DEBF5CA44DB8.quest_subtitle: "Serene Seasons"
	quest.7241DEBF5CA44DB8.quest_desc: [
		"&lWhat:&r the world goes through spring, summer, autumn and winter. Each crop grows only in its seasons."
		"&lHow to tell:&r seeds show \"Growing seasons\" in their tooltip. A calendar shows the current season."
		"&lTip:&r winter brings snow, but under glass in a &lgreenhouse&r everything grows all year."
	]
	quest.51B628DF436AF763.title: "The Greenhouse"
	quest.51B628DF436AF763.quest_subtitle: "Summer under glass"
	quest.51B628DF436AF763.quest_desc: [
		"Plants under a glass roof (up to 15 blocks above) ignore the seasons and always grow."
		"Make it pretty: Create framed glass, frames, lanterns. It's one of the nicest builds in the pack."
	]
	quest.65FFF886EE6B1875.title: "A Vegetable Patch"
	quest.65FFF886EE6B1875.quest_subtitle: "Tomatoes, cabbage, onions"
	quest.65FFF886EE6B1875.quest_desc: [
		"Wild crops grow in the world — pick them for seeds. The cook welcomes every harvest."
		"&lTip:&r Farmer's Delight compost turns into rich soil — crops grow faster on it."
	]
	quest.088D8FACF9F9DAAA.title: "Rich Soil"
	quest.088D8FACF9F9DAAA.quest_subtitle: "Compost → black earth"
	quest.088D8FACF9F9DAAA.quest_desc: [
		"Organic compost turns into &lrich soil&r over time. Plants grow faster on it,"
		"and mushrooms spread into colonies."
	]
	quest.4D54840C4041EC3A.title: "A Garden in a Pot"
	quest.4D54840C4041EC3A.quest_subtitle: "Botany Pots"
	quest.4D54840C4041EC3A.quest_desc: [
		"A &lpot&r grows any plant without water or seasons: add soil, plant a seed."
		"A hopper pot drops the harvest &lby itself&r into the chest below. Ten pots and the cook never runs out of tomatoes."
	]
	quest.27F654BD0954779C.title: "Inferium"
	quest.27F654BD0954779C.quest_subtitle: "Mystical Agriculture: resources grow in a field"
	quest.27F654BD0954779C.quest_desc: [
		"&lWhat:&r inferium ore is found underground. Its essence grows &lresource seeds&r."
		"&lWhy:&r iron, copper, coal, quartz — without a mine. Miners sleep, gardeners work."
		"More in EMI on any Mystical Agriculture seed (&lU&r)."
	]
	quest.1B1006BAB8E24DB6.title: "Seeds from Nothing"
	quest.1B1006BAB8E24DB6.quest_subtitle: "Inferium grows itself"
	quest.1B1006BAB8E24DB6.quest_desc: [
		"Inferium seeds yield more essence — that's how you save up for valuable seeds."
		"&lTip:&r on &linferium farmland&r (special soil) more essence drops."
	]
	quest.67BC52F22FD0E4BF.title: "The Infusion Crystal"
	quest.67BC52F22FD0E4BF.quest_subtitle: "The gardener-alchemist's tool"
	quest.67BC52F22FD0E4BF.quest_desc: [
		"The crystal goes into every seed recipe. It isn't consumed — it just wears down."
		"Find &lprosperity&r — the pale ore deep underground — the crystal needs it."
	]
	quest.2F5070961E1FFE98.title: "An Iron Field"
	quest.2F5070961E1FFE98.quest_subtitle: "Iron without a mine"
	quest.2F5070961E1FFE98.quest_desc: [
		"Plant iron seeds — in time you'll have essence; 8 essence makes ingots."
		"&lValued by:&r engineers. A whole field of iron is a gift nobody refuses."
	]
	quest.3BE440186F9F12A4.title: "Copper Sprouts"
	quest.3BE440186F9F12A4.quest_subtitle: "Create loves copper"
	quest.3BE440186F9F12A4.quest_desc: [
		"Create eats copper by the stack — pipes, tanks, gears. Gift the engineer your harvest."
	]
	quest.52922CDBEA05738F.title: "Steps of Mastery"
	quest.52922CDBEA05738F.quest_subtitle: "Prudentium, tertium, imperium…"
	quest.52922CDBEA05738F.quest_desc: [
		"Inferium essence can be upgraded to prudentium and beyond. Each tier unlocks new seeds."
		"The most valuable (diamonds, netherite) need tiers 4–5 — a long-term gardener goal."
	]
	quest.78E30C72A34F8162.title: "The Watering Can"
	quest.78E30C72A34F8162.quest_subtitle: "Speeds up growth"
	quest.78E30C72A34F8162.quest_desc: [
		"Water a field and plants grow noticeably faster. Better cans cover a bigger area."
	]
	quest.4D95235DFCDB4BB6.title: "Automatic Watering"
	quest.4D95235DFCDB4BB6.quest_subtitle: "The Slice & Dice sprinkler"
	quest.4D95235DFCDB4BB6.quest_desc: [
		"A sprinkler on a Create pipe waters the field for you. Feed it water — or fertiliser for double speed."
		"&lWho helps:&r gardener + engineer = a farm that runs without you."
	]
	quest.642C7E8CAB83E54C.title: "A Tea Plantation"
	quest.642C7E8CAB83E54C.quest_subtitle: "Tea and coffee for the tavern"
	quest.642C7E8CAB83E54C.quest_desc: [
		"Wild coffee bushes grow near stone in hot biomes, tea bushes in forests. Pick them and plant them at home."
		"The cook turns the harvest into buff drinks."
	]
	quest.718C1E915828D752.title: "The Vine"
	quest.718C1E915828D752.quest_subtitle: "Grapes on trellises"
	quest.718C1E915828D752.quest_desc: [
		"Plant a vine by a trellis and in a couple of days it gives bunches. Different biomes grow different grapes."
	]
	quest.72B5ECDBCD5107D7.title: "Green Hands"
	quest.72B5ECDBCD5107D7.quest_subtitle: "You have a greenhouse, pots and resource fields"
	quest.72B5ECDBCD5107D7.quest_desc: [
		"You feed the group and supply its metal. Next up: bees (chapter \"Animals\") and"
		"the Terraformer in \"Great Works\": it changes the biome of whole districts."
	]
	quest.7CB48C4FD3A9F3DF.title: "The Season Sensor"
	quest.7CB48C4FD3A9F3DF.quest_desc: [
		"Gives a redstone signal depending on the season. Open the greenhouse in winter or start sprinklers in summer automatically."
	]
	quest.21945C96E7DA4646.title: "Country Crops"
	quest.21945C96E7DA4646.quest_desc: [
		"Corn, barley, oats, strawberries — Farm & Charm. Wild plants grow in meadows; harvest them for seeds."
		"Oats and barley also feed livestock."
	]
	quest.51F81B7358F45A59.title: "The Scarecrow"
	quest.51F81B7358F45A59.quest_desc: [
		"Keeps crows and rabbits away from your beds. And looks lovely in the middle of a field."
	]
	quest.0D9885D7100AC406.title: "The Plough"
	quest.0D9885D7100AC406.quest_desc: [
		"A horse-drawn plough tills a wide strip. The good old way to work a big field."
	]
	quest.159B0875B4B3DB6C.title: "Fertiliser"
	quest.159B0875B4B3DB6C.quest_desc: [
		"Fertiliser speeds growth more than bone meal and keeps soil fertile for a long time."
	]
	quest.5FC48417FEF5D55A.title: "Inferium Farmland"
	quest.5FC48417FEF5D55A.quest_desc: [
		"Special soil: Mystical Agriculture plants on it yield more essence. It upgrades along with the tiers."
	]
	quest.1B78140E6F7A62BD.title: "Tertium"
	quest.1B78140E6F7A62BD.quest_desc: [
		"The third tier. Unlocks gold, redstone, lapis, quartz and much more."
	]
	quest.315AD198F9D70C16.title: "A Golden Field"
	quest.315AD198F9D70C16.quest_desc: [
		"Gold grows in a bed. Valued by: engineers (electronics) and mages (rituals)."
	]
	quest.4A2580C75ABA966B.title: "Imperium"
	quest.4A2580C75ABA966B.quest_desc: [
		"The fourth tier: diamonds, emeralds, rare modded metals. Needs the &linfusion altar&r with pedestals."
	]
	quest.5D15BA5A782800D0.title: "The Infusion Altar"
	quest.5D15BA5A782800D0.quest_desc: [
		"An altar and eight pedestals — ritual crafting of the strongest seeds. The gardener becomes a bit of a mage."
	]
	quest.243227B8EF08F684.title: "The Diamond Garden"
	quest.243227B8EF08F684.quest_desc: [
		"Diamonds grow. Miners weep, the gardener smiles."
	]
	quest.627590F45B4E0068.title: "The Growth Accelerator"
	quest.627590F45B4E0068.quest_desc: [
		"Placed under a bed, it speeds up the plants above. Higher tiers are faster."
	]
	quest.33A17CFAEB1BE951.title: "The Harvester"
	quest.33A17CFAEB1BE951.quest_desc: [
		"Collects crops around itself into a chest. A hands-free essence farm."
	]
	quest.1DD56AA69632697C.title: "Mob Souls"
	quest.1DD56AA69632697C.quest_desc: [
		"Soul jars collect mob souls with a special dagger. They grow mob seeds: leather, feathers, string — no hunting."
		"You'll need a warrior's help."
	]
	quest.6C8A77DB5B4722EE.title: "Bio-Fuel"
	quest.6C8A77DB5B4722EE.quest_desc: [
		"Crops in a Mekanism crusher become bio-fuel for the bio-generator. The gardener feeds the power plant."
	]
	quest.0A17B14200495303.title: "Prosperity Shard"
	quest.0A17B14200495303.quest_desc: [
		"Prosperity Shards are the other of the two base materials in Mystical Agriculture. They are used to create magical variations of basic materials. You can usually obtain Prosperity Shards by mining them from the ground."
	]
	quest.4B4F1CC20D888AD0.title: "Fertilized Essence"
	quest.4B4F1CC20D888AD0.quest_desc: [
		"Fertilized Essence usually drops from all Resource Crops except Inferium. It works identically to Bonemeal, but also works on Resource Crops! Fertilized Essence can also be used to more efficiently craft Mystical Fertilizer."
	]
	quest.6710759E7B7A6E68.title: "Mystical Fertilizer"
	quest.6710759E7B7A6E68.quest_desc: [
		"Mystical Fertilizer is used to instantly grow a crop or sapling. It's effective on Resource Crops too!"
	]
	quest.16D6AEF14E4596B7.title: "Resource Crops"
	quest.16D6AEF14E4596B7.quest_desc: [
		"&lWhy:&r Resource seeds grow coal, iron, redstone on a farm."
		"Resource Crops are the heart and soul of what makes Mystical Agriculture so great. However, there are some special properties of resource crops that should be noted. Resource Crops can not be grown using Bonemeal. Resource Crops do not drop a second seed unless planted on Essence Farmland."
	]
	quest.22E73CE19A5B425D.title: "Prudentium Watering Can"
	quest.22E73CE19A5B425D.quest_desc: [
		"Upgrading the regular Watering Can with essences and Mystical Fertilizer improves your farming experience a ton. Upgraded Watering Cans have improved range and growth acceleration speed. You can also toggle automatic watering by Shift + Right Clicking with the Watering Can while not targeting a block."
	]
	quest.0B7FF24B7CBE6CB3.title: "Master Infusion Crystal"
	quest.0B7FF24B7CBE6CB3.quest_desc: [
		"&lWhy:&r An infusion crystal that never breaks."
		"The Master Infusion Crystal has infinite durability. You want this, I know you do."
	]
	quest.15E77E1F1B48A889.title: "Supremium Essence"
	quest.15E77E1F1B48A889.quest_desc: [
		"&lWhy:&r Top essence tier for rare resource seeds."
	]
	quest.5EB14F07CC754D45.title: "Supremium Farmland"
	quest.5EB14F07CC754D45.quest_desc: [
		"Essence Farmland increases the output efficiency of Mystical Agriculture crops in multiple ways. They are listed on the following page. You can create Essence Farmland by either right-clicking on Farmland in-world with an essence or by crafting it."
	]
	quest.12D81A56A5FCC4BD.title: "Machine Frame"
	quest.12D81A56A5FCC4BD.quest_desc: [
		"&lWhy:&r The base of every machine in the mod."
	]
	quest.6E709D01CBFFF07C.title: "Furnace"
	quest.6E709D01CBFFF07C.quest_desc: [
		"&lWhy:&r A faster, more efficient furnace."
		"The basic furnace can be upgraded to take advantage of Machine Upgrades for increased cooking speed. They run off of solid fuels and have an internal power storage buffer."
	]
	quest.67588871FAB2E694.title: "Seed Reprocessor"
	quest.67588871FAB2E694.quest_desc: [
		"Seed Reprocessors are used to convert your excess seeds into their respective essences. They run off of solid fuels and have an internal power storage buffer."
	]
	quest.3963DCF2AE9BD6F8.title: "Prudentium Machine Upgrade"
	quest.3963DCF2AE9BD6F8.quest_desc: [
		"Machine Upgrades can be placed in applicable machines to increase their effectiveness. Higher tier machines will both use and generate power faster."
	]
	quest.73E49FD79ED17912.title: "Soul Extractor"
	quest.73E49FD79ED17912.quest_desc: [
		"Soul Extractors are used to convert mob drops into mob souls. They run off of solid fuels and have an internal power storage buffer. The Soul Extractor provides a use for extra mob drops you may have, but generally won't be as efficient as using a Soulium Dagger."
	]
	quest.6BB435B2F8FBED2F.title: "Soulium Spawner"
	quest.6BB435B2F8FBED2F.quest_desc: [
		"&lWhy:&r A spawner for mobs whose souls you collected."
		"The Soulium Spawner is used to spawn both hostile and passive mobs using Essences. They run off of solid fuels and have an internal power storage buffer. The Spawner has an internal inventory that can hold up to 512 items. Each operation will take a certain amount of items and power to spawn a corresponding mob."
	]
	quest.5906340128227BE5.title: "Soulstone"
	quest.5906340128227BE5.quest_desc: [
		"Soulstone is a special kind of stone that spawns in the Nether. It generates in large veins at all Y levels. Soulstone is a decorative block with many variants. It is also required to create Witherproof Blocks."
	]
	quest.658DC4317838768D.title: "Soulium Dagger"
	quest.658DC4317838768D.quest_desc: [
		"&lWhy:&r Collects mob souls for mob seeds."
		"The Soulium Dagger is used to collect souls from mobs. These souls are collected using Soul Jars. Souls are collected by killing mobs with the Soulium Dagger The Soulium Dagger can be upgraded using an Infusion Altar, improving soul collection efficiency."
	]
	quest.26D05FCAEE98D915.title: "Mob Seeds"
	quest.26D05FCAEE98D915.quest_desc: [
		"&lWhy:&r Mob drops grown on a farm."
	]
	quest.790CA639125851D2.title: "Experience Capsule"
	quest.790CA639125851D2.quest_desc: [
		"Experience Capsules are used to collect experience for creating Experience Seeds. To collect experience, simply have some Experience Capsules in your inventory and pick up Experience Orbs."
	]
	quest.6872F301CB6B6989.title: "Enchanter"
	quest.6872F301CB6B6989.quest_desc: [
		"&lWhy:&r Pick the enchantment you want."
		"The Enchanter is a block that allows you to enchant your tools and armor using different crafting materials and Experience Essence. The Enchanter can apply enchantments to both Books and tools/armor, similarly to an Anvil."
	]
	quest.4F2D0B15B7408083.title: "Witherproof Bricks"
	quest.4F2D0B15B7408083.quest_desc: [
		"&lWhy:&r A wither arena it can't break."
		"Witherproof Blocks are unbreakable by the Wither. Very useful for those who like to cheese bosses. They are also immune to damage from the Ender Dragon, however it can still fly though them."
	]
	quest.388CB3B8A232234F.title: "Four Elements"
	quest.388CB3B8A232234F.quest_desc: [
		"Air, Earth, Water and Fire essences can be used in Awakening Altar recipes using Essence Vessels. Elemental seeds can be planted on Tier 1 Essence Farmland for additional drops."
	]
	quest.6A92C9FFFC822177.title: "Cognizant Dust"
	quest.6A92C9FFFC822177.quest_desc: [
		"Cognizant Dust is usually obtained by killing a Wither or Ender Dragon using an Essence Weapon enchanted with Mystical Enlightenment. Higher levels of Mystical Enlightenment will increase the amount of dust dropped on kill."
	]
	quest.449E70857E7D26BA.title: "Essence Vessel"
	quest.449E70857E7D26BA.quest_desc: [
		"Essence Vessels are used in the Awakening Altar structure to hold the elemental essences required to create items. Each vessel can hold up to 40 of a single elemental essence."
	]
	quest.74E04417094816FF.title: "Awakening Altar"
	quest.74E04417094816FF.quest_desc: [
		"The Awakening Altar is a crafting structure that is usually used to create Awakened Supremium. The structure consists of 1 Infusion Altar, 4 Infusion Pedestals and 4 Essence Vessels. Once you have a recipe put in place, you just need to activate the altar with a Redstone signal."
	]
	quest.0EDE86C9C8D3F60C.title: "Awakened Supremium Essence"
	quest.0EDE86C9C8D3F60C.quest_desc: [
		"Awakened Supremium is a high level crafting material used to create upgraded versions of many of your Supremium items. Awakened Supremium is usually created by infusing Cognizant Dust with a Supremium Block using an Awakening Altar."
	]
	quest.0FA62F4604899575.title: "Tinkering Table"
	quest.0FA62F4604899575.quest_desc: [
		"The Tinkering Table is used to add Augments to Essence Tools and Essence Armor."
	]
	quest.76AC689FD69F5824.title: "Sickles and Scythes"
	quest.76AC689FD69F5824.quest_desc: [
		"Sickles are used for harvesting/destroying large areas of plant material. Higher tier Sickles will have a greater area of effect."
		"Scythes are used for harvesting large areas of crops by right clicking. Any fully grown crops within the area of effect will be harvested without being uprooted. Scythes are also an effective weapon with an increased attack AOE. Higher tier Scythes have a greater area of effect."
	]
	quest.3B8E8A8E74884893.title: "Inferium Armor"
	quest.3B8E8A8E74884893.quest_desc: [
		"Upgrading your Diamond* armor with essence improves its durability and protection. This also allows them to be equipped with Augments. Essence Armor can be repaired in an Anvil with their corresponding Essence Ingot. These armor pieces each have 1 augment slot."
	]
	quest.1B268B25F067B7C5.title: "Tertium Armor"
	quest.1B268B25F067B7C5.quest_desc: [
		"&lWhy:&r Each tier: tougher, more augment slots."
	]
	quest.09CA69A67001EDA7.title: "Supremium Armor"
	quest.09CA69A67001EDA7.quest_desc: [
		"&lWhy:&r Netherite-level protection, two augment slots."
	]
	quest.18105C037764B90C.title: "Awakened Supremium Armor"
	quest.18105C037764B90C.quest_desc: [
		"&lWhy:&r The best armor and augment slots of the mod."
	]
	quest.416120935F72BC07.title: "Essence Tools"
	quest.416120935F72BC07.quest_desc: [
		"Upgrading your Diamond* tools with essence improves their durability and mining speed. This also allows them to be equipped with Augments. Essence Tools can be repaired in an Anvil with their corresponding Essence Ingot. These tools each have 1 augment slot."
	]
	quest.2E2B8D9DB116AB7C.title: "mag_aug_flight"
	quest.2E2B8D9DB116AB7C.quest_desc: [
		"The Flight Augment is a chestplate augment that gives the wearer creative flight while they have the armor equipped."
	]
	quest.1A004E1673575AD2.title: "mag_aug_mining"
	quest.1A004E1673575AD2.quest_desc: [
		"The Mining AOE Augment is a tool augment that increases the are that the tool breaks blocks, up to 9x9. This effect can be negated by sneaking. The center of the AOE can be changed by pressing CTRL + Arrow Keys."
	]
	quest.7817B0CBE6726065.title: "Speed and Jump"
	quest.7817B0CBE6726065.quest_desc: [
		"The Speed Augment is a leggings augment that increases the wearers movement speed while they have the armor equipped. This effect is also applied to flight speed."
	]
	quest.7E14F261B672A8E0.title: "mag_aug_health"
	quest.7E14F261B672A8E0.quest_desc: [
		"The Health Boost Augment is an armor augment that adds 2-10 hearts to the wearer while they have the armor equipped."
	]
	quest.732BE297F60E85C9.title: "Resistances"
	quest.732BE297F60E85C9.quest_desc: [
		"&lWhy:&r Fire and poison resistance augments."
		"The Fire Resistance Augment is an armor augment that grants the wearer Fire Resistance while they have the armor equipped."
	]
	quest.5DCC070F362FE310.title: "Night Vision and No Fall"
	quest.5DCC070F362FE310.quest_desc: [
		"The Night Vision Augment is a helmet augment that grants the wearer Night Vision while they have the armor equipped."
	]
	quest.22AE8BEB2AAE8F97.title: "Mystic Farmer"
	quest.22AE8BEB2AAE8F97.quest_desc: [
		"Iron, diamonds and souls grow on your farm."
	]
	chapter.2C295B34DEBBAD70.title: "Animals, Bees, Dragons"
	chapter.2C295B34DEBBAD70.chapter_subtitle: [
		"Breed, tame, discover"
	]
	quest.58A5F95E7247AE74.title: "On a Lead"
	quest.58A5F95E7247AE74.quest_subtitle: "The start of a farm"
	quest.58A5F95E7247AE74.quest_desc: [
		"&lWhy:&r animals give milk, wool, eggs, meat — and rare materials for potions and armour."
		"Bring a pair of cows or sheep home on a lead and feed them — they'll have young."
		"&lValued by:&r the cook (milk → cheese), the alchemist (rare drops), colonists (food)."
	]
	quest.4990A38E7AFA20D8.title: "A Feeding Trough"
	quest.4990A38E7AFA20D8.quest_subtitle: "Farm & Charm"
	quest.4990A38E7AFA20D8.quest_desc: [
		"A trough feeds animals by itself — they stay fed and fertile while you're busy."
		"Fill it with fodder: hay, oats, barley. A chicken coop and a nest give eggs without the chase."
	]
	quest.2AADB93EE520A6DB.title: "Alpine Livestock"
	quest.2AADB93EE520A6DB.quest_subtitle: "Let's Do Meadow"
	quest.2AADB93EE520A6DB.quest_desc: [
		"Mountains are home to alpine cows, goats, sheep and buffalo. Their milk makes different cheeses."
		"A milk can is the best gift for a Meadow cook."
	]
	quest.398471DFFDDBAAF0.title: "Bee Genetics"
	quest.398471DFFDDBAAF0.quest_subtitle: "Productive Bees"
	quest.398471DFFDDBAAF0.quest_desc: [
		"&lWhat:&r dozens of bee species, each makes its own combs: iron, copper, redstone, even diamond."
		"&lHow to start:&r catch a bee in a cage from a nest in the world (nests appear in stone, sand, snow, wood)."
		"The bee guide is in EMI: search \"bee\" and check the mutations (&lR&r)."
	]
	quest.1473A8EBD1BA9240.title: "A Serious Hive"
	quest.1473A8EBD1BA9240.quest_subtitle: "The advanced beehive"
	quest.1473A8EBD1BA9240.quest_desc: [
		"An advanced hive holds more bees, and their combs can be pulled out with a hopper."
		"Put an &lexpansion box&r on top for even more room."
	]
	quest.1171779A20E89BC0.title: "The Centrifuge"
	quest.1171779A20E89BC0.quest_subtitle: "Combs → honey, wax and resources"
	quest.1171779A20E89BC0.quest_desc: [
		"The centrifuge spins combs into honey, wax and useful dusts or ingots."
		"&lTip:&r the mechanical one runs on Create rotation, the powered one on energy."
	]
	quest.0367AB6113664DF8.title: "Crossbreeding"
	quest.0367AB6113664DF8.quest_subtitle: "New bee species"
	quest.0367AB6113664DF8.quest_desc: [
		"Two bees of different species + a &lhoney treat&r = a chance at a new bee."
		"Mutations are listed in EMI. The goal: a bee for the resource you need — iron, copper, gold…"
		"&lValued by:&r engineers and mages — a bee gives a resource forever."
	]
	quest.74361E94132C2418.title: "Genes"
	quest.74361E94132C2418.quest_subtitle: "Productivity, endurance, temper"
	quest.74361E94132C2418.quest_desc: [
		"Bees have genes: productivity, endurance, behaviour. Extract them into bottles and splice them into your best bee."
		"A few generations later your bees work twice as well — even in rain and at night."
	]
	quest.0E9DB92921EFC049.title: "The Zoologist"
	quest.0E9DB92921EFC049.quest_subtitle: "The Alex's Mobs encyclopedia"
	quest.0E9DB92921EFC049.quest_desc: [
		"&lWhat:&r the world holds over a hundred new animals, from hummingbirds to elephants. Many give unique materials."
		"The encyclopedia covers each one: habitat, food, drops."
		"The &lcapture net&r (reward) catches butterflies and small critters — release them in your garden."
	]
	quest.0064456F4405DB56.title: "A Friend on Your Shoulder"
	quest.0064456F4405DB56.quest_subtitle: "Pets"
	quest.0064456F4405DB56.quest_desc: [
		"Otters, ferrets, dragonflies, red pandas — they can be tamed. Pets ride on your shoulder, help in fights or just make you smile."
		"&lTip:&r tamed pets don't attack friends and aren't hurt by stray hits from your team."
	]
	quest.6ACD4387091E4FF3.title: "A Dragon Egg"
	quest.6ACD4387091E4FF3.quest_subtitle: "Dragon Mounts: Remastered"
	quest.6ACD4387091E4FF3.quest_desc: [
		"&lWhat:&r dragon eggs are found in dungeons and dangerous lands. The &lbreed&r depends on where it hatches."
		"Fire near lava, water in the ocean, forest in forests, ice in the snow…"
		"Raise the dragon and you can ride it through the sky."
	]
	quest.57ADB4BD729FE83D.title: "The Whistle"
	quest.57ADB4BD729FE83D.quest_subtitle: "Call your dragon"
	quest.57ADB4BD729FE83D.quest_desc: [
		"A whistle binds to your dragon and calls it from afar. The colour is just for style."
	]
	quest.37E6738A6C282F33.title: "Dragon Armour"
	quest.37E6738A6C282F33.quest_subtitle: "A winged tank"
	quest.37E6738A6C282F33.quest_desc: [
		"Dragon armour protects your pet in battle. It takes a lot of metal — ask the &lengineer&r or a &lgardener&r with resource fields."
	]
	quest.08258F26A6CD43D5.title: "Lord of Beasts"
	quest.08258F26A6CD43D5.quest_subtitle: "Bees, beasts and a dragon"
	quest.08258F26A6CD43D5.quest_desc: [
		"You've got bees, the encyclopedia and a dragon egg. Next: the \"Collections\" chapter —"
		"every bee species, every dragon breed and rare beasts."
	]
	quest.01F1978AF428CF7A.title: "A Herd of Your Own"
	quest.01F1978AF428CF7A.quest_desc: [
		"Breed cows, sheep, pigs and chickens — at least a pair each. Fence them in so no one wanders off."
		"Tick once you have all four."
	]
	quest.64D3410CC19B67C9.title: "The Chicken Coop"
	quest.64D3410CC19B67C9.quest_desc: [
		"A coop collects eggs by itself — no more hunting for them around the yard."
	]
	quest.476E92FC8FA01BD2.title: "Wool for Everyone"
	quest.476E92FC8FA01BD2.quest_desc: [
		"Wool goes to builders (decor), engineers (airship envelopes) and into waxed canvas. Dye sheep for coloured wool straight away."
	]
	quest.62A1724CA0AF2D93.title: "Honey"
	quest.62A1724CA0AF2D93.quest_desc: [
		"Honey goes to the cook (baking, mead) and the alchemist (Fertility potion). Collect it from a hive with bottles."
	]
	quest.2EB248A3855853E5.title: "Beeswax"
	quest.2EB248A3855853E5.quest_desc: [
		"Wax is the key ingredient of &lwaxed canvas&r for airships. Valued by: engineers."
		"This is where the breeder becomes essential to the sky."
	]
	quest.5B230BCEB3D60F81.title: "Finding Nests"
	quest.5B230BCEB3D60F81.quest_desc: [
		"The locator points to the nearest nest of the chosen type. Stone, sand, snow, nether — each has its own bees."
	]
	quest.5D23827FB88F8BB2.title: "The Bee Catcher"
	quest.5D23827FB88F8BB2.quest_desc: [
		"The catcher traps passing bees in cages by itself. Handy for collecting new species."
	]
	quest.7AEC96EC3DFA61E1.title: "The Honey Generator"
	quest.7AEC96EC3DFA61E1.quest_desc: [
		"Honey becomes electricity. The apiary powers machines — another handshake with the engineer."
	]
	quest.260142089968250C.title: "The Incubator"
	quest.260142089968250C.quest_desc: [
		"Larvae in the incubator hatch into new bees of the chosen species."
	]
	quest.31A649466EC5B0A1.title: "Crocodile Scutes"
	quest.31A649466EC5B0A1.quest_desc: [
		"Crocodiles live in swamps and mangroves. Their scutes are the base of &ldragon plating&r for warships."
		"Valued by: warriors and engineers. Careful — they bite."
	]
	quest.1F6B650E813930CE.title: "Bear Fur"
	quest.1F6B650E813930CE.quest_desc: [
		"Grizzlies roam the forests. Their fur makes warm clothing and decor."
	]
	quest.660352F7C57C7229.title: "Fish Oil"
	quest.660352F7C57C7229.quest_desc: [
		"Fish oil is raw material for Aeronautics &laero lubricant&r. The angler and breeder supply the sky."
	]
	quest.2CB166812FBDDB4A.title: "Deer Antlers"
	quest.2CB166812FBDDB4A.quest_desc: [
		"Naturalist deer shed antlers in spring — nobody gets hurt. Antlers go into decor and tools."
	]
	quest.7B663457FD4E47AC.title: "Butterflies in the Garden"
	quest.7B663457FD4E47AC.quest_desc: [
		"Catch a butterfly with a net and release it by your beds — butterflies pollinate plants and crops grow faster."
	]
	quest.1958E45AF97140BD.title: "A Dragonfly Pet"
	quest.1958E45AF97140BD.quest_desc: [
		"A dragonfly can be tamed and even armoured. It looks beautiful flying over a pond."
	]
	quest.035FE318376C81BB.title: "The Copper Golem"
	quest.035FE318376C81BB.quest_desc: [
		"Friends & Foes: the copper golem presses copper buttons — a little helper for contraptions. Build it from a copper block and a pumpkin."
	]
	quest.3CB255952686B6BA.title: "Productive Bees"
	quest.3CB255952686B6BA.quest_desc: [
		"Productive Bees builds on top of vanilla bees. Some understanding of the vanilla system is assumed in this guide."
		"In addition to vanilla bees you'll come across a range of new bees living in well hidden nests in different biomes around the overworld. These bees are solitary meaning they will not live in a hive. However, their genetics allow for breeding different types of bees, plus they look cool."
	]
	quest.56F290846FF16675.title: "Nests"
	quest.56F290846FF16675.quest_desc: [
		"Nests can be found scattered around the world and will each be the home of 1 solitary bee. Nests can be picked up with the bee inside by breaking it, no need for silk touch. To clear a nest of it's bee and any eggs you simply need to craft it with itself."
		"Empty nests can attract new bees if you put one or more honey treats in them. Right click with a honey treat to start the repopulation cooldown."
	]
	quest.2AE6D774B280A0D0.title: "Sturdy Bee Cage"
	quest.2AE6D774B280A0D0.quest_desc: [
		"A bee cage can be used to capture bees for storing or for transport. To catch a bee simply right click the bee with the cage. Right click the filled cage on the ground to release the bee again.Make sure to always keep a few cages on you when travelling in case you come across an interesting bee."
		"Easy to get early in the game"
	]
	quest.220EA98BE03CA4F0.title: "Expansion Box"
	quest.220EA98BE03CA4F0.quest_desc: [
		"Expansion boxes can be attached to advanced beehives to increase the bee capacity of the hive from 3 to 5. Expansion boxes can be placed on top of or next to the hive. Each hive can only have one expansion box."
	]
	quest.4E6710C7FD33F88B.title: "Advanced Hives"
	quest.4E6710C7FD33F88B.quest_desc: [
		"Productive bees expand on the vanilla hive with an Advanced Hive. Unlike the vanilla hive, the advanced hive does not require a campfire nearby to be harvestable it can be broken and moved with the bees still inside without the use of silk touch."
		"There are many variants of advanced beehives available depending on other woods are available in your pack."
	]
	quest.2E18EE6AA3B2093A.title: "Hive Upgrades"
	quest.2E18EE6AA3B2093A.quest_desc: [
		"Upgrades can be put into machines and hives to increase their functionality or improve the performance"
		"The base of all the other upgrades."
	]
	quest.06EB4255BC9F9739.title: "Combs"
	quest.06EB4255BC9F9739.quest_desc: [
		"Bees living in advanced beehives will produce resource combs which can be put into a centrifuge to extract resources."
		"Combs can also be compressed into comb blocks for easier storage."
	]
	quest.0A27D533A7220AFE.title: "Powered Centrifuge"
	quest.0A27D533A7220AFE.quest_desc: [
		"Processes resource combs into resources and honey. Holds 10 buckets of liquid which can be pumped out. The centrifuge will also automatically output fluid to any fluid storage block placed next to. The Powered Centrifuge takes FE to run at an increased processing speed. The centrifuge is also used to separate genetic material from bottles of bee material into genes."
	]
	quest.5B70D7CD0A166F37.title: "Heated Centrifuge"
	quest.5B70D7CD0A166F37.quest_desc: [
		"&lWhy:&r Outputs blocks directly, for big apiaries."
	]
	quest.4E3F0C89E45CDDD3.title: "Bottler"
	quest.4E3F0C89E45CDDD3.quest_desc: [
		"Used for bottling honey and other fluids. Honey can be pumped into the side or it can be placed next to a centrifuge to be filled automatically.The bottler together with a piston can be used to bottle up bees as well, see genetics page."
	]
	quest.3EA5B2CF6DD5234F.title: "Feeding Slab"
	quest.3EA5B2CF6DD5234F.quest_desc: [
		"Can be used as a collection point for feeding bees. It holds 3 item blocks. When Lumber or Quarry bees feed from this it will produce from a random item in the feeder."
		"Feeding slabs can be honeylogged giving the bees an excellent place to dip their toes and recover from a long day of works, aka it gives them regeneration."
	]
	quest.05952DA9EE708E87.title: "Bee Jar"
	quest.05952DA9EE708E87.quest_desc: [
		"Show your bee collection to the world with this fancy glass container perfectly suited to hold a bee. Use a hopper or pipe to insert a bee cage containing a bee of your choosing."
	]
	quest.064151FF9B1D13D3.title: "Honey Treat"
	quest.064151FF9B1D13D3.quest_desc: [
		"Honey treats can be fed to angry bees to calm them down. Feeding them to baby bees will make them grow up faster.Honey treats can also bee combined with genes to transfer genetics from one bee to another. Read more on the genetics page"
	]
	quest.6BA7B408FE4DE512.title: "Bee Attributes"
	quest.6BA7B408FE4DE512.quest_desc: [
		"Bee attributes can be transferred from one bee to another by putting the isolated gene on a honey treat and feeding it to the bee."
		"See the page on collecting genes."
		"Bees with higher level of productivity will produce more combs per trip.Levels are:"
	]
	quest.2FDE9F3B14390EA6.title: "Collecting Genes"
	quest.2FDE9F3B14390EA6.quest_desc: [
		"The bottler together with a piston can be used to bottle up bees. Place a bee in the middle and pull the lever. Make sure the bottler has empty bottles inside. Throw the bottled bee in a centrifuge to separate the useful stuff from the junk."
	]
	quest.1FF16E02F15EE5B0.title: "Transferring Genes"
	quest.1FF16E02F15EE5B0.quest_desc: [
		"To transfer genes to a bee you will need to combine the gene with a honey treat. Feed the honey treat to the bee and it will have a chance, based on the purity of the gene, to acquire the new attribute."
		"The purity of the gene can be increased by combining two of the same genes or by putting more of the same gene onto a treat."
	]
	quest.31F82DA4DE475578.title: "Gene Indexer"
	quest.31F82DA4DE475578.quest_desc: [
		"Are you drowning in gene samples? Are you getting RSI from combining genes? Then this block is for you!"
		"Fill up this extra big container with all the genes you have lying around, flip a switch and watch as the automated internal gene indexer thingy combines the genes for you. It might not be the most efficient way...but it's automated!Needs a redstone signal."
	]
	quest.5A8DBAFCE07FEC6D.title: "Iron Bee"
	quest.5A8DBAFCE07FEC6D.quest_desc: [
		"Bred from a Crystalline Bee and an Ashy Mining Bee."
	]
	quest.3116C39F136644F4.title: "Gold Bee"
	quest.3116C39F136644F4.quest_desc: [
		"Bred from a Crystalline Bee and an Mason Bee."
	]
	quest.79056AF6054FA4DE.title: "Redstone Bee"
	quest.79056AF6054FA4DE.quest_desc: [
		"Bred from a Glowing Bee and an Chocolate Mining Bee."
	]
	quest.07D43E8DD7AAACA7.title: "Diamond Bee"
	quest.07D43E8DD7AAACA7.quest_desc: [
		"Bred from an Ender Bee and a Lapis Bee."
	]
	quest.010A7E9DACD52FE7.title: "Netherite Bee"
	quest.010A7E9DACD52FE7.quest_desc: [
		"Converted from a Diamond Bee be feeding it a block of netherite."
	]
	quest.26954D05B4DFE593.title: "Experience Bee"
	quest.26954D05B4DFE593.quest_desc: [
		"Bred from an Emerald Bee and a Lapis Bee."
	]
	quest.2A2DC3504398F76E.title: "Mob Bees"
	quest.2A2DC3504398F76E.quest_desc: [
		"Will move in to an advanced hive if the hive is left empty in the dark."
	]
	quest.500D77F0F617709F.title: "Wild Bees"
	quest.500D77F0F617709F.quest_desc: [
		"Found living in slimy nests in swampy biomes. Slimy Bees prefer pollinating flowers found in swampy areas, but will also make do with flowers from other biomes.."
	]
	quest.26769BB150AA553C.title: "Solitary Bees"
	quest.26769BB150AA553C.quest_desc: [
		"&lWhy:&r Solitary bees carry genes for breeding new species."
		"[Osmia lignaria]"
	]
	quest.195351E9BD0F28A5.title: "Worker Bees"
	quest.195351E9BD0F28A5.quest_desc: [
		"Will harvest nearby crops and leave the produce on the ground. It operates in a 4 block radius around it's home hive which can be increased with range upgrades. If you have a mod that adds right click harvest, the bee will do exactly that."
		"Nibble on nearby wood and collects it in its hive."
	]
	quest.699B8DBC76FBABEC.title: "Quarry Bee"
	quest.699B8DBC76FBABEC.quest_desc: [
		"Nibble on nearby stone, sand or gravel and collects stone chips in its hive. Stone chips can be crafted into its counterpart block."
	]
	quest.0A7C8017D75EBE02.title: "Ender Bee"
	quest.0A7C8017D75EBE02.quest_desc: [
		"Found living in end stone nests on end islands. Ender Bees prefer pollinating the locally flora of chorus plants."
	]
	quest.3396C14F451D4771.title: "Draconic Bee"
	quest.3396C14F451D4771.quest_desc: [
		"Rarely found living in obsidian pillars on the main island in the end. Draconic Bees pollinate by flying around in the end collecting nectar from the air. The will also nibble on dragon eggs if they get the chance."
	]
	quest.282E53F350A4ABD6.title: "Dragon Egg Hive"
	quest.282E53F350A4ABD6.quest_desc: [
		"A special hive made for Draconic bees that allows the user to harvest the otherwise hard to obtain draconic combs. Naturally Draconic bees live in obsidian nests, but will also live inside a hollowed out dragon egg. They can also be convinced to live in an advanced hive but won't produce any dragon breath there."
		"You can make a fulfilling omelet with the leftovers"
	]
	quest.14163802F9EDFD87.title: "Bee Bomb"
	quest.14163802F9EDFD87.quest_desc: [
		"&lWhy:&r Moves a whole swarm at once."
	]
	quest.0887CD77DDF199C1.title: "Master Beekeeper"
	quest.0887CD77DDF199C1.quest_desc: [
		"Bees bring netherite, XP and dragon dust."
	]
	chapter.0BD79D79E7D32154.title: "Bestiary and Companions"
	chapter.0BD79D79E7D32154.chapter_subtitle: [
		"Beasts, pets and villagers: whom to tame, whom to study"
	]
	quest.13CF20102D7B78A9.title: "The Naturalist's Net"
	quest.13CF20102D7B78A9.quest_subtitle: "Naturalist"
	quest.13CF20102D7B78A9.quest_desc: [
		"&lWhat:&r hundreds of new creatures live in the world (Naturalist, Alex's Mobs, Friends & Foes, Critters & Companions). Most are peaceful."
		"&lWhy:&r each is useful: materials, help, a pet. This chapter covers the most useful ones."
		"&lThe net&r catches butterflies, fireflies and other small things: release them near home."
	]
	quest.1C77C072846E22DB.title: "Firefly"
	quest.1C77C072846E22DB.quest_subtitle: "A living lantern"
	quest.1C77C072846E22DB.quest_desc: [
		"Fireflies glow in swamps at night. Catch some and release them in your garden: pretty, and you can see the way home."
	]
	quest.55964F7444DDA930.title: "Snail Shell"
	quest.55964F7444DDA930.quest_subtitle: "A natural material"
	quest.55964F7444DDA930.quest_desc: [
		"Snails leave shells: a crafting material (see EMI for what they make)."
	]
	quest.3EDAFB99296BD41D.title: "Penguin Feather"
	quest.3EDAFB99296BD41D.quest_subtitle: "Friends & Foes"
	quest.3EDAFB99296BD41D.quest_desc: [
		"Penguins live on icy shores. Their feathers go into arrows and clothing."
	]
	quest.5866BB61BDFE6005.title: "Crab Claw"
	quest.5866BB61BDFE6005.quest_subtitle: "Long arms"
	quest.5866BB61BDFE6005.quest_desc: [
		"A potion from a crab claw extends your reach: builders can touch distant blocks."
	]
	quest.4F8BAF5FD1792F61.title: "A Copper Friend"
	quest.4F8BAF5FD1792F61.quest_subtitle: "Friends & Foes"
	quest.4F8BAF5FD1792F61.quest_desc: [
		"The copper golem is built from a copper block and a lightning rod. It presses copper buttons and oxidises over time: a waxed lightning rod suits its little house."
	]
	quest.033B1D9A70472766.title: "Totem of Illusion"
	quest.033B1D9A70472766.quest_subtitle: "From the illusioner"
	quest.033B1D9A70472766.quest_desc: [
		"The illusioner drops a totem that spawns copies of you when hit: enemies get confused. Good against illager gunners."
	]
	quest.2402F75EF7C35548.title: "Wildfire Crown"
	quest.2402F75EF7C35548.quest_subtitle: "A Nether mini-boss"
	quest.2402F75EF7C35548.quest_desc: [
		"The Wildfire is the blaze queen of bastions. Her crown protects against fire: useful in the Foundry and against Ignis."
	]
	quest.329BCF45C9315052.title: "Koi"
	quest.329BCF45C9315052.quest_subtitle: "Critters & Companions"
	quest.329BCF45C9315052.quest_desc: [
		"A decorative fish for a garden pond. Koi near your bed bring luck, they say (and nice screenshots)."
	]
	quest.32002160EE532F37.title: "Dragonfly Wing"
	quest.32002160EE532F37.quest_subtitle: "An ingredient"
	quest.32002160EE532F37.quest_desc: [
		"Dragonflies live near water. Their wings go into tonics and armour for pet dragonflies."
	]
	quest.3B2210219FF0E30D.title: "Silk"
	quest.3B2210219FF0E30D.quest_subtitle: "From cocoons"
	quest.3B2210219FF0E30D.quest_desc: [
		"Silkworms spin cocoons; they become silk for a silk lead (it doesn't snap) and fabrics."
	]
	quest.339ADBA3BE321FC3.title: "Family Tree"
	quest.339ADBA3BE321FC3.quest_subtitle: "Minecraft Comes Alive"
	quest.339ADBA3BE321FC3.quest_desc: [
		"MCA villagers are alive: names, personalities, families. The tree shows who's related, including your own children if you married in the village."
	]
	quest.54CA79F1B0C4FC67.title: "Engagement"
	quest.54CA79F1B0C4FC67.quest_subtitle: "Not just for villagers"
	quest.54CA79F1B0C4FC67.quest_desc: [
		"Give a ring to a villager who likes you, or to another player. A wedding in the tavern is a reason to gather the server."
	]
	quest.6AC6020BC3187145.title: "Naturalist"
	quest.6AC6020BC3187145.quest_subtitle: "A living world"
	quest.6AC6020BC3187145.quest_desc: [
		"You know who lives around you and what they're good for. Suggest a nature reserve: it's one of the Great Works."
	]
	chapter.57DD3485DB076FB1.title: "Fishing"
	chapter.57DD3485DB076FB1.chapter_subtitle: [
		"A hundred fish, quiet water and the star carp"
	]
	quest.3A9539897B1176C1.title: "Your First Rod"
	quest.3A9539897B1176C1.quest_subtitle: "Tide: fishing with a mini-game"
	quest.3A9539897B1176C1.quest_desc: [
		"&lWhat:&r fishing here is a little game. When it bites, keep the fish in the green zone until the bar fills."
		"&lWhy:&r over a hundred fish — for food, potions, rituals and your collection. The cosiest pastime in the pack."
		"Different fish live in different biomes, depths, times of day and weather."
	]
	quest.21F0682242876677.title: "The Angler's Journal"
	quest.21F0682242876677.quest_subtitle: "Who bites where"
	quest.21F0682242876677.quest_desc: [
		"The journal records every fish you catch and hints where to find the rest."
		"&lTip:&r night fishing in the rain is the best time for rare species."
	]
	quest.1D087548C817D51D.title: "First Catch"
	quest.1D087548C817D51D.quest_subtitle: "Eight cod"
	quest.1D087548C817D51D.quest_desc: [
		"Just fish from the shore. Fresh cod goes to the cook for soup and rolls."
	]
	quest.27EA82321637535F.title: "Bait"
	quest.27EA82321637535F.quest_subtitle: "Luck and faster bites"
	quest.27EA82321637535F.quest_desc: [
		"Bait speeds up bites and raises the odds of rare fish. Craft it from worms, berries, glow berries."
		"Put it in the rod through its window (right-click the rod in your inventory)."
	]
	quest.78B9356D937BFE4F.title: "A Sturdier Rod"
	quest.78B9356D937BFE4F.quest_subtitle: "Line, hook, bobber"
	quest.78B9356D937BFE4F.quest_desc: [
		"An iron rod holds fish better. Swappable &lhooks&r open special waters:"
		"the fiery hook for lava, the permafrost hook under ice, the void hook in the End."
	]
	quest.4E0C0B6EE4FBB412.title: "Lava Fishing"
	quest.4E0C0B6EE4FBB412.quest_subtitle: "The lavaproof hook"
	quest.4E0C0B6EE4FBB412.quest_desc: [
		"Nether lava holds fire fish — needed for alchemy and fire-resistant dishes."
		"Remember: the Nether is &lzone 3&r. Bring a warrior friend."
	]
	quest.7852E1FD4535E319.title: "A Crate from the Deep"
	quest.7852E1FD4535E319.quest_subtitle: "Treasure on the hook"
	quest.7852E1FD4535E319.quest_desc: [
		"Sometimes you hook a crate of loot: books, coins, rare items. Better rods mean richer crates."
	]
	quest.36CEBA9F196FF2E6.title: "Fillets"
	quest.36CEBA9F196FF2E6.quest_subtitle: "Aquaculture"
	quest.36CEBA9F196FF2E6.quest_desc: [
		"A fillet knife turns fish into fillets — easier for the cook, and big fish give many servings."
		"A tackle box keeps hooks and bait together."
	]
	quest.2C267C60B4B16E10.title: "The Old Angler"
	quest.2C267C60B4B16E10.quest_subtitle: "Fill a third of the journal"
	quest.2C267C60B4B16E10.quest_desc: [
		"Tick the quest once a third of the species are in the journal. Legendary fish wait in \"Collections\"."
		"&lValued by:&r alchemists and mages — rare fish go into their recipes."
	]
	quest.5F473F9F3E8F5EF4.title: "The Angling Table"
	quest.5F473F9F3E8F5EF4.quest_desc: [
		"Here you build a rod: pole, line, hook and bobber. Each part changes how the tackle behaves."
	]
	quest.45CF406C62919035.title: "The Golden Rod"
	quest.45CF406C62919035.quest_desc: [
		"Raises the chance of rare fish and treasure."
	]
	quest.47531F258913D839.title: "The Diamond Rod"
	quest.47531F258913D839.quest_desc: [
		"Fish slip off less often, legendary species bite more."
	]
	quest.2CAAF7B984EE8DCE.title: "Ice Fishing"
	quest.2CAAF7B984EE8DCE.quest_desc: [
		"The permafrost hook fishes under ice. Cold waters hold their own special fish."
	]
	quest.1A48F0C1E0815E52.title: "Void Fishing"
	quest.1A48F0C1E0815E52.quest_desc: [
		"The void hook fishes the End's abyss. The strangest fish in the world."
	]
	quest.1FB9BA2B85926335.title: "Neptunium"
	quest.1FB9BA2B85926335.quest_desc: [
		"From Neptune's Bounty chests comes neptunium. Underwater armour and weapons."
	]
	quest.18B2199085A4FF74.title: "The Tackle Box"
	quest.18B2199085A4FF74.quest_desc: [
		"Holds hooks, bait and line. An angler's order."
	]
	chapter.42BEE9E4256E795A.title: "Create: Mechanics"
	chapter.42BEE9E4256E795A.chapter_subtitle: [
		"Rotation that does everything"
	]
	quest.3AD12F9A22C2B78E.title: "Andesite Alloy"
	quest.3AD12F9A22C2B78E.quest_subtitle: "The core material of early mechanics"
	quest.3AD12F9A22C2B78E.quest_desc: [
		"&lWhat:&r Create is all about rotation. Shafts, gears and machines turning each other."
		"&lWhy:&r automate everything: ore crushing, farms, kitchens, lifts, trains, ships."
		"&lHow to start:&r andesite + iron nuggets (or zinc) = andesite alloy. Almost every early part uses it."
	]
	quest.7600D492D41F2A33.title: "Engineer's Goggles"
	quest.7600D492D41F2A33.quest_subtitle: "See the invisible"
	quest.7600D492D41F2A33.quest_desc: [
		"Goggles show rotation speed and network &lstress&r when you look at a machine."
		"Overload the network and everything stops. Goggles show where you lack power."
		"&lReminder:&r hold &lW&r on any Create block — Ponder shows how it works."
	]
	quest.296FB32E35848D1D.title: "The Wheel That Turns Everything"
	quest.296FB32E35848D1D.quest_subtitle: "Your first rotational power"
	quest.296FB32E35848D1D.quest_desc: [
		"&lHow:&r place a water wheel in flowing water and connect a shaft. Each wheel gives a little power — line several up."
		"&lTip:&r a windmill made of sails gives more, a steam engine even more."
	]
	quest.20FAD4E8DA79E2D4.title: "The Mechanical Press"
	quest.20FAD4E8DA79E2D4.quest_subtitle: "Ingots → sheets"
	quest.20FAD4E8DA79E2D4.quest_desc: [
		"The press flattens ingots into sheets and, with a basin, compacts ingredients."
		"Put an item on a &ldepot&r under it or run a &lbelt&r beneath — the press works by itself."
	]
	quest.34E945325D85CA7B.title: "The Conveyor"
	quest.34E945325D85CA7B.quest_subtitle: "Items move by themselves"
	quest.34E945325D85CA7B.quest_desc: [
		"A belt connects two shafts and carries items. Presses, fans, saws and depots all work on belts."
		"&lTip:&r funnels at the ends pull from and push into chests."
	]
	quest.55D84A0552C38733.title: "Crushing Wheels"
	quest.55D84A0552C38733.quest_subtitle: "Ore doubling"
	quest.55D84A0552C38733.quest_desc: [
		"Two wheels spinning toward each other crush ore into &lcrushed ore&r, which smelts into more ingots."
		"Wash it with a fan through water and you get nuggets on top."
		"&lValued by:&r anyone who needs metal. Which is everyone."
	]
	quest.2447D5B34A8A9577.title: "The Fan"
	quest.2447D5B34A8A9577.quest_subtitle: "Wash, smelt, smoke"
	quest.2447D5B34A8A9577.quest_desc: [
		"A fan blows through whatever is in front of it: through water it &lwashes&r, through lava it &lsmelts&r, through fire it &lsmokes&r food."
		"Run a belt through the stream and you won't need a furnace."
	]
	quest.3F74EE2573975D1F.title: "Mixer and Basin"
	quest.3F74EE2573975D1F.quest_subtitle: "Alloys, dough, dyes"
	quest.3F74EE2573975D1F.quest_desc: [
		"A mixer above a basin combines ingredients. That's how you make &lbrass&r (copper + zinc), dough, concrete."
		"With a &lblaze burner&r under the basin you can do heated mixes."
	]
	quest.157A9338DC294AEA.title: "The Brass Age"
	quest.157A9338DC294AEA.quest_subtitle: "Copper + zinc + heat"
	quest.157A9338DC294AEA.quest_desc: [
		"Brass unlocks smart logistics: brass funnels with filters, smart chutes, precision mechanisms."
		"You need a &lblaze burner&r — catch a blaze in the Nether with an empty burner (or ask a warrior)."
	]
	quest.51A00B20682F60A0.title: "The Precision Mechanism"
	quest.51A00B20682F60A0.quest_subtitle: "Step-by-step assembly"
	quest.51A00B20682F60A0.quest_desc: [
		"A precision mechanism is assembled on a belt in several steps: press, deployers, repeat."
		"It's your first \"assembly line\" — EMI shows the recipe step by step."
	]
	quest.40070ED0DEB601C3.title: "A Mechanical Hand"
	quest.40070ED0DEB601C3.quest_subtitle: "The deployer does what you would"
	quest.40070ED0DEB601C3.quest_desc: [
		"A deployer clicks with whatever it holds: plants, hits, uses, assembles parts. These are your factory's hands."
	]
	quest.16E227013AEA622A.title: "Steam!"
	quest.16E227013AEA622A.quest_subtitle: "Boiler and steam engine"
	quest.16E227013AEA622A.quest_desc: [
		"A tank boiler + burners + water = steam. Steam engines on the tank give &lhuge&r rotational power."
		"Check Ponder — tank size and burner count set the boiler level."
	]
	quest.5F0E571DB9523C4F.title: "Moving Builds"
	quest.5F0E571DB9523C4F.quest_subtitle: "Bearings, pistons, glue"
	quest.5F0E571DB9523C4F.quest_desc: [
		"Glue blocks together, mount them on a bearing or piston — and they'll move or spin."
		"That's how you make windmills, gates, lifts, bridges — and later, flying ships."
	]
	quest.6BFCC5C406BD8E53.title: "The Drill"
	quest.6BFCC5C406BD8E53.quest_subtitle: "It digs by itself"
	quest.6BFCC5C406BD8E53.quest_desc: [
		"A drill on a piston or a moving frame digs tunnels and quarries stone on its own."
		"Later it becomes part of a tunnel-boring machine on Aeronautics tracks."
	]
	quest.337822115DCCE924.title: "The Harvester"
	quest.337822115DCCE924.quest_subtitle: "A farm that harvests itself"
	quest.337822115DCCE924.quest_desc: [
		"A harvester on a moving frame passes over a field and collects crops, leaving the plants."
		"&lWho helps:&r the gardener. It's a joint project — build the farm together."
	]
	quest.189B47E1DFEF15C5.title: "Pipes and Tanks"
	quest.189B47E1DFEF15C5.quest_subtitle: "Fluids move too"
	quest.189B47E1DFEF15C5.quest_desc: [
		"A pump pushes fluid through pipes: water, lava, honey, chocolate, oil. A &lspout&r fills bottles and buckets."
	]
	quest.3BE63B3331C9B9B8.title: "Tracks and a Station"
	quest.3BE63B3331C9B9B8.quest_subtitle: "Create trains"
	quest.3BE63B3331C9B9B8.quest_desc: [
		"Create trains run on tracks of any shape, on schedules, between stations."
		"Assemble a carriage at a station, add train controls — and the train is yours."
		"&lTip:&r Steam 'n' Rails adds narrow and wide gauge, couplers and nicer carriages."
	]
	quest.5A15E86CEF89EA05.title: "All Aboard!"
	quest.5A15E86CEF89EA05.quest_subtitle: "A train on a schedule"
	quest.5A15E86CEF89EA05.quest_desc: [
		"A schedule tells the train where to go and how long to wait. A train between friends' bases is the best gift."
	]
	quest.347C760F79CA6686.title: "A Warehouse in Parcels"
	quest.347C760F79CA6686.quest_subtitle: "Create 6 logistics"
	quest.347C760F79CA6686.quest_desc: [
		"Packagers wrap items into parcels, frogports carry them, and a &lstock ticker&r orders what you need from storage."
		"One-click ordering without a digital network."
	]
	quest.5856C39EACDC4542.title: "The Building Cannon"
	quest.5856C39EACDC4542.quest_subtitle: "Schematics"
	quest.5856C39EACDC4542.quest_desc: [
		"Save a build as a &lschematic&r and the &lschematicannon&r builds it again, block by block, from a chest of materials."
		"Share ready-made buildings with friends and build them anywhere."
	]
	quest.5975871C2753E3AA.title: "A Bridge to Electricity"
	quest.5975871C2753E3AA.quest_subtitle: "Create Crafts & Additions"
	quest.5975871C2753E3AA.quest_desc: [
		"An alternator turns rotation into FE energy — the same power Mekanism, AE2 and IE use."
		"An &lelectric motor&r does the reverse. Mechanics and electrics become one system."
	]
	quest.5FBE8D5CCCE83C71.title: "Chief Mechanic"
	quest.5FBE8D5CCCE83C71.quest_subtitle: "Steam, trains and farms"
	quest.5FBE8D5CCCE83C71.quest_desc: [
		"You have steam, a train and an automated farm. Next step: &lthe sky&r — chapter \"Sky & Roads\" for planes and airships."
	]
	quest.7861F972337E213A.title: "The Millstone"
	quest.7861F972337E213A.quest_desc: [
		"A millstone grinds wheat into flour, bones into bone meal, gravel into flint. A simple first machine."
	]
	quest.45E52B7675E48E3D.title: "The Depot"
	quest.45E52B7675E48E3D.quest_desc: [
		"A stand under a press or deployer. Drop an ingot in, take a sheet out. The base of manual lines."
	]
	quest.087DF855D6631721.title: "Funnels and Chutes"
	quest.087DF855D6631721.quest_desc: [
		"A funnel moves items between a belt and a chest, a chute drops items downward. With them the line runs hands-free."
	]
	quest.50FDEED93633617E.title: "Ore Washing"
	quest.50FDEED93633617E.quest_desc: [
		"Crushed ore washed by a fan through water yields bonus nuggets. Together with crushing — nearly triple the output."
	]
	quest.6EFA612B7E06CDA1.title: "The Mechanical Saw"
	quest.6EFA612B7E06CDA1.quest_desc: [
		"On a belt a saw cuts logs into planks; on a moving frame it fells trees. An automatic lumber mill in half an hour."
	]
	quest.4842E7CF7AF8A692.title: "Clutch and Gearshift"
	quest.4842E7CF7AF8A692.quest_desc: [
		"A clutch disconnects a shaft on a redstone signal, a gearshift reverses it. That's how lifts and gates are controlled."
	]
	quest.492AF3B3494FC98F.title: "The Elevator"
	quest.492AF3B3494FC98F.quest_desc: [
		"An elevator pulley + floor contacts = a real lift with buttons. Perfect for a mage's tower or a mine shaft."
	]
	quest.0918D6D0D5C847D6.title: "The Item Vault"
	quest.0918D6D0D5C847D6.quest_desc: [
		"A vault grows by blocks: place a 2×2×4 and you have a huge chest for belts."
	]
	quest.4031E8667755DC63.title: "Spout and Drain"
	quest.4031E8667755DC63.quest_desc: [
		"The spout fills bottles and buckets on a belt, the drain empties them. Honey, milk, chocolate — all automatic."
	]
	quest.626D50B98EDCF165.title: "The Chocolate Factory"
	quest.626D50B98EDCF165.quest_desc: [
		"Cocoa, milk and sugar in the mixer — and a river of chocolate. Create Confectionery adds candy and gingerbread."
	]
	quest.77513643791B2DE5.title: "The Mechanical Crafter"
	quest.77513643791B2DE5.quest_desc: [
		"A grid of mechanical crafters builds big recipes by itself. Needed for cannons, rockets and large machines."
	]
	quest.4CF9CAB1D7B00C1A.title: "Diving Gear"
	quest.4CF9CAB1D7B00C1A.quest_desc: [
		"A copper backtank of compressed air and a helmet — breathe underwater for ages. The tank also powers Create tools."
	]
	quest.7D91FDAB52BA16A2.title: "The Extendo Grip"
	quest.7D91FDAB52BA16A2.quest_desc: [
		"The grip extends your reach — building at height becomes much easier."
	]
	quest.7FB122966F58C63E.title: "The Toolbox"
	quest.7FB122966F58C63E.quest_desc: [
		"A toolbox holds your tools and a hotkey pulls them from anywhere nearby. Order in the workshop."
	]
	quest.5375F9873F5AC43D.title: "The Display Board"
	quest.5375F9873F5AC43D.quest_desc: [
		"A display link shows storage contents, train schedules, machine speed. Build a station with an arrivals board!"
	]
	quest.5C4FE191A3A807BE.title: "Signals"
	quest.5C4FE191A3A807BE.quest_desc: [
		"Signals split tracks into blocks so trains don't collide. Needed as soon as there's more than one train."
	]
	quest.51969B0301BA1EDC.title: "Steam 'n' Rails"
	quest.51969B0301BA1EDC.quest_desc: [
		"Semaphores, the conductor's whistle, couplers and different gauges. Call a train to you with the whistle!"
	]
	quest.46F98B846DE095EC.title: "The Potato Cannon"
	quest.46F98B846DE095EC.quest_desc: [
		"It shoots food. The stranger the food, the stranger the effect. A joke that works."
	]
	quest.5B1D8C7DB03F8655.title: "Industrial Enchanting"
	quest.5B1D8C7DB03F8655.quest_desc: [
		"Create Enchantment Industry turns XP into a liquid and enchants items on a belt. No grinding at the enchanting table."
	]
	quest.2B6BA5EF7AFE7EFB.title: "The Chunk Loader"
	quest.2B6BA5EF7AFE7EFB.quest_desc: [
		"Create: Power Loader keeps a chunk loaded while its loader gets rotation — the factory runs when you're away."
	]
	quest.6E41A64ECE5960D9.title: "Hand Crank"
	quest.6E41A64ECE5960D9.quest_desc: [
		"Hand Cranks can be used by players to apply rotational force manually. Hold Right-Click to rotate it Counter-Clockwise. Sneak and Hold Right-Click to rotate it Clockwise."
	]
	quest.17742DEF09F4E37B.title: "Gear Ratios"
	quest.17742DEF09F4E37B.quest_desc: [
		"&lWhy:&r Large to small doubles speed but also stress."
		"Large and Small cogs can be connected diagonally. Shifting from large to small cogs, the conveyed speed will be doubled. Shifting the opposite way, the conveyed speed will be halved."
	]
	quest.3E0C74616C4C4098.title: "Gearbox"
	quest.3E0C74616C4C4098.quest_desc: [
		"Jumping between axes of rotation can get bulky quickly. A gearbox is the more compact equivalent of this setup. Shafts around corners rotate in mirrored directions. Straight connections will be reversed."
		"Chain Drives relay rotation to each other in a row. All shafts connected like this will rotate in the same direction. Any part of the row can be rotated by 90 degrees."
	]
	quest.6E4CC7DED631E6FB.title: "Large Water Wheel"
	quest.6E4CC7DED631E6FB.quest_desc: [
		"Large Water Wheels draw force from adjacent Water Currents. Covering additional sides will not improve its kinetic output further. These rotate only at half the speed of regular water wheels... ...but provide a substantially higher stress capacity. Use wood planks on the wheel to change its appearance."
	]
	quest.5A56460EB76ECD8F.title: "Windmill"
	quest.5A56460EB76ECD8F.quest_desc: [
		"&lWhy:&r More sails, more power — works anywhere."
		"Any Structure can count as a valid Windmill, as long as it contains at least 8 sail-like Blocks."
	]
	quest.439AB1D66F23B816.title: "Speed and Stress"
	quest.439AB1D66F23B816.quest_desc: [
		"&lWhy:&r If the network stops, check the stressometer."
		"The Stressometer displays the current Stress Capacity of the attached kinetic network. When wearing Engineers' Goggles, the player can get more detailed information from the Gauge. Comparators can emit analog Redstone Signals relative to the Stressometer's measurements."
	]
	quest.09B72D21E7475B38.title: "Sequenced Gearshift"
	quest.09B72D21E7475B38.quest_desc: [
		"Seq. Gearshifts relay rotation by following a timed list of instructions. Right-click it to open the Configuration UI. Upon receiving a Redstone Signal, it will start running its configured sequence. Once finished, it waits for the next Redstone Signal and starts over. A redstone comparator can be used to read the current progress."
		"Rot. Speed Controllers relay rotation from their axis to a Large Cogwheel above them. Using the value panel on its side, the conveyed speed can be configured."
	]
	quest.789866CD897AFFAD.title: "Steam Boiler"
	quest.789866CD897AFFAD.quest_desc: [
		"&lWhy:&r A 3x3 tank boiler with blaze burners powers a factory."
		"Steam Engines can be placed on a Fluid Tank. Clicking the engine with a Shaft creates the Kinetic Output. With sufficient Heat, Water and Boiler space... ...they will generate Rotational Force. The minimal setup requires 4 Fluid Tanks. With the help of Blaze Burners, the power output can be increased. Higher power levels require more Water, Size and Heat. The boiler's current power level can be inspected with Engineer's Goggles."
		"Blaze Burners can provide Heat to Items processed in a Basin. For this, the Blaze has to be fed with flammable items. With a Blaze Cake, the Burner can reach an even stronger level of heat. The feeding process can be automated using Deployers or Mechanical Arms."
	]
	quest.65F0D1BE947AA3B9.title: "Blaze Cake"
	quest.65F0D1BE947AA3B9.quest_desc: [
		"&lWhy:&r Superheats a burner for superheated recipes."
		"A Delicious treat for your hard-working Blaze Burners. Gets them all fired up!"
	]
	quest.3C14611B85BBFA31.title: "Steam Whistle"
	quest.3C14611B85BBFA31.quest_desc: [
		"Steam Whistles can be placed on a Fluid Tank. If the tank receives sufficient heat... ...the Whistle will play a note when activated. Use a Whistle item on the block to lower its pitch. Cycle between three different octaves using a Wrench. Engineer's Goggles can help to find out the current pitch of a Whistle."
	]
	quest.6F5A49281E0F0CF6.title: "Mechanical Piston"
	quest.6F5A49281E0F0CF6.quest_desc: [
		"Mechanical Pistons can move blocks in front of them. Speed and direction of movement depend on the Rotational Input. Sticky Mechanical Pistons can pull the attached blocks back."
	]
	quest.24B46602A0468CD7.title: "Gantry Carriage"
	quest.24B46602A0468CD7.quest_desc: [
		"Gantry Shafts form the basis of a gantry setup. Attached Carriages will move along them. Gantry setups can move attached Blocks."
	]
	quest.5F0AB56D6CE44650.title: "Rope Pulley"
	quest.5F0AB56D6CE44650.quest_desc: [
		"Rope Pulleys can move blocks vertically when given Rotational Force. Direction and Speed of movement depend on the Rotational Input."
	]
	quest.528D00532814FEBA.title: "Chassis"
	quest.528D00532814FEBA.quest_desc: [
		"Linear Chassis connect to identical Chassis blocks next to them. When one is moved by a Contraption, the others are dragged with it. Chassis of a different type or facing another direction will not attach."
		"Radial Chassis connect to identical Chassis blocks in a row. When one is moved by a Contraption, the others are dragged with it. The side faces of a Radial Chassis can be made Sticky. Click again to make all other sides sticky. Sneak and Right-Click with an empty hand to remove the slime. Whenever a Block is next to a sticky face... ...it will attach all reachable blocks within a radius on that layer. Using a Wrench, a precise Radius can be specified for this chassis."
	]
	quest.63B007A73C7624F6.title: "Sticker"
	quest.63B007A73C7624F6.quest_desc: [
		"Stickers are ideal for Redstone-controlled block attachment. Upon receiving a signal, it will toggle its state. If it is now moved in a contraption, the block will move with it. Toggled once again, the block is no longer attached."
	]
	quest.529DC58B8DBDDA33.title: "Clockwork Bearing"
	quest.529DC58B8DBDDA33.quest_desc: [
		"&lWhy:&r Clock hands for your town hall tower."
		"Clockwork Bearings attach to blocks in front of them. Upon receiving Rotational Force, the structure will be rotated according to the hour of the day. 3:00. 4:00. Right-Click the bearing to start or stop animating the structure. In front of the Hour Hand, a second structure can be added. Ensure that the two Structures are not glued to each other. The Second Structure will now rotate as the Minute Hand."
	]
	quest.0094FCEEFD55BC35.title: "Cart Assembler"
	quest.0094FCEEFD55BC35.quest_desc: [
		"Powered Cart Assemblers mount attached structures to passing Minecarts. Without a redstone signal, it disassembles passing cart contraptions back into blocks. Using a Wrench on the Minecart will let you carry the Contraption elsewhere."
	]
	quest.0005700F5C84E0CB.title: "Contraption Controls"
	quest.0005700F5C84E0CB.quest_desc: [
		"Actors on moving contraptions are always active by default. Contraption Controls can be used to toggle them on the fly. They can be attached anywhere on the contraption. While disassembled, the filter can be changed to target specific types of actors. If it is redstone-activated during assembly... ...targeted actors will be turned off from the start."
	]
	quest.14F40C35FEE4570C.title: "Mechanical Plough"
	quest.14F40C35FEE4570C.quest_desc: [
		"Whenever Ploughs are moved as part of an animated Contraption... ...they will break blocks without a solid collision hitbox. Additionally, ploughs can create farmland. ...they can also launch entities without hurting them."
	]
	quest.6E4C621731A2E3CC.title: "Mechanical Roller"
	quest.6E4C621731A2E3CC.quest_desc: [
		"&lWhy:&r Paves roads and fills holes as it moves."
		"Mechanical rollers help to clean up terrain around tracks or paths. In its default mode, without a material set, it will simply clear blocks like a Drill. While disassembled, a suitable paving material can be specified. Materials can be supplied via chests or barrels attached to the structure. In addition to breaking blocks, it will now replace the layer beneath them. Note that any block destroyed by a roller has a chance not to yield drops. Rollers are especially useful on Trains, but can also be used on most other types of moving contraptions."
	]
	quest.03AADBDAD9561F63.title: "Portable Storage Interface"
	quest.03AADBDAD9561F63.quest_desc: [
		"&lWhy:&r Unloads a moving drill or train at a station."
		"Moving inventories can be tricky to access with automation. This component can interact with storage without the need to stop the contraption. Place a second one with a gap of 1 or 2 blocks inbetween. Whenever they pass by each other, they will engage in a connection. While engaged, the stationary interface will represent ALL inventories on the contraption. Items can now be inserted... ...or extracted from the contraption. After no items have been exchanged for a while, the contraption will continue on its way."
	]
	quest.6A1F70D602EEF065.title: "Mechanical Arm"
	quest.6A1F70D602EEF065.quest_desc: [
		"Mechanical Arms have to be assigned their in- and outputs before they are placed. Right-Click inventories while holding the Arm to assign them as Targets. Right-Click again to toggle between Input (Blue) and Output (Yellow). Left-Click components to remove their Selection. Once placed, the Mechanical Arm will target the blocks selected previously. They can have any amount of in- and outputs within their range. However, not every type of Inventory can be interacted with directly. Funnels and Depots can help to Bridge that gap."
		"Input. Outputs. Whenever an Arm has to choose between multiple valid outputs... ...it will act according to its setting. The value panel will allow you to configure it. Round Robin mode simply cycles through all outputs that are available. If an output is unable to take more items, it will be skipped. Forced Round Robin mode will never skip outputs, and instead wait until they are free."
	]
	quest.7BC536D0DABFF75C.title: "Weighted Ejector"
	quest.7BC536D0DABFF75C.quest_desc: [
		"Sneak and Right-Click holding an Ejector to select its target location. The placed ejector will now launch objects to the marked location. A valid target can be at any height or distance within range. They cannot however be off to a side. If no valid Target was selected, it will simply target the block directly in front. Supply Rotational Force in order to charge it up. Items placed on the ejector cause it to trigger. If Inventories are targeted, the ejector will wait until there is space."
	]
	quest.1A632D59F2F2863B.title: "Brass Funnel"
	quest.1A632D59F2F2863B.quest_desc: [
		"Andesite Funnels can only ever extract single items. Brass Funnels can extract up to a full stack. The value panel allows for precise control over the extracted stack size. Using items on the filter slot will restrict the funnel to only transfer matching stacks."
		"The distribution behaviour of Brass Tunnels can be configured. 'Split' will attempt to distribute the stack evenly between available outputs. If an output is unable to take more items, it will be skipped. 'Forced Split' will never skip outputs, and instead wait until they are free. 'Round Robin' keeps stacks whole, and cycles through outputs iteratively. Once Again, if an output is unable to take more items, it will be skipped. 'Forced Round Robin' never skips outputs. 'Prefer Nearest' prioritizes the outputs closest to the items' input location."
	]
	quest.4931171F4435EBF9.title: "Smart Chute"
	quest.4931171F4435EBF9.quest_desc: [
		"Smart Chutes are vertical chutes with additional control. Items in the filter slot specify what to extract or transfer. Use the value panel to specify the extracted stack size. Redstone power will prevent Smart Chutes from acting."
	]
	quest.1B74397ACB9100F7.title: "Filters"
	quest.1B74397ACB9100F7.quest_desc: [
		"&lWhy:&r Filters let only matching items through."
		"Matches items against a collection of items or other filters. Can be used in Filter Slots of Create's Components"
	]
	quest.7C703659B2D0B37E.title: "Crafting Blueprint"
	quest.7C703659B2D0B37E.quest_desc: [
		"Placed on a wall, it can be used to specify ingredient arrangements for easier manual crafting. Each slot represents a Recipe."
	]
	quest.3FF8BEF20FBB03E4.title: "Chain Conveyor"
	quest.3FF8BEF20FBB03E4.quest_desc: [
		"Right-click two conveyors with chains to connect them. Chain conveyors relay rotational power between each other.. ..and connect to shafts above or below them. Right-click holding a wrench to start travelling on the chain. At a junction, face towards a chain to follow it."
		"Right-click a Chain Conveyor and place the Frogport nearby. Assign it an address in the inventory UI. If the address of an inserted package does not match it.. Albert. → Peter. ..the Frogport will place the package on the conveyor. Packages spin in place if they have no valid destination. More Frogports can be added anywhere on the chain network."
	]
	quest.370288E2C336547D.title: "White Postbox"
	quest.370288E2C336547D.quest_desc: [
		"&lWhy:&r Trains carry packages between postboxes."
		"Right-click a Train Station and place the Postbox nearby. Assign it an address in the inventory UI. If the address of an inserted package does not match it.. Warehouse. → Outpost. ..trains stopping at the station will collect it as cargo. Conversely, packages matching the address will be dropped off. Packages that arrived by train can be extracted from the Postbox."
	]
	quest.04EC50D9EF207AD0.title: "Redstone Requester"
	quest.04EC50D9EF207AD0.quest_desc: [
		"Right-click a Stock link before placement to connect to its network. Just like Stock tickers, Redstone requesters can order items from the logistics network. Right-click the requester to open its configuration UI. The order set in the UI will be requested on every redstone pulse. Alternatively, the requester can be fully configured before placement. Right-click a Stock keeper with it and set the desired order there."
	]
	quest.6853B92385A49174.title: "Factory Gauge"
	quest.6853B92385A49174.quest_desc: [
		"&lWhy:&r Orders ingredients and keeps stock. The heart of Create 6 automation."
		"Whenever gauges are not placed on a packager... They will instead monitor stock levels of all linked inventories. Right-click it with the item that should be monitored. It will now display the total amount present on the network. The gauge can replenish stock levels by sending other items to be processed. First, add the required ingredients as new factory gauges. From the target's UI, new connections can be made. For aesthetics, input panels can be wrenched to change the pathing."
		"Right-click a Stock link before placement to connect to its network. When placed on a packager, factory gauges can monitor items inside the inventory. Right-click it with the item that should be monitored. It will now display the amount present in the inventory. The gauge can refill this inventory from the logistics network. Right-click it again to open its configuration UI. Set an address that should be used for the requested items. The target amount to maintain can now be set by holding Right-click on the gauge."
	]
	quest.796A20BC5A03BFB6.title: "White Table Cloth"
	quest.796A20BC5A03BFB6.quest_desc: [
		"&lWhy:&r A shop counter that sells from your stock."
		"Table cloths can be used to display items. With the help of a logistics system, they can also be used to sell items. Start with the shop's inventory, a Packager and Stock link. Bind a Stock ticker to the link and place it in the shop. Employ a mob or blaze burner as the shop keeper. Fill the shop inventory with items to be sold. To create a new trade, interact with the shop keeper while holding a table cloth. Once placed, set a price in the item slot on the side."
	]
	quest.646CF849C136583D.title: "Hose Pulley"
	quest.646CF849C136583D.quest_desc: [
		"Hose Pulleys can be used to fill or drain large bodies of Fluid. With the Kinetic Input, the height of the pulleys' hose can be controlled. The Pulley retracts while the input rotation is inverted. On the opposite side, pipes can be connected. Attached pipe networks can either provide fluid to the hose... ...or pull from it, draining the pool instead. Fill and Drain speed of the pulley depends entirely on the fluid networks' throughput."
		"When deploying the Hose Pulley into a large enough ocean... It will provide/dispose fluids without affecting the source. Pipe networks can limitlessly take fluids from/to such pulleys."
	]
	quest.1AE7B4D173A72FAB.title: "Smart Fluid Pipe"
	quest.1AE7B4D173A72FAB.quest_desc: [
		"Smart pipes can help control flows by fluid type. When placed directly at the source, they can specify the type of fluid to extract. Simply Right-Click their filter slot with any item containing the desired fluid. When placed further down a pipe network, smart pipes will only let matching fluids continue."
	]
	quest.7016908F07D01275.title: "Portable Fluid Interface"
	quest.7016908F07D01275.quest_desc: [
		"Fluid Tanks on moving contraptions cannot be accessed by any pipes. This component can interact with fluid tanks without the need to stop the contraption. Place a second one with a gap of 1 or 2 blocks inbetween. Whenever they pass by each other, they will engage in a connection. While engaged, the stationary interface will represent ALL Tanks on the contraption. Fluid can now be inserted... ...or extracted from the contraption. After no contents have been exchanged for a while, the contraption will continue on its way."
	]
	quest.5894F275AFB19AE1.title: "Redstone Link"
	quest.5894F275AFB19AE1.quest_desc: [
		"&lWhy:&r Wireless redstone."
		"Redstone Links can transmit redstone signals wirelessly. Right-click while Sneaking to toggle receive mode. A simple Right-click with a Wrench can do the same. Receivers emit the redstone power of transmitters within 256 blocks. Placing items in the two slots can specify a Frequency. Only the links with matching Frequencies will communicate."
	]
	quest.41539C1104D0DC1A.title: "Create Logic Kit"
	quest.41539C1104D0DC1A.quest_desc: [
		"Pulse Extenders can lengthen a signal passing through. They activate after a short delay... ...and cool down for the configured duration. Using the value panel, the discharge time can be configured. The configured duration can range up to an hour."
	]
	quest.61D822F52C3F2A61.title: "Smart Observers"
	quest.61D822F52C3F2A61.quest_desc: [
		"Smart Observers can be used to detect a variety of events. It can detect items or fluids inside of generic containers. The filter slot can be used to look for specific contents only. It also activates when the block itself matches the filter. Additionally, smart observers can monitor belts, chutes and pipes. ...and will emit a pulse, if an item enters or exits a funnel."
		"Threshold Switches monitor the fill level of containers. When the inventory content exceeds the upper threshold... ...the switch will change its redstone output. The signal stays until the lower threshold is reached. The redstone output can now be used to control item supply, keeping the buffer filled. The specific thresholds can be changed in the UI. A filter can help to only count specific contents toward the total. Fluid buffers can be monitored in a similar fashion."
	]
	quest.44B552C1221505DA.title: "Nixie Tube"
	quest.44B552C1221505DA.quest_desc: [
		"When powered by Redstone, Nixie Tubes will display the signal strength. Using written Clipboards, custom text can be displayed. Right-Click with Dye to change their display colour."
	]
	quest.16AFA75E1F1CA519.title: "Linked Controller"
	quest.16AFA75E1F1CA519.quest_desc: [
		"&lWhy:&r A remote that drives redstone links."
		"Grants handheld control over Redstone Link frequencies assigned to its six buttons."
	]
	quest.0F833148CBCEE255.title: "Zinc"
	quest.0F833148CBCEE255.quest_desc: [
		"&lWhy:&r Zinc + copper = brass."
	]
	quest.2F436D152B6D226B.title: "Rose Quartz"
	quest.2F436D152B6D226B.quest_desc: [
		"&lWhy:&r Polished rose quartz makes electron tubes."
	]
	quest.63CED89D89010B73.title: "Sturdy Sheet"
	quest.63CED89D89010B73.quest_desc: [
		"&lWhy:&r Obsidian sheets for train parts and cannons."
	]
	quest.0B453B0B6FE80020.title: "Haunting"
	quest.0B453B0B6FE80020.quest_desc: [
		"&lWhy:&r A fan through soul fire haunts items."
		"When passing through lava, the Air Flow becomes Heated. Items caught in the area will be smelted. Food items thrown here would be incinerated. Instead, a setup for Smoking using Fire should be used for them. Air Flows passing through water create a Washing Setup. Some interesting new processing can be done with it. The Speed of the Fan does NOT affect the processing speed, only its range. Fan Processing can also be applied to Items on Depots and Belts."
	]
	quest.792546CC41F59CA1.title: "Netherite Diving Gear"
	quest.792546CC41F59CA1.quest_desc: [
		"&lWhy:&r Swim in lava while the tank has air."
		"A Wearable Tank for carrying Pressurized Air."
	]
	quest.5886D1EDDA939D43.title: "Cardboard Armor"
	quest.5886D1EDDA939D43.quest_desc: [
		"&lWhy:&r Barely protects, but mobs ignore a crouching box."
	]
	quest.7469E9A830ECCF65.title: "Wand Of Symmetry"
	quest.7469E9A830ECCF65.quest_desc: [
		"&lWhy:&r Build one half, the other mirrors."
		"Mirrors Block placement while present in any Hotbar Slot."
	]
	quest.10E9DBF7B1535788.title: "Tree Fertilizer"
	quest.10E9DBF7B1535788.quest_desc: [
		"A powerful combination of minerals useful for growing saplings in tight spaces."
	]
	quest.00C5D1713FEED0DC.title: "Builder's Tea"
	quest.00C5D1713FEED0DC.quest_desc: [
		"The perfect drink to get the day started- Motivating and Saturating."
	]
	quest.05C861DE4ACBE483.title: "Schematic And Quill"
	quest.05C861DE4ACBE483.quest_desc: [
		"&lWhy:&r Save a build to a schematic and rebuild it anywhere."
		"Used for saving a Structure in your world to a .nbt file."
	]
	quest.3C1291E302F6C9D6.title: "Copycat Panel"
	quest.3C1291E302F6C9D6.quest_desc: [
		"Converts any full block into a decorative panel. Also accepts Bars and Trapdoors."
	]
	quest.34D7C916CBEC9868.title: "White Seat"
	quest.34D7C916CBEC9868.quest_desc: [
		"&lWhy:&r Seats ride along on contraptions; a mob on a seat stays put."
	]
	quest.1DC60463C39AD55F.title: "Cuckoo Clock"
	quest.1DC60463C39AD55F.quest_desc: [
		"Fine craftsmanship for decorating a space and keeping track of time."
	]
	quest.21C87A4A59E7717B.title: "Peculiar Bell"
	quest.21C87A4A59E7717B.quest_desc: [
		"&lWhy:&r The haunted bell shows where mobs can spawn."
		"A decorative Brass Bell. Placing it right above open Soul Fire may have side-effects..."
	]
	quest.7888BBDB0019B7BA.title: "Clipboard"
	quest.7888BBDB0019B7BA.quest_desc: [
		"Keeps your notes and makes you look more professional."
	]
	quest.7CD7B9B4111EDF4A.title: "Train Assembly"
	quest.7CD7B9B4111EDF4A.quest_desc: [
		"Select a Train Track then place the Station nearby. Stations are the Waypoints of your Track Network. To create a new Train, open the UI and switch to Assembly Mode. During Assembly no scheduled trains will approach this station. Create new bogeys by using Train Casing on Tracks. Click the track again to cycle between bogey designs. Attach blocks with the help of Super Glue. Assembled Trains will move faster if they can find fuel in assembled chests or barrels."
	]
	quest.655594C87BEF07E5.title: "Train Schedule"
	quest.655594C87BEF07E5.quest_desc: [
		"Schedules allow Trains to be controlled by other Drivers. Right-click with the item in hand to open its Interface. Once programmed, the Schedule can be handed off to a Train Driver. Any mob or blaze burner sitting in front of Train Controls is an eligible conductor. Creatures on a lead can be given their seat more conveniently. Schedules can be retrieved from Drivers at any moment."
		"Schedules can be used to provide drivers with a destination. Comparators will receive a signal whenever a Train is present. Mind that a Station can only be approached from the indicated direction. Stations can also be used to assign new Schedules automatically. The Schedule placed on a station will automatically copy itself to present trains. As opposed to manual scheduling, drivers will not take the item with them."
	]
	quest.0313AA2F0A6E1CA0.title: "Train to the Nether"
	quest.0313AA2F0A6E1CA0.quest_desc: [
		"Tracks placed up against a nether portal... ...will attempt to create a paired track on the other side. Trains on this track are now able to travel across dimensions."
	]
	quest.3EBBB7FF40B4E7BF.title: "Train Observer"
	quest.3EBBB7FF40B4E7BF.quest_desc: [
		"Select a Train Track then place the Observer nearby. The Observer will detect any Trains passing over the marker. Observers can be filtered to activate for matching cargo."
	]
	quest.7F16EF7DB7292898.title: "Create Engineer"
	quest.7F16EF7DB7292898.quest_desc: [
		"Boilers, factory gauges, trains through the Nether and mail between towns."
	]
	chapter.771C1FF49C38AFE7.title: "Create: Add-ons"
	chapter.771C1FF49C38AFE7.chapter_subtitle: [
		"Batteries, power, experience enchanting, smart gearing"
	]
	quest.7D38C871CC211EF9.title: "Create Is a Platform"
	quest.7D38C871CC211EF9.quest_subtitle: "Add-ons extend the base"
	quest.7D38C871CC211EF9.quest_desc: [
		"These mods add what Create lacks: &lstored rotation&r, &lelectricity&r, &lexperience as a fluid&r, handy gearing and disguise blocks."
		"Every quest here explains which problem a part solves."
	]
	quest.5F3C221590C6A560.title: "Smart Gearboxes"
	quest.5F3C221590C6A560.quest_subtitle: "Create Connected"
	quest.5F3C221590C6A560.quest_desc: [
		"The six-way and parallel gearboxes send rotation where a plain gearbox can't. Fewer shafts, tidier factory."
	]
	quest.30C19E71E43D8B9A.title: "Kinetic Battery"
	quest.30C19E71E43D8B9A.quest_subtitle: "Stored rotation"
	quest.30C19E71E43D8B9A.quest_desc: [
		"&lProblem:&r your wheel turns all night while windmills stall in calm weather. &lSolution:&r the battery stores rotation when there's plenty and gives it back when there's little."
	]
	quest.7DE779C4EADEE227.title: "Overload Protection"
	quest.7DE779C4EADEE227.quest_subtitle: "Shear pin and clutch"
	quest.7DE779C4EADEE227.quest_desc: [
		"When the network is overstressed, the shear pin breaks and keeps the other machines running. The overstress clutch disconnects a branch and reconnects it on its own."
	]
	quest.5B9945A1D0B3302F.title: "Item Silo"
	quest.5B9945A1D0B3302F.quest_subtitle: "Multiblock storage"
	quest.5B9945A1D0B3302F.quest_desc: [
		"Silo blocks merge into one big container, like a Create vault but for bulk crops and ore."
	]
	quest.389037C19D27671B.title: "Fan Catalysts"
	quest.389037C19D27671B.quest_subtitle: "New processing types"
	quest.389037C19D27671B.quest_desc: [
		"A plain fan washes, smelts and smokes. Catalysts add sanding, freezing, withering and more: less manual work."
	]
	quest.3B2387F2822A0C64.title: "Alternator"
	quest.3B2387F2822A0C64.quest_subtitle: "Create Addition"
	quest.3B2387F2822A0C64.quest_desc: [
		"&lThe bridge between worlds:&r the alternator turns Create rotation into FE for Mekanism, AE2 and IE. The electric motor does the reverse."
		"Your water wheels now power Mekanism machines too."
	]
	quest.2B5EED31BF242AD9.title: "Overhead Wires"
	quest.2B5EED31BF242AD9.quest_subtitle: "Power over distance"
	quest.2B5EED31BF242AD9.quest_desc: [
		"A copper wire spool and connectors: a power line from your plant to a neighbour. Pretty and cheap."
	]
	quest.350DF99E7C5AC08F.title: "Modular Accumulator"
	quest.350DF99E7C5AC08F.quest_subtitle: "An energy store"
	quest.350DF99E7C5AC08F.quest_desc: [
		"Place blocks side by side and the capacity grows. Stores power overnight for solar panels."
	]
	quest.370722D32BE17EBE.title: "Tesla Coil"
	quest.370722D32BE17EBE.quest_subtitle: "Item charging"
	quest.370722D32BE17EBE.quest_desc: [
		"Charges energy items on a belt, and zaps mobs if you put it in their path."
	]
	quest.3A0D66D736400BB4.title: "Experience in Buckets"
	quest.3A0D66D736400BB4.quest_subtitle: "Create Enchantment Industry"
	quest.3A0D66D736400BB4.quest_desc: [
		"&lWhat:&r experience becomes a fluid you pump through pipes and store in tanks."
		"&lWhy:&r send experience from a mob farm straight into the enchanter, no standing at the spawner."
	]
	quest.7371DE8B2A53A740.title: "Blaze Enchanter"
	quest.7371DE8B2A53A740.quest_subtitle: "Enchanting on a belt"
	quest.7371DE8B2A53A740.quest_desc: [
		"A blaze with an enchanting template applies the chosen enchantment to everything on the belt. No more enchanting-table lottery."
	]
	quest.2F54F645102E13EE.title: "Printer"
	quest.2F54F645102E13EE.quest_subtitle: "Book copies"
	quest.2F54F645102E13EE.quest_desc: [
		"Prints copies of books: enchanted, written, even guides. Handy for the colony library."
	]
	quest.2C8B1662D32860D4.title: "Dragon's Breath"
	quest.2C8B1662D32860D4.quest_subtitle: "Create: Dragons Plus"
	quest.2C8B1662D32860D4.quest_desc: [
		"Dragon's breath in a bucket: a fluid for fans, whose «ending» process turns items into their End variants."
	]
	quest.7AF22375ED6E4E3A.title: "Disguise"
	quest.7AF22375ED6E4E3A.quest_subtitle: "Copycats+"
	quest.7AF22375ED6E4E3A.quest_desc: [
		"Copycat blocks take the look of any block: slopes, steps, beams. Hide your factory behind a pretty facade."
	]
	quest.20B5B4A0BD67576A.title: "Jetpack"
	quest.20B5B4A0BD67576A.quest_subtitle: "Create Jetpack"
	quest.20B5B4A0BD67576A.quest_desc: [
		"The jetpack flies on compressed air from a Create backtank. Refill at a compressor at base. Indispensable on building sites."
	]
	quest.08B90679F2712DC1.title: "Master Mechanic"
	quest.08B90679F2712DC1.quest_subtitle: "Create to the full"
	quest.08B90679F2712DC1.quest_desc: [
		"Rotation is stored, turned into power, enchants books and hides behind pretty walls. Show the factory to your neighbours so they can learn."
	]
	chapter.75D3C2A26C328D05.title: "Sky & Roads"
	chapter.75D3C2A26C328D05.chapter_subtitle: [
		"Cars, planes, airships, citadels"
	]
	quest.4B1734BD66CA871A.title: "A Build That Lives"
	quest.4B1734BD66CA871A.quest_subtitle: "Create Aeronautics and Sable physics"
	quest.4B1734BD66CA871A.quest_desc: [
		"&lWhat:&r the physics assembler turns any build into a &lreal physical object&r: it falls, floats, drives, flies."
		"Heavy things sink, light things float, wheels grip the ground. Build as usual — then bring it to life."
		"More: Ponder (&lW&r) on the assembler."
	]
	quest.6B4F8E536E588C89.title: "Four Wheels"
	quest.6B4F8E536E588C89.quest_subtitle: "Your first car"
	quest.6B4F8E536E588C89.quest_desc: [
		"Wheel mounts + tyres + a motor (Create rotation) = a car. A &lsteering wheel&r turns the front wheels."
		"&lTip:&r start with a small cart, then build a truck for ore."
	]
	quest.7266207763E94952.title: "Behind the Wheel"
	quest.7266207763E94952.quest_subtitle: "Steering wheel and throttle"
	quest.7266207763E94952.quest_desc: [
		"Take the wheel — WASD drives. The throttle lever changes rotation speed."
		"Works? Drive to a friend and honk."
	]
	quest.0679B41EE5CEA5EE.title: "The Propeller"
	quest.0679B41EE5CEA5EE.quest_subtitle: "Thrust"
	quest.0679B41EE5CEA5EE.quest_desc: [
		"A propeller on its bearing pushes the build forward — or up. Faster rotation, more thrust."
		"Light materials (wood, wool) are your friends in the sky."
	]
	quest.7AF169EE9ACAE9A5.title: "The Sky Is Calling"
	quest.7AF169EE9ACAE9A5.quest_subtitle: "First flight"
	quest.7AF169EE9ACAE9A5.quest_desc: [
		"Build a light plane: propeller, wings (sails), controls — and take off. Tick the quest after landing."
		"&lTip:&r aviator's goggles show altitude and speed. Scared? Land near a Waystone."
	]
	quest.57F2358A447DEBD0.title: "The Floating Stone"
	quest.57F2358A447DEBD0.quest_subtitle: "Levitite"
	quest.57F2358A447DEBD0.quest_desc: [
		"&lLevitite&r is stone that pulls upward. Enough of it and a build hangs in the air without propellers."
		"&lValued by:&r mages — they make it easier to get. It's the first engineer-mage handshake."
	]
	quest.453103DB798973F2.title: "The Airship"
	quest.453103DB798973F2.quest_subtitle: "Burner and envelope"
	quest.453103DB798973F2.quest_desc: [
		"An adjustable burner heats the air in the envelope — the airship rises. Less heat, it sinks."
		"Build a gondola with a bed and chests — you have a &lmobile base&r. Tick the quest once you're airborne."
	]
	quest.69E9F652F112C896.title: "The Flying Citadel"
	quest.69E9F652F112C896.quest_subtitle: "A megaproject for the whole group"
	quest.69E9F652F112C896.quest_desc: [
		"A sky island with a garden, kitchen, workshop and mage tower. Built by everyone — each has something to bring."
		"More, with rewards, in the \"Great Works\" chapter."
	]
	quest.3BAC276E3AB02105.title: "A Biplane for the Impatient"
	quest.3BAC276E3AB02105.quest_subtitle: "Immersive Aircraft"
	quest.3BAC276E3AB02105.quest_desc: [
		"Don't feel like building a plane from blocks? Ready-made &lbiplanes, gyrodynes and airships&r from Immersive Aircraft are crafted at a table."
		"A great way to explore before you master Create."
	]
	quest.7D7D4CC48CC8985C.title: "The Jetpack"
	quest.7D7D4CC48CC8985C.quest_subtitle: "Create Jetpack"
	quest.7D7D4CC48CC8985C.quest_desc: [
		"A jetpack running on compressed air from a copper backtank. Recharge at a compressor — and up you go!"
	]
	quest.288B24A597910CC4.title: "Ropes and Winches"
	quest.288B24A597910CC4.quest_subtitle: "Towing, lifts, cable cars"
	quest.288B24A597910CC4.quest_desc: [
		"A winch with a rope pulls one build toward another: tows a car, lowers cargo from an airship, holds a bridge."
		"Boarding and cable-car quests are in the \"Weapons & Gear\" chapter."
	]
	quest.4B89702C281986E7.title: "Big Wheels"
	quest.4B89702C281986E7.quest_desc: [
		"Large tyres carry heavy vehicles off-road: a truck, an all-terrain rover, a mobile base."
	]
	quest.408A8ED8412F2D83.title: "The Tunnel Borer"
	quest.408A8ED8412F2D83.quest_desc: [
		"A borehead on a wheeled machine cuts through mountains. Dig a tunnel between bases — then run a train through it."
	]
	quest.0E9340588AEF41F4.title: "The Engine"
	quest.0E9340588AEF41F4.quest_desc: [
		"An engine assembly needs &laero lubricant&r: fish oil (angler) or TFMG/IE lubricant (engineer). No powerful planes without it."
	]
	quest.14BB3D3AFFEE65C9.title: "The Smart Propeller"
	quest.14BB3D3AFFEE65C9.quest_desc: [
		"A gyro-stabilised propeller keeps the build level. Without it a big ship sways and spins."
	]
	quest.410A0B4DB02A6E21.title: "Airship Envelope"
	quest.410A0B4DB02A6E21.quest_desc: [
		"Envelopes hold hot air. &lWaxed canvas&r (the breeder's beeswax) makes three times as many."
	]
	quest.6A34014B73F8BCC2.title: "The Altitude Sensor"
	quest.6A34014B73F8BCC2.quest_desc: [
		"Signals by altitude — an autopilot keeps the airship at the height you want."
	]
	quest.17ACF815BAF33888.title: "The Navigation Table"
	quest.17ACF815BAF33888.quest_desc: [
		"Plots a course to a point — the ship flies itself. Haul cargo between bases on a schedule."
	]
	quest.28AADDB1A7758B1D.title: "Docking"
	quest.28AADDB1A7758B1D.quest_desc: [
		"Docking connectors lock a ship to a dock or another ship. Build a port in the sky."
	]
	quest.04820B0D68A5E446.title: "The Gyrodyne"
	quest.04820B0D68A5E446.quest_desc: [
		"A pedal-powered flyer — it runs on your own effort. Funny and useful."
	]
	quest.17868DEAA2C48847.title: "A Ready-Made Airship"
	quest.17868DEAA2C48847.quest_desc: [
		"The Immersive Aircraft airship — slow but roomy and simple. Great for first expeditions."
	]
	quest.0AD4DFA0CA5501B3.title: "The Warship"
	quest.0AD4DFA0CA5501B3.quest_desc: [
		"Create Big Cannons on an airship, plated with dragon armour. Tick when the ship fires its first broadside."
	]
	chapter.250C907E46C379E8.title: "Transport"
	chapter.250C907E46C379E8.chapter_subtitle: [
		"Ships, trains, teleports: conquering distance"
	]
	quest.6984D699D2660B8F.title: "How to Travel"
	quest.6984D699D2660B8F.quest_subtitle: "Choose your way"
	quest.6984D699D2660B8F.quest_desc: [
		"&lSea&r: Small Ships ships carry cargo and fire cannons."
		"&lRails&r: Create trains + Steam 'n' Rails: automatic logistics between bases."
		"&lSky&r: planes and airships («Sky» chapter), FPV drones («Firearms and War» chapter)."
		"&lInstant&r: waystones and warp scrolls, but you must find and activate them first."
	]
	quest.4DC0F06F77F4E8D0.title: "Sails"
	quest.4DC0F06F77F4E8D0.quest_subtitle: "Small Ships"
	quest.4DC0F06F77F4E8D0.quest_desc: [
		"Every Small Ships ship needs sails (recipe in EMI): the bigger the ship, the more sails."
		"&lControls:&r W/S raise/lower the sails, A/D steer. The wind is real: sailing into it is slower."
	]
	quest.5088E3C71CA9EAB9.title: "The Cog"
	quest.5088E3C71CA9EAB9.quest_subtitle: "Your first ship"
	quest.5088E3C71CA9EAB9.quest_desc: [
		"A cog is a small cargo ship for a couple of people and some cargo. Faster than a boat, holds the waves."
		"&lWhy:&r islands, far coasts and ocean dungeons are now within reach."
	]
	quest.4A924D0C915569ED.title: "The Brig"
	quest.4A924D0C915569ED.quest_subtitle: "Fast and armed"
	quest.4A924D0C915569ED.quest_desc: [
		"A brig is a medium ship: room for broadside cannons and a cargo hold. Good for hunting illager galleys."
	]
	quest.3B06282EB819370D.title: "The Galleon"
	quest.3B06282EB819370D.quest_subtitle: "Flagship"
	quest.3B06282EB819370D.quest_desc: [
		"The biggest sailing ship: many cannons, a huge hold, room for the whole crew. A floating base for expeditions to the Sunken City and the ship graveyard."
	]
	quest.1F8568D64C4D85D9.title: "The Drakkar"
	quest.1F8568D64C4D85D9.quest_subtitle: "Oars instead of wind"
	quest.1F8568D64C4D85D9.quest_desc: [
		"A drakkar rows: it doesn't need wind. Great for rivers and narrow straits."
	]
	quest.36AF2E60F7B656EB.title: "Sail or Motor?"
	quest.36AF2E60F7B656EB.quest_subtitle: "Small Ships vs Immersive Petroleum"
	quest.36AF2E60F7B656EB.quest_desc: [
		"The IP speedboat is fast but drinks gasoline and carries no cargo. A ship is slower but free, and has cannons. A good base keeps both."
	]
	quest.17DADFF13634DB04.title: "Handcar"
	quest.17DADFF13634DB04.quest_subtitle: "Steam 'n' Rails"
	quest.17DADFF13634DB04.quest_desc: [
		"The handcar is the smallest «train» on Create tracks: for short trips to the mine or a neighbour."
	]
	quest.7CFEDCB56F3C85D9.title: "Steam Locomotive"
	quest.7CFEDCB56F3C85D9.quest_subtitle: "Pretty trains"
	quest.7CFEDCB56F3C85D9.quest_desc: [
		"Steam 'n' Rails adds smokestacks, boilers and locometal: the train looks like a real steam engine. Traction comes from Create rotation."
	]
	quest.6D7CC78BAD7C139E.title: "Couplers and Semaphores"
	quest.6D7CC78BAD7C139E.quest_subtitle: "A railway network"
	quest.6D7CC78BAD7C139E.quest_desc: [
		"The coupler joins and splits trains on the move; semaphores show signals. That's how a network grows: freight trains between players' bases."
		"&lRoles meet:&r the railway is a shared project: the farmer ships food, the miner ore, the engineer machines."
	]
	quest.631B95D917C4FF14.title: "Monorail"
	quest.631B95D917C4FF14.quest_subtitle: "Above the town"
	quest.631B95D917C4FF14.quest_desc: [
		"A monorail runs through the air above the roofs: a metro for your Minecolonies colony."
	]
	quest.466444CD9C2D77D4.title: "Warp Scroll"
	quest.466444CD9C2D77D4.quest_subtitle: "Waystones"
	quest.466444CD9C2D77D4.quest_desc: [
		"A single-use scroll takes you to any activated waystone."
		"&lWhy:&r get back from an expedition without dropping your loot. &lWhy not always:&r scrolls cost resources, and the road is part of the adventure."
	]
	quest.59FE438CCB6B63CB.title: "Warp Stone"
	quest.59FE438CCB6B63CB.quest_subtitle: "Reusable"
	quest.59FE438CCB6B63CB.quest_desc: [
		"The warp stone is a reusable pocket portal with a cooldown. Your own waystone at home + the stone = freedom to explore."
	]
	quest.79CAC370B6DC53A9.title: "Quadrocopter"
	quest.79CAC370B6DC53A9.quest_subtitle: "Immersive Aircraft"
	quest.79CAC370B6DC53A9.quest_desc: [
		"Slow, but it hovers: perfect for building tall towers and surveying land."
	]
	quest.69A1D02B4D7A4EFC.title: "Transport Empire"
	quest.69A1D02B4D7A4EFC.quest_subtitle: "Sea, rails, sky"
	quest.69A1D02B4D7A4EFC.quest_desc: [
		"You've tied the world together. Suggest a shared station at spawn so every line meets in one place."
	]
	chapter.78D5E7433029BED0.title: "Mekanism & the Atom"
	chapter.78D5E7433029BED0.chapter_subtitle: [
		"From the enrichment chamber to fusion"
	]
	quest.245608597F69080B.title: "Osmium"
	quest.245608597F69080B.quest_subtitle: "Mekanism's metal"
	quest.245608597F69080B.quest_desc: [
		"&lWhat:&r Mekanism is electric industry: ore processing, chemistry, nuclear power, an exosuit."
		"&lHow to start:&r find osmium ore (bluish) and smelt ingots. Osmium is in every first machine."
		"Mekanism reference: &lU&r on any block in EMI."
	]
	quest.47C67B75E3CB3CF3.title: "Steel"
	quest.47C67B75E3CB3CF3.quest_subtitle: "The metallurgic infuser"
	quest.47C67B75E3CB3CF3.quest_desc: [
		"The infuser blends iron with coal into enriched iron, then steel."
		"Steel is shared: Mekanism, Immersive Engineering and TFMG all use it (Almost Unified merges them into one)."
	]
	quest.625415B7F4D63866.title: "Electricity"
	quest.625415B7F4D63866.quest_subtitle: "The heat generator"
	quest.625415B7F4D63866.quest_desc: [
		"The heat generator burns fuel or draws heat from nearby lava. Power for your first machines."
		"&lTip:&r solar panels and wind turbines run free, and the Create alternator turns rotation into power."
	]
	quest.77688562BA6E2F2C.title: "Ore Doubling"
	quest.77688562BA6E2F2C.quest_subtitle: "The enrichment chamber"
	quest.77688562BA6E2F2C.quest_desc: [
		"The enrichment chamber turns ore into 2 dust — twice the ingots. It's the first of five tiers."
		"Next: purification (×3), chemical injection (×4), acid dissolution (×5)."
	]
	quest.6ADA9E43D1CB61AE.title: "Control Circuits"
	quest.6ADA9E43D1CB61AE.quest_subtitle: "The brains of machines"
	quest.6ADA9E43D1CB61AE.quest_desc: [
		"Circuits go into upgrades and advanced machines. Basic ones are osmium and redstone."
	]
	quest.6FB9DD22E96511CF.title: "Tripling"
	quest.6FB9DD22E96511CF.quest_subtitle: "Purification chamber + oxygen"
	quest.6FB9DD22E96511CF.quest_desc: [
		"A purification chamber fed with oxygen gives 3 ingots per ore. Oxygen comes from an electrolytic separator (water → hydrogen + oxygen)."
	]
	quest.552270423C6CD2BE.title: "Factories"
	quest.552270423C6CD2BE.quest_subtitle: "Many operations at once"
	quest.552270423C6CD2BE.quest_desc: [
		"A factory is a machine with several slots: smelts, crushes or enriches 3–9 items at once. Upgrade it with a tier installer."
	]
	quest.6B07DF1CDC5F216D.title: "The Hydrogen Jetpack"
	quest.6B07DF1CDC5F216D.quest_subtitle: "Fly on water"
	quest.6B07DF1CDC5F216D.quest_desc: [
		"The Mekanism jetpack is fuelled with hydrogen from the electrolytic separator. It stays up longer than you'd think."
	]
	quest.6E06D49078E7978C.title: "Radiation Is Serious"
	quest.6E06D49078E7978C.quest_subtitle: "Geiger counter and hazmat suit"
	quest.6E06D49078E7978C.quest_desc: [
		"Before the atom — protection. Radiation &laccumulates&r in your body and hurts at high doses."
		"The Geiger counter shows the background, the dosimeter your dose. A hazmat suit blocks almost all of it."
		"More on protection and cleanup in \"Elements & Defence\"."
	]
	quest.6C6A40C7728A898A.title: "Splitting the Atom"
	quest.6C6A40C7728A898A.quest_subtitle: "The fission reactor"
	quest.6C6A40C7728A898A.quest_desc: [
		"A fission reactor means huge power and huge responsibility. &lCooling&r comes first: watch the temperature."
		"Start at a low burn rate (0.1 mB/t) and wire an emergency SCRAM with a logic adapter."
		"&lTip:&r build the reactor on an \"island\", away from bases and farms."
	]
	quest.14BEE4BDABDB075B.title: "The Turbine"
	quest.14BEE4BDABDB075B.quest_subtitle: "Steam → electricity"
	quest.14BEE4BDABDB075B.quest_desc: [
		"The reactor heats sodium or water, the boiler makes steam, the turbine turns steam into power."
		"A huge, handsome structure — make it the centrepiece of your power plant."
	]
	quest.673E8013AF5960AA.title: "Waste"
	quest.673E8013AF5960AA.quest_subtitle: "Don't pour it in the river!"
	quest.673E8013AF5960AA.quest_desc: [
		"Nuclear waste goes into a radioactive waste barrel, which slowly neutralises it."
		"Later the waste becomes &lplutonium&r and &lpolonium&r — fuel for the SPS and antimatter."
	]
	quest.474E9801152A6673.title: "The Accelerator"
	quest.474E9801152A6673.quest_subtitle: "SPS and antimatter"
	quest.474E9801152A6673.quest_desc: [
		"The supercritical phase shifter (SPS) turns polonium into antimatter. It's part of"
		"the \"Ring Collider\" megaproject in \"Great Works\"."
	]
	quest.1152DA7E951B01C8.title: "A Sun in a Box"
	quest.1152DA7E951B01C8.quest_subtitle: "The fusion reactor"
	quest.1152DA7E951B01C8.quest_desc: [
		"Deuterium and tritium, a laser ignition — and a star in your basement. Safer than fission and stronger."
	]
	quest.547A2E63CB89901D.title: "The Exosuit"
	quest.547A2E63CB89901D.quest_subtitle: "MekaSuit"
	quest.547A2E63CB89901D.quest_desc: [
		"Modular armour: flight, night vision, radiation shielding, auto-feeding. Modules go in at the modification station."
		"The peak of the engineering branch — and a great gift for your group's warrior."
	]
	quest.202B14FABDF1BEBE.title: "The Crusher"
	quest.202B14FABDF1BEBE.quest_desc: [
		"Crushes ingots into dust, cobble into gravel, crops into bio-fuel. Metal dust smelts into ingots."
	]
	quest.4CF40E8C8033E8A3.title: "The Energized Smelter"
	quest.4CF40E8C8033E8A3.quest_desc: [
		"Smelts quickly without coal. With speed upgrades — very quickly."
	]
	quest.49875A981F07E924.title: "Cables and Storage"
	quest.49875A981F07E924.quest_desc: [
		"Universal cable carries energy, the cube stores it. The configurator sets which side inputs and which outputs."
	]
	quest.3B9CF5DEF05B0975.title: "The Configurator"
	quest.3B9CF5DEF05B0975.quest_desc: [
		"Mekanism's main tool: sets machine sides, rotates blocks, empties contents."
	]
	quest.16088EC8A05113FC.title: "Machine Upgrades"
	quest.16088EC8A05113FC.quest_desc: [
		"Speed upgrades go faster, energy upgrades cut usage. They fit any Mekanism machine."
	]
	quest.27072E7F71AB537A.title: "Logistical Transporters"
	quest.27072E7F71AB537A.quest_desc: [
		"Mekanism pipes move items with filters and colour tags. An alternative to Create belts."
	]
	quest.5085E51AFD3E356C.title: "Solar Power"
	quest.5085E51AFD3E356C.quest_desc: [
		"Quiet, clean daytime power. No air pollution — the gardener approves."
	]
	quest.6C0D1DCA5D7B6BBA.title: "The Wind Generator"
	quest.6C0D1DCA5D7B6BBA.quest_desc: [
		"The higher it stands, the more power. Put it on a mountain or a floating island."
	]
	quest.1ECF6115162FDEAE.title: "The Bio-Generator"
	quest.1ECF6115162FDEAE.quest_desc: [
		"Burns the gardener's bio-fuel. No smog — and no mine."
	]
	quest.27FE97C313BB88D2.title: "Electrolysis"
	quest.27FE97C313BB88D2.quest_desc: [
		"Splits water into hydrogen and oxygen. Oxygen triples ore; hydrogen fuels the jetpack and a generator."
	]
	quest.43AA10D65F8C95AE.title: "Ore Quadrupling"
	quest.43AA10D65F8C95AE.quest_desc: [
		"The chemical injection chamber with hydrogen chloride gives 4 ingots per ore. Needs a chemistry line: salt → brine → chlorine."
	]
	quest.1CB53BC48DEE6135.title: "The Digital Miner"
	quest.1CB53BC48DEE6135.quest_desc: [
		"Mines chosen ores in a huge radius and leaves the surface untouched. The king of mine automation."
	]
	quest.13E7AADECF1DA346.title: "The Teleporter"
	quest.13E7AADECF1DA346.quest_desc: [
		"A Mekanism portal frame carries you between bases — even across dimensions."
	]
	quest.1B8A663F3567C4BB.title: "QIO"
	quest.1B8A663F3567C4BB.quest_desc: [
		"Mekanism's quantum storage — an alternative to AE2 without channels. Pick what suits your group."
	]
	quest.467A309FB47AF4E3.title: "The Atomic Disassembler"
	quest.467A309FB47AF4E3.quest_desc: [
		"An all-in-one tool: pickaxe, axe, shovel and sword. Runs on energy."
	]
	quest.5AEFDCFC36E4DDA2.title: "The Induction Matrix"
	quest.5AEFDCFC36E4DDA2.quest_desc: [
		"A huge energy store — the heart of the whole group's power grid."
	]
	quest.31249669C0F62F41.title: "The Thermoelectric Boiler"
	quest.31249669C0F62F41.quest_desc: [
		"Superheated sodium from the reactor boils water in the boiler — steam goes to the turbine. A classic nuclear plant."
	]
	quest.098450DFBC4F0224.title: "The Paxel"
	quest.098450DFBC4F0224.quest_subtitle: "Mekanism Tools"
	quest.098450DFBC4F0224.quest_desc: [
		"A pickaxe, axe and shovel in one tool: less swapping in the mine. A steel paxel outlasts iron and nearly matches diamond."
	]
	quest.3000FF6EC8D61578.title: "Osmium Armour"
	quest.3000FF6EC8D61578.quest_subtitle: "Heavy and tough"
	quest.3000FF6EC8D61578.quest_desc: [
		"Osmium is a heavy metal: its armour takes hits better than iron. An alternative for those short on diamonds."
	]
	quest.5E40C59EA1D4B28B.title: "Refined Obsidian"
	quest.5E40C59EA1D4B28B.quest_subtitle: "Mekanism Tools' best armour"
	quest.5E40C59EA1D4B28B.quest_desc: [
		"Refined obsidian is made in Mekanism from obsidian and diamond dust. Its armour is netherite-tier without a trip for ancient debris."
	]
	quest.328AF20751E40D18.title: "Refined Glowstone"
	quest.328AF20751E40D18.quest_subtitle: "Fast tools"
	quest.328AF20751E40D18.quest_desc: [
		"Refined glowstone tools are the fastest in Mekanism Tools."
	]
	quest.208F1AAF087B6DB8.title: "Tin and Lead"
	quest.208F1AAF087B6DB8.quest_desc: [
		"A lightweight, yet sturdy, conductive material."
		"A somewhat rare metal that is excellent at resisting radioactive particles."
	]
	quest.5389D027A4F6E785.title: "Fluorite"
	quest.5389D027A4F6E785.quest_desc: [
		"A mineral found relatively deep under the world's surface. The crystals can be processed into Hydrofluoric Acid, an essential chemical for Uranium processing."
	]
	quest.6686A7AD590ABADB.title: "Raw Uranium"
	quest.6686A7AD590ABADB.quest_desc: [
		"&lWhy:&r Uranium fuels fission reactors."
		"A common, heavy metal, which can yield massive amounts of energy when properly processed. In its naturally-occurring form, it is not radioactive enough to cause harm."
	]
	quest.160283B76377C7AB.title: "Metallurgic Infuser"
	quest.160283B76377C7AB.quest_desc: [
		"&lWhy:&r The infuser makes steel, alloys and circuits."
		"A machine used to infuse various materials into (generally) metals to create metal alloys and other compounds."
	]
	quest.3CE4764A153AC85A.title: "Infused Alloy"
	quest.3CE4764A153AC85A.quest_desc: [
		"&lWhy:&r Copper + redstone; used for advanced tiers."
		"Infuse Copper with Redstone"
	]
	quest.6F48949B7D675579.title: "Reinforced Alloy"
	quest.6F48949B7D675579.quest_desc: [
		"&lWhy:&r Diamond alloy for elite tiers."
		"Diamonds make everything better!"
	]
	quest.03FC9E1F3F7355E0.title: "Atomic Alloy"
	quest.03FC9E1F3F7355E0.quest_desc: [
		"&lWhy:&r Refined obsidian alloy for ultimate tiers."
		"Create one of the strongest alloys in existence"
	]
	quest.7530C844138E673F.title: "Enriched Materials"
	quest.7530C844138E673F.quest_desc: [
		"&lWhy:&r Enriched materials are 8x more efficient in the infuser."
		"Enrich your infusion inputs to increase their efficiency"
	]
	quest.7E9E462FF6FFDA13.title: "Steel Casing"
	quest.7E9E462FF6FFDA13.quest_desc: [
		"A sturdy, steel-based casing used as a foundation for machinery."
	]
	quest.7EF57D7933D864F4.title: "Advanced Control Circuit"
	quest.7EF57D7933D864F4.quest_desc: [
		"Craft an Advanced Control Circuit"
	]
	quest.401F6DCAA652419D.title: "Elite Control Circuit"
	quest.401F6DCAA652419D.quest_desc: [
		"Create a circuit with even more pathways"
	]
	quest.2C98FBD7D2FE6DDD.title: "Ultimate Control Circuit"
	quest.2C98FBD7D2FE6DDD.quest_desc: [
		"Can this thing run Minecraft yet?"
	]
	quest.008F89647DA1CDCE.title: "Osmium Compressor"
	quest.008F89647DA1CDCE.quest_desc: [
		"&lWhy:&r Makes refined obsidian and glowstone."
		"A fairly advanced machine used to compress osmium into various dusts in order to create their ingot counterparts."
	]
	quest.0EF010CE1FF4BE11.title: "Combiner"
	quest.0EF010CE1FF4BE11.quest_desc: [
		"A machine used to combine items together. For example, raw ores and cobblestone to form their ore counterparts."
	]
	quest.0FB69DB081CB20D4.title: "Precision Sawmill"
	quest.0FB69DB081CB20D4.quest_desc: [
		"&lWhy:&r 6 planks per log plus sawdust."
		"A machine used to process logs and other wood-based items more efficiently, as well as to obtain sawdust."
	]
	quest.48C6E1726C3D2A5E.title: "Fivefold Processing: Dissolution"
	quest.48C6E1726C3D2A5E.quest_desc: [
		"&lWhy:&r The top of Mekanism ore processing: 5 ingots per ore."
		"An ultimate machine used to chemically dissolve all impurities of an ore, leaving an unprocessed slurry behind."
	]
	quest.3D21F6C40F18B9E5.title: "Chemical Washer"
	quest.3D21F6C40F18B9E5.quest_desc: [
		"An ultimate machine that cleans unprocessed slurry and prepares it for crystallization."
	]
	quest.493F355FE29BB330.title: "Chemical Crystallizer"
	quest.493F355FE29BB330.quest_desc: [
		"An ultimate machine used to crystallize purified ore slurry into ore crystals."
		"Craft a Chemical Crystallizer, Dissolution Chamber and Washer"
	]
	quest.37DD07DD4F509A57.title: "Ore Crystals"
	quest.37DD07DD4F509A57.quest_desc: [
		"&lWhy:&r Crystals are the 5x output; feed them into the injection chamber."
	]
	quest.57879D32834BD4B2.title: "Chemical Oxidizer"
	quest.57879D32834BD4B2.quest_desc: [
		"A machine capable of oxidizing solid materials into gas phase."
	]
	quest.4360665E87FB5B7D.title: "Chemical Infuser"
	quest.4360665E87FB5B7D.quest_desc: [
		"&lWhy:&r Combines two gases into a third: the base of Mekanism chemistry."
		"A machine that produces a new chemicals by infusing two others."
	]
	quest.5555A9E6C5C1ACF4.title: "Rotary Condensentrator"
	quest.5555A9E6C5C1ACF4.quest_desc: [
		"&lWhy:&r Turns gas into liquid and back."
		"A machine capable of converting chemicals into their fluid form and vice versa."
	]
	quest.5CFD190864B3EEFC.title: "Pressurized Reaction Chamber"
	quest.5CFD190864B3EEFC.quest_desc: [
		"&lWhy:&r Makes HDPE plastic, substrate and ethylene."
		"An advanced machine that processes a solid, liquid and chemical mixture and creates both a chemical and solid product."
	]
	quest.3543811430F83BB5.title: "HDPE Sheet"
	quest.3543811430F83BB5.quest_desc: [
		"&lWhy:&r Plastic sheets for modules, Robit and elytra."
	]
	quest.7C3041E19838CDEA.title: "Thermal Evaporation Plant"
	quest.7C3041E19838CDEA.quest_desc: [
		"&lWhy:&r Water → brine → lithium for fusion and induction cells."
		"The controller for a Thermal Evaporation Plant, acting as the master block of the structure. Only one of these should be placed on a multiblock."
	]
	quest.1412FCAB06C56612.title: "Lithium"
	quest.1412FCAB06C56612.quest_desc: [
		"&lWhy:&r Lithium → tritium → fusion fuel; also induction cells."
	]
	quest.47574A538D6C9510.title: "Dynamic Tank"
	quest.47574A538D6C9510.quest_desc: [
		"The casing used in the Dynamic Tank multiblock, a structure capable of storing great amounts of fluid and chemicals."
	]
	quest.73AFEF7642C120FF.title: "Basic Bin"
	quest.73AFEF7642C120FF.quest_desc: [
		"A block used to store large quantities of a single type of item."
		"Create a bin to store large amounts of one item"
	]
	quest.162761C557CA4953.title: "Personal Chest"
	quest.162761C557CA4953.quest_desc: [
		"&lWhy:&r A chest only the owner opens, portable."
		"A 54-slot chest that can be opened from your own inventory."
	]
	quest.183F425FAC8622D9.title: "Tanks"
	quest.183F425FAC8622D9.quest_desc: [
		"A handy, sturdy, portable tank that lets you carry multiple buckets of fluid wherever you please. Also doubles as a bucket!"
		"A portable tank that lets you carry chemicals wherever you please."
	]
	quest.00432F389CAB2B52.title: "Advanced Energy Cube"
	quest.00432F389CAB2B52.quest_desc: [
		"An advanced device for storing and distributing energy."
	]
	quest.6E9A9F2CEA14E074.title: "Elite Energy Cube"
	quest.6E9A9F2CEA14E074.quest_desc: [
		"An advanced device for storing and distributing energy."
	]
	quest.461FB926CD1026EB.title: "Electric Pump"
	quest.461FB926CD1026EB.quest_desc: [
		"An advanced, upgradeable pump, capable of extracting any type of fluid."
		"Craft an Electric Pump in order to automatically 'suck up' fluids"
	]
	quest.0E2A1D841BFB6CCE.title: "Fluidic Plenisher"
	quest.0E2A1D841BFB6CCE.quest_desc: [
		"A machine that is capable of creating entire lakes by filling ravines with fluids."
	]
	quest.54FC0564B01E0138.title: "Logistical Sorter"
	quest.54FC0564B01E0138.quest_desc: [
		"A filter-based, advanced sorting machine that can auto-eject specified items out of and into adjacent inventories and Logistical Transporters."
	]
	quest.638025CB1C61A8DD.title: "Special Transporters"
	quest.638025CB1C61A8DD.quest_desc: [
		"&lWhy:&r Restrictive = fallback path, diversion = redstone-controlled."
		"- Only used if no other paths available"
		"- Controllable by redstone"
	]
	quest.6E409A67689220F9.title: "Advanced Tier Installer"
	quest.6E409A67689220F9.quest_desc: [
		"&lWhy:&r Upgrades a factory in place."
		"Craft any tier of Installer to upgrade your factories in place"
	]
	quest.214BE62DD0DF735B.title: "Elite Enriching Factory"
	quest.214BE62DD0DF735B.quest_desc: [
		"&lWhy:&r Elite factory: 7 operations at once."
	]
	quest.7B6995F354F6FA92.title: "Formulaic Assemblicator"
	quest.7B6995F354F6FA92.quest_desc: [
		"A machine that uses energy to rapidly craft items and blocks from Crafting Formulas. Doubles as an advanced crafting bench."
		"Craft a machine to do the crafting for you"
	]
	quest.16AB42CFA6A3F851.title: "Oredictionificator"
	quest.16AB42CFA6A3F851.quest_desc: [
		"A machine used to unify and translate between various items and blocks using item tags."
	]
	quest.745C0507A5A7D3DA.title: "QIO Drives"
	quest.745C0507A5A7D3DA.quest_desc: [
		"&lWhy:&r Denser drives hold more items per slot."
		"Increase the storage bandwidth of your QIO Drive"
	]
	quest.2A6AC46D22A7A02C.title: "QIO Import and Export"
	quest.2A6AC46D22A7A02C.quest_desc: [
		"A QIO-linked item import unit. Place on a block and import its contents to your QIO system."
		"A QIO-linked item export unit. Place on a block and export contents from your QIO system to the block."
	]
	quest.55D767D9EC0BE5F4.title: "Portable QIO Dashboard"
	quest.55D767D9EC0BE5F4.quest_desc: [
		"&lWhy:&r The whole QIO network in your hand."
		"Craft a Portable QIO Dashboard"
	]
	quest.0A66EFD9B0C21198.title: "QIO Redstone Adapter"
	quest.0A66EFD9B0C21198.quest_desc: [
		"A QIO-linked redstone adapter. Use to monitor your QIO system's contents."
	]
	quest.57435E17FA17DFC5.title: "Teleportation Core"
	quest.57435E17FA17DFC5.quest_desc: [
		"&lWhy:&r Needed for teleporters and the entangloporter."
		"Construct the core of all teleportation technology"
	]
	quest.4EAF0DA87182D9E9.title: "Portable Teleporter"
	quest.4EAF0DA87182D9E9.quest_desc: [
		"&lWhy:&r Teleport to your own stations from your pocket."
		"Craft a Portable Teleporter"
	]
	quest.0D399BDAC9FE778F.title: "Quantum Entangloporter"
	quest.0D399BDAC9FE778F.quest_desc: [
		"A highly-advanced block capable of transmitting any practical resource across long distances and dimensions."
	]
	quest.44ABA6974D840D8C.title: "Dimensional Stabilizer"
	quest.44ABA6974D840D8C.quest_desc: [
		"&lWhy:&r Keeps chunks loaded. Don't overdo it — the server pays for it."
		"A machine that prevents areas of the world from disappearing when not observed."
	]
	quest.76F5F3EE70F4B2D0.title: "Seismic Vibrator"
	quest.76F5F3EE70F4B2D0.quest_desc: [
		"A machine that uses seismic vibrations to provide information on differing layers of the world."
		"Craft a Seismic Vibrator and Seismic Reader, and then view the world beneath you"
	]
	quest.1F5242D27AAD1D64.title: "Security Desk"
	quest.1F5242D27AAD1D64.quest_desc: [
		"A central control hub for managing the security of all your owned machinery."
	]
	quest.53F73E79C3E9CCD9.title: "Robit"
	quest.53F73E79C3E9CCD9.quest_desc: [
		"&lWhy:&r Robit follows you, picks up items, smelts and crafts."
		"Craft and place a Robit on a Chargepad"
	]
	quest.2F8EDC4D6C27C09F.title: "Nutritional Liquifier"
	quest.2F8EDC4D6C27C09F.quest_desc: [
		"A machine that is capable of processing any foods into non-dangerous, easily-digestible Nutritional Paste."
		"Completely fill a Canteen with Nutritional Paste"
	]
	quest.6057CF46D9BA8F96.title: "Scuba Gear"
	quest.6057CF46D9BA8F96.quest_desc: [
		"&lWhy:&r Oxygen tank: breathe underwater and in polluted air."
		"Craft some Scuba Gear to refill your oxygen supply under water and filter out contaminants"
	]
	quest.3044A1B30724966F.title: "Free Runners"
	quest.3044A1B30724966F.quest_desc: [
		"&lWhy:&r No fall damage, step up blocks."
		"Protect yourself from falling with a pair of Free Runners"
	]
	quest.2266D6B64109393A.title: "Flamethrower"
	quest.2266D6B64109393A.quest_desc: [
		"&lWhy:&r Hydrogen flamethrower. Not near wooden houses."
		"Be responsible and don't burn down any forests; or do, we're not your manager"
	]
	quest.2D36B9BF63341043.title: "Electric Bow"
	quest.2D36B9BF63341043.quest_desc: [
		"&lWhy:&r An energy bow that never breaks and can ignite arrows."
	]
	quest.73EE4C3F40C5A06C.title: "Armored Jetpack"
	quest.73EE4C3F40C5A06C.quest_desc: [
		"&lWhy:&r Jetpack with chest armor."
		"Use a Jetpack to take to the skies"
	]
	quest.0E79B85CF20BF406.title: "Dictionary"
	quest.0E79B85CF20BF406.quest_desc: [
		"A tool used for viewing the tags of various components such as: items, blocks, and fluids."
	]
	quest.48E5ED223B38875F.title: "Cardboard Box"
	quest.48E5ED223B38875F.quest_desc: [
		"&lWhy:&r Pack a block with its contents and move it."
		"Use a Cardboard Box to move another block"
	]
	quest.54CA9815FAB50F6F.title: "Pigment Extractor"
	quest.54CA9815FAB50F6F.quest_desc: [
		"A machine used to color blocks and items via a careful application of a stored pigment."
	]
	quest.3154CA022255B234.title: "Fuelwood Heater"
	quest.3154CA022255B234.quest_desc: [
		"A machine that is capable of producing large quantities of heat energy by burning combustible items."
		"A simple way of transferring heat from one location to another."
	]
	quest.1CF813637A5B621E.title: "Resistive Heater"
	quest.1CF813637A5B621E.quest_desc: [
		"A condensed, coiled resistor capable of converting electrical energy directly into heat energy."
	]
	quest.1D28DF9B4B56E388.title: "Gas-Burning Generator"
	quest.1D28DF9B4B56E388.quest_desc: [
		"&lWhy:&r Burns hydrogen or ethylene; ethylene is great early fuel."
		"A generator that harnesses the varying molecular gases to produce energy."
	]
	quest.4ECD9FC70302709F.title: "Advanced Solar Generator"
	quest.4ECD9FC70302709F.quest_desc: [
		"An advanced generator that directly absorbs the sun's rays with little loss to produce energy."
	]
	quest.13B3A34AD465CD24.title: "Lasers"
	quest.13B3A34AD465CD24.quest_desc: [
		"An advanced form of linear energy transfer that utilizes an extremely collimated beam of light."
		"A block that can be used to merge, redirect and amplify laser beams, with fine controls over when to fire."
	]
	quest.2513CEB7E663CD30.title: "Laser Tractor Beam"
	quest.2513CEB7E663CD30.quest_desc: [
		"A block used to merge and redirect laser beams. Collects drops from blocks it has broken."
		"Tractor beams pull in the drops of blocks they break"
	]
	quest.3D2A3AFC097DC31B.title: "Uranium Enrichment"
	quest.3D2A3AFC097DC31B.quest_desc: [
		"&lWhy:&r Ore → yellow cake → hexafluoride → centrifuge → fissile fuel."
		"Create some cake that must not be eaten"
		"A machine with one single purpose: to spin its contents really, REALLY fast."
	]
	quest.3A116AD1C9958C8C.title: "Reactor Control"
	quest.3A116AD1C9958C8C.quest_desc: [
		"&lWhy:&r Logic adapter + redstone = automatic SCRAM. Build it before the first start."
		"A collection of control rods used to halt a fission chain reaction. Placed on top of a tower of Fission Fuel Assemblies."
		"A block that can be used to monitor or control the Fission Reactor with redstone."
	]
	quest.1325BCDFC065DACE.title: "Polonium Pellet"
	quest.1325BCDFC065DACE.quest_desc: [
		"&lWhy:&r Waste → polonium, the key to the SPS."
		"Refine your Nuclear Waste into Polonium"
	]
	quest.26B5695FC133B624.title: "Plutonium Pellet"
	quest.26B5695FC133B624.quest_desc: [
		"Refine your Nuclear Waste into Plutonium"
	]
	quest.0054E6CAF20561EA.title: "Solar Neutron Activator"
	quest.0054E6CAF20561EA.quest_desc: [
		"A machine that directs the neutron radiation of the sun into its internal reservoir, allowing for the slow creation of various isotopes."
	]
	quest.0B7681931EC0F059.title: "Full Hazmat Suit"
	quest.0B7681931EC0F059.quest_desc: [
		"&lWhy:&r Only the full 4-piece set protects you."
		"Use a Dosimeter to see how badly you irradiated yourself"
		"Protect yourself from radiation with a Hazmat Suit"
	]
	quest.097AA259F55DA84F.title: "Antimatter Pellet"
	quest.097AA259F55DA84F.quest_desc: [
		"Create matter that shouldn't be able to exist here"
	]
	quest.3A34D2D14C91B14C.title: "Antiprotonic Nucleosynthesizer"
	quest.3A34D2D14C91B14C.quest_desc: [
		"A machine which uses bits of antimatter and mass amounts of energy to atomically transmute various resources."
		"Craft an Antiprotonic Nucleosynthesizer and don't worry if you can't pronounce the name"
	]
	quest.3FA160B1B430B7FA.title: "Igniting Fusion"
	quest.3FA160B1B430B7FA.quest_desc: [
		"&lWhy:&r Hohlraum with D-T fuel plus a strong laser ignite fusion."
		"A panel of Fusion Reactor Glass that is capable of absorbing optical energy and thereby heating up the Fusion Reactor."
	]
	quest.33EE9D2288D0A1A3.title: "Modification Station"
	quest.33EE9D2288D0A1A3.quest_desc: [
		"An advanced workbench capable of installing and removing modules from modular equipment (i.e. MekaSuit!)"
	]
	quest.67CB221E25650927.title: "Full MekaSuit"
	quest.67CB221E25650927.quest_desc: [
		"Protect yourself with a complete MekaSuit and a Meka-Tool"
	]
	quest.7A13054B48B60CD3.title: "Meka-Tool"
	quest.7A13054B48B60CD3.quest_desc: [
		"&lWhy:&r Pickaxe, axe, shovel, sword — and teleport, vein mining, silk touch with modules."
	]
	quest.51211D3EA449AAB1.title: "mg_module_jet"
	quest.51211D3EA449AAB1.quest_desc: [
		"Applies a hydrogen-fueled jetpack to the MekaSuit."
	]
	quest.77965E98C0CC2E14.title: "mg_module_radiation"
	quest.77965E98C0CC2E14.quest_desc: [
		"Provides thick, radiation-proof metal plating to any MekaSuit armor piece."
	]
	quest.7E8B7F88FD7E6325.title: "mg_module_breathing"
	quest.7E8B7F88FD7E6325.quest_desc: [
		"Applies a miniature electromagnetic field around the breathing apparatus, preventing selected potion effect types."
	]
	quest.2701EE491464FD16.title: "mg_module_vision"
	quest.2701EE491464FD16.quest_desc: [
		"Brightens the surrounding environment, allowing the user to see through darkness. Install multiple for more effective night vision."
	]
	quest.1B8B8ACB1D5CDE7C.title: "mg_module_magnet"
	quest.1B8B8ACB1D5CDE7C.quest_desc: [
		"Uses powerful magnets to draw distant items towards the player. Install multiple for a greater range."
	]
	quest.20B5038DA250FE4E.title: "mg_module_vein"
	quest.20B5038DA250FE4E.quest_desc: [
		"Allows for quick mining of ore deposits and rapid felling of trees."
	]
	quest.411F81EF8B370C25.title: "mg_module_elytra"
	quest.411F81EF8B370C25.quest_desc: [
		"Applies an HDPE Reinforced Elytra to the MekaSuit."
	]
	quest.2F8204523469DF85.title: "mg_module_gravity"
	quest.2F8204523469DF85.quest_desc: [
		"Using experimental technologies and the tremendous energy of antimatter, allows the user to defy gravity."
	]
	quest.6CB2C1719214613C.title: "mg_module_attack"
	quest.6CB2C1719214613C.quest_desc: [
		"Amplifies melee attacks on players or mobs."
	]
	quest.52AC0472F5C60571.title: "Bronze Armor"
	quest.52AC0472F5C60571.quest_desc: [
		"&lWhy:&r First armor better than iron."
	]
	quest.511247AD68873F1F.title: "Lapis Armor"
	quest.511247AD68873F1F.quest_desc: [
		"&lWhy:&r Weak but highly enchantable."
	]
	quest.0C9357EA1044CD3F.title: "Full Osmium Set"
	quest.0C9357EA1044CD3F.quest_desc: [
		"&lWhy:&r Osmium is tougher than iron and common — a fair mid-game set."
	]
	quest.731873834639106E.title: "Steel Armor"
	quest.731873834639106E.quest_desc: [
		"&lWhy:&r Tough and cheap once you have steel."
	]
	quest.49C07FA18C49B0DD.title: "Refined Glowstone Armor"
	quest.49C07FA18C49B0DD.quest_desc: [
		"&lWhy:&r Gives light around you."
	]
	quest.64CE71B25A3CAE2C.title: "Refined Obsidian Warrior"
	quest.64CE71B25A3CAE2C.quest_desc: [
		"&lWhy:&r Best non-modular armor, near netherite."
	]
	quest.58724F96B511E562.title: "Steel Shield"
	quest.58724F96B511E562.quest_desc: [
		"&lWhy:&r Metal shields last longer."
	]
	quest.0D65B1FEB6CF518B.title: "Mekanism Master"
	quest.0D65B1FEB6CF518B.quest_desc: [
		"5x processing, fusion, antimatter and a full MekaSuit."
	]
	chapter.1D269465AE61C05E.title: "The Atom"
	chapter.1D269465AE61C05E.chapter_subtitle: [
		"Extreme Reactors and Mekanism fission: lots of power, little harm"
	]
	quest.385179001FCC35DD.title: "Yellorite"
	quest.385179001FCC35DD.quest_subtitle: "Extreme Reactors"
	quest.385179001FCC35DD.quest_desc: [
		"&lWhat:&r Extreme Reactors (formerly Big Reactors): multiblock reactors and turbines you build at any size."
		"&lWhy:&r one medium reactor powers a whole base. &lNo radiation, no pollution&r: a peaceful atom for home."
		"&lHow to start:&r yellorite ore lies deep underground. Smelt it into yellorium ingots: the fuel."
	]
	quest.00B5A7E9699DCF0C.title: "Graphite"
	quest.00B5A7E9699DCF0C.quest_subtitle: "Moderator and casing"
	quest.00B5A7E9699DCF0C.quest_desc: [
		"Graphite is smelted from coal or charcoal. It makes the reactor casing and fuel rods."
		"&lTip:&r put a Create fan-smelting line on a belt: coal turns into graphite by itself."
	]
	quest.42035AA943CCC666.title: "Reactor Casing"
	quest.42035AA943CCC666.quest_subtitle: "At least 3×3×3"
	quest.42035AA943CCC666.quest_desc: [
		"The smallest reactor is a 3×3×3 cube: casing edges, casing or glass faces, a fuel rod inside."
		"You need 26 casing blocks (fewer if some faces are glass)."
	]
	quest.6016A6F923D9EEAD.title: "Rods"
	quest.6016A6F923D9EEAD.quest_subtitle: "Fuel and control"
	quest.6016A6F923D9EEAD.quest_desc: [
		"A &lfuel rod&r is a column from floor to ceiling. On top sits a &lcontrol rod&r: it sets the power (0–100 %)."
		"More rods in a checkerboard pattern give more energy per unit of fuel."
	]
	quest.1773A8F8F5018FEC.title: "The First Reactor"
	quest.1773A8F8F5018FEC.quest_subtitle: "Controller + power tap"
	quest.1773A8F8F5018FEC.quest_desc: [
		"Controller on a face, a power tap to your cables. Load yellorium into an access port, switch the controller on."
		"&lSafe:&r overheating only lowers output. No explosions, no radiation."
		"&lWaste&r is cyanite: reprocess it back into fuel (the reprocessor)."
	]
	quest.03A29457CE8D2345.title: "The Turbine"
	quest.03A29457CE8D2345.quest_subtitle: "Steam → energy, several times more"
	quest.03A29457CE8D2345.quest_desc: [
		"Switch the reactor to water cooling (a fluid port): it starts producing &lsteam&r. Steam into a turbine gives 3–5 times more energy."
		"Rotor blades are made of steel: your steel mill pays off here."
	]
	quest.0AECD052E87EA63D.title: "The Reprocessor"
	quest.0AECD052E87EA63D.quest_subtitle: "Cyanite back into fuel"
	quest.0AECD052E87EA63D.quest_desc: [
		"The reprocessor turns cyanite (waste) and water into blutonium: a stronger fuel than yellorium. A closed loop with no garbage."
	]
	quest.0C2DA46EC2979143.title: "Reinforced Reactor"
	quest.0C2DA46EC2979143.quest_subtitle: "Big sizes"
	quest.0C2DA46EC2979143.quest_desc: [
		"Reinforced blocks allow reactors up to 32×32×48. That's a power plant for the whole server: agree with neighbours on who maintains it."
	]
	quest.7352B03F0E567940.title: "Two Roads to the Atom"
	quest.7352B03F0E567940.quest_subtitle: "Extreme Reactors vs Mekanism"
	quest.7352B03F0E567940.quest_desc: [
		"&lExtreme Reactors&r is safe: it never explodes, and waste is reprocessed."
		"&lThe Mekanism fission reactor&r is stronger and yields plutonium and polonium for the SPS and fusion, but if it overheats it &lexplodes and contaminates the area&r (radiation stays at the accident site; the rest of the world is untouched). Wear a hazmat suit and use sensors."
		"Your choice: the server never forces you to take risks."
	]
	quest.0679515BD8C61681.title: "A Star in a Box"
	quest.0679515BD8C61681.quest_subtitle: "Fusion"
	quest.0679515BD8C61681.quest_desc: [
		"The Mekanism fusion reactor is the peak of power: deuterium + tritium, ignited by laser. Safe, but it needs everything you've built before."
		"&lGreat work:&r «Fusion Plant» in the Great Works chapter."
	]
	chapter.3609E2F89D752FA6.title: "Steel & Oil"
	chapter.3609E2F89D752FA6.chapter_subtitle: [
		"Immersive Engineering, Petroleum, TFMG — and the air we breathe"
	]
	quest.0210AA1ED353DB24.title: "The Engineer's Hammer"
	quest.0210AA1ED353DB24.quest_subtitle: "Immersive Engineering"
	quest.0210AA1ED353DB24.quest_desc: [
		"&lWhat:&r IE is huge, handsome multiblocks: coke ovens, blast furnaces, excavators, oil derricks."
		"&lHow:&r build the structure block by block from the &lEngineer's Manual&r and strike it with the hammer — it comes alive."
		"It's all in the book: keep it handy."
	]
	quest.42529685BB61068A.title: "The Coke Oven"
	quest.42529685BB61068A.quest_subtitle: "Your first multiblock"
	quest.42529685BB61068A.quest_desc: [
		"27 coke bricks in a 3×3×3 cube and a hammer strike. Coal turns into &lcoke&r and creosote."
		"Creosote treats planks for windmills and posts."
	]
	quest.450EFCA7DA0C32C3.title: "The Blast Furnace"
	quest.450EFCA7DA0C32C3.quest_subtitle: "Iron + coke = steel"
	quest.450EFCA7DA0C32C3.quest_desc: [
		"A blast furnace of fire bricks turns iron and coke into steel. Slow, but needs no power."
	]
	quest.7BACE05C294403E1.title: "Windmill and Dynamo"
	quest.7BACE05C294403E1.quest_subtitle: "IE power"
	quest.7BACE05C294403E1.quest_desc: [
		"A big windmill turns a kinetic dynamo — and power flows along wires on posts."
		"IE wires are pretty: string a power line between bases."
	]
	quest.1A07CB4F99214042.title: "Core Samples"
	quest.1A07CB4F99214042.quest_subtitle: "The core sample drill and the excavator"
	quest.1A07CB4F99214042.quest_desc: [
		"The core sample drill finds &lmineral veins&r deep underground. A giant excavator over the vein mines ore forever."
	]
	quest.0487C41259C69160.title: "Where's the Oil?"
	quest.0487C41259C69160.quest_subtitle: "Immersive Petroleum seismic survey"
	quest.0487C41259C69160.quest_desc: [
		"The seismic survey finds an &loil reservoir&r beneath you. Build a derrick and a pumpjack over it."
	]
	quest.7F7D4CF8C56466A4.title: "Black Gold"
	quest.7F7D4CF8C56466A4.quest_subtitle: "Derrick and pumpjack"
	quest.7F7D4CF8C56466A4.quest_desc: [
		"First the derrick drills a well, then the pumpjack draws oil. Crude goes into a &ldistillation tower&r."
		"&lImportant:&r oil machines &lpollute the air&r — see the \"Air\" quest below."
	]
	quest.3E617B5D12B1FC24.title: "Distillation"
	quest.3E617B5D12B1FC24.quest_subtitle: "Diesel, gasoline, lubricant"
	quest.3E617B5D12B1FC24.quest_desc: [
		"The tower splits crude into fractions: diesel for generators, gasoline for vehicles, lubricant for machines, asphalt for roads."
	]
	quest.3DEC14AC13120A77.title: "The Factory Must Grow"
	quest.3DEC14AC13120A77.quest_subtitle: "TFMG: steel and oil, Create-style"
	quest.3DEC14AC13120A77.quest_desc: [
		"TFMG is heavy industry for Create: coke oven, blast furnace, casting, diesel engines."
		"If IE isn't your style, this is another road to steel and fuel, entirely on rotation."
	]
	quest.1A020305E1D3E7EE.title: "The Diesel Engine"
	quest.1A020305E1D3E7EE.quest_subtitle: "Power for huge machines"
	quest.1A020305E1D3E7EE.quest_desc: [
		"Cylinders, a gearbox and a controller — and the engine drives a whole factory or a heavy Aeronautics vehicle."
	]
	quest.294E4669A44B8A90.title: "The Air"
	quest.294E4669A44B8A90.quest_subtitle: "Airborne: pollution"
	quest.294E4669A44B8A90.quest_desc: [
		"&lWhat:&r factories, diesel and steam engines emit &lsmog&r. Wind spreads it; it harms crops and animals."
		"&lHow to fight it:&r forests and flowers absorb pollution; filters and tall stacks disperse it; electricity is cleaner than diesel."
		"&lTip:&r keep heavy industry far from the gardener's farm — and the friendship survives."
	]
	quest.2AD96C483D33D856.title: "Treated Wood"
	quest.2AD96C483D33D856.quest_desc: [
		"Planks soaked in creosote from the coke oven. Used for power poles, windmills and handsome industrial builds."
	]
	quest.7AFF934DCA0E6570.title: "Wires and Connectors"
	quest.7AFF934DCA0E6570.quest_desc: [
		"String copper wire between connectors and power flows through the air. Wire cutters take it down again."
	]
	quest.4FBD2D0E83BE60B4.title: "The Capacitor"
	quest.4FBD2D0E83BE60B4.quest_desc: [
		"Stores IE power. Place it between generator and consumers to smooth out the wind."
	]
	quest.5483FBF5D1816A4C.title: "Engineering Components"
	quest.5483FBF5D1816A4C.quest_desc: [
		"Iron and steel components — gears and springs for IE multiblocks. Made at the engineer's workbench."
	]
	quest.328FDBEF228A8FFE.title: "Engineering Blocks"
	quest.328FDBEF228A8FFE.quest_desc: [
		"Light and heavy engineering blocks — the bricks of big machines: the press, arc furnace, excavator."
	]
	quest.5C46F0227CB6505C.title: "The IE Crusher"
	quest.5C46F0227CB6505C.quest_desc: [
		"A huge crusher doubles ore and grinds everything. Build it from the manual and tick the quest."
	]
	quest.3E2D9D8E886F6C84.title: "The Arc Furnace"
	quest.3E2D9D8E886F6C84.quest_desc: [
		"Smelts alloys and ore with electricity and graphite electrodes. IE's most spectacular machine."
	]
	quest.2F616E00AAE960B1.title: "The Excavator"
	quest.2F616E00AAE960B1.quest_desc: [
		"A giant wheel over an ore vein mines forever. Worth building as a whole group."
	]
	quest.59FAF5536B9FD537.title: "The Engineer's Revolver"
	quest.59FAF5536B9FD537.quest_desc: [
		"IE's upgradeable revolver with barrels and cylinders. Ammo is made at an assembler."
	]
	quest.3046392D71FAC550.title: "The Skyhook"
	quest.3046392D71FAC550.quest_desc: [
		"Hook onto a wire and ride it like a zip line. Wires between bases become roads."
	]
	quest.1329CEFC5DE03CC2.title: "The Diesel Generator"
	quest.1329CEFC5DE03CC2.quest_desc: [
		"A big generator burning diesel. Powerful — but it &lpollutes the air&r. Think about filters and trees around it."
	]
	quest.5C51AE40CD1103E9.title: "Asphalt"
	quest.5C51AE40CD1103E9.quest_desc: [
		"Asphalt roads speed you up. Lay a highway between bases."
	]
	quest.2C47CC784D3B70E5.title: "The Speedboat"
	quest.2C47CC784D3B70E5.quest_desc: [
		"A fast gasoline boat. With an icebreaker it handles ice too."
	]
	quest.35E236DBFB93865C.title: "TFMG Steel"
	quest.35E236DBFB93865C.quest_desc: [
		"TFMG's blast furnace with a stove pours molten steel into moulds. Steel is shared — Almost Unified makes it one item across mods."
	]
	quest.6E091F8E2D5D5FBC.title: "Plastic"
	quest.6E091F8E2D5D5FBC.quest_desc: [
		"Oil fractions make plastic. Needed for electronics and modern machines."
	]
	quest.64C0EDFF9ABD667E.title: "Lithium"
	quest.64C0EDFF9ABD667E.quest_desc: [
		"Lithium ore — for TFMG batteries and electric motors."
	]
	quest.0A4D3CC8580A871B.title: "TFMG Coke Oven"
	quest.0A4D3CC8580A871B.quest_subtitle: "Create: The Factory Must Grow"
	quest.0A4D3CC8580A871B.quest_desc: [
		"&lWhat:&r TFMG is heavy industry on Create: coke, steel, oil, plastic, electrics."
		"&lWhy coke:&r no coke, no TFMG steel. The coke oven is a multiblock; vent the smoke outside (watch the smog, «Elements» chapter)."
	]
	quest.3159A577DDBB09A3.title: "Bauxite"
	quest.3159A577DDBB09A3.quest_subtitle: "The road to aluminium"
	quest.3159A577DDBB09A3.quest_desc: [
		"Bauxite is aluminium ore. Aluminium pipes and cogs are lighter and carry more than copper and andesite."
	]
	quest.587BA5DC216ED50E.title: "Reinforced Concrete"
	quest.587BA5DC216ED50E.quest_subtitle: "For real factories"
	quest.587BA5DC216ED50E.quest_desc: [
		"Concrete with rebar withstands blasts better than stone. A foundation for a reactor or a powder store."
	]
	quest.594F228266507B1D.title: "Circuit Board"
	quest.594F228266507B1D.quest_subtitle: "TFMG electronics"
	quest.594F228266507B1D.quest_desc: [
		"Plastic + copper → a board. Boards make electric motors, transistors, traffic lights: the TFMG electric branch."
	]
	quest.34A6CC13D56A641D.title: "TFMG Electric Motor"
	quest.34A6CC13D56A641D.quest_subtitle: "Power → rotation"
	quest.34A6CC13D56A641D.quest_desc: [
		"The motor turns Create shafts from electricity: run your factory off a reactor instead of windmills."
	]
	quest.6D88123A2F5C4016.title: "Pumpjack"
	quest.6D88123A2F5C4016.quest_subtitle: "TFMG oil"
	quest.6D88123A2F5C4016.quest_desc: [
		"The TFMG pumpjack draws oil from deposits underground: the same resource as Immersive Petroleum, but on Create mechanics."
	]
	quest.2914A07238F4FC3A.title: "Industrialisation"
	quest.2914A07238F4FC3A.quest_subtitle: "The factory must grow"
	quest.2914A07238F4FC3A.quest_desc: [
		"Coke, steel, aluminium, concrete, plastic and electronics. Mind the smog: filters and trees around the plant keep the sky clear."
	]
	quest.5ECA5ED6855261BA.title: "Fireclay"
	quest.5ECA5ED6855261BA.quest_desc: [
		"&lWhy:&r Fireproof bricks build the blast furnace and coke oven."
	]
	quest.4D11317C715C21B6.title: "Coke Oven Battery"
	quest.4D11317C715C21B6.quest_desc: [
		"&lWhy:&r Ovens placed together merge into a battery."
		"The Coke Oven is a machine that produces coal coke from coal. It is very slow so it is beneficial to have long arrays of them. Coal can be inserted from anywhere. Carbon Dioxide is extracted at the top, Creosote can be extracted anywhere else. After some time, coal coke will fall out of the machine."
	]
	quest.11A2A60CF4B777CB.title: "Blast Furnace"
	quest.11A2A60CF4B777CB.quest_desc: [
		"&lWhy:&r Ore + coke + flux → molten iron and slag. Taller = more."
		"Main part of a blast furnace is a blast furnace output. To build a blast furnace, make a cylinder of fireproof bricks around it with one blast furnace hatch in it. This hatch will function as a hot air input. Blast furnaces need reinforcements to function. Everything is inserted to through a hole at the top. Next hatch can be placed on the top hole to collect furnace gas, items directed into it will fall into the blast furnace. Blast furnace reinforcements can be placed around the furnace to increase its speed."
	]
	quest.44074560068461DF.title: "Blast Stove"
	quest.44074560068461DF.quest_desc: [
		"&lWhy:&r Hot blast speeds up the furnace."
	]
	quest.08242AFBD392E776.title: "Casting Basin"
	quest.08242AFBD392E776.quest_desc: [
		"&lWhy:&r Casts molten metal into ingots and blocks."
	]
	quest.3C29252E178AF10C.title: "Cast Iron"
	quest.3C29252E178AF10C.quest_desc: [
		"&lWhy:&r Cast iron pipes for hot fluids."
	]
	quest.721B57CAE7CE28F2.title: "Steel Mechanism"
	quest.721B57CAE7CE28F2.quest_desc: [
		"&lWhy:&r The heavy-industry counterpart of the precision mechanism."
	]
	quest.3620AFEA4D92D4B4.title: "Heavy Plate"
	quest.3620AFEA4D92D4B4.quest_desc: [
		"&lWhy:&r Casing for engines and machines."
	]
	quest.0B40A8FB2D17C594.title: "Steel Gearing"
	quest.0B40A8FB2D17C594.quest_desc: [
		"&lWhy:&r Steel gears handle engine power."
	]
	quest.4A375F21AC4978AB.title: "TFMG Tools"
	quest.4A375F21AC4978AB.quest_desc: [
		"&lWhy:&r Tougher than iron tools."
	]
	quest.122A23D50B4234A1.title: "Galena"
	quest.122A23D50B4234A1.quest_desc: [
		"&lWhy:&r Lead and silver ore."
	]
	quest.2A2098A285C33969.title: "Lead Pickaxe"
	quest.2A2098A285C33969.quest_desc: [
		"&lWhy:&r Slow but durable."
	]
	quest.287FB412A80D9A4C.title: "Surface Scanner"
	quest.287FB412A80D9A4C.quest_desc: [
		"&lWhy:&r Finds oil deposits."
		"Helps to find chunks with oil"
	]
	quest.6847F4C28664F3EF.title: "Distillation Tower"
	quest.6847F4C28664F3EF.quest_desc: [
		"&lWhy:&r Oil → gasoline, diesel, kerosene, naphtha and more."
		"The base of a distillation tower is comprised of steel tanks. Tower is assembled by placing Steel Distillation Controller next to the tanks. To finish the multiblock, place up to 6 Distillation outputs and Industrial Pipes between them. Place a heat source under the tanks to power it, the dial on the tower shows the power level of the structure. Oil is inputted into the controller block."
	]
	quest.57EC2C8953E0A97C.title: "Chemical Vat"
	quest.57EC2C8953E0A97C.quest_desc: [
		"&lWhy:&r Multiblock vat for acids, plastic and electrolysis."
		"The chemical vat is a machine with attachments that can give it many different uses. First attachment is the industrial mixer. When the mixer blade is inserted, the vat becomes a mixer. The industrial mixer can also become a centrifuge. Some recipes need heating. Placing 2 electrode holders with copper electrodes creates an electrolyzer. 3 graphite electrodes create a blast furnace."
	]
	quest.601C98B2B0AE949E.title: "Flarestack"
	quest.601C98B2B0AE949E.quest_desc: [
		"&lWhy:&r Burns excess gas. Watch pollution."
		"Burns unneeded oil products"
	]
	quest.31C3166E6150C725.title: "Metal Smokestack"
	quest.31C3166E6150C725.quest_desc: [
		"&lWhy:&r Leads smoke up and away."
	]
	quest.08CEFA3508F0016D.title: "Asphalt"
	quest.08CEFA3508F0016D.quest_desc: [
		"&lWhy:&r Roads for faster driving."
	]
	quest.3D740BDDBBB1DC75.title: "Synthetics"
	quest.3D740BDDBBB1DC75.quest_desc: [
		"&lWhy:&r Leather and string without animals."
	]
	quest.2E806EC193D6C56D.title: "Regular Engine"
	quest.2E806EC193D6C56D.quest_desc: [
		"&lWhy:&r A gasoline engine for huge rotational power."
		"To build an engine, start by placing up to 5 engine blocks in a line. The engine's tooltip will show you items needed for the assembly. Engine configuration can be changed with a schematic. Next step is inserting the cylinders (or turbine blades in turbine engines). Shafts are inserted by right clicking. Fuel input and exhaust output can be done from any block. Every engine block can be right clicked with certain items to be upgraded. For example industrial pipes make the engine consume fuel from neighboring tanks."
	]
	quest.488BC9D213903789.title: "Large Engine"
	quest.488BC9D213903789.quest_desc: [
		"&lWhy:&r More cylinders, more power."
		"Creates rotation from less refined fuels"
	]
	quest.7E0F2CDFD6BDC524.title: "Radial Engine"
	quest.7E0F2CDFD6BDC524.quest_desc: [
		"&lWhy:&r Compact power for planes and ships."
	]
	quest.75CF4D487EB9FF03.title: "Turbine Engine"
	quest.75CF4D487EB9FF03.quest_desc: [
		"&lWhy:&r The strongest TFMG power unit."
	]
	quest.6C20A3E55F0AD3CD.title: "Turbocharging"
	quest.6C20A3E55F0AD3CD.quest_desc: [
		"&lWhy:&r More engine power; the exhaust vents gases."
	]
	quest.615B3B0DA6998ACF.title: "TFMG Electricity"
	quest.615B3B0DA6998ACF.quest_desc: [
		"&lWhy:&r Generators turn rotation into current; voltage and resistance are simulated."
		"A generator creates 2 values, Voltage and Power. Generator:"
		"   Voltage(U) = 200V"
		"   Max Power = 8kW"
		"Light Bulb:"
		"   Voltage(U) = 200V"
		"   Current(I) = 2A"
		"   Power(P) = 100W"
		"   Resistance(R) = 100Ω. When load is applied on a generator, it takes its voltage. Every an electric device has electrical resistance, light bulbs are 100 Ohm(Ω). Current with size of Voltage divided by Resistance will start flowing in the light bulb."
	]
	quest.4DBA62B14DC9CD80.title: "Multimeter"
	quest.4DBA62B14DC9CD80.quest_desc: [
		"&lWhy:&r Shows voltage and current."
		"Shows data about an electrical block and its network"
	]
	quest.175FB7FD839C4A47.title: "Accumulator"
	quest.175FB7FD839C4A47.quest_desc: [
		"&lWhy:&r Stores power for night and load spikes."
		"Holds a Large Amount of energy (inserted from bottom) that can be outputted Slowly from the Top"
	]
	quest.4DE23E23F98F80A2.title: "Transformer"
	quest.4DE23E23F98F80A2.quest_desc: [
		"&lWhy:&r Steps voltage up for long lines and down for machines."
		"Some blocks have connections from 2 sides. These blocks create a new electric network on one of their sides. This subnetwork will get all the power from the main network but not the opposite way. The most basic block with this ability is the Diode, it has no other extra abilities. Next one is the potentiometer, this one can set the percentage of voltage that gets to the subnetwork. The switch works similarly but with redstone. The transformer changes voltage based on the ratio of turns between the primary and secondary coil."
	]
	quest.10FF7C32138FD2DB.title: "Electronic Components"
	quest.10FF7C32138FD2DB.quest_desc: [
		"&lWhy:&r Made by sequenced assembly."
		"Adds resistance to a network"
	]
	quest.29DC664BF5E3BB07.title: "Winding Machine"
	quest.29DC664BF5E3BB07.quest_desc: [
		"&lWhy:&r Winds coils for motors and generators."
		"Changes the amount of turns on spools and the resistance on resistors"
	]
	quest.3B1A72A757EE9C13.title: "Converter"
	quest.3B1A72A757EE9C13.quest_desc: [
		"&lWhy:&r Converts TFMG power to FE for other mods."
		"Converts FE to TFMG energy and vice versa"
	]
	quest.5D7228E0468C2ECE.title: "City Lights"
	quest.5D7228E0468C2ECE.quest_desc: [
		"&lWhy:&r Lamps, neon and traffic lights."
	]
	quest.5885F30E7CF3C4F9.title: "Electric Pump"
	quest.5885F30E7CF3C4F9.quest_desc: [
		"&lWhy:&r Pumps fluids on electricity alone."
	]
	quest.15D110F1B5A5AAB6.title: "Reinforced Concrete"
	quest.15D110F1B5A5AAB6.quest_desc: [
		"&lWhy:&r Walls that stand up to blasts and meteors."
	]
	quest.7332C6399AE90323.title: "Factory Floor"
	quest.7332C6399AE90323.quest_desc: [
		"&lWhy:&r A proper factory floor."
	]
	quest.270D09DCA18C2A9F.title: "Fire Extinguisher"
	quest.270D09DCA18C2A9F.quest_desc: [
		"&lWhy:&r Puts out fires. Keep one near wooden builds!"
	]
	quest.1BED2E449CF8B36B.title: "Flamethrower"
	quest.1BED2E449CF8B36B.quest_desc: [
		"&lWhy:&r Burns mob crowds — and forests, so be careful."
		"Burns  burnable Gases and Fluids to shoot out a burst of flame to burn your Enemies"
	]
	quest.0C7D5B49867AB317.title: "Advanced Potato Cannon"
	quest.0C7D5B49867AB317.quest_desc: [
		"&lWhy:&r Farther, faster, stronger."
		"Launches Napalm Potatoes at Enemies. Can be powered with Air Pressure from a Backtank"
	]
	quest.728CE71459E1D7A7.title: "Grenades"
	quest.728CE71459E1D7A7.quest_desc: [
		"&lWhy:&r Use them in the wilds, not near other players' houses."
	]
	quest.06B6DC6F3547A72D.title: "The Factory Must Grow"
	quest.06B6DC6F3547A72D.quest_desc: [
		"Your factory powers the server. Mind the shared air."
	]
	chapter.3DEA61287EDBEADA.title: "Immersive Engineering"
	chapter.3DEA61287EDBEADA.chapter_subtitle: [
		"Wires, multiblock machines, revolver and railgun"
	]
	quest.45545743A5457871.title: "Engineer's Manual"
	quest.45545743A5457871.quest_desc: [
		"&lWhy:&r Everything in IE is built with the hammer from layouts in this manual."
		"Greetings and welcome to Immersive Engineering."
		"The following notes and guides will showcase the most recent technology available in the modern combined worlds."
		"However, certain pieces of science may be so weird, that this manual can not yet explain them. In traveling the worlds, certain Eureka-moments may lead to new pages being added to the manual, though this will be a rare exception."
	]
	quest.1C9C7E82FFB2E75D.title: "Engineer's Workbenches"
	quest.1C9C7E82FFB2E75D.quest_desc: [
		"&lWhy:&r The workbench makes blueprints: press molds, bullets, gun parts."
		"The Engineer's Workbench is a professional worktable for the educated engineer. It is widely used to create items described by Engineer's Blueprints."
		"A wide variety of blueprints can be crafted, as detailed here, whereas a few select ones can only be discovered in the world or bought from villagers."
		"To use a blueprint in the Workbench, put it in the slot on the left of the GUI and the necessary ingredients in the six slots in the middle."
	]
	quest.205AABFE7AD734F6.title: "Alloy Kiln"
	quest.205AABFE7AD734F6.quest_desc: [
		"&lWhy:&r The first IE machine, no power: bronze, electrum, constantan."
		"The Alloy Kiln is a simple furnace made out of heat resistant sandstone and bricks. Within it, temperatures are high enough to allow metals to be melted into a fluid state and mixed, creating an alloy;alloys."
		"This allows the creation of important alloys like Electrum and Constantan without the tedious mixing of dusts."
		"To form the Kiln, arrange 8 of the Kiln Bricks in a 2x2x2 cube, as shown above, and rightclick one of the sides' blocks with an Engineer's Hammer."
	]
	quest.691B4D3B6B61A89F.title: "Constantan and Electrum"
	quest.691B4D3B6B61A89F.quest_desc: [
		"&lWhy:&r Constantan for coils, electrum for MV wires."
	]
	quest.19C6607FC3B0C7B8.title: "Coke Oven"
	quest.19C6607FC3B0C7B8.quest_desc: [
		"&lWhy:&r 3x3x3 cube: coal to coke plus creosote."
		"The Coke Oven is the first important machine on the engineer's journey."
		"The brick oven heats up fuels in a low-oxygen environment, pyrolyzing them into a more carbon-rich version, such as Coal Coke, or Charcoal."
		"A byproduct of this process is Creosote Oil;creosote_oil, which is used as a preservative for wood. This preserved wood serves as a basic construction material all throughout."
	]
	quest.61B82D82D1A4ACA6.title: "Blast Furnace"
	quest.61B82D82D1A4ACA6.quest_desc: [
		"&lWhy:&r Iron + coke → steel, no power needed."
		"The Crude Blast Furnace is used to increase the carbon contents in iron, turning it into TD LINK STEEL."
		"To achieve this, only pure, high-carbon fuels may be used for the furnace, such as coal coke and charcoal."
		"Along with steel, the furnace will also create slag;slag, which you must remove or the furnace will cease to function."
	]
	quest.0667C77CBF1DBF02.title: "Improved Blast Furnace"
	quest.0667C77CBF1DBF02.quest_desc: [
		"&lWhy:&r Reinforced bricks and preheaters: much faster steel."
		"The Improved Blast Furnace is a much more professional way of creating steel. Not only does it allow the automation of in- and outputs, it can also be outfitted with preheaters;preheater to speed up the refinement process by addition of hot air."
		"The furnace is made from reinforced bricks, a prime choice for the aspiring engineer's first steel."
		"The structure of the Furnace is similar to its crude predecessor, but the bricks have been reinforced and a hopper was added at the top to funnel in the inputs."
	]
	quest.5101C74CFBC8C2DC.title: "Treated Wood"
	quest.5101C74CFBC8C2DC.quest_desc: [
		"&lWhy:&r Posts carry wires, scaffolding helps build tall machines."
		"Treated wood is any kind of wooden planks impregnated with Creosote Oil;creosote_oil."
		"Despite their simplicity, these weatherproof planks are used throughout industrial matters where a durable wood is needed."
		"Treated wood can also be used to craft Wallmounts, which can be very useful to mount connectors in a visually attractive way without using posts."
	]
	quest.2E5826298D96EEBE.title: "Water Wheel"
	quest.2E5826298D96EEBE.quest_desc: [
		"&lWhy:&r A waterwheel on a river powers you day and night."
		"The simplest form of power generation available is not solar or coal, but using natural forces to excite a generator."
		"The Kinetic Dynamo connects to integrated methods of producing shaft power and produces electrical power based on how fast they turn."
		"Windmills and waterwheels, detailed in the following pages, are the sources of shaft power the Kinetic Dynamo will accept, and must be assembled after the dynamo for them to connect."
	]
	quest.348A5DB2F367FA7B.title: "Thermoelectric Generator"
	quest.348A5DB2F367FA7B.quest_desc: [
		"&lWhy:&r Between hot and cold blocks it makes power with no fuel."
		"Thermoelectric Generators are another kind of power generation, and work without the use of any mechanical parts. These generators use the temperature gradient between two opposing sources to produce power."
		"Placing a heat source on one side and a colder source on the opposite side generates energy based on the difference between the two temperatures."
		"Any fluid will work based on its temperature, along with some other blocks."
	]
	quest.0880A0951D2F356D.title: "Medium Voltage"
	quest.0880A0951D2F356D.quest_desc: [
		"&lWhy:&r Electrum and a transformer move more power farther."
		"Transformers are laminated iron cores wrapped in coils of wire that convert between different voltages of wire."
		"Standard transformers can convert between LV and MV freely, but specialty circuits found in the HV Transformer are needed to convert to HV."
		"Their compact internals allow standard transformers to be placed on Posts, however HV Transformers cannot be placed this way."
	]
	quest.7D24B59880179944.title: "High Voltage"
	quest.7D24B59880179944.quest_desc: [
		"&lWhy:&r Steel wires are the trunk line between bases. They shock — build them high."
	]
	quest.3B8B4D6CB4D64F33.title: "Insulated Wires"
	quest.3B8B4D6CB4D64F33.quest_desc: [
		"&lWhy:&r Indoors use insulated wires; bare ones shock."
		"Power grids have three important devices: connectors in- and output to the net, relays attach multiple wires together, and Transformers that convert between different voltages of wire."
		"Connectors serve as in- and outputs to the electrical grid. Powered devices connected with them will transfer power through the grid."
		"Relays will not in- or output power, they serve as hubs for the electrical grid."
	]
	quest.462AFB78E531FC9C.title: "MV Accumulator"
	quest.462AFB78E531FC9C.quest_desc: [
		"Accumulators serve as energy storage units. Input and output power is limited to one connector of the voltage of the accumulator per side."
		"Side configuration can be adjusted with the hammer: Blue corresponds to input, orange corresponds to output, and no colour marking preventing any connection at all."
		"Sneaking while configuring a side will configure the side opposite to the one that was clicked."
	]
	quest.4C6CE2A973BF5263.title: "HV Accumulator"
	quest.4C6CE2A973BF5263.quest_desc: [
		"&lWhy:&r HV buffer for the railgun, tesla coil and lightning rod."
	]
	quest.346F3397EDB5B2A8.title: "Breaker Switch and Current Transformer"
	quest.346F3397EDB5B2A8.quest_desc: [
		"Breaker Switches are simple switches that can stop the flow of power through wires."
		"They connect two wires of the same type and will only allow power to pass when activated. Due to the high risk, these switches cannot be connected to HV wiring."
		"This can be used to separate power-hungry machinery from the network or hook up an additional set of generators when needed."
	]
	quest.6272FE2ABE4520CB.title: "Lightning Rod"
	quest.6272FE2ABE4520CB.quest_desc: [
		"&lWhy:&r Catches lightning and stores the energy."
		"Lightning is a phenomenon of nature. It contains a huge amount of raw power, and this lightning rod is able to harness that power."
		"Stacking steel fences on the port at the top of the rod increases the changes that lightning hits it during rain or thunder. The chance of a strike can be increased further by widening the rod into a net at its top."
		"When the steel pole is struck, the huge amounts of energy created are stored in the base of the lightning rod and then slowly distributed to the energy connections at the sides."
	]
	quest.0BFF60364CFBA3A4.title: "Diesel Generator"
	quest.0BFF60364CFBA3A4.quest_desc: [
		"&lWhy:&r Huge power from diesel or biodiesel."
		"High-Voltage architecture might be fascinating, but an electrical grid isn't very useful unless there is a generator which can provide for it."
		"The Diesel Generator is the primary method of generating HV power. It will run off of Biodiesel;biodiesel or other heavy fuels, as detailed in the following pages. Due to its high output, it will consume fuel rapidly, so sufficient fuel production is a must."
		"The engine and generator are constructed from radiators, pipes, engineering blocks, and scaffolding as shown above and formed via activating the central generator with an Engineer's Hammer."
	]
	quest.317A646E3485C32B.title: "Metal Press"
	quest.317A646E3485C32B.quest_desc: [
		"&lWhy:&r Plates, rods, gears and wires from one ingot each."
		"The Metal Press is an automated way of shaping metal. It uses a high pressure piston to press plates, rods, or other metal components using molds."
		"The machine is created as shown above by using an Engineer's Hammer on the piston."
		"Power is input through the plug on the top of the piston, and items through the conveyors in the direction of movement."
	]
	quest.71D9EAB44F223902.title: "Squeezer and Fermenter"
	quest.71D9EAB44F223902.quest_desc: [
		"&lWhy:&r Seeds → plant oil, sugar → ethanol; together → biodiesel."
		"The Squeezer is a multiblock structure that presses juice or oil out of organic materials with a large piston. The structure is built as shown above and formed by using the Engineer's Hammer on the central wooden barrel, on the side of the redstone port."
		"Items can be input into the Squeezer via the two hatches at the back that are marked with blue dots. The hatch with the orange dot serves as an item output and the block below it to output fluids."
		"Applying a redstone signal to the control panel at the front will halt the machine's process, this behavior can be inverted by use of the Engineer's Screwdriver."
		"The Fermenter is a multiblock structure that extracts ethanol from certain fruits, grains and vegetables through a fermenting process. The structure is built as shown above and formed by using the Engineer's Hammer on the central cauldron, on the side of the redstone port."
		"Items can be input into the Fermenter via the two hatches at the back that are marked with blue dots. The hatch with the orange dot serves as an item output and the block below it to output fluids."
		"Applying a redstone signal to the control panel at the front will halt the machine's process, this behavior can be inverted by use of the Engineer's Screwdriver."
	]
	quest.0CCCE1041BFDD4F4.title: "Refinery"
	quest.0CCCE1041BFDD4F4.quest_desc: [
		"Many processes necessitate the addition of a catalyst. The refinery passes its input fluids through a mixer and a catalyst at the same time, producing novel outputs from one or two inputs."
		"To form the machine, construct it as shown and rightclick the Heavy Engineering Block on the middle layer."
		"Fluids are input through the two ports on either side of the block and output through the orange marked port at the front. Using buckets to interact with the refinery's tanks is also possible."
	]
	quest.010DB7A46B603A9A.title: "Industrial Hemp"
	quest.010DB7A46B603A9A.quest_desc: [
		"&lWhy:&r Fibre for fabric, rope, sails and hempcrete."
		"Industrial Hemp is a very versatile plant, with uses all throughout the engineering profession. It seeds can be used for the creation of LINK TO GO HERE(plant oil), used in Biodiesel;biodiesel; its fibers can be used in the creation of a sturdy canvas, Tough Fabric."
		"The seeds can be obtained by breaking tall grass and other similar methods of collection."
		"Tough Fabric is a resilient weave made from hemp fiber. When waterproofed, it can be used as Ersatz Leather;ersatz_leather."
	]
	quest.0A76ADD1563FAB13.title: "Garden Cloche"
	quest.0A76ADD1563FAB13.quest_desc: [
		"&lWhy:&r A one-block auto-farm for any crop."
		"Garden Cloches are machines designed to hasten the growth of plants in a controlled, semi hydroponic environment."
		"It allows even agriculturally challenged engineers to grow plants quickly and automatically harvest their produce."
		"The device accepts power through the plugs on the top and sides, and fluid and items through the other ports."
	]
	quest.7DD2F6A6B48065FD.title: "Mixer and Concrete"
	quest.7DD2F6A6B48065FD.quest_desc: [
		"&lWhy:&r Liquid concrete: blast-resistant building blocks."
		"The Mixer is a multiblock structure that dissolves solids in fluids, mixing them together. The structure is built as shown above and formed by using the Engineer's Hammer on the central sheetmetal block."
		"The most common uses for this machine are the mixing of Liquid Concrete;liquid, or the creation of Liquid Potions;potion from water and their various ingredients."
		"Fluids are input into the mixer through the port at the bottom of its powersupply. Items can be input via the two hatches at the back. The fluid port at the front serves as fluid output."
	]
	quest.5A17D906E36CDBF7.title: "Concrete Bunker"
	quest.5A17D906E36CDBF7.quest_desc: [
		"&lWhy:&r Shelter from meteors and blasts; leaded concrete for reactors."
		"Concrete is a very hard and resistant composite material. It's cheap to craft and makes for an excellent use for crushed excess slag;slag produced by making steel."
		"Concrete can be cut and assembled into various bricks and pillars using the Stonecutter."
		"Concrete bricks have the same blast resistance as concrete, but can be disassembled faster than their solid counterpart, making them a good structural material."
	]
	quest.3BC5DF8F9349944B.title: "Bottling Machine"
	quest.3BC5DF8F9349944B.quest_desc: [
		"The Bottling Machine fills fluids into containers or molds."
		"The structure is created as shown above, but can be mirrored. To form it, rightclick the central conveyor with an Engineer's Hammer. The direction of the conveyors is important."
		"The machine can store 8 buckets of fluid, which is input through the ports on the metal tank. Energy is input through the connection at the top of the opposing side."
	]
	quest.5EEEEB3E32962819.title: "Sawmill"
	quest.5EEEEB3E32962819.quest_desc: [
		"&lWhy:&r Strips and saws logs into planks and sawdust."
		"The sawmill is a machine assembly which cuts wooden logs into neatly stacked planks."
		"The machine operates in two stages: first, the log is stripped, then the stripped law is cut apart using a sawblade."
		"Both steps of the process create sawdust, which is collected and output through the port at the front of the machine."
	]
	quest.074B63D941DB7CAF.title: "Silo and Tank"
	quest.074B63D941DB7CAF.quest_desc: [
		"&lWhy:&r Silo: 40k of one item; tank: 512 buckets."
		"Silos offer space for a lot of items of the same type, making them excellent for mass storage of seeds, slag or cobblestone. They have space for 41472 items, equaling the capacity of 24 chests."
		"The structure can be constructed out of any sheetmetal, it is not limited to using iron."
		"Items can be input through the top grate, or through the bottom port. Items must be extracted from the bottom port."
		"The Tank is a multiblock that provides space for large amounts of fluid."
		"It will store up to 512 buckets of any fluid, which can be piped in via the top or bottom port."
		"The structure can be constructed out of any sheetmetal, it is not limited to using iron."
	]
	quest.34463437BBA6632E.title: "Assembler"
	quest.34463437BBA6632E.quest_desc: [
		"The Assembler is a complex machine capable of crafting items, similar to a player."
		"To form the structure, build it like demonstrated above and use the Engineer's Hammer on the inwards facing conveyor."
		"The Assembler allows for up to 3 recipes to be stored inside it that will be performed in order. The outputs of previous recipes can be used as inputs for following recipes."
	]
	quest.796AFA592184D450.title: "Automated Workbench"
	quest.796AFA592184D450.quest_desc: [
		"The Automated Workbench is one of the first major successes of small-scale engineering."
		"The machine is able to follow a set of instructions described by a Blueprint;start to assemble the items detailed by it."
		"Upon assembling the multiblock, a Blueprint can be placed on its drawing table. After selecting the item that should be created, it will begin the assembly process. In order for the machine to work, it will need to be supplied with materials and power."
	]
	quest.334F4513E6CBA912.title: "Graphite Electrode"
	quest.334F4513E6CBA912.quest_desc: [
		"&lWhy:&r The arc furnace needs three graphite electrodes."
		"Coal Coke is a purified form of carbon similar to charcoal. Coke is created from coal in the Coke Oven."
		"It is used in steelmaking of all forms, from the simplest to the most advanced, and is a better furnace fuel than coal."
		"Highly Ordered Pyrolytic (HOP) Graphite is a complex, allotrope of graphite used in special engineering constructs."
	]
	quest.3497BFB8C982710D.title: "Slag Products"
	quest.3497BFB8C982710D.quest_desc: [
		"&lWhy:&r Slag glass, bricks and gravel."
		"Slag Gravel is slag that has been ground in the Crusher to a rough grit. As with other gravels, it can be crushed further into sand."
		"Additionally, slag gravel contains valuable nutrients for aquatic flora. Waterlogged plants placed on slag gravel grow faster than when grown on other blocks."
		"Remelting slag in a Furnace vitrifies it to a hard, darkened slag glass."
	]
	quest.16347FEBFCAA6464.title: "Mineral Deposits"
	quest.16347FEBFCAA6464.quest_desc: [
		"&lWhy:&r The core sample shows the deposit under you."
		"Scattered throughout the stone of the world are small, concentrated deposits of ores, visible to the naked eye and recoverable with hand tools."
		"Outside of those and in the underlying rock are Mineral Veins, composed of several different ores, too sparse for all but a special machine to recover."
		"At the end of this section is an appendix listing all known mineral veins."
	]
	quest.506D26624B12F125.title: "Conveyor Belts"
	quest.506D26624B12F125.quest_desc: [
		"&lWhy:&r IE multiblocks are fed by conveyors."
		"Conveyor Belts are an easy, unpowered method of moving in-world things around."
		"Conveyor belts will move anything other creatures can push and several they cannot, with their primary design point being items. Other creatures such as cows and sheep can also be moved, but will not interact with some item-specific designs."
		"Items dropped onto conveyor belts will move along a belt, and items can be dropped onto belts from devices such as hoppers or pipes."
	]
	quest.42BBEC80D2207D5E.title: "Iron Sheetmetal Chute"
	quest.42BBEC80D2207D5E.quest_desc: [
		"Chutes are simple constructions made from sheetmetal that allow creatures and items that fit inside to drop straight down."
		"Chutes also insert into inventories below them and can be inserted into by conveyors or similar devices."
		"Items within them won't be picked up by players and should be immune to most forms of attraction, magnetic or otherwise."
	]
	quest.3E0DD81BB79338A8.title: "Item and Fluid Routers"
	quest.3E0DD81BB79338A8.quest_desc: [
		"The Item Router is designed to parcel and sort items into inventories such as chests, machines, and conveyors."
		"Items inserted into the router will be output from matching configured sides or open sides in that order."
		"Items can be inserted from any side, and will be output from one of the other five sides, or will disallow input if they cannot be sorted."
	]
	quest.1CBBA1A0F316EFF2.title: "Pipes and Pump"
	quest.1CBBA1A0F316EFF2.quest_desc: [
		"Fluid Pipes are a versatile and efficient method of transporting fluids, unlike moving tanks ore buckets around en masse."
		"Pipe systems will output any fluid input to them across the available ouputs, split evenly."
		"At low pressure, pipe systems will transport fluid slowly. Pressurized fluids output from a Fluid Pump or certain large machines can move much faster."
	]
	quest.6F7BB611E8D98EC4.title: "Jerrycan"
	quest.6F7BB611E8D98EC4.quest_desc: [
		"&lWhy:&r A 10-bucket can to refuel vehicles and generators."
		"Jerrycans are simple metal containers used to carry fluids. They can store up to 10 buckets and can pour that fluid into the world as well as into machines."
		"Jerrycans cannot be used to pick up fluids from the world, but can be refilled from tanks such as barrels or large tanks."
		"Additionally, they can be used to refill fluid-consuming items like the Mining Drill;start by placing the jerrycan and the tool together in a crafting grid."
	]
	quest.48B0EF47F5568A73.title: "Crates and Barrels"
	quest.48B0EF47F5568A73.quest_desc: [
		"&lWhy:&r Crates keep contents when broken; barrels hold fluids."
		"Wooden Storage Crates are similar to a chest in function, storing up to 27 stacks of material and providing a comparator signal based on their fill."
		"Unlike chests, they can be sealed up to keep all the material stored within a crate when picking it up."
		"Using an Engineer's Hammer;engineers_hammer on a crate for an extended duration will seal it up, after which it can be broken to pick it up."
	]
	quest.60033203B5A72663.title: "Minecart with Wooden Storage Crate"
	quest.60033203B5A72663.quest_desc: [
		"Storage Crates can be placed into Minecarts, as with chests and hoppers."
		"When placed into Minecarts, crates will act as they do outside, and store their items inside when they are broken, unlike chests."
		"Storage Barrels can be placed into Minecarts, as with chests and hoppers."
	]
	quest.27A49C65BF1E6E60.title: "Electronics"
	quest.27A49C65BF1E6E60.quest_desc: [
		"&lWhy:&r Tubes and boards for advanced machines, turrets and the railgun."
		"Many machines and tools are constructed from various sub-components. Some of these you will have to use on a regular basis, detailed on the following pages."
		"Simple components can be crafted in the regular Crafting Table, but advanced components will need the help of a specialized workbench."
		"The Basic Engineering Block serves as the main construction material for a large variety of machinery. It makes up a core frame for most single-block machinery, especially in matters of transportation and power storage."
	]
	quest.54291F60442EA4FF.title: "Logic Unit"
	quest.54291F60442EA4FF.quest_desc: [
		"&lWhy:&r A programmable logic block."
		"With the versatility of Redstone Wires and shunting from Vacuum Tubes;tubes, complex redstone can be compacted into Logic Circuits."
		"The Logic Unit is the specialty machine in which logic circuits are slotted to be used."
		"It has enough space for a total of 10 circuits, and features a full 8 inbuilt registers, usable for any circuit."
	]
	quest.357238A037B74D9D.title: "Redstone Wiring"
	quest.357238A037B74D9D.quest_desc: [
		"Redstone Wires are aluminium coated in redstone dust. The resulting cables provide an easy way to transfer redstone signals over long distance without losing signal strength."
		"Redstone Wire Connectors work as both relays and connectors: input and output connectors can have multiple wires connected."
		"With the Engineer's Screwdriver, the connectors can be configured between in- and output mode and set to one of 16 coloured frequencies."
	]
	quest.27FC410F2C73B81F.title: "Engineered Lighting"
	quest.27FC410F2C73B81F.quest_desc: [
		"&lWhy:&r Floodlights keep mobs from spawning."
		"Deep in the halls of the factories, it can be quite dark. Thankfully, lanterns can help illuminate the machinery."
		"Their light-level can be adjusted by right-clicking them with an Engineer's Screwdriver."
		"Cage lamps are a little more rugged and atmospheric than lanterns, while also providing redstone control. By default, a cage lamp requires a redstone signal to turn on, this behavior can be inverted by sneaking and right-clicking them a screwdriver."
	]
	quest.11F57772678E8456.title: "Tesla Coil"
	quest.11F57772678E8456.quest_desc: [
		"&lWhy:&r Shocks enemies around; wear Faraday armor yourself."
		"The Tesla Coil started as a concept of wireless energy transfer. However, due to its potentially high loss rates and its rather interesting property of frying every living being in a 6 meter radius, it was quickly converted into an Engineer's dream of home defense."
		"The upkeep cost of the coil is high, clocking in at 256 Flux of passive consumption plus an additional 512 every time it applies damage."
		"The coil is disabled unless supplied with a redstone signal. Rightclicking it with an Engineer's Screwdriver will invert this behavior."
	]
	quest.6C4151F9D1CC5DD7.title: "Faraday Suit"
	quest.6C4151F9D1CC5DD7.quest_desc: [
		"&lWhy:&r Protects from wire and tesla shocks."
	]
	quest.56C28697797703A0.title: "Steel Tools"
	quest.56C28697797703A0.quest_desc: [
		"&lWhy:&r Tougher than iron for about the same cost."
		"Engineer's Hammers are one of the most important tools in the engineer's toolbox."
		"It can be used to configure and form machines, as well as crush ores."
		"Engineer's Wire Cutters are used to remove all the wires connected to a block by simply rightclicking it."
	]
	quest.4CE89AEFF656E9AA.title: "IE Steel Armor"
	quest.4CE89AEFF656E9AA.quest_desc: [
		"&lWhy:&r Close to diamond; the helmet takes ear defenders."
	]
	quest.0EA0F172A29FF98F.title: "Ear Defenders"
	quest.0EA0F172A29FF98F.quest_desc: [
		"Ear Defenders are devices for protecting your hearing. They are quite important for engineers that work in close proximity to Diesel Generators; or other loud machinery."
		"While wearing Ear Defenders, all noises are reduced by 90% and they make your ears considerably more warm and fuzzy! :D"
		"Placing the Ear Defenders in the Engineer's Workbench; allows you to specify which types of noises you want cancelled and by how much their volume should be reduced."
	]
	quest.42EFDBCD46D2B14E.title: "Heavy Plated Shield"
	quest.42EFDBCD46D2B14E.quest_desc: [
		"&lWhy:&r A heavy shield with flash, shock and magnet upgrades."
		"The Heavy Plated Shield is a direct upgrade to the normal wooden shields you might be acquainted with. In similar fashion, this shield will block most incoming damage from the front, but its durability has been increased considerably, and it can be upgraded."
		"The Flashbulb upgrade adds a bright lightbulb and reflector screen to the shield. Upon being attacked, the device will produce a bright, blinding flash, disorienting everyone in front of the user."
		"Adding Shock Emitters to the shield allows you to retaliate against attacking enemies. When the shield is struck, it will emit a shock, inflicting minor damage to the aggressor."
	]
	quest.34B33ADEBC15940D.title: "Mining Drill"
	quest.34B33ADEBC15940D.quest_desc: [
		"&lWhy:&r A diesel drill that digs 3x3."
		"The handheld, diesel-powered drill is a big advancement in mining. With exchangeable drill heads and upgrades, its speed and other properties are almost entirely modifiable."
		"To modify it, place it in an Engineer's Workbench;start."
		"The drill runs off of Biodiesel;biodiesel and can be filled directly in the refinery, or filled at other storage such as barrels or large tanks."
	]
	quest.5F561CDE6C7EA8D3.title: "Drill Upgrades"
	quest.5F561CDE6C7EA8D3.quest_desc: [
		"&lWhy:&r Faster digging and a bigger fuel tank."
	]
	quest.3F91E8A636BF3798.title: "Buzzsaw"
	quest.3F91E8A636BF3798.quest_desc: [
		"&lWhy:&r Fells whole trees."
		"This large, portable buzzsaw is designed to make quick work of trees and other pieces of foliage that may stand in the way of a pristine factory."
		"After using the Engineer's Workbench;start to place a sawblade in it, and loading it with Biodiesel;biodiesel or another fuel, it can be used to carve through everything from small birches to large jungle trees."
		"Like many other tools, the buzzsaw can be modified in the Engineer's Workbench. These upgrades affect the size of the internal tank, the number of blades it can store, and the durability of its sawblade."
	]
	quest.4491AAC0B8111658.title: "Revolver Upgrades"
	quest.4491AAC0B8111658.quest_desc: [
		"&lWhy:&r Speedloader and extended magazine."
		"The Revolver, a more elegant weapon from a more civilized age, is an achievement of small mechanics.Small being relative here, since this weapon is chambered for 12-gauge."
		"Similar to the Mining Drill, the Revolver will allow for modification in the Engineer's Workbench, as detailed on the last pages."
		"Note that firing the revolver is quite noisy, and will attract the attention of hostile mobs in the area!"
	]
	quest.6FCEA0766DD51744.title: "Cartridges"
	quest.6FCEA0766DD51744.quest_desc: [
		"&lWhy:&r Casings from the press; AP for armored foes, buckshot for crowds."
		"Cartridges are created in the Engineer's Workbench, by the use of specific Engineer's Blueprints. Blueprints for normal ammunition you can create yourself, but some more advanced types will require you to buy adequate blueprints from other engineers."
		"Empty Casings and Shells are the basis for every projectile. Empty Casings can also be crafted in the Metal Press, using the Bullet Casing mold, which reduces the copper required. Similarly, Empty Shells can be made out of Phenolic Resin;empty_shell in a bottling machine."
		"Casull Cartridges are created with a \"Common Projectiles\" blueprint."
	]
	quest.182FE3A5B21218A3.title: "Special Cartridges"
	quest.182FE3A5B21218A3.quest_desc: [
		"&lWhy:&r Silver vs undead, dragon's breath burns, wolfpack homes."
	]
	quest.16D90D05F0680667.title: "Chemical Thrower"
	quest.16D90D05F0680667.quest_desc: [
		"&lWhy:&r Sprays any fluid: creosote burns, water puts out fires."
		"The Chemical Thrower is a device that propels fluids and optionally ignites from its internal tanks."
		"The device can be loaded with any fluid, liquid or gas, and, on right click, will spray it out."
		"To toggle the pilot light for the ignition of flammable fluids, sneak and right-click."
	]
	quest.71C74557859F7A44.title: "Railgun"
	quest.71C74557859F7A44.quest_desc: [
		"&lWhy:&r Fires steel rods; IE's strongest handheld weapon."
		"The Railgun (or more accurately the Portable Induction Catapult) is a marvel of engineering. It consists of two rails through which an electric current flows and accelerates a sled, and by that, a projectile."
		"The process is energy intensive but will accelerate various projectiles to high speeds."
		"To launch a projectile from your inventory, click and hold the use button till the charge level reaches 99, then release."
	]
	quest.1D4F54791DD7872B.title: "Powerpack"
	quest.1D4F54791DD7872B.quest_desc: [
		"&lWhy:&r Charges your railgun, drill and shield on the go."
		"Energy storage takes space and some heavyweight components. As such, storing large amounts of energy in each tool individually is inefficient and makes them awkward to wield."
		"The Accumulator Backpack acts as a compromise, offering a centralized storage of energy for any powered tools to tap into."
		"The carrying frame can be constructed with the recipe shown on the following page."
	]
	quest.32684CE8298AAFC6.title: "Turrets"
	quest.32684CE8298AAFC6.quest_desc: [
		"&lWhy:&r A gun turret for base defence. Whitelist your friends!"
		"Turrets are the next step is automated defense of your factory. They feature a complex optical system combined with an electronic \"brain\" to effectively distinguish and acquire targets and use the inbuilt weaponry to neutralize them."
		"All turrets feature energy ports at their base, and require a redstone signal to be active, although this behavior can be inverted by sneaking and rightclicking it with an Engineer's Screwdriver."
		"Upon being placed, Turrets will remember their owner and will not allow other users to break or modify them."
	]
	quest.6575193BF5DBA93C.title: "Razor Wire"
	quest.6575193BF5DBA93C.quest_desc: [
		"Razorwire is a wire with sharpened pieces of metal attached. It will slow and cut any entity that tries to move through it."
		"Razorwire can only be removed with Wirecutters, any other attempts will damage the player. Additionally, LV wires can be connected to electrify the razorwire for extra damage."
	]
	quest.66781CD614789BE2.title: "Collapsible Glider"
	quest.66781CD614789BE2.quest_desc: [
		"&lWhy:&r Elytra before the End."
		"The villagers tell stories about cities in the sky, guarded by dragons, where brave adventurers may acquire magical wings that let them glide through the air."
		"Humbug, surely - but the concept intrigues the engineer's mind. The Collapsible Glider is a device that affords just such liberties, allowing you to sail through the skies."
		"It performs the same tasks as the \"Elytra\" that the villagers spoke of, but comes with a few downsides: It has lower durability and lacks any magical potential for enchantments."
	]
	quest.0B4EE9B9D0E5C8EC.title: "Steel Cable Coil"
	quest.0B4EE9B9D0E5C8EC.quest_desc: [
		"&lWhy:&r Ride steel cables between bases."
		"The Engineer's Skyhook is a motorized grabber system designed to hook onto wires, hemp ropes or steel cables."
		"With it, engineers can quickly traverse the length of a powerline to move between substations or other sites."
		"Simply hold the right mouse button while close to a wire and you will be attached to it."
	]
	quest.5618E337E950989F.title: "Automaton Wolf"
	quest.5618E337E950989F.quest_desc: [
		"Within the Trial Chambers, you have found a slightly faded but still legible blueprint. It seems to contain instructions on how to construct a synthetic creature akin to the common wolf!"
		"This construct is loyal to the person that deploys it."
		"Being powered by a thermoelectric generator, it should never run out of energy to move itself."
	]
	quest.2275E9EDA5A1A5B7.title: "Shaders"
	quest.2275E9EDA5A1A5B7.quest_desc: [
		"&lWhy:&r Skins for guns and machines, from bags dropped by bosses."
		"Shaders are items you can find in the world or aquire by trading with villagers."
		"They don't have a purpose by themselves, but they can be equipped to Revolvers, Drills, Chemical Throwers, Heavy Plated Shields, Railguns, and Accumulator Backpacks (and possibly other things you still have to discover) to change the designs of the item."
		"Simply put the item in an Engineer's Workbench and equip the shader in the appropriate slot."
	]
	quest.640FC1D2837BE6BB.title: "Other Engineers"
	quest.640FC1D2837BE6BB.quest_desc: [
		"&lWhy:&r Engineer villagers trade blueprints, ammo and shaders."
		"Outside of the comfortable compound of any engineer are others less fortified."
		"Inside of the villages and towns of the world come a variety of inhabitants who farm and build. Among these come some engineers at the forefront of the field in their towns, pushing against the tide."
		"Common trades among those that ply designs and devices in the markets of the world are below."
	]
	quest.219A855AC1E03F0A.title: "Chief Engineer"
	quest.219A855AC1E03F0A.quest_desc: [
		"HV lines, lightning, biodiesel, turrets and a railgun."
	]
	chapter.1CB608F08E9C4FA8.title: "Storage"
	chapter.1CB608F08E9C4FA8.chapter_subtitle: [
		"AE2: from a chest to autocrafting"
	]
	quest.7CE32C7F71CB05D8.title: "A Meteorite with a Secret"
	quest.7CE32C7F71CB05D8.quest_subtitle: "Applied Energistics 2"
	quest.7CE32C7F71CB05D8.quest_desc: [
		"&lWhat:&r AE2 turns items into &ldata&r and stores thousands of stacks in small cells. Find anything from one terminal."
		"&lHow to start:&r find a fallen AE2 meteorite (a meteorite compass helps) — inside are processor presses and quartz."
		"The AE2 guide book is this quest's reward."
	]
	quest.17F6CA0CCFC34634.title: "Fluix"
	quest.17F6CA0CCFC34634.quest_subtitle: "Charged quartz + redstone + water"
	quest.17F6CA0CCFC34634.quest_desc: [
		"Drop charged quartz, redstone and quartz into water — they fuse into &lfluix&r. Cables and networks are made from it."
		"&lTip:&r the AE2 charger charges quartz with power."
	]
	quest.3A74454EECFAF6CA.title: "The Inscriber"
	quest.3A74454EECFAF6CA.quest_subtitle: "Processors"
	quest.3A74454EECFAF6CA.quest_desc: [
		"The inscriber with the meteorite presses prints circuits and assembles &lprocessors&r: logic, calculation, engineering."
	]
	quest.4886C83968921E76.title: "Your First Network"
	quest.4886C83968921E76.quest_subtitle: "Drive, terminal, cell"
	quest.4886C83968921E76.quest_desc: [
		"A drive with cells, a terminal and an energy acceptor wired together — and you have a digital warehouse."
		"Put everything into the terminal and find it by search."
	]
	quest.0B0790571127F00F.title: "The Controller"
	quest.0B0790571127F00F.quest_subtitle: "Channels and a big network"
	quest.0B0790571127F00F.quest_desc: [
		"Without a controller a network holds 8 devices. With one, hundreds. Cables carry &lchannels&r: normal 8, dense 32."
	]
	quest.6DE7C0C959612D5B.title: "Autocrafting"
	quest.6DE7C0C959612D5B.quest_subtitle: "Patterns and assemblers"
	quest.6DE7C0C959612D5B.quest_desc: [
		"Encode a recipe into a pattern, slot it into a molecular assembler next to a crafting CPU — and the network makes a hundred."
		"Patterns also drive Create, Mekanism and IE machines through an interface."
	]
	quest.595F1264AFC77E3A.title: "A Warehouse in Your Pocket"
	quest.595F1264AFC77E3A.quest_subtitle: "The wireless terminal"
	quest.595F1264AFC77E3A.quest_desc: [
		"A wireless terminal opens the network from afar. With the AE2 Wireless Terminals addon — even from another dimension."
	]
	quest.768779FCB55BCD1C.title: "Chemistry on the Network"
	quest.768779FCB55BCD1C.quest_subtitle: "Applied Mekanistics"
	quest.768779FCB55BCD1C.quest_desc: [
		"With Applied Mekanistics the network stores Mekanism &lgases and chemicals&r. Autocraft osmium, steel and fuel without running around."
	]
	quest.29A06962A5C66618.title: "Growth Accelerator"
	quest.29A06962A5C66618.quest_desc: [
		"&lWhy:&r Certus doesn't have to be mined forever: budding quartz grows crystals on its own."
		"--- navigation: parent: ae2-mechanics/ae2-mechanics-index.md title: Certus Growth icon: quartz_cluster ---"
		"Certus quartz buds will sprout from budding certus blocks, similar to amethyst. If you break a bud that is not finished growing, it will drop one certus quartz dust, unchanged by fortune. If you break a fully grown cluster, it will drop four certus quartz crystals, and fortune will increase this number."
		"There are 4 tiers of budding certus blocks: Flawless, Flawed, Chipped, and Damaged, and you initially find them in meteorites."
	]
	quest.271C176D620BFB3A.title: "Inscriber Logic Press"
	quest.271C176D620BFB3A.quest_desc: [
		"&lWhy:&r The four presses unlock every processor."
		"--- navigation: parent: items-blocks-machines/items-blocks-machines-index.md title: Presses icon: silicon_press position: 010 categories: - misc ingredients blocks item_ids: - ae2:silicon_press - ae2:logic_processor_press - ae2:calculation_processor_press - ae2:engineering_processor_press - ae2:name_press ---"
		"There are 5 different presses used in the inscriber."
		"The Silicon, Logic, Calculation, and Engineering presses are used in the production of processors. These 4 presses are obtained by breaking a mysterious cube in a meteorite. They can also be duplicated in an inscriber."
	]
	quest.1F1420D431DD22F8.title: "Logic Processor"
	quest.1F1420D431DD22F8.quest_desc: [
		"&lWhy:&r Logic, calculation and engineering processors: automate them early, you'll need hundreds."
		"--- navigation: parent: items-blocks-machines/items-blocks-machines-index.md title: Processors icon: logic_processor position: 010 categories: - misc ingredients blocks item_ids: - ae2:logic_processor - ae2:calculation_processor - ae2:engineering_processor - ae2:printed_silicon - ae2:printed_logic_processor - ae2:printed_calculation_processor - ae2:printed_engineering_processor - ae2:silicon ---"
		"Processors are one of the primary ingredients in AE2 devices and machines. They are also one of your first big automation challenges. There are three types of processor, made with gold, certus quartz crystal, and diamond respectively."
	]
	quest.7493F8085971A0E6.title: "ME Drive"
	quest.7493F8085971A0E6.quest_desc: [
		"&lWhy:&r The drive holds 10 storage cells: the network's hard disk."
		"--- navigation: parent: items-blocks-machines/items-blocks-machines-index.md title: ME Drive icon: drive position: 210 categories: - devices item_ids: - ae2:drive ---"
		"The Drive is the device you plug your storage cells into in order to use them for network storage. It has 10 slots which each accept a cell."
		"If for some reason you want to, you can push and pull the cells from its inventory with any item logistics like hoppers or ae2 busses."
	]
	quest.1FF250305243F2AD.title: "4k ME Item Storage Cell"
	quest.1FF250305243F2AD.quest_desc: [
		"&lWhy:&r A cell holds a limited number of item types (63) and bytes."
		"--- navigation: parent: items-blocks-machines/items-blocks-machines-index.md title: Storage Cells icon: item_storage_cell_1k position: 410 categories: - tools item_ids: - ae2:item_cell_housing - ae2:fluid_cell_housing - ae2:cell_component_1k - ae2:cell_component_4k - ae2:cell_component_16k - ae2:cell_component_64k - ae2:cell"
		"--- navigation: parent: ae2-mechanics/ae2-mechanics-index.md title: Bytes and Types icon: creative_storage_cell ---"
		"Storage Cells are defined by both &obytes&r and &otypes&r. Bytes, like in your actual computer, are a measure of the total amount of \"stuff\" in a storage cell. Types are a measure of how many different, well, &otypes&r of things are stored in a cell. Each type represents a unique item, so 4,096 cobblestone is 1 type but 16 different swords with different enchantments are 16 types."
		"Each storage cell can store a fixed amount of data."
	]
	quest.11197930ED7FA35F.title: "Cell Workbench"
	quest.11197930ED7FA35F.quest_desc: [
		"&lWhy:&r Set a cell's filter and add upgrade cards here."
		"--- navigation: parent: items-blocks-machines/items-blocks-machines-index.md title: Cell Workbench icon: cell_workbench position: 310 categories: - machines item_ids: - ae2:cell_workbench ---"
		"The Cell Workbench allows you to configure storage cells and view cells."
		"You can add upgrade cards and configure \"partitions\" to filter what the cell will store."
	]
	quest.494F464FD106FB9E.title: "Acceleration Card"
	quest.494F464FD106FB9E.quest_desc: [
		"&lWhy:&r Upgrade cards: speed, capacity, fuzzy, inverter."
		"--- navigation: parent: items-blocks-machines/items-blocks-machines-index.md title: Upgrade Cards icon: speed_card position: 410 categories: - tools item_ids: - ae2:basic_card - ae2:advanced_card - ae2:redstone_card - ae2:capacity_card - ae2:void_card - ae2:fuzzy_card - ae2:speed_card - ae2:inverter_card - ae2:crafting_card - ae2:equal_distribution_card - ae2:energy_card ---"
		"Upgrade cards change the behavior of AE2 devices and machines, increasing their speed, improving their filter capacity, enabling redstone control, etc."
		"Cards are crafted with either basic or advanced card bases"
	]
	quest.03CD74443853451C.title: "ME Crafting Terminal"
	quest.03CD74443853451C.quest_desc: [
		"&lWhy:&r The crafting terminal searches the whole base and crafts straight from the network."
		"--- navigation: parent: items-blocks-machines/items-blocks-machines-index.md title: Terminals icon: crafting_terminal position: 210 categories: - devices item_ids: - ae2:terminal - ae2:crafting_terminal - ae2:pattern_encoding_terminal - ae2:pattern_access_terminal ---"
		"While pattern providers, import busses, storage busses, and the et cetera are the primary method by which an AE2 network interacts with the world, Terminals are the primary method by which an AE2 network interacts with &oyou&r. There are several variants with differing functions."
		"Terminals will inherit the color of the cable they are mounted on."
	]
	quest.4299B226322341FC.title: "ME Pattern Encoding Terminal"
	quest.4299B226322341FC.quest_desc: [
		"&lWhy:&r A pattern is a recipe you write once; then the network knows how to make the item."
		"--- navigation: parent: items-blocks-machines/items-blocks-machines-index.md title: Patterns icon: crafting_pattern position: 410 categories: - tools item_ids: - ae2:blank_pattern - ae2:crafting_pattern - ae2:processing_pattern - ae2:smithing_table_pattern - ae2:stonecutting_pattern ---"
		"Patterns are made in a pattern encoding terminal out of blank patterns, and inserted in pattern providers or molecular assemblers."
		"There are several different types of pattern for different things:"
	]
	quest.2DA35D6CA4347FBE.title: "Molecular Assembler"
	quest.2DA35D6CA4347FBE.quest_desc: [
		"&lWhy:&r The molecular assembler performs crafting-table patterns next to a pattern provider."
		"--- navigation: parent: items-blocks-machines/items-blocks-machines-index.md title: Molecular Assembler icon: molecular_assembler position: 310 categories: - machines item_ids: - ae2:molecular_assembler ---"
		"The molecular assembler takes items input into it and carries out the operation defined by an adjacent pattern provider, or the inserted crafting pattern, smithing table pattern, or stonecutting pattern, then pushes the result to adjacent inventories."
		"This assembler has a crafting pattern that specifies the 1 oak log = 4 oak planks recipe."
	]
	quest.0FF5477F502C15E4.title: "Crafting Unit"
	quest.0FF5477F502C15E4.quest_desc: [
		"&lWhy:&r The crafting CPU is a multiblock that plans the chain."
		"--- navigation: parent: items-blocks-machines/items-blocks-machines-index.md title: Crafting CPU Multiblock (Storage, Coprocessor, Monitor, Unit) icon: 1k_crafting_storage position: 210 categories: - devices item_ids: - ae2:1k_crafting_storage - ae2:4k_crafting_storage - ae2:16k_crafting_storage - ae2:64k_crafting_storage - ae2:256k_crafting_storage - ae2:crafting_accelerator - ae2:crafting_monitor - ae2:crafting_unit ---"
		"Crafting CPUs manage crafting requests/jobs."
	]
	quest.040984A2E748EB52.title: "ME Interface"
	quest.040984A2E748EB52.quest_desc: [
		"&lWhy:&r The interface keeps a set stock from the network and accepts anything inserted."
		"--- navigation: parent: items-blocks-machines/items-blocks-machines-index.md title: Interface icon: interface position: 210 categories: - devices item_ids: - ae2:interface - ae2:cable_interface ---"
		"Interfaces act like a small chest and fluid tank that fills itself from and empties to network storage depending on what you set it to keep a stock of in its slots. It tries to complete this in a single gametick, so it can fill itself with or empty itself from up to 9 stacks per gametick, making it a fast method of import or export if you have fast item pipes."
	]
	quest.41F7E6DD3272D341.title: "ME Storage Bus"
	quest.41F7E6DD3272D341.quest_desc: [
		"&lWhy:&r The storage bus connects any chest, barrel or Create vault to the network."
		"--- navigation: parent: items-blocks-machines/items-blocks-machines-index.md title: ME Storage Bus icon: storage_bus position: 220 categories: - devices item_ids: - ae2:storage_bus ---"
		"Ever wanted to &okeep&r your chest monster instead of replacing it with something sensible? We present the Storage Bus!"
		"The storage bus turns the inventory it's touching into network storage. It does this by allowing the network to see the contents of that inventory, and by pushing to and pulling from that inventory in order to fulfill devices pushing to and pulling from network storage."
	]
	quest.0B198C324326DE2E.title: "ME Import Bus"
	quest.0B198C324326DE2E.quest_desc: [
		"&lWhy:&r Import pulls from machines, export pushes into them: processing lines."
		"--- navigation: parent: ae2-mechanics/ae2-mechanics-index.md title: Import, Export, and Storage ---"
		"&lyour ME system and the world&r"
		"An important concept in AE2 is the idea of Network Storage. It is the place in which the contents of a network are stored, usually storage cells or whatever inventory a storage bus is connected to. Most AE2 devices interact with it in one way or another."
	]
	quest.5E6C92E8BB0B638C.title: "ME Formation Plane"
	quest.5E6C92E8BB0B638C.quest_desc: [
		"&lWhy:&r The annihilation plane breaks blocks into the network; the formation plane places them."
		"--- navigation: parent: items-blocks-machines/items-blocks-machines-index.md title: Annihilation Plane icon: annihilation_plane position: 210 categories: - devices item_ids: - ae2:annihilation_plane ---"
		"The Annihilation Plane breaks blocks and picks up items. It works similarly to an import bus, pushing things into network storage. For items to be picked up, they must collide with the face of the plane, it does not pick up in an area."
		"Annihilation planes can be enchanted with any pickaxe enchantment, so yes, you can put crazy levels of fortune on a few and automate ore processing if your modpack allows it."
	]
	quest.3EA0814B8D511AFD.title: "ME IO Port"
	quest.3EA0814B8D511AFD.quest_desc: [
		"&lWhy:&r Moves cell contents into the network and back."
		"--- navigation: parent: items-blocks-machines/items-blocks-machines-index.md title: ME IO Port icon: io_port position: 210 categories: - devices item_ids: - ae2:io_port ---"
		"The IO Port allows you to rapidly fill or empty storage cells to or from network storage."
		"It can be rotated with a certus quartz wrench."
	]
	quest.3BAF7ADE145A5297.title: "Channels"
	quest.3BAF7ADE145A5297.quest_desc: [
		"&lWhy:&r Channels are unlimited in Arkhaven, but it's worth knowing how they normally work."
		"--- navigation: parent: ae2-mechanics/ae2-mechanics-index.md title: Channels icon: controller ---"
		"Applied Energistics 2's ME Networks require Channels to support devices which use networked storage, or other network services. Think of channels like USB cables to all your devices. A computer only has so many USB ports and can only support so many devices connected to it. Most machines, full-block devices, and standard cables can only pass through up to 8 channels. You can think of full-block devices and standard cables as a bundle of 8 \"channel wires\". However, dense cables can support up to 32 channels."
	]
	quest.724D2A0EF7D18896.title: "Quartz Fiber"
	quest.724D2A0EF7D18896.quest_desc: [
		"&lWhy:&r A subnetwork keeps farms separate from the main network."
		"--- navigation: parent: ae2-mechanics/ae2-mechanics-index.md title: Subnetworks ---"
		"Item Pipe Subnet"
		"Fluid Pipe Subnet"
	]
	quest.0288370B301E6D74.title: "Energy Acceptor"
	quest.0288370B301E6D74.quest_desc: [
		"&lWhy:&r The energy acceptor takes FE; energy cells smooth out peaks."
		"--- navigation: parent: ae2-mechanics/ae2-mechanics-index.md title: Energy icon: energy_cell ---"
		"Your network will require energy to run. Networks have a pool of energy that devices directly pull from, and vibration chambers, energy acceptors (and controllers) add to. You can see the energy statistics for a network by right-clicking anywhere on it with a network tool or by right-clicking the network's controller, if it has one."
	]
	quest.7813E866A41FE514.title: "Vibration Chamber"
	quest.7813E866A41FE514.quest_desc: [
		"&lWhy:&r Burns fuel to power the network before you have generators."
		"--- navigation: parent: items-blocks-machines/items-blocks-machines-index.md title: Vibration Chamber icon: vibration_chamber position: 110 categories: - network infrastructure item_ids: - ae2:vibration_chamber ---"
		"While the primary intended method of providing energy to your network is an energy acceptor, the vibration chamber can directly generate small to middling amounts of AE."
		"By default (no upgrades and default configs) it makes 40 AE/t."
	]
	quest.374F3B1674E00EBA.title: "ME Wireless Access Point"
	quest.374F3B1674E00EBA.quest_desc: [
		"&lWhy:&r The access point is the router for wireless terminals."
		"--- navigation: parent: items-blocks-machines/items-blocks-machines-index.md title: Wireless Access Point icon: wireless_access_point position: 210 categories: - devices item_ids: - ae2:wireless_booster - ae2:wireless_access_point ---"
		"Allows wireless access via a wireless terminal. Range and power usage is determined based on the number of wireless booster installed."
		"A network can have any number of wireless access points with any number of wireless booster in each one, allowing you to optimize power usage and range by altering your setup."
	]
	quest.268FCB5DE77484F6.title: "ME Quantum Ring"
	quest.268FCB5DE77484F6.quest_desc: [
		"&lWhy:&r The quantum bridge links two networks at any distance, even across dimensions."
		"--- navigation: parent: items-blocks-machines/items-blocks-machines-index.md title: Quantum Bridge icon: quantum_ring position: 110 categories: - network infrastructure item_ids: - ae2:quantum_link - ae2:quantum_ring ---"
		"Quantum Network Bridges can extend a network over infinite distances and even between dimensions. They can carry 32 channels in total (regardless of how cables are connected to each face), essentially acting like a wireless dense cable."
		"An imaginary cable between the two endpoints"
	]
	quest.5D20B3A04975D7B8.title: "Spatial IO Port"
	quest.5D20B3A04975D7B8.quest_desc: [
		"&lWhy:&r Spatial IO cuts a piece of the world into a cell and puts it back elsewhere: move a whole base."
		"--- navigation: parent: ae2-mechanics/ae2-mechanics-index.md title: Spatial IO icon: spatial_storage_cell_2 ---"
		"The volume to be moved"
		"Spatial IO is a way to cut-and-paste physical volumes of space in your world. It can be used to move flawless budding quartz, have a room in your base where you can swap out various interiors to use it for different purposes, or even move the end portal!"
	]
	quest.0E385B3940A59AA8.title: "Matter Condenser"
	quest.0E385B3940A59AA8.quest_desc: [
		"&lWhy:&r The condenser destroys junk into matter balls and singularities."
		"--- navigation: parent: items-blocks-machines/items-blocks-machines-index.md title: Matter Condenser icon: condenser position: 310 categories: - machines item_ids: - ae2:condenser ---"
		"The matter condenser can be used as either a trash can or to create matter balls and singularities. It can take any item or fluid or etc. a storage cell can store."
		"* In trash can mode, the matter condenser just voids everything that enters it * In matter ball mode the condenser makes matter balls out of whatever you put in it. This mode requires that you put a storage component in the top slot of the condenser."
	]
	quest.1A3571D8433E2691.title: "Singularity"
	quest.1A3571D8433E2691.quest_desc: [
		"&lWhy:&r A singularity + ender dust makes the entangled singularities for the quantum bridge."
		"--- navigation: parent: items-blocks-machines/items-blocks-machines-index.md title: Singularities icon: singularity position: 010 categories: - misc ingredients blocks item_ids: - ae2:singularity - ae2:quantum_entangled_singularity ---"
		"A very compact ball of matter."
		"Made with 256,000 items or buckets in a condenser in singularity mode."
	]
	quest.49C287CE796A9FB6.title: "Fluix Pickaxe"
	quest.49C287CE796A9FB6.quest_desc: [
		"&lWhy:&r Fluix tools are a bit better than iron."
		"--- navigation: parent: items-blocks-machines/items-blocks-machines-index.md title: Fluix Tools icon: fluix_pickaxe position: 410 categories: - tools item_ids: - ae2:fluix_axe - ae2:fluix_hoe - ae2:fluix_shovel - ae2:fluix_pickaxe - ae2:fluix_sword ---"
		"Fluix tools are similar to iron tools, having 3x the durability and a slightly higher attack damage and mining speed."
		"All fluix tools act as if they have at least fortune/looting 1, which is useful before getting access to an enchanting table."
	]
	quest.269590655BC4AC7F.title: "Entropy Manipulator"
	quest.269590655BC4AC7F.quest_desc: [
		"&lWhy:&r Heats or cools blocks: smelts ore in place, freezes water."
		"--- navigation: parent: items-blocks-machines/items-blocks-machines-index.md title: Entropy Manipulator icon: entropy_manipulator position: 410 categories: - tools item_ids: - ae2:entropy_manipulator ---"
		"The Entropy Manipulator allows you to heat and cool things by right-clicking and shift-right-clicking respectively. It can't do much, just things like evaporating or freezing water, solidifying lava to obsidian, smelting logs to charcoal, and smelting cobble to stone in-world."
		"If there is not a specific thing it can do to a block, it will act as a flint-and-steel."
	]
	quest.045D42BC6E8FA95A.title: "Matter Cannon"
	quest.045D42BC6E8FA95A.quest_desc: [
		"&lWhy:&r A gun that fires matter balls or metal nuggets."
		"--- navigation: parent: items-blocks-machines/items-blocks-machines-index.md title: Matter Cannon icon: matter_cannon position: 410 categories: - tools item_ids: - ae2:matter_cannon ---"
		"The matter cannon is a portable railgun that can fire small items as projectiles, like matter balls and metal nuggets. The damage depends on the item being fired, with \"heavier\" items like gold nuggets (10 damage) doing more damage than light items like matter balls (2 damage). It consumes a base energy of 1600 AE per shot."
	]
	quest.70280A04D1F446B1.title: "Network Tool"
	quest.70280A04D1F446B1.quest_desc: [
		"&lWhy:&r The network tool diagnoses; the memory card copies settings between devices."
		"--- navigation: parent: items-blocks-machines/items-blocks-machines-index.md title: Network Tool icon: network_tool position: 410 categories: - tools item_ids: - ae2:network_tool ---"
		"The Network Tool is a modified wrench that also shows network diagnostic information and can store upgrade cards. While it retains the wrench's ability to quickly disassemble things and pull subparts off of a cable, it cannot rotate things."
		"It has 9 slots in which to store upgrade cards, and they will be available in any AE2 device UI if the tool is anywhere in your inventory."
	]
	quest.1B1D42A792FEEC99.title: "ME Toggle Bus"
	quest.1B1D42A792FEEC99.quest_desc: [
		"&lWhy:&r Switches part of the network with redstone, e.g. a farm when stock is full."
		"--- navigation: parent: items-blocks-machines/items-blocks-machines-index.md title: Toggle Bus icon: toggle_bus position: 110 categories: - network infrastructure item_ids: - ae2:toggle_bus - ae2:inverted_toggle_bus ---"
		"A bus which functions similarly to fluix glass cable or other cables, but it allows its connection state to be toggled via redstone. This allows you to cut off a section of a ME Network."
		"When redstone signal supplied the part enables the connection, inverted toggle bus provides the reverse behavior by disabling the connection instead."
	]
	quest.128F2E6930ACBDB3.title: "View Cell"
	quest.128F2E6930ACBDB3.quest_desc: [
		"&lWhy:&r A terminal filter: show only ore, only food."
		"--- navigation: parent: items-blocks-machines/items-blocks-machines-index.md title: View Cell icon: view_cell position: 410 categories: - tools item_ids: - ae2:view_cell ---"
		"View Cells are used to filter the display of terminals. You partition them in a cell workbench."
		"For example, say you want a terminal to only display a selection of stone building materials. Partition the view cell to those materials and place it in a terminal, and only those items will be shown."
	]
	quest.4432EC872881230D.title: "Facades"
	quest.4432EC872881230D.quest_desc: [
		"&lWhy:&r A facade hides a cable as any block."
		"--- navigation: parent: items-blocks-machines/items-blocks-machines-index.md title: Facades icon: facade icon_components: \"ae2:facade_item\": \"minecraft:stone\" position: 110 categories: - network infrastructure item_ids: - ae2:facade ---"
		"Facades can be used to make your base appear more clean. They can cover up both sizes of cable, and be made out of many kinds of blocks."
		"They can cover all sides of a cable, but will let subparts and cable connections protrude though."
	]
	quest.73458882DFB6CE71.title: "ME Storage Monitor"
	quest.73458882DFB6CE71.quest_desc: [
		"&lWhy:&r A storage monitor shows a chosen item's count; the conversion monitor also hands it out."
		"--- navigation: parent: items-blocks-machines/items-blocks-machines-index.md title: Monitors icon: storage_monitor position: 210 categories: - devices item_ids: - ae2:storage_monitor - ae2:conversion_monitor ---"
		"Monitors allow visualization and interaction with a single item or fluid type, without opening a GUI."
		"Monitors will inherit the color of the cable they are mounted on."
	]
	quest.313F20F0F2B83E4B.title: "ME Chest"
	quest.313F20F0F2B83E4B.quest_desc: [
		"&lWhy:&r The ME chest: one cell in a block, a small storage without a network."
		"--- navigation: parent: items-blocks-machines/items-blocks-machines-index.md title: ME Chest icon: chest position: 210 categories: - devices item_ids: - ae2:chest ---"
		"The ME Chest acts like a miniature network with a terminal, drive, and energy acceptor. While it can be used as a tiny storage network, its capacity for just one single storage cell means it has limited utility as such."
		"Instead, it is useful for interacting with specifically the storage cell mounted inside it."
	]
	quest.3B8BB67D88DE00FE.title: "Network Engineer"
	quest.3B8BB67D88DE00FE.quest_desc: [
		"You've mastered AE2 from quartz farms to moving bases."
	]
	quest.36C60720F4EA9E96.title: "The Meteorite Compass"
	quest.36C60720F4EA9E96.quest_desc: [
		"The compass points to the nearest AE2 meteorite. Inside are the processor presses. AE2 can't start without them."
	]
	quest.653961AE9D19159C.title: "The Charger"
	quest.653961AE9D19159C.quest_desc: [
		"Charges quartz with energy. Charged quartz is needed for fluix."
	]
	quest.48D500566B41A653.title: "Smart Cable"
	quest.48D500566B41A653.quest_desc: [
		"Smart cable shows used channels with lights. You can see at a glance where the network is full."
	]
	quest.7717FF8FC0B79B80.title: "Network Power"
	quest.7717FF8FC0B79B80.quest_desc: [
		"An energy cell stores AE2 network power — handy during outages."
	]
	quest.75C0981B7AE66C1D.title: "Buses"
	quest.75C0981B7AE66C1D.quest_desc: [
		"Import pulls from machines into the network, export pushes out, a storage bus plugs ordinary chests into the network."
	]
	quest.03E39F53E8961A2C.title: "The Level Emitter"
	quest.03E39F53E8961A2C.quest_desc: [
		"Signals when an item falls below a set amount — the way to run farms and machines on demand."
	]
	quest.131997C73B90D11E.title: "A 64k Cell"
	quest.131997C73B90D11E.quest_desc: [
		"Cells grow: 1k, 4k, 16k, 64k, 256k. The MEGA Cells addon goes even bigger."
	]
	quest.612AB2506CB12DF7.title: "The Pattern Provider"
	quest.612AB2506CB12DF7.quest_desc: [
		"A provider sends ingredients into any machine — Create crusher, Mekanism enricher, furnace — and waits for the result."
	]
	quest.00AEBF840B10042D.title: "Crafting Accelerators"
	quest.00AEBF840B10042D.quest_desc: [
		"Accelerators let the crafting CPU run many steps in parallel."
	]
	quest.2455CEB25DAAB7EF.title: "P2P Tunnels"
	quest.2455CEB25DAAB7EF.quest_desc: [
		"A tunnel carries channels, energy or fluids through one cable. Magic for a tidy base."
	]
	quest.6C6304EB044AF2D3.title: "MEGA Cells"
	quest.6C6304EB044AF2D3.quest_desc: [
		"MEGA cell housings store millions of items. The end of storage problems."
	]
	quest.1D7B9B84D2EEFDDE.title: "The Extended Provider"
	quest.1D7B9B84D2EEFDDE.quest_desc: [
		"ExtendedAE: a provider with 36 patterns. For huge factories."
	]
	quest.4441866ED74046FB.title: "Universal Terminal"
	quest.4441866ED74046FB.quest_subtitle: "AE2 Wireless Terminals"
	quest.4441866ED74046FB.quest_desc: [
		"&lWhy:&r one terminal instead of three wireless ones (items, crafting, patterns). Switch with the mouse wheel."
		"&lHow:&r craft the universal terminal and combine the others into it at a crafting table."
	]
	quest.143D342AC339D4C8.title: "Magnet Card"
	quest.143D342AC339D4C8.quest_subtitle: "Loot straight into the network"
	quest.143D342AC339D4C8.quest_desc: [
		"The card in your terminal pulls nearby items in and can send them straight into the ME network. Miners never walk home to unload again."
	]
	quest.2834497140F06F0A.title: "Quantum Bridge Card"
	quest.2834497140F06F0A.quest_subtitle: "A terminal without limits"
	quest.2834497140F06F0A.quest_desc: [
		"Links the terminal to your network through a quantum bridge: access your base from anywhere, even other dimensions."
	]
	quest.7957233924B56D96.title: "Extended Drive"
	quest.7957233924B56D96.quest_subtitle: "ExtendedAE"
	quest.7957233924B56D96.quest_desc: [
		"Holds twice as many cells as a normal ME drive. Fewer blocks, a more compact server room."
	]
	quest.69B1C9286584E909.title: "Assembler Matrix"
	quest.69B1C9286584E909.quest_subtitle: "Hundreds of crafts at once"
	quest.69B1C9286584E909.quest_desc: [
		"A multiblock matrix replaces a wall of molecular assemblers. Autocrafting thousands of items stops lagging."
	]
	quest.75C66A8AEA94F189.title: "Infinite Water"
	quest.75C66A8AEA94F189.quest_subtitle: "A source cell"
	quest.75C66A8AEA94F189.quest_desc: [
		"A cell whose water never runs out. For autocrafting that needs water: concrete, clay, farms."
	]
	quest.3DFC5F9E59155713.title: "MEGA Crafting CPU"
	quest.3DFC5F9E59155713.quest_subtitle: "MEGA Cells"
	quest.3DFC5F9E59155713.quest_desc: [
		"1M–256M crafting storage and mega accelerators: a crafting CPU that handles a whole reactor in one order."
	]
	quest.38B7049903894594.title: "Bulk Cell"
	quest.38B7049903894594.quest_subtitle: "One item, no limit"
	quest.38B7049903894594.quest_desc: [
		"Stores &lone&r item type in nearly unlimited amounts. Perfect for cobblestone, dirt and farm ore."
	]
	quest.20FE08C0C7302ACA.title: "Chemicals in the Network"
	quest.20FE08C0C7302ACA.quest_subtitle: "Applied Mekanistics"
	quest.20FE08C0C7302ACA.quest_desc: [
		"Mekanism gases and chemicals (hydrogen, oxygen, chlorine) are stored in AE2 like items. No more mazes of tanks and pipes."
	]
	quest.4EDD0BB5CDE3E9DF.title: "Data Architect"
	quest.4EDD0BB5CDE3E9DF.quest_subtitle: "The whole base in one terminal"
	quest.4EDD0BB5CDE3E9DF.quest_desc: [
		"Your network knows everything, crafts everything and reaches everywhere. Connect neighbours through a shared interface so the server trades through your network."
	]
	chapter.40872413A59558AE.title: "Ars Nouveau"
	chapter.40872413A59558AE.chapter_subtitle: [
		"Magic you build yourself"
	]
	quest.653C10B3F4E99952.title: "The Novice Spellbook"
	quest.653C10B3F4E99952.quest_subtitle: "Spells made of glyphs"
	quest.653C10B3F4E99952.quest_desc: [
		"&lWhat:&r in Ars Nouveau you &lbuild&r spells from glyphs: a form (projectile, touch, self) + effects."
		"\"Projectile + Break\" mines from afar. \"Self + Heal\" heals. Thousands of combinations."
		"The mod's guide is the &lWorn Notebook&r — you get one on first join."
	]
	quest.22E3A91D0CD8AF70.title: "Source Gems"
	quest.22E3A91D0CD8AF70.quest_subtitle: "Amethyst + lapis"
	quest.22E3A91D0CD8AF70.quest_desc: [
		"Source gems come from amethyst and lapis in an &limbuement chamber&r, or crafted early on."
		"Source is the fuel for all Ars magic."
	]
	quest.2EA1CE047C193DCE.title: "The Scribe's Table"
	quest.2EA1CE047C193DCE.quest_subtitle: "Learning new glyphs"
	quest.2EA1CE047C193DCE.quest_desc: [
		"At the scribe's table you write glyphs into your book. Each new glyph opens new tricks."
		"&lTip:&r grab Projectile, Break, Light and Leap first — life gets easier."
	]
	quest.5664F89936D9EBEF.title: "The Source Jar"
	quest.5664F89936D9EBEF.quest_subtitle: "Storage for magical energy"
	quest.5664F89936D9EBEF.quest_desc: [
		"Jars store Source. &lSourcelinks&r fill them — blocks that turn various activities into Source."
	]
	quest.7055B3AF6E8AB129.title: "Magic from Food"
	quest.7055B3AF6E8AB129.quest_subtitle: "The mycelial sourcelink"
	quest.7055B3AF6E8AB129.quest_desc: [
		"The &lmycelial sourcelink&r turns &lfood&r into Source. The more filling the dish, the more magic."
		"&lWho helps:&r this is where the mage and the cook become best friends. Ask the tavern for feast leftovers."
	]
	quest.285AF3BB0E17A1D1.title: "Garden Magic"
	quest.285AF3BB0E17A1D1.quest_subtitle: "The agronomic sourcelink"
	quest.285AF3BB0E17A1D1.quest_desc: [
		"Plants growing near an agronomic sourcelink produce Source. Place it by the gardener's beds."
	]
	quest.339F37A57CCF42F6.title: "The Enchanting Apparatus"
	quest.339F37A57CCF42F6.quest_subtitle: "Ritual crafting"
	quest.339F37A57CCF42F6.quest_desc: [
		"The apparatus on an arcane core, surrounded by pedestals, assembles complex magic items: rings, belts, the apprentice book."
	]
	quest.728DE8639046E9C8.title: "The Apprentice"
	quest.728DE8639046E9C8.quest_subtitle: "More mana, stronger spells"
	quest.728DE8639046E9C8.quest_desc: [
		"The apprentice book unlocks tier-two glyphs and more slots. Next comes the archmage book."
	]
	quest.5005922F7F263D60.title: "The Starbuncle Courier"
	quest.5005922F7F263D60.quest_subtitle: "Magical logistics"
	quest.5005922F7F263D60.quest_desc: [
		"A starbuncle moves items from chest to chest. Cute, quiet, cable-free."
		"There are other helpers too: wixies craft, drygmies collect mob drops, whirlisprigs speed up growth."
	]
	quest.07D1DF3649F23B99.title: "The Ritual of Flight"
	quest.07D1DF3649F23B99.quest_subtitle: "Fly near the brazier"
	quest.07D1DF3649F23B99.quest_desc: [
		"The flight ritual on a brazier grants flight to everyone nearby. Priceless for building tall towers."
		"&lValued by:&r builders and airship engineers."
	]
	quest.091A81DFA2C750F9.title: "Portals"
	quest.091A81DFA2C750F9.quest_subtitle: "The stable warp scroll"
	quest.091A81DFA2C750F9.quest_desc: [
		"Bind a scroll to a place and it opens a portal there. Scrolls make permanent portals between bases."
	]
	quest.74DB104AC5A8EE45.title: "Magic and Cogs"
	quest.74DB104AC5A8EE45.quest_subtitle: "Ars Creo"
	quest.74DB104AC5A8EE45.quest_desc: [
		"With Ars Creo starbuncles turn Create wheels and spells work inside contraptions."
		"It's a bridge between the mage's tower and the engineer's workshop. Build something together!"
	]
	quest.677C27BAE7F82E5C.title: "The Dowsing Rod"
	quest.677C27BAE7F82E5C.quest_desc: [
		"The rod highlights nearby Source blocks — helps find where to put sourcelinks."
	]
	quest.6B1AE1B499DAEBEF.title: "Magebloom"
	quest.6B1AE1B499DAEBEF.quest_desc: [
		"Magebloom grows like an ordinary crop. Its fibre makes mage robes. A gardener can grow it for you."
	]
	quest.2B62BAEEEC251847.title: "The Four Elements"
	quest.2B62BAEEEC251847.quest_desc: [
		"Fire, water, earth and air essences come from the imbuement chamber. They go into glyphs and gear."
	]
	quest.641B4C6B4F82C9E9.title: "The Imbuement Chamber"
	quest.641B4C6B4F82C9E9.quest_desc: [
		"The chamber infuses items with Source: lapis → source gem, amethyst → ward crystal."
		"It also makes &llevitite&r for engineers!"
	]
	quest.03B748F649B91F40.title: "The Volcanic Sourcelink"
	quest.03B748F649B91F40.quest_desc: [
		"Source from burning fuel and nearby lava."
	]
	quest.58097CE85FFDA488.title: "The Vitalic Sourcelink"
	quest.58097CE85FFDA488.quest_desc: [
		"Source from animals being born nearby. Place it by the breeder's pens and magic flows."
	]
	quest.0FD04222AFCD4D58.title: "The Alchemical Sourcelink"
	quest.0FD04222AFCD4D58.quest_desc: [
		"Source from potions. The alchemist gives spare potions, the mage gets mana."
	]
	quest.7228CAAC64556133.title: "The Relay"
	quest.7228CAAC64556133.quest_desc: [
		"Moves Source between jars at a distance. Magical wiring."
	]
	quest.6E24501F5DDB485C.title: "Archmage"
	quest.6E24501F5DDB485C.quest_desc: [
		"The archmage book unlocks tier-three glyphs and maximum mana. The peak of Ars Nouveau."
	]
	quest.658707DB87E893AB.title: "The Wixie"
	quest.658707DB87E893AB.quest_desc: [
		"A wixie crafts items and potions from a sample. A little alchemist on call."
	]
	quest.6B966748AE6AB149.title: "The Drygmy"
	quest.6B966748AE6AB149.quest_desc: [
		"A drygmy collects mob drops from a pen without killing. A peaceful resource farm."
	]
	quest.12E80AFF249EC3C8.title: "The Whirlisprig"
	quest.12E80AFF249EC3C8.quest_desc: [
		"Speeds up plant growth around it and makes Source. The gardener's best friend."
	]
	quest.0CD69A9B09F54808.title: "Magical Jewellery"
	quest.0CD69A9B09F54808.quest_desc: [
		"Rings and amulets raise your mana pool and lower spell costs."
	]
	quest.09E9C69607F1C726.title: "The Belt of Levitation"
	quest.09E9C69607F1C726.quest_desc: [
		"Crouch in mid-air and you hover. Tower builders will love it."
	]
	quest.75F214C699D14F96.title: "The Wilden"
	quest.75F214C699D14F96.quest_desc: [
		"Horn, spike and wing of Ars wilden creatures — for the ritual that summons the Wilden Chimera. The mage's boss."
	]
	quest.26441D1B5F1BFDE4.title: "An Elemental Focus"
	quest.26441D1B5F1BFDE4.quest_desc: [
		"Ars Elemental: a school focus empowers spells of one element. Pick yours."
	]
	quest.4E176049191FFEEA.title: "How Spellcasting Works"
	quest.4E176049191FFEEA.quest_subtitle: "C to craft, X to switch, right click to cast"
	quest.4E176049191FFEEA.quest_desc: [
		"&lWhy:&r A spell = a form + effects + augments. Open the book with C and build your first: Projectile + Break."
		"Ars Nouveau grants aspiring wizards the ability to craft powerful spells. Through creative spellcrafting, you can vanquish foes, reshape the world, automate tasks, create spectacles, and so much more!"
		"To begin spellcasting, you will need to craft a Novice’s Spell Book which will allow you to create, store, and cast spells using Mana."
		"Upgrading your Spell Book, learning new Glyphs, and crafting magical equipment will further enhance your ability to cast new and more powerful spells."
	]
	quest.42E6307F696C36A1.title: "Sourceberry"
	quest.42E6307F696C36A1.quest_desc: [
		"&lWhy:&r Sourceberries are the first cure for low mana and the base of mana regeneration potions."
		"A Sourceberry Bush can be found in Taiga and Archwood Forest biomes, and produces Sourceberries. A Sourceberry can be used to craft a Potion of Mana Regeneration or consumed as food. Starbuncles will automatically harvest fully grown Source Berry Bushes, making them useful for early automation of the Agronomic Sourcelink. Sourceberry foods will also grant Mana Regeneration."
	]
	quest.13E932A95A85C46D.title: "Archwood"
	quest.13E932A95A85C46D.quest_desc: [
		"&lWhy:&r The magic tree: almost every Ars device is built from it, and its fruits are special resources."
		"Archwood Trees have a small chance to spawn in any biome, and come in four types. Rarely, you may stumble upon an Archwood Forest, a biome full of magical creatures, naturally spawning lights, and Archwood trees. Can be used as decoration, rituals, or for crafting wands. Archwood Trees also have a chance to spawn magical fruits that can be consumed or brewed into potions."
	]
	quest.70EE5377275D6AD4.title: "New Glyphs"
	quest.70EE5377275D6AD4.quest_desc: [
		"&lWhy:&r Glyphs are the words of spells. Every new glyph unlocks a new effect or augment."
		"New Glyphs may be created through the Scribe’s Table from certain items and paying EXP. Once crafted, the Glyph can be consumed to learn it, making it available during spellcrafting."
		"Players can share their current Glyph knowledge with each other by crafting an Annotated Codex."
	]
	quest.1920413ABE5E39A6.title: "Source Relay: Splitter"
	quest.1920413ABE5E39A6.quest_desc: [
		"&lWhy:&r Splits the Source flow across several devices: without it a big workshop starves."
		"Operates similar to the Source Relay, but will support taking from and transferring to multiple jars at once. The splitter has a much larger through-put than the Source Relay, and will split this throughput amongst all of its jars. See the instructions on the Source Relay for use."
	]
	quest.4FDB9D9557C77EE0.title: "Source Relay: Warper"
	quest.4FDB9D9557C77EE0.quest_desc: [
		"&lWhy:&r Sends Source over long distances without a chain of relays."
		"Operates similar to the Source Relay: Splitter but can teleport source an endless distance between other Warp relays. For distances beyond 30 blocks, there is a chance that some source will be lost during warp."
	]
	quest.045E4DF07ADA97A8.title: "Five Sourcelinks"
	quest.045E4DF07ADA97A8.quest_desc: [
		"&lWhy:&r Each sourcelink feeds on something: plant growth, fire, mushrooms, mob deaths, potions. Build all five and Source never runs out."
		"Source is a magical resource used for many purposes such as speeding up the Imbuement Chamber, fueling devices, powering magical helpers, creating portals, or fueling powerful Enchanting Apparatus recipes."
		"Sourcelinks are specialized artifacts that can collect and concentrate Source from the world into Source Jars. Source Relays can be used to transfer Source over large distances between jars."
		"The Agronomic and Mycelial Sourcelinks are good early options for building up your Source supply."
	]
	quest.1D1D4E99997FB1CE.title: "Arcane Pedestal"
	quest.1D1D4E99997FB1CE.quest_desc: [
		"&lWhy:&r Pedestals around the Imbuement Chamber and the Enchanting Apparatus are the crafting table of magic."
		"The Imbuement Chamber allows the conversion of Amethyst Shards or Lapis Lazuli into Source Gems. By placing three Arcane Pedestals bearing certain items adjacent to the chamber, Source Gems can be imbued further into Essences which are used in many Glyph recipes."
		"Placing an Enchanting Apparatus on top of an Arcane Core allows the crafting of essentials such as Magebloom Seeds, magical equipment, and charms to summon magical helpers. It can also directly enchant your gear with enchantments of your choice."
		"The Alteration Table allows for slotting in various Threads into magical armor that grant special properties while worn."
	]
	quest.206EE22AAE892841.title: "Enchanting Without the Lottery"
	quest.206EE22AAE892841.quest_desc: [
		"&lWhy:&r The Apparatus applies the enchantment you choose and raises its level: no enchanting-table randomness."
		"The Enchanting Apparatus may add new enchantments or upgrade existing ones by using Source and items. To begin, select a level 1 enchantment and add its items to the pedestals. Place a jar of Source nearby, and use the item you want to enchant on the apparatus. The apparatus may only apply enchantments that are valid to the item you have given it."
	]
	quest.2A1975EFA7DC9A10.title: "Reactive Enchantment"
	quest.2A1975EFA7DC9A10.quest_desc: [
		"&lWhy:&r A weapon that casts a spell when it hits: a sword that ignites and knocks enemies back."
		"Items with Reactive have a chance to cast spells when swung. The spell on the Spell Parchment determines the spell that will be inscribed on the item."
	]
	quest.6448B9F48E0F9798.title: "Basic Spell Turret"
	quest.6448B9F48E0F9798.quest_desc: [
		"&lWhy:&r A turret casts a spell on a redstone signal: magic for automation: break, plant, ignite."
		"Turrets can be used to cast spells when given a redstone signal, functioning like a dispenser. Turrets will accept spells that use Touch and Projectile. Spells may be set using an inscribed piece of Spell Parchment. To cast spells, turrets will draw source from linked or nearby Source Jars. Turrets may use Item Pickup and Place Block as long as an inventory is placed adjacent to this block."
	]
	quest.752430A21D3E840F.title: "Adjustable Spell Turret"
	quest.752430A21D3E840F.quest_desc: [
		"&lWhy:&r An aimable turret, for farms and base defence."
		"Turrets can be used to cast spells when given a redstone signal, functioning like a dispenser. Turrets will accept spells that use Touch and Projectile. Spells may be set using an inscribed piece of Spell Parchment. To cast spells, turrets will draw source from linked or nearby Source Jars. Turrets may use Item Pickup and Place Block as long as an inventory is placed adjacent to this block."
	]
	quest.2B34CDFC8809AFAA.title: "Spell Prism"
	quest.2B34CDFC8809AFAA.quest_desc: [
		"&lWhy:&r The prism redirects flying spell projectiles: for clever farms and traps."
		"When a projectile spell hits this block, it is redirected the direction the block is facing. Spell Prisms will send a signal to nearby Observers if a spell is redirected."
	]
	quest.104996AFE6559440.title: "Enchanter's Sword"
	quest.104996AFE6559440.quest_desc: [
		"&lWhy:&r A sword with a spell inscribed: every hit casts it."
		"Applies a Touch spell before damaging an entity. Additionally, all spells gain Spell Damage. Apply a spell at the Scribes Table that does NOT contain a form, such as Ignite -> Extend Time."
	]
	quest.75B39896169E71E9.title: "Enchanter's Shield"
	quest.75B39896169E71E9.quest_desc: [
		"&lWhy:&r A shield that restores mana and speeds its regeneration while you block."
		"Upon blocking damage, the user will gain a short duration of Mana Regeneration and Spell Damage. Additionally, this shield will repair over time using the wearers mana."
	]
	quest.53F653AE1FF03B77.title: "Enchanter's Mirror"
	quest.53F653AE1FF03B77.quest_desc: [
		"&lWhy:&r A self-cast spell without the book in hand: healing or flight on one button."
		"Applies a self spell to the user. Spells cast with this mirror are discounted and gain additional bonus duration to all glyphs. Apply a spell at the Scribe's table that DOES NOT contain a form such as Heal -> Amplify."
	]
	quest.3C6D96AB50637D7A.title: "Enchanter's Bow"
	quest.3C6D96AB50637D7A.quest_desc: [
		"&lWhy:&r Arrows become spell projectiles. Works with augmented arrows: Pierce, Split, Amplify."
		"A bow that can be inscribed with a spell using the Scribes Table. If the player has enough mana, arrows will become Spell Arrows and will apply the spell on their target. If no arrows are in the inventory, a spell arrow that deals 0 damage will be cast. If there is not enough mana, regular arrows will be fired. Enchanter's Bows may use special Augment Arrows for empowering the inscribed spell."
	]
	quest.037246CB240983F6.title: "Enchanter's Crossbow"
	quest.037246CB240983F6.quest_desc: [
		"A crossbow that can be inscribed with a spell. The mana cost of the spell will be deducted when the bow is loaded if mana is present. Enchanter's Crossbows may use special augment arrows to empower their spells."
	]
	quest.172486C0A007A2F5.title: "Enchanter's Gauntlet"
	quest.172486C0A007A2F5.quest_desc: [
		"&lWhy:&r A multi-tool gauntlet: digs at diamond hardness and casts its inscribed spell."
		"Gauntlets are a spell casting multi-tool that can break blocks at diamond hardness. Gauntlets accept a single spell and are inscribed using the Scribes Table. Gauntlets always start with Touch and MUST be inscribed with a spell that does not contain a form. Spells cast with the gauntlet are cast with a discount."
	]
	quest.21A3B8E069D5C396.title: "Enchanter's Fishing Rod"
	quest.21A3B8E069D5C396.quest_desc: [
		"&lWhy:&r A fishing rod with an inscribed spell that fires on the catch."
		"Fishing Rods accept a single spell and are inscribed using the Scribes Table. Rods always start with Touch and MUST be inscribed with a spell that does not contain a form. Fishing Rods can be used like a normal fishing rod, but hooking an entity will allow the user to cast the spell on the hooked entity until the line is broken."
	]
	quest.29EB7A6F200629F9.title: "Potion Flask"
	quest.29EB7A6F200629F9.quest_desc: [
		"&lWhy:&r Eight drinks of a potion in one flask: less inventory space."
		"A flask that stores 8 charges of a potion. To fill the flask, use the flask on a Potion Jar, or craft the flask in a Crafting Table with another potion. You may empty the flask by using the flask on a Potion Jar while sneaking."
	]
	quest.154416231C2F76E8.title: "Splash Flask Cannon"
	quest.154416231C2F76E8.quest_desc: [
		"&lWhy:&r Fires potions from your flasks: heal the team from afar or poison enemies."
		"Flask Cannons can consume potions from bottles and flasks from the players inventory and convert the potion into a Splash or Lingering potion. To select the potion to be thrown, use the Radial Menu to select your flask or potion and use the launcher."
	]
	quest.6E59CE5F5C83E272.title: "Potion Jar"
	quest.6E59CE5F5C83E272.quest_desc: [
		"&lWhy:&r The jar stores potions by the litre, and the Melder merges two potions into one with both effects."
		"A jar that stores up to 100 potions. Potion can be removed by using an Empty Bottle, Potion Flask, or Arrows on the jar. Wixies will use these jars during Potion Autocrafting. The jar may be locked by using a Dominion Wand while sneaking. Locked Jars will only receive the potion it is locked to from Wixies. Can be used with a Comparator."
	]
	quest.633AA32EA34D7061.title: "Ring of Jumping"
	quest.633AA32EA34D7061.quest_desc: [
		"Allows the user to continue jumping in the air. Each jump will expend mana."
	]
	quest.279AB0FC8F611A73.title: "Amulet of Mana Regen"
	quest.279AB0FC8F611A73.quest_desc: [
		"Increases mana regeneration by a moderate amount."
	]
	quest.59E1AE454D70F39B.title: "Ring of Discount"
	quest.59E1AE454D70F39B.quest_desc: [
		"&lWhy:&r Spells cost less mana. The greater ring is even cheaper."
	]
	quest.6E14FFA9CCE9A7CE.title: "Belt of Unstable Gifts"
	quest.6E14FFA9CCE9A7CE.quest_desc: [
		"Occasionally grants a random positive potion effect for a short duration. These effects can vary in strength."
	]
	quest.7E13C03E04ADD748.title: "Dominion Wand"
	quest.7E13C03E04ADD748.quest_desc: [
		"&lWhy:&r The wand tells helpers where to take from and where to put to: the main tool of magical automation."
		"A tool for configuring Source Relays and automation entities. To set a transfer path, use the wand on the object that you would like to take source from, and then use it on the block you would like to send source to. For example: Source Jar to Source Relay, Source Relay to Source Relay, or Source Relay to Source Jar. To clear connections, sneak and use this wand on a relay. You can switch into Strict mode using the radial menu, allowing to specify the side of the blocks to use."
	]
	quest.0E5FE0A30306EC2F.title: "Item Lists"
	quest.0E5FE0A30306EC2F.quest_desc: [
		"&lWhy:&r Filters for helpers: what a Starbuncle may carry and what not."
		"Provides a list of items to automation related entities. To inscribe an item, place on the Scribes Table and use blocks and items on the table while sneaking. When given to a Starbuncle, the Starbuncle will only pickup and take items on the scroll."
	]
	quest.4F1E2023AFA94234.title: "Repository"
	quest.4F1E2023AFA94234.quest_desc: [
		"&lWhy:&r Magic storage: a double chest in one block."
		"A repository can store a double chests worth of items. When named, it will display the name as a tooltip, and preserve it when dropped as an item. Useful for creating named inventory tabs with the Storage Lectern. A Repository Catalog can be used as a proxy for a chain of connected repositories, and respects filter scrolls on repositories when inserting items."
	]
	quest.28F0FA2905918F94.title: "Storage Lectern"
	quest.28F0FA2905918F94.quest_desc: [
		"&lWhy:&r The lectern sees every linked storage and crafts from it: AE2 for mages."
		"The Storage Lectern can used to view, manage, and craft from multiple connected inventories. The number of inventories that may be connected is determined by the number of Bookwyrms bound to the lectern. You can add more Bookwyrms to the lectern by using a Bookwyrm Charm. Use the Dominion Wand from an inventory to the lectern in order to bind or remove access. Inventories can be connected 30 blocks away."
	]
	quest.23BFF9C277F8C594.title: "Bookwyrm Charm"
	quest.23BFF9C277F8C594.quest_desc: [
		"Bookwyrm Charms can be used on a Storage Lectern to increase the number of accessible inventories. Augment a Ritual of Awakening with Book and Quills in order to obtain charms. Bookwyrms can be dyed using white, black, blue, green, red, or purple dye."
	]
	quest.3839B36CEF452636.title: "Repository Catalog"
	quest.3839B36CEF452636.quest_desc: [
		"&lWhy:&r The catalog inserts and extracts from every connected repository: a funnel into your magic storage."
		"Catalogs can insert and extract items from any adjacent and connected repository. Catalogs respect filters placed on repositories via item frames while inserting items, and will prioritize existing stacks of an item. Filter scrolls can be used on the Catalog, storing the filter and applying it to all connected repositories when interacted with directly."
	]
	quest.3CAD5052819B777C.title: "Display Case"
	quest.3CAD5052819B777C.quest_desc: [
		"A Display Case can be configured to output a redstone signal when a certain level of inventory is reached. To set the item for tracking, use an item on the case. Interact with the block to increase the count, and punch to decrease. To link to an inventory, Dominion Wand an inventory to the display case. Wanding while sneaking will invert if the signal outputs below or greater than the set count."
	]
	quest.2EE3E2A5CC03A321.title: "Alteration Table"
	quest.2EE3E2A5CC03A321.quest_desc: [
		"&lWhy:&r Here you fit Threads into magic armour: special abilities."
		"Used to inscribe Threads onto magical armors. To use the table, place armor onto the stand of the table. The tablet will display the available Thread Slots on the armor. To add or remove a Thread, use the thread on the tablet of the table. Removing the armor will apply the threads to the armor. To remove a thread, place the armor on the table and interact with the display with an empty hand."
	]
	quest.07FFE018E9BEFB8C.title: "Sorcerer's Robes"
	quest.07FFE018E9BEFB8C.quest_desc: [
		"&lWhy:&r The weakest protection, but the most mana and thread slots: for a pure mage."
		"Magical robes will increase the wearers mana regen and can be upgraded with special abilities using Threads. The Sorceror's set provides the lowest defence, but provides the most powerful set of slots for Threads. The Arcanist's and Battlemage's sets provide increasingly more defence, but fewer and less powerful Thread Slots. For more information on Threads, see the section on Armor and Perks."
	]
	quest.01CAFE98321BB2D6.title: "Arcanist's Robes"
	quest.01CAFE98321BB2D6.quest_desc: [
		"&lWhy:&r A balance of protection and mana."
		"Magical armor can be upgraded with Threads to provide additional effects. Each type of armor has a different number of slots, and those slots vary in size. Larger slots will increase the power of threads, and some threads require a slot of a certain size or larger. To apply threads, see the section on the Alteration Table."
	]
	quest.0CF962DA69866229.title: "Battlemage Armour"
	quest.0CF962DA69866229.quest_desc: [
		"&lWhy:&r Protection close to real armour, less mana: for a frontline mage."
		"Threads may be applied to armor using the Alteration Apparatus. Each piece of armor has a unique set of Thread Slots with their own variety of levels. Some Threads may require a Thread Slot of a minimum level, but many threads simply increase in power based on the slot they are given."
	]
	quest.6F1261F9C2723A08.title: "Threads"
	quest.6F1261F9C2723A08.quest_desc: [
		"&lWhy:&r A blank thread becomes an ability thread in the Apparatus: night vision, jump, speed, mana regen."
	]
	quest.16BB5DC8FD9AC769.title: "Awakening"
	quest.16BB5DC8FD9AC769.quest_desc: [
		"&lWhy:&r Awakens trees and amethyst into living helpers: the Weald Walker, the Amethyst Golem."
		"Awakens nearby Archwood trees into Weald Walkers and Budding Amethyst into Amethyst Golems. Weald Walkers can be given a position in the world to guard against hostile mobs. They will heal over time, and turn into Weald Waddlers if they die. To create a Weald Walker, perform this ritual near the base of an Archwood Tree. Augmenting with Book and Quills will create Bookwyrm Charms."
	]
	quest.1E0AC6CFD51CC217.title: "Binding"
	quest.1E0AC6CFD51CC217.quest_desc: [
		"The Ritual of Binding converts nearby eligible entities into Bound Scripts, used for summoning a Familiar. For more information, see the section on Familiars."
	]
	quest.070432BFD467ACDA.title: "Containment"
	quest.070432BFD467ACDA.quest_desc: [
		"Captures a nearby entity and places it into any nearby placed Containment Jars. After the first capture, this ritual requires additional source to continue. Mobs and jars must be within 3 blocks of the brazier."
		"Allows you to capture and store mobs for transportation or decoration. To capture a mob, you must perform a Ritual of Containment. See the Ritual of Containment for more info. To release a mob, cast Dispel on the jar and the mob will be released above the jar. Note Blocks placed above a jar will play an ambient sound of the mob inside."
	]
	quest.5832947FD82D4604.title: "Sunrise"
	quest.5832947FD82D4604.quest_desc: [
		"Sets the time to day."
	]
	quest.0417263A3AAB284F.title: "Moonfall"
	quest.0417263A3AAB284F.quest_desc: [
		"Sets the time to night."
	]
	quest.7CD13204170C4C96.title: "Cloudshaping"
	quest.7CD13204170C4C96.quest_desc: [
		"This ritual can change the weather at a moments notice. By default, this ritual will set the weather to clear. Augmenting with Gunpowder will cause it to rain, while a Lapis Block will cause it to storm."
	]
	quest.378A386846920E3B.title: "Overgrowth"
	quest.378A386846920E3B.quest_desc: [
		"Occasionally bone meals blocks in the area around it. This ritual requires source to operate. If augmented with a Bone Block, this ritual will instead force baby animals to grow faster."
	]
	quest.3F90ABC846576DB6.title: "Harvest"
	quest.3F90ABC846576DB6.quest_desc: [
		"Casts the Harvest effect on nearby crops. Consumes source each time a set of crops are harvested. If an inventory is adjacent to the brazier, the items will be deposited in them before dropping on the ground."
	]
	quest.5461E590E1F01494.title: "Fertility"
	quest.5461E590E1F01494.quest_desc: [
		"Periodically causes nearby animals to breed if possible. This ritual requires source to operate, and will have no effect if there are twenty or more animals nearby."
	]
	quest.7D1EECCF6E402A55.title: "Forestation"
	quest.7D1EECCF6E402A55.quest_desc: [
		"Places grown Oak and Birch trees, and applies bonemeal in a 7x7 (circular) area. Augmenting with a source gem will increase the radius by 1 for each gem. Augmenting with a Brown Mushroom will convert the area to Podzol and spawn taiga resources. Augmenting with Glow Berries will spawn jungle resources."
	]
	quest.5CAEC38CBEDFE5F6.title: "Restoration"
	quest.5CAEC38CBEDFE5F6.quest_desc: [
		"Heals nearby entities or harms undead over time. Additionally, Zombie Villagers will be instantly cured, and the resulting villager will offer discounts if a player was nearby. This ritual requires source to operate."
	]
	quest.7663D1448EE06D9C.title: "Sanctuary"
	quest.7663D1448EE06D9C.quest_desc: [
		"Denies hostile mobs from naturally spawning in a 32 block radius. Augment with rotten flesh to increase the radius by 1 each, up to 128. Costs source once a minute if a spawn is denied."
	]
	quest.591A5B36BD57EC66.title: "Scrying"
	quest.591A5B36BD57EC66.quest_desc: [
		"&lWhy:&r Highlights chosen blocks through walls: find ore without digging blind."
		"Grants vision of a given block through any other block for a given time. White particles signify you are very close, green is semi-far, and blue particles are blocks very far from you.  To complete the ritual, throw any block of your choice before starting. You may also add a Manipulation Essence to increase the duration to 15 minutes."
	]
	quest.5B201DF395D5CCC4.title: "Burrowing"
	quest.5B201DF395D5CCC4.quest_desc: [
		"Digs four adjacent holes to bedrock, dropping any blocks."
	]
	quest.231E10FEAEB1BFC8.title: "Disintegration"
	quest.231E10FEAEB1BFC8.quest_desc: [
		"Destroys nearby monsters and converts them into Experience Gems worth twice as much experience. Monsters destroyed this way will not drop items. This ritual consumes source each time a monster is destroyed."
	]
	quest.7DB905138567A025.title: "Gravity"
	quest.7DB905138567A025.quest_desc: [
		"Grants nearby players the Gravity effect, forcing them to the ground for a short time. If the player is nearby, this ritual will refresh their gravity debuff. Each time this ritual grants or refreshes gravity, it will expend source from nearby jars."
	]
	quest.66C04B592F90514C.title: "Conjure Island: Plains"
	quest.66C04B592F90514C.quest_desc: [
		"Creates an island of grass and dirt in a circle around the ritual, converting the area to Plains. Augmenting with a Frostaya with convert to Snow Plains. The island will generate with a radius of 7 blocks. Augmenting the ritual with Source Gems will increase the radius by 1 for each gem. Source must be provided nearby as blocks are generated."
	]
	quest.18A1689A31C40F63.title: "Challenge"
	quest.18A1689A31C40F63.quest_desc: [
		"Summons an illager raid when used inside a village. An Emerald may be used to increase the difficulty of the raid to the maximum amount, making Totems of the Undying accessible on easier difficulties. Augmenting has no effect on Hard difficulty."
	]
	quest.0C5E869F026825FF.title: "Warping"
	quest.0C5E869F026825FF.quest_desc: [
		"Warps all nearby entities to the location on a warp scroll. Before starting the ritual, you must first augment the ritual with an inscribed Warp Scroll."
	]
	quest.530BC067BF6E1EA5.title: "Ritual Brazier Relay"
	quest.530BC067BF6E1EA5.quest_desc: [
		"Allows the users to bind a Ritual Brazier ritual to a new location. Multiple rituals can be connected to the same brazier relay. To connect, use the Dominion Wand on your Ritual Brazier, then the relay. Source is consumed at the original braziers location. Can be bound within 15 blocks."
	]
	quest.13E8B84B96C128B0.title: "Amethyst Golem Charm"
	quest.13E8B84B96C128B0.quest_desc: [
		"Amethyst Golems will harvest, grow, and collect Amethyst near its home. To obtain an Amethyst Golem, perform the Ritual of Awakening near Budding Amethyst to obtain the Amethyst Golem Charm."
	]
	quest.077E63FB066093F8.title: "Weald Walker"
	quest.077E63FB066093F8.quest_desc: [
		"Weald Walkers are living Archwood Trees that guard their homes against hostile monsters. A Weald Walker can be created from the Ritual of Awakening. When summoned, the Weald Walker will roam randomly unless given a home position. To give the Weald Walker a home, use the dominion wand on the Weald Walker, and then the block you wish it to guard."
	]
	quest.53B1B43E512492DB.title: "Alakarkinos Charm"
	quest.53B1B43E512492DB.quest_desc: [
		"&lWhy:&r The Alakarkinos crab sifts sand and gravel for archaeology loot: sherds and treasures."
		"Alakarkinos can sift sand and gravel to find items found in archaeology sites. They can be found on beaches and will give you a token if they receive a Pottery Sherd of any kind."
	]
	quest.022E4B84065E57CF.title: "Familiar"
	quest.022E4B84065E57CF.quest_desc: [
		"&lWhy:&r A familiar stays by your side and gives a bonus: the Starbuncle speed, the Wixie longer potions, the Bookwyrm cheaper spells."
		"To begin summoning familiars, you will need to obtain a Bound Script of the entity you wish to befriend. These can be obtained by performing the Ritual of Binding near a relevant entity. See the full list of eligible entities in the Familiars section. Once you have obtained a Bound Script, use it to learn the familiar."
	]
	quest.6197C666E8AD149F.title: "Gold Sconce"
	quest.6197C666E8AD149F.quest_desc: [
		"Decorative lights. To ignite, cast Light on the sconce. The color of the flame corresponds with your spell color. The Magelight Torch on a wall can change the direction of its flames by interacting. Use Touch or Projectile Sensitive to target the sconce."
	]
	quest.0DDF4F22665E681A.title: "Mirrorweave"
	quest.0DDF4F22665E681A.quest_desc: [
		"Mirrorweave can replicate the appearance of any block that is used on it. These blocks will take on the same collisions and light as their replicated block. Sense Magic will reveal the illusion. All illusion blocks can also be used as frames for portals. Casting light on an illusion block will allow it to emit light."
	]
	quest.24A8B12CEC2DAE22.title: "Warp Portal"
	quest.24A8B12CEC2DAE22.quest_desc: [
		"&lWhy:&r A permanent portal to any spot in the dimension: a shared transport network for the server."
		"Warp portals, like warp scrolls, provide a one-way teleport to any location, provided it is in the same dimension. To construct a Warp Portal, build a frame from Sourcestone or its variants in the shape of a rectangle and provide a full Source Jar nearby. Then, throw a warp scroll with a written location into the frame. Given there is enough source nearby, the portal will be created."
	]
	quest.06B2954D508D8530.title: "Planarium"
	quest.06B2954D508D8530.quest_desc: [
		"&lWhy:&r A pocket dimension in a jar: your own little base you can step into."
		"The Planarium allows for the creation of custom pocket dimensions. Blocks placed within the jar will be rendered inside the Planarium. To create a new dimension, name a Planarium with the Name glyph or an anvil. Interact with the planarium while sneaking to enter the jar."
		"The spawn point of the Planarium can be set by using the Dominion Wand on a boundary of the jar, and then using the wand again on your desired spawn point. To exit the jar, simply break any wall of the dimension."
	]
	quest.2A4234012CF07503.title: "Scryer's Oculus"
	quest.2A4234012CF07503.quest_desc: [
		"&lWhy:&r Watch through a crystal placed far away: a camera for your farm or base entrance."
	]
	quest.3A0AA55BF72A51A3.title: "Master of Ars Nouveau"
	quest.3A0AA55BF72A51A3.quest_desc: [
		"Source flows by itself, helpers work, armour and weapons are steeped in magic. The rest is your imagination in the spell book."
	]
	chapter.543CD5142769B82D.title: "Iron's Spells"
	chapter.543CD5142769B82D.chapter_subtitle: [
		"Schools of battle magic"
	]
	quest.52131970F0AF37EB.title: "A Spell Scroll"
	quest.52131970F0AF37EB.quest_subtitle: "Find one or buy one"
	quest.52131970F0AF37EB.quest_desc: [
		"&lWhat:&r Iron's Spells is magic with &lschools&r: fire, ice, lightning, holy, blood, nature, ender, evocation."
		"Spells are stored in &lscrolls&r: find them in dungeon chests or buy them from wandering mages."
		"You can cast a scroll without a book — once."
	]
	quest.062A4C4223BD9574.title: "A Spellbook"
	quest.062A4C4223BD9574.quest_subtitle: "Forever"
	quest.062A4C4223BD9574.quest_desc: [
		"A book (in an accessory slot) keeps spells forever. Better books have more slots."
		"Choose a spell with the wheel key and cast it — see &oControls → Iron's Spells&r for the bindings."
	]
	quest.2689CA1241CB0BE8.title: "The Inscription Table"
	quest.2689CA1241CB0BE8.quest_subtitle: "Scroll → book"
	quest.2689CA1241CB0BE8.quest_desc: [
		"At the inscription table a spell moves from a scroll into your book. The scroll is used up."
	]
	quest.1807C290BC564799.title: "The Scroll Forge"
	quest.1807C290BC564799.quest_subtitle: "Make your own scrolls"
	quest.1807C290BC564799.quest_desc: [
		"The forge makes a scroll of the spell &lyou choose&r from paper, ink and a school focus. Rarer ink means a stronger spell."
		"&lValued by:&r alchemists — ink is brewed in their cauldron."
	]
	quest.64D45646DD838107.title: "Arcane Essence"
	quest.64D45646DD838107.quest_subtitle: "Break down spare scrolls"
	quest.64D45646DD838107.quest_desc: [
		"Spare scrolls break down into arcane essence — used for runes, upgrades and books."
	]
	quest.710E1FB9C0AF78C8.title: "School Runes"
	quest.710E1FB9C0AF78C8.quest_subtitle: "Fire, ice, lightning…"
	quest.710E1FB9C0AF78C8.quest_desc: [
		"A school rune is needed for its foci and upgrades. Pick a favourite school — its skill tree grows as you cast."
	]
	quest.20EF7614A84A8044.title: "The Wizard's Robes"
	quest.20EF7614A84A8044.quest_subtitle: "More mana"
	quest.20EF7614A84A8044.quest_desc: [
		"Mage armour grants mana and school power. The wizard hat is also a fine photo opportunity."
	]
	quest.26E181A4C50935DA.title: "Upgrades"
	quest.26E181A4C50935DA.quest_subtitle: "The arcane anvil"
	quest.26E181A4C50935DA.quest_desc: [
		"On the arcane anvil, upgrade orbs add mana, school power and cooldown reduction to armour."
	]
	quest.3A9E5FDFBAC6AAC3.title: "The Warlock's Tower"
	quest.3A9E5FDFBAC6AAC3.quest_subtitle: "Mage bosses"
	quest.3A9E5FDFBAC6AAC3.quest_desc: [
		"Towers and camps of hostile mages dot the world — necromancers, pyromancers, cultists. This is &lzone 3&r."
		"Beating them yields rare books, inks and school trophies. Go as a group and bring food."
	]
	quest.37CE8B7ABAD95E28.title: "Magic Structures"
	quest.37CE8B7ABAD95E28.quest_desc: [
		"&lWhy:&r Early magic is exploring: towers, huts and forts. Each has a strong mage."
		"Early game progression is dominated by exploring and looting. The world is full of magic loot, especially in new magic structures that can be found dotted across the lands. But be careful! Each magic structure is home to a powerful mage, who will not take kindly to you."
		"Scrolls will be your first taste of magic. While they can be consumed to cast the spell they hold, it is better to save them until you can inscribe it into a spell book, where it can be used repeatedly, via an Inscription Table >>>"
	]
	quest.5D7DD45CF34F8B76.title: "Pyromancer Tower"
	quest.5D7DD45CF34F8B76.quest_desc: [
		"&lWhy:&r Find a pyromancer tower: fire scrolls inside."
	]
	quest.3AA33F1AB8EA6FA0.title: "Evoker Fort"
	quest.3AA33F1AB8EA6FA0.quest_desc: [
		"&lWhy:&r An illager mage fortress. Go as a group."
	]
	quest.4E016BB473E77206.title: "Mountain Tower"
	quest.4E016BB473E77206.quest_desc: [
		"&lWhy:&r A mountain tower with cryomancers and ice scrolls."
	]
	quest.649DBD9BAE8C8D1C.title: "Catacombs"
	quest.649DBD9BAE8C8D1C.quest_desc: [
		"&lWhy:&r Undead dungeon, the way to the Dead King."
	]
	quest.619C0EEA858D0BF8.title: "Ice Spider Den"
	quest.619C0EEA858D0BF8.quest_desc: [
		"&lWhy:&r Frozen bones and spider eggs for alchemy."
	]
	quest.2A583A6AA81CA063.title: "The Citadel"
	quest.2A583A6AA81CA063.quest_desc: [
		"&lWhy:&r A huge fortress guarded by the Citadel Keeper."
	]
	quest.32FBD7AB171A572F.title: "Mid Game"
	quest.32FBD7AB171A572F.quest_desc: [
		"&lWhy:&r A gold book holds more spells."
		"Upon reaching nether level resources, you will unlock an entirely new dynamic to gaining power: The Scroll ForgeThe Scroll Forge is used to craft scrolls by using ink, paper, and a focus. The ink determines the rarity (and therefore level), and the focus determines spell's school."
	]
	quest.66498EEE1D03149B.title: "Enchanted Spell Book"
	quest.66498EEE1D03149B.quest_desc: [
		"&lWhy:&r More slots and bonus mana."
	]
	quest.4F373047F55047BE.title: "Late Game"
	quest.4F373047F55047BE.quest_desc: [
		"&lWhy:&r The netherite book: 12 slots."
		"Late game is reached by obtaining netherite and vast quantities of basic resources, and powered by the Arcane Anvil.The Arcane Anvil is the most powerful crafting station, used to level up your scrolls, upgrade armor and spell books, and imbue weapons with spells."
	]
	quest.3DF57D5706B45337.title: "Unique Spell Books"
	quest.3DF57D5706B45337.quest_desc: [
		"&lWhy:&r Necronomicon, dragonskin book and others drop only from bosses and vaults."
		"Unique spell books are rare drops from certain mobs that come with spells inscribed, which cannot be removed or edited. Not every spell book can be manufactured -- it is called the arcane art, after all."
		"The spells in a unique spell book are locked, but can be improved. By combining a unique spell book in the Arcane Anvil with a higher-level scroll of the same spell from the spell book, you can raise the level of the locked spell."
	]
	quest.55B28F062048D323.title: "Epic and Legendary Ink"
	quest.55B28F062048D323.quest_desc: [
		"&lWhy:&r Ink sets the scroll's rarity in the forge."
		"The most common of the inks (ergo the name), common ink can craft the lowest level of spells. If a spell's lowest level is above common, it cannot be crafted with common ink. The same goes for all other inks."
		"Less common than common, it can craft slightly more powerful spells."
	]
	quest.711FD1AD09A96AA8.title: "Lesser Spell Slot Improvement"
	quest.711FD1AD09A96AA8.quest_desc: [
		"&lWhy:&r Adds a spell slot to a book."
	]
	quest.37DD901E5EDDF578.title: "Staves and Spell Weapons"
	quest.37DD901E5EDDF578.quest_desc: [
		"&lWhy:&r Staves boost spell power; spell blades hold their own spells."
		"Casting Implements are items that can be right-clicked (used) in order to cast your active spell. Most often, they also provide passive benefits, allowing for a dedicated wizard playstyle."
		"A simple stick is all it takes to get the crystal ball rolling."
	]
	quest.1E69531BF5075088.title: "Alchemist Cauldron"
	quest.1E69531BF5075088.quest_desc: [
		"&lWhy:&r Brews inks and elixirs, dissolves scrolls back into essence."
	]
	quest.1ED5B2479E899B35.title: "Elixirs"
	quest.1ED5B2479E899B35.quest_desc: [
		"&lWhy:&r Oakskin, evasion and invisibility."
	]
	quest.0717565A1E2B9135.title: "Greater Elixirs"
	quest.0717565A1E2B9135.quest_desc: [
		"&lWhy:&r Stronger, longer elixirs for boss fights."
	]
	quest.69EC7A617666F350.title: "Tinctures"
	quest.69EC7A617666F350.quest_desc: [
		"Dropped from Ominous Bosses"
	]
	quest.7FF93BEFC552763F.title: "Fire Ale"
	quest.7FF93BEFC552763F.quest_desc: [
		"&lWhy:&r Fire ale for fire mages."
	]
	quest.12160D22993CF48F.title: "Mage's Library"
	quest.12160D22993CF48F.quest_desc: [
		"&lWhy:&r Pedestal and wisewood shelves for your tower."
	]
	quest.151474994DB8BD72.title: "Portal Frame"
	quest.151474994DB8BD72.quest_desc: [
		"&lWhy:&r Frames + Portal spell = a permanent gate."
		"Can be connected with Portal spell"
	]
	quest.0336A72055E2BA37.title: "Shriving Stone"
	quest.0336A72055E2BA37.quest_desc: [
		"&lWhy:&r Removes upgrades so you can re-spec."
	]
	quest.45BAAE2BE8DAB33D.title: "School of Fire"
	quest.45BAAE2BE8DAB33D.quest_desc: [
		"&lWhy:&r Area damage. Not near forests or wooden houses."
		"Manifest and throw a ball of fire, exploding and dealing massive damage on impact."
		"Recast to place anchor points, which erupts into a wall of fire when the cast finishes, or when the maximum length is reached. This wall blocks projectiles and ignites creatures that pass through it."
	]
	quest.0E045D512219B5AA.title: "School of Ice"
	quest.0E045D512219B5AA.quest_desc: [
		"&lWhy:&r Slows and freezes: crowd control."
		"Fire a beam of cold energy, dealing low damage but immediately applying freeze to the creature hit."
		"Conjure a giant chunk of ice above a targeted creature or block. After a short delay, it will fall down and explode for area frost damage, doing additional damage to any creatures hit on the way down."
	]
	quest.7CED103CE5224479.title: "School of Lightning"
	quest.7CED103CE5224479.quest_desc: [
		"Start a chain of lightning from a targeted creature, causing waves of zapping magic to cascade to nearby creatures"
		"Imbue yourself with the power of lightning, increasing your speed and combat abilities."
	]
	quest.31C90D0E6D94FF84.title: "Bottle o' Lightning"
	quest.31C90D0E6D94FF84.quest_desc: [
		"Use an empty bottle on a charged creeper to obtain."
	]
	quest.436F4C31A566E4DD.title: "Holy School"
	quest.436F4C31A566E4DD.quest_desc: [
		"&lWhy:&r Heal yourself and allies — every team needs a healer."
		"Cast to infuse yourself with holy energy and immediately regain health."
		"Cast to target any creature, showing a glowing outline. Completing the cast will heal this creature."
	]
	quest.3B0DD55F2A217826.title: "Ender School"
	quest.3B0DD55F2A217826.quest_desc: [
		"&lWhy:&r Teleport, recall home, pocket dimension."
		"Instantaneously teleport to where you are looking, leaving nothing but a cloud of ender energy behind."
		"Warps you back to your spawn location, or world spawn if there is none."
	]
	quest.029A46AC640B1072.title: "Blood School"
	quest.029A46AC640B1072.quest_desc: [
		"&lWhy:&r Steals life and raises the dead."
		"Cast to summon undead minions from the earth beneath you. The higher the power, the better equipment they will have."
		"Hold to cast a ray of necrotic energy that siphons health from creatures it hits, damaging them and healing you for 100% of damage done."
	]
	quest.1781E0393F790FC5.title: "Blood Vial"
	quest.1781E0393F790FC5.quest_desc: [
		"By heating up a Minecraft cauldron with a campfire below, or by using an Alchemist cauldron, mobs placed inside can be cooked for blood."
	]
	quest.7C1F105E13D52F97.title: "Evocation School"
	quest.7C1F105E13D52F97.quest_desc: [
		"Cast to conjure vexes that will follow, protect, and fight for you."
		"Conjure a stationary shield of arcane energy where you look that will block projectiles and prevent creatures from passing."
	]
	quest.6C75A953F061D0B3.title: "Nature School"
	quest.6C75A953F061D0B3.quest_desc: [
		"Around a targeted creature, sprout magical roots than entangle them and completely prevent non-magical movement"
		"The great power of oak infuses itself into your skin, granting damage reduction of any incoming damage for a duration."
	]
	quest.00639AF876EA60B0.title: "Eldritch Magic"
	quest.00639AF876EA60B0.quest_desc: [
		"&lWhy:&r Forbidden school, learned from manuscripts in ancient cities."
		"From where you look, erupt a mass of sculk energy in the form of wailing tentacles, damaging and blinding creatures caught in the chaos."
		"Blast forth a sonic boom of immense power, passing through solid material and harming all creatures in its path."
	]
	quest.6E60BCE3732C6E60.title: "Cooldown Upgrades"
	quest.6E60BCE3732C6E60.quest_desc: [
		"&lWhy:&r Faster spell cooldowns."
	]
	quest.0F9F93E560058AEE.title: "More Mana"
	quest.0F9F93E560058AEE.quest_desc: [
		"&lWhy:&r More mana: more casts in a row."
	]
	quest.0517E2BEDD9A8CBF.title: "Protection Upgrades"
	quest.0517E2BEDD9A8CBF.quest_desc: [
		"&lWhy:&r Extra armor for mage gear."
	]
	quest.599814422E929544.title: "Wandering Magician Set"
	quest.599814422E929544.quest_desc: [
		"&lWhy:&r First mage armor: a bit of mana and cast speed."
	]
	quest.22E37928A1F4E5F3.title: "Pyromancer Set"
	quest.22E37928A1F4E5F3.quest_desc: [
		"&lWhy:&r Fire power and fire resistance."
	]
	quest.3D9DAFF1DD2DB56F.title: "Cryomancer Set"
	quest.3D9DAFF1DD2DB56F.quest_desc: [
		"&lWhy:&r Ice power and frost protection."
	]
	quest.4324928AC259FF0A.title: "Electromancer Set"
	quest.4324928AC259FF0A.quest_desc: [
		"&lWhy:&r Lightning power and speed."
	]
	quest.505F9B9308C5705E.title: "Priest Set"
	quest.505F9B9308C5705E.quest_desc: [
		"&lWhy:&r Boosts healing: the team healer's armor."
	]
	quest.5772070EE5904042.title: "Shadowwalker Set"
	quest.5772070EE5904042.quest_desc: [
		"&lWhy:&r Ender power and stealth."
	]
	quest.1D9C4A678FD1843A.title: "Cultist Set"
	quest.1D9C4A678FD1843A.quest_desc: [
		"&lWhy:&r Blood power: life steal and undead."
	]
	quest.7BDD1FD256B59F70.title: "Archevoker Set"
	quest.7BDD1FD256B59F70.quest_desc: [
		"&lWhy:&r Evocation power: more vexes and fangs."
	]
	quest.5D8E54B41454D7D5.title: "Plagued Set"
	quest.5D8E54B41454D7D5.quest_desc: [
		"&lWhy:&r Nature and poison power."
	]
	quest.7A8BAE07E712FA12.title: "Netherite Battlemage Set"
	quest.7A8BAE07E712FA12.quest_desc: [
		"&lWhy:&r Netherite-level defence plus mana."
	]
	quest.03089F07F5504FEB.title: "Infernal Sorcerer Chestplate"
	quest.03089F07F5504FEB.quest_desc: [
		"Dealing Fire Spell Damage adds a stack of Immolation to the creature"
	]
	quest.648C9C830C653736.title: "Mage Rings"
	quest.648C9C830C653736.quest_desc: [
		"&lWhy:&r Faster cooldown and cast time."
	]
	quest.227BF055317FB7E0.title: "Ward Rings"
	quest.227BF055317FB7E0.quest_desc: [
		"&lWhy:&r Pick the ward ring that matches the boss."
		"Grants fire immunity"
	]
	quest.05D7400821AB6A23.title: "Amulet of Concentration"
	quest.05D7400821AB6A23.quest_desc: [
		"Long Casts become uninterruptible"
	]
	quest.07194CCCBA38D0C1.title: "Affinity Ring"
	quest.07194CCCBA38D0C1.quest_desc: [
		"&lWhy:&r Raises the level of one spell."
	]
	quest.2CB288E440D62BB4.title: "Conjurer's Talisman"
	quest.2CB288E440D62BB4.quest_desc: [
		"&lWhy:&r Summons last longer."
	]
	quest.4910FD8B790BB4EA.title: "Emerald Stoneplate Ring"
	quest.4910FD8B790BB4EA.quest_desc: [
		"Slain creatures drop +25% experience"
	]
	quest.4D31E18F609B59F8.title: "Amethyst Rapier"
	quest.4D31E18F609B59F8.quest_desc: [
		"&lWhy:&r A fast blade scaling with spell power."
	]
	quest.3C9DD0A3E7385CD0.title: "Magehunter"
	quest.3C9DD0A3E7385CD0.quest_desc: [
		"&lWhy:&r Anti-mage sword."
	]
	quest.4E820FD029FE30EE.title: "Spellbreaker"
	quest.4E820FD029FE30EE.quest_desc: [
		"&lWhy:&r Interrupts enemy spellcasting."
	]
	quest.04117E5E42C6A4DD.title: "Autoloader Crossbow"
	quest.04117E5E42C6A4DD.quest_desc: [
		"> Automatically loads next available projectile while in inventory. Crouch-Click to cancel"
	]
	quest.5736887E673B4861.title: "Ice Staff"
	quest.5736887E673B4861.quest_desc: [
		"&lWhy:&r Boosts ice spells."
	]
	quest.4ECCDA9E795CEC44.title: "Pyrium Staff"
	quest.4ECCDA9E795CEC44.quest_desc: [
		"&lWhy:&r The best staff for fire mages."
	]
	quest.2161D87DAD290E20.title: "Dragonskin"
	quest.2161D87DAD290E20.quest_desc: [
		"Dropped from the Ender Dragon."
	]
	quest.17010B5742787A3F.title: "Cinder Essence"
	quest.17010B5742787A3F.quest_desc: [
		"Dropped from Ancient Knights."
	]
	quest.066C6A280BD39351.title: "Frozen Bone"
	quest.066C6A280BD39351.quest_desc: [
		"Dropped from strays."
	]
	quest.69942EFA5E8584EF.title: "Ruined Book"
	quest.69942EFA5E8584EF.quest_desc: [
		"Found in likewise sculk-infested cities."
	]
	quest.7EB8E5C4A09D0649.title: "Defeat a Pyromancer"
	quest.7EB8E5C4A09D0649.quest_desc: [
		"&lWhy:&r Fights with fireballs; bring fire protection."
	]
	quest.503D54E9E24A6C70.title: "Defeat a Cryomancer"
	quest.503D54E9E24A6C70.quest_desc: [
		"&lWhy:&r Slows and freezes; close the distance."
	]
	quest.0F3330C9F12CC680.title: "Defeat an Archevoker"
	quest.0F3330C9F12CC680.quest_desc: [
		"&lWhy:&r Kill the vexes first; keep moving."
	]
	quest.7C9C10AB62CD4A71.title: "Defeat a Necromancer"
	quest.7C9C10AB62CD4A71.quest_desc: [
		"&lWhy:&r Hit the necromancer, not his skeletons."
	]
	quest.4B05E241BD05306F.title: "Ice Spider"
	quest.4B05E241BD05306F.quest_desc: [
		"&lWhy:&r Poison and cold; carry milk."
	]
	quest.4F90DE4C3503858F.title: "Citadel Keeper"
	quest.4F90DE4C3503858F.quest_desc: [
		"&lWhy:&r Huge flamberge; keep distance and dodge."
	]
	quest.03916D6A55B1E05A.title: "Tyros, the Fire Boss"
	quest.03916D6A55B1E05A.quest_desc: [
		"&lWhy:&r A fire lord; fire ward ring, potions and a healer required."
	]
	quest.76FE632065909AEB.title: "Archmage"
	quest.76FE632065909AEB.quest_desc: [
		"All schools learned, the towers cleared, bosses defeated."
	]
	quest.59DAC3A798675F2C.title: "Mithril"
	quest.59DAC3A798675F2C.quest_desc: [
		"Mithril ore lies deep underground. It makes the best spellbooks and mage armour."
	]
	quest.4C4770E1F9711E9D.title: "The Arcane Ingot"
	quest.4C4770E1F9711E9D.quest_desc: [
		"Mithril + arcane essence = an arcane ingot. The base of advanced books."
	]
	quest.0BE46ED673E89342.title: "School Books"
	quest.0BE46ED673E89342.quest_desc: [
		"The fire, ice and druidic books each boost their school. Pick one for your favourite spells."
	]
	quest.79520F0703E2D1D3.title: "Mage Rings"
	quest.79520F0703E2D1D3.quest_desc: [
		"Mana ring, cooldown ring, affinity ring — accessory slots for mages."
	]
	quest.4881E593675BEAC3.title: "Rare Ink"
	quest.4881E593675BEAC3.quest_desc: [
		"Better ink makes stronger scrolls. Ink is brewed in the alchemist's cauldron from common ink and essences."
	]
	quest.3990DF9B5753B506.title: "The Teleportation Amulet"
	quest.3990DF9B5753B506.quest_desc: [
		"Strengthens movement spells. An instant dash across a ravine — priceless."
	]
	quest.62EC5608FBE429B5.title: "The Dead King"
	quest.62EC5608FBE429B5.quest_desc: [
		"The undead king sleeps in a crypt underground. Defeating him is the magic branch's greatest trophy."
	]
	quest.161358A8E5F7983F.title: "The Jewelcrafting Station"
	quest.161358A8E5F7983F.quest_desc: [
		"Iron's Jewelry: rings and necklaces set with rubies, sapphires and topaz — each with its own bonus."
	]
	chapter.38CD7CF2D4519A5D.title: "Occultism"
	chapter.38CD7CF2D4519A5D.chapter_subtitle: [
		"Rituals and spirit workers"
	]
	quest.01CE06E57550BE24.title: "The Dictionary of Spirits"
	quest.01CE06E57550BE24.quest_subtitle: "The Occultism guide"
	quest.01CE06E57550BE24.quest_desc: [
		"&lWhat:&r Occultism is rituals with chalk and sacrificial bowls, summoning spirit servants and magical storage."
		"&lWhy:&r spirits work for you: chop trees, move items, clean up, run machines."
		"It's all in the Dictionary of Spirits — start with \"Getting Started\"."
	]
	quest.5D53F6CD01048766.title: "Datura"
	quest.5D53F6CD01048766.quest_subtitle: "Seeing the Otherworld"
	quest.5D53F6CD01048766.quest_desc: [
		"Datura grows from seeds dropped by grass. It makes &lDemon's Dream&r —"
		"after which you can see hidden Otherworld ores and trees."
		"&lValued by:&r gardeners — help the mage with a bed."
	]
	quest.3249B651AE7FF470.title: "Chalk and Bowl"
	quest.3249B651AE7FF470.quest_subtitle: "Your first pentacle"
	quest.3249B651AE7FF470.quest_desc: [
		"A ritual is drawn on the floor in chalk following the Dictionary's diagram, a golden sacrificial bowl in the centre, ingredient bowls around it."
		"&lTip:&r build the ritual room pretty from the start — candles and skulls are part of the pattern."
	]
	quest.6BBDBFD07168218A.title: "The Foliot"
	quest.6BBDBFD07168218A.quest_subtitle: "Your first spirit servant"
	quest.6BBDBFD07168218A.quest_desc: [
		"Bind a foliot in a book, then summon it with a ritual. A foliot can become a lumberjack, a cleaner or an item carrier."
	]
	quest.1429288ACE921923.title: "The Lumberjack"
	quest.1429288ACE921923.quest_subtitle: "A spirit fells the forest"
	quest.1429288ACE921923.quest_desc: [
		"A lumberjack spirit chops trees in its area, replants saplings and stacks logs in a chest. Builders will be thrilled."
	]
	quest.7DF2700D3B654BFD.title: "The Djinni"
	quest.7DF2700D3B654BFD.quest_subtitle: "Stronger and smarter"
	quest.7DF2700D3B654BFD.quest_desc: [
		"A djinni is the next rank of spirit. It runs machines and is needed for magical storage."
	]
	quest.2A27D09E6BCC33F9.title: "A Warehouse in a Dimension"
	quest.2A27D09E6BCC33F9.quest_subtitle: "Dimensional storage"
	quest.2A27D09E6BCC33F9.quest_desc: [
		"Occultism's storage keeps items in a pocket dimension. It's the magical answer to AE2 —"
		"pick one storage path for the group or build both for style."
	]
	quest.33B194723B40588C.title: "The Afrit"
	quest.33B194723B40588C.quest_subtitle: "A spirit of fire"
	quest.33B194723B40588C.quest_desc: [
		"The afrit is a dangerous, powerful spirit. Summoning it is a trial; the reward is access to the strongest rituals."
	]
	quest.4F522F244FA7F524.title: "Demon's Dream"
	quest.4F522F244FA7F524.quest_desc: [
		"Eat it and you see the Otherworld: hidden ores and trees. The effect lasts a few minutes."
	]
	quest.23BB481071838C9B.title: "Otherworld Goggles"
	quest.23BB481071838C9B.quest_desc: [
		"See the Otherworld all the time, no potion needed. Handy for mining iesnium."
	]
	quest.11F2CEF5CA17E371.title: "The Otherworld Tree"
	quest.11F2CEF5CA17E371.quest_desc: [
		"Special trees grow from the Otherworld — their wood is needed for rituals. A gardener can help grow a grove."
	]
	quest.20E03685BC9E6B17.title: "Iesnium"
	quest.20E03685BC9E6B17.quest_desc: [
		"The Otherworld's metal. It makes a pickaxe that sees hidden ores and the Occultism anvil."
	]
	quest.5B4F4EBBEDCAE623.title: "The Divination Rod"
	quest.5B4F4EBBEDCAE623.quest_desc: [
		"Finds a chosen block — ore, crystals — at long range."
	]
	quest.38FFF53198F0B11A.title: "A Familiar"
	quest.38FFF53198F0B11A.quest_desc: [
		"Summon a familiar — a spirit companion granting night vision, protection or speed. It lives in a ring."
	]
	quest.7E7BA6520B7760EB.title: "The Cleaner Spirit"
	quest.7E7BA6520B7760EB.quest_desc: [
		"Collects dropped items in its area and puts them in a chest. A tidy farm."
	]
	quest.2482B81DD409A7CA.title: "The Transporter Spirit"
	quest.2482B81DD409A7CA.quest_desc: [
		"Carries items from one chest to another. Logistics without pipes."
	]
	quest.570A419BD05A6077.title: "The Machine Djinni"
	quest.570A419BD05A6077.quest_desc: [
		"A djinni runs a machine: loads ingredients and collects results from magical storage."
	]
	quest.6BE1348766348F20.title: "Spiritfire"
	quest.6BE1348766348F20.quest_desc: [
		"&lWhy:&r Spiritfire turns ordinary items into occult ones."
		"The main uses of [](item://occultism:spirit_fire) are to convert [](item://minecraft:diamond) into [](item://occultism:spirit_attuned_gem),"
		"to get basic ingredients such as [](item://occultism:otherstone) and [Otherworld Saplings](item://occultism:otherworld_sapling_natural),"
		"and to purify impure chalks."
	]
	quest.157AAA8C21BFE0F9.title: "The Third Eye"
	quest.157AAA8C21BFE0F9.quest_desc: [
		"The ability to see beyond the physical world is referred to as [#](ad03fc)Third Eye[#]()."
		"Humans do not possess such an ability to see [#](ad03fc)beyond the veil[#](),"
		"however with certain substances and contraptions the knowledgeable summoner can work around this limitation."
	]
	quest.13DE2F84620EE0AF.title: "Sacrificial Bowl"
	quest.13DE2F84620EE0AF.quest_desc: [
		"These bowls are used to place the items we will sacrifice as part of a ritual and you will need a handful of them."
		"Note: Their exact placement in the ritual does not matter - just keep them within 8 blocks horizontally of the pentacle center!"
		"Once everything has been set up and you are ready to start, this special ritual bowl is used to activate the ritual by [#](ad03fc)right-clicking[#]() it with the activation item,"
		"usually a [Book of Binding](entry://getting_started/books_of_binding)."
	]
	quest.36A810031247CDD3.title: "Large Candle"
	quest.36A810031247CDD3.quest_desc: [
		"Candles provide stability to rituals and are an important part of almost all pentacles."
		"&lLarge Candles also act like bookshelves for enchantment purposes.&r"
		"\\"
		"\\"
		"Candles from Minecraft and other Mods may be used in place of Occultism candles."
	]
	quest.5711E9243534BDAE.title: "Chalk Brush"
	quest.5711E9243534BDAE.quest_desc: [
		"Chalk is a pain to clean up, by [#](ad03fc)right-clicking[#]() with a brush you can remove it from the world much more easily."
	]
	quest.3B559043D151BEBF.title: "The First Ritual"
	quest.3B559043D151BEBF.quest_desc: [
		"These pages will walk the gentle reader through the process of the [first ritual](entry://summoning_rituals/summon_crusher_t1) step by step."
		"\\"
		"We &lstart&r by placing the [](item://occultism:golden_sacrificial_bowl) and drawing the appropriate pentacle, [Aviar's Circle](entry://pentacles/summon_foliot) as seen on the left around it."
		"Rituals allow to summon spirits into our plane of existence, or bind them into objects or living beings. Every ritual consists of a [#](ad03fc)Pentacle[#](), [#](ad03fc)Ritual Ingredients[#]() provided via sacrificial bowls, a [#](ad03fc)Starting Item[#]() and optionally the [#](ad03fc)Sacrifice[#]() of living beings. A purple particle effect will show that the ritual is successful and in progress."
	]
	quest.0B2E97D95D6ABF82.title: "Book of Binding: Empty"
	quest.0B2E97D95D6ABF82.quest_desc: [
		"To call forth a spirit, a [#](ad03fc)Book of Binding[#]() must be used in the ritual."
		"There is a type of book corresponding to each type (or tier) of spirit."
		"To identify a spirit to summon, it's name must be written in the [#](ad03fc)Book of Binding[#](), resulting in a [#](ad03fc)Bound Book of Binding[#]() that can be used in the ritual."
	]
	quest.2CA35C400C546163.title: "Book of Binding: Foliot (Bound)"
	quest.2CA35C400C546163.quest_desc: [
		"To summon a spirit the magician needs to know their [#](ad03fc)True Name[#](). By calling the true naming during the summoning ritual the Spirit is drawn forth from [#](ad03fc)The Other Place[#]() and forced to do the summoners bidding."
		"\\"
		"\\"
		"&oIt should be noted, that it does not matter which spirit name is used in summoning, only the spirit tier is relevant.&r"
	]
	quest.14527BC9485CE9F5.title: "The Spirit Hierarchy"
	quest.14527BC9485CE9F5.quest_desc: [
		"&lWhy:&r Foliot < Djinni < Afrit < Marid."
		"The lowest identified class of spirit. Equipped with some intelligence and a modicum of power they are most often used for manual labor or minor artifacts."
		"The most commonly summoned class. There is a great variety of Djinni, differing both in intelligence and power. Djinni can be used for a variety of task, ranging from higher artifacts over possession of living beings to carrying out tasks in their Chosen Form."
	]
	quest.16CEB8D707FC6B0F.title: "Empty Magic Lamp"
	quest.16CEB8D707FC6B0F.quest_desc: [
		"Magic Lamps can be used to keep spirits safe from [#](ad03fc)Essence Decay[#]() (if the spirit has decay), while still having access to some of their powers. Right-Click on one of your workers to store and transport it as desired."
	]
	quest.22CAE8CB27182222.title: "Miner Foliot"
	quest.22CAE8CB27182222.quest_desc: [
		"&lWhy:&r A spirit miner digs in its own dimension and brings ore back."
		"By summoning a spirit into a Magic Lamp and placing it in a [Dimensional Mineshaft (see next step)](entry://getting_started/mineshaft) it can be made to mine for you in a [#](ad03fc)Mining Dimension[#]()."
		"See [Foliot Miner](entry://crafting_rituals/craft_foliot_miner) and the subsequent entries for information on how to craft spirit miners."
	]
	quest.47BFFD5BDFFC48EA.title: "Dimensional Mineshaft"
	quest.47BFFD5BDFFC48EA.quest_desc: [
		"See [Dimensional Mineshaft](entry://crafting_rituals/craft_dimensional_mineshaft) in the [Binding Rituals](category://crafting_rituals) Category."
	]
	quest.785111D423C73BF4.title: "Ore Miner Djinni"
	quest.785111D423C73BF4.quest_desc: [
		"The [#](AA00AA)Djinni[#]() miner harvests ores specifically. By discarding other blocks it is able to mine faster and"
		" more efficiently. The greater power of the djinni it damages the magic lamp relatively quickly."
	]
	quest.1F304D85DB83850F.title: "Deep Ore Miner Afrit"
	quest.1F304D85DB83850F.quest_desc: [
		"The [#](AA00AA)Afrit[#]() miner harvests ores, like djinni miners, and additionally"
		" mines some deepslate ores. This miner is faster and more efficient"
		" than the djinnis, thus damaging the magic lamp even more slowly."
	]
	quest.60BFA4BAD2244519.title: "Master Miner Marid"
	quest.60BFA4BAD2244519.quest_desc: [
		"The [#](AA00AA)Marid[#]() miner is the most powerful miner spirit, it has the fasted mining speed and best magic lamp"
		" preservation. Unlike other miner spirits they also can mine the rarest ores, such as [](item://minecraft:ancient_debris) and [](item://occultism:iesnium_ore)."
	]
	quest.62898C38547CB748.title: "Spirit Crusher"
	quest.62898C38547CB748.quest_desc: [
		"&lWhy:&r Crushes ore into dust: two dusts per ore."
		"Crusher spirits are summoned to crush ores into dusts, effectively multiplying the metal output."
		"   They will pick up appropriate ores and drop the resulting dusts into the world."
		"   A spark particle effect and a crushing sound indicate the crusher is at work."
	]
	quest.33F1EAB5F17B4004.title: "Spirit Smelter"
	quest.33F1EAB5F17B4004.quest_desc: [
		"Smelter spirits are summoned to do furnace, blast furnace, smoker and campfire process,"
		"without using fuel. They will pick up appropriate items and drop the resulting into the world."
		"A fire particle effect and a flame sound indicate the smelter is at work."
	]
	quest.05C7EA617D95F814.title: "Spirit Crystallizer"
	quest.05C7EA617D95F814.quest_desc: [
		"Crystallizer spirits are summoned to regenerate gem from their dusts and directly multiply"
		"the output of breaking gem ores. They will pick up appropriate items and drop the resulting into"
		"the world. A magical particle effect and a amethyst sound indicate the crystallizer is at work."
	]
	quest.1D0B04D9A9947955.title: "Foliot Farmer"
	quest.1D0B04D9A9947955.quest_desc: [
		"The farmer will harvest and re-plant crops in it's working area."
		" If a deposit location is set it will collect the dropped items into the specified chest."
	]
	quest.2E048D09F8C3DC88.title: "Spirit Traders"
	quest.2E048D09F8C3DC88.quest_desc: [
		"Trade spirits pick up appropriate items and throw trade results on the ground."
		"The spirit is only actively exchanging items if purple particles spawn around it."
		"\\"
		"\\"
		"&lIf you do not see any particles&r, ensure that you gave the proper item and amount."
	]
	quest.768BC79277A283F6.title: "Weather and Time Magic"
	quest.768BC79277A283F6.quest_desc: [
		"Weather magic is especially useful for farmers and others depending"
		"on specific weather. Summons spirits to modify the weather."
		"Different types of weather modification require different spirits."
		"\\"
		"\\"
		"Weather spirits will only modify the weather once and then vanish."
	]
	quest.2FB0C781AACEF443.title: "The Wild Hunt"
	quest.2FB0C781AACEF443.quest_desc: [
		"A group of legendary Greater Spirits, usually appearing in the form of wither skeletons, with their skeleton minions. The Greater Spirits are bound to their minions in such fashion that they are virtually invulnerable until their minions have been sent back to [#](ad03fc)The Other Place[#]()."
		"Besides venturing into nether dungeons, there is one more way to get these skulls. The legendary [#](ad03fc)Wild Hunt[#]() consists of [#](ad03fc)Greater Spirits[#]() taking the form of wither skeletons. While summoning the Wild Hunt is incredibly dangerous, it is the fastest way to get wither skeleton skulls."
	]
	quest.20A5250B160AC5B0.title: "Possession Rituals"
	quest.20A5250B160AC5B0.quest_desc: [
		"&lWhy:&r Possess a mob for guaranteed rare drops without hunting."
		"Possessed mobs are controlled by spirits, allowing the summoner to determine some of their properties. They usually have &lhigh drop rates&r for rare drops, but are generally harder to kill."
		"\\"
		"\\"
		"You probably will want to start by summoning a [Possessed Endermite](entry://possession_rituals/possess_endermite) to get [](item://minecraft:end_stone) to craft [Advanced Chalks](entry://getting_started/chalks)."
	]
	quest.63EFFCF318247D1D.title: "Possessed Shulker"
	quest.63EFFCF318247D1D.quest_desc: [
		"In this ritual a [#](ad03fc)Shulker[#]() is spawned using the life energy of a [#](ad03fc)Cube Mob[#]() and immediately possessed by the summoned [#](ad03fc)Afrit[#](). The [#](ad03fc)Possessed Shulker[#]() will always drop at least one [](item://minecraft:shulker_shell) when killed. You can use vanilla shulker multiplication to get normal shulkers but their have less chance to drop shells."
	]
	quest.5BA258F7F0DD5F3E.title: "Possessed Warden"
	quest.5BA258F7F0DD5F3E.quest_desc: [
		"In this ritual a [#](ad03fc)Warden[#]() is spawned using the life energy of a [#](ad03fc)Axolotl[#]() and immediately possessed by the summoned [#](ad03fc)Afrit[#](). The [#](ad03fc)Possessed Warden[#]() will always drop at least six [](item://minecraft:echo_shard) when killed and as a chance to drop [](item://minecraft:disc_fragment_5), [](item://minecraft:music_disc_otherside), [](item://minecraft:silence_armor_trim_smithing_template), [](item://minecraft:ward_armor_trim_smithing_template). If you try to escape, this possessed Warden will go to the floor like a normal warden."
	]
	quest.16B9D3C04837AABD.title: "Summoning a Horde"
	quest.16B9D3C04837AABD.quest_desc: [
		"&lWhy:&r Summons a wave of enemies: team practice and loot."
		"Summon a Wild Evoker and his henchmen to get [](item://minecraft:totem_of_undying), [](item://minecraft:vex_armor_trim_smithing_template) and [](item://minecraft:sentry_armor_trim_smithing_template)."
	]
	quest.5734A13F8CF72FE5.title: "Familiar Ring"
	quest.5734A13F8CF72FE5.quest_desc: [
		"Enterprising summoners have found a way to bind familiars into jewelry that passively applies their buff, the [Familiar Ring](entry://crafting_rituals/craft_familiar_ring)."
	]
	quest.64C5700CB6C57BCE.title: "Greedy Familiar"
	quest.64C5700CB6C57BCE.quest_desc: [
		"The greedy familiar is a Foliot that will pick up nearby items for it's master. When captured in a familiar ring it increased the pick-up range of the wearer."
		"\\"
		"\\"
		"&lUpgrade Behaviour&r\\"
		"When upgraded by a blacksmith familiar, it can find blocks for its master. [#](ad03fc)Right-click[#]() it with a block to tell it what to look for."
	]
	quest.09AE03699F6FF6FE.title: "Blacksmith Familiar"
	quest.09AE03699F6FF6FE.quest_desc: [
		"Whenever the player picks up stone, there is a chance for the blacksmith familiar to repair their equipment a little bit."
		"\\"
		"\\"
		"&lUpgrade Behaviour&r: \\"
		"Cannot be upgraded, but upgrades other Familiars."
	]
	quest.4646F00FB5F7ADC2.title: "Dragon Familiar"
	quest.4646F00FB5F7ADC2.quest_desc: [
		"Greedy familiars can ride on dragon familiars, giving the dragon the greedy effects additionally."
		"\\"
		"\\"
		"&lUpgrade Behaviour&r\\"
		"When upgraded by a blacksmith familiar, it will throw swords at nearby enemies."
	]
	quest.64F4FE179136705A.title: "Iesnium Golem"
	quest.64F4FE179136705A.quest_desc: [
		"An Iesnium Golem is a direct upgrade from a regular Iron Golem, this new version is much stronger and invulnerable. \\"
		"Only a player can dismiss them, by hitting while crouched, returning as a [](item://occultism:fragile_soul_gem)."
	]
	quest.21E8DA2E786B5EBF.title: "Resurrecting a Familiar"
	quest.21E8DA2E786B5EBF.quest_desc: [
		"The resurrection is a relatively simple process. The soul shard is strengthened with [](item://occultism:otherworld_essence) until it is strong enough to allow the familiar to return to the mortal realm and create a new body for itself."
		"\\"
		"\\"
		"The essence is obtained by growing (lots of) Demons Dream plants."
	]
	quest.05BF4C9E9D36E77F.title: "Soul Gem"
	quest.05BF4C9E9D36E77F.quest_desc: [
		"&lWhy:&r A soul gem captures a mob to move it anywhere."
		"To capture an entity, [#](AA00AA)right-click[#]() it with the soul gem. \\"
		"[#](AA00AA)right-click[#]() again to release the entity."
		"\\"
		"\\"
		"Bosses cannot be captured."
	]
	quest.78E9154728593312.title: "Infused Pickaxe"
	quest.78E9154728593312.quest_desc: [
		"After preparing the raw materials, the pickaxe needs to be infused with a spirit."
		"\\"
		"\\"
		"Follow the instructions at [Craft Infuse Pickaxe](entry://crafting_rituals/craft_infused_pickaxe)"
	]
	quest.266E74BDF17EB46A.title: "Iesnium Pickaxe"
	quest.266E74BDF17EB46A.quest_desc: [
		"Like the [Infused Pickaxe](entry://getting_started/infused_pickaxe), this pickaxe can be used to mine Tier 2 Otherworld Materials such as [](item://occultism:iesnium_ore). As it is made from metal, instead of brittle [](item://occultism:spirit_attuned_gem), it is very durable and can be used for a long time."
	]
	quest.7B3F08C22542815B.title: "Iesnium Anvil"
	quest.7B3F08C22542815B.quest_desc: [
		"The [](item://occultism:iesnium_anvil) is a [#](AA00AA)Marid[#]() infusion."
		"This anvil has some improvements:"
		"1. Is unbreakable;"
		"2. Can exceed the maximum level of enchantments by 1;"
		"3. Marid will pay half of the showed level cost (round up);"
		"4. The cost increase of working with the same item is reduced;"
		"5. The maximum cost limit is increased;"
	]
	quest.7E30173AF0DAA1A7.title: "Tier 1 Dimensional Storage Stabilizer"
	quest.7E30173AF0DAA1A7.quest_desc: [
		"&lWhy:&r Stabilizers around the actuator raise storage capacity."
		"The stabilizer system works by tier, starting from 0 (which does not add space) up to 5."
		"\\"
		"\\"
		"To get started, see the recipes and instructions on the following pages."
	]
	quest.7005DBFFDE4D8507.title: "Tier 4 Dimensional Storage Stabilizer"
	quest.7005DBFFDE4D8507.quest_desc: [
		"This highly advanced storage stabilizer is inhabited by a [#](AA00AA)Marid[#]() that supports the dimensional matrix"
		" in keeping the storage dimension stable, thus allowing to store more items."
		"\\"
		"\\"
		"By default each Tier 4 Stabilizer adds &l512&r item types and 4098000 items storage capacity."
	]
	quest.777B0130DE546921.title: "Storage Accessor"
	quest.777B0130DE546921.quest_desc: [
		"The [](item://occultism:storage_remote) can be linked to a [](item://occultism:storage_controller) by shift-clicking."
		" The [#](AA00AA)Djinni[#]() bound to the accessor will then be able to"
		" access items from the actuator even from across dimensions."
	]
	quest.281C924603403A40.title: "Stable Wormhole"
	quest.281C924603403A40.quest_desc: [
		"The Storage Actuator behaves much like a big chest or shulker box."
		" That means, hoppers and pipes can insert and extract items."
	]
	quest.1B5A0ED0BD2CD9FC.title: "Surprisingly Substantial Satchel"
	quest.1B5A0ED0BD2CD9FC.quest_desc: [
		"&lWhy:&r A dimensional satchel: bigger inside than outside."
		"A [#](AA00AA)Foliot[#]() is bound to the satchel, tasked with &lslightly&r warping reality. This allows to store more"
		" items in the satchel than its size would indicate, making it a practical travellers companion."
	]
	quest.0B2A09B8ED730BCA.title: "Apprentice Ritual Satchel"
	quest.0B2A09B8ED730BCA.quest_desc: [
		"&lWhy:&r Places a whole ritual circle from the satchel in a few clicks."
		"Visit the entry about the [Apprentice Satchel](entry://crafting_rituals/apprentice_ritual_satchel) or the [Artisanal Satchel](entry://crafting_rituals/apprentice_ritual_satchel) in the [Binding Rituals Category](category://crafting_rituals) to learn how to enchant a satchel and use it for rituals."
	]
	quest.1BAEF5BAEF1A9803.title: "Entity Wormhole"
	quest.1BAEF5BAEF1A9803.quest_desc: [
		"To set the destination, you''ll need a compass. Right-click to place it and shift+right-click to remove it."
		"+ A standard compass takes you to the world spawn;"
		"+ A compass attached to a lodestone takes you to the top of it. (After placing it in the wormhole, the lodestone can be broken);"
	]
	quest.77EC4B9921BBA1C4.title: "True Sight Staff"
	quest.77EC4B9921BBA1C4.quest_desc: [
		"The [](item://occultism:true_sight_staff) employs an [#](AA00AA)Marid[#]() to assist the summoner in tasks of finding and interacting with the otherworld."
		" Unlike [#](AA00AA)Foliot[#]() in the otherworld goggles, which can only provide vision, with this staff in the off-hand or curio slot, the occultist can collect otherworld materials."
		" The divining rods search abilities receive an upgrade, now is possible locate any block."
	]
	quest.1EE09B08F3B6567C.title: "Vitality Compass"
	quest.1EE09B08F3B6567C.quest_desc: [
		"The [](item://occultism:vitality_compass) is a mystical tool infused with a [#](AA00AA)Foliot[#]()"
		" that allows it to be attuned to the essence of living beings."
		" By right-clicking on a creature, you bind its life force to the compass,"
		" allowing the needle to always point toward its location no matter the distance (while loaded)."
	]
	quest.7526D01774227A65.title: "Knowledge Tablet"
	quest.7526D01774227A65.quest_desc: [
		"This item use is very simple: \\"
		"[#](55FF55)Right-Click[#]() will storage all of your experience points. \\"
		"[#](55FF55)Shift-Right-Click[#]() receive all stored points. \\"
		"\\"
		"NOTE: Sometimes, with big values, you can lost a small quantity of point due numerical approximations."
	]
	quest.529F0FBF184DE56C.title: "Unbound Spirits"
	quest.529F0FBF184DE56C.quest_desc: [
		"Generally spirits are summoned [#](ad03fc)bound[#](), which refers to any condition that keeps them under control of the summoner. A side effect of binding spells is that part of the spirit remains in [#](ad03fc)The Other Place[#](), robbing them of large portions of the power, but at the same time also protecting their essence from foreign access in this world."
	]
	quest.2DD49A38DAC38A8E.title: "Marid Essence"
	quest.2DD49A38DAC38A8E.quest_desc: [
		"[](item://occultism:marid_essence)  is required to safely control the most powerful spirits, commonly used"
		" in the form of blue chalk. To obtain the essence, an [#](AA00AA)Marid[#]() needs to be summoned"
		" unbound into this plane, and killed. Be warned that this is no simple endeavour,"
		" and unbound spirit presents great danger to all nearby."
	]
	quest.32764B23238080CF.title: "Dimensional Battlefield"
	quest.32764B23238080CF.quest_desc: [
		"The dimensional battlefield will discard any items it cannot store, so it is important"
		"  to regularly empty the output, either manually, with hoppers or using a transporter spirit.\\"
		"  Interactions per side:"
		"  + Top -> input slots (gem, weapon, fuel);"
		"  + Bottom -> loot slots;"
		"  + Other -> all slots;"
	]
	quest.4CE75A9F1AC7342B.title: "Master of Spirits"
	quest.4CE75A9F1AC7342B.quest_desc: [
		"Spirits mine, smelt, carry and store for you."
	]
	chapter.6F2A8A724E748B44.title: "Alchemy"
	chapter.6F2A8A724E748B44.chapter_subtitle: [
		"Potions everyone needs"
	]
	quest.0FE6B961A2B65B01.title: "The Brewing Stand"
	quest.0FE6B961A2B65B01.quest_subtitle: "Where alchemy begins"
	quest.0FE6B961A2B65B01.quest_desc: [
		"&lWhat:&r the alchemist is the trade hub. Ingredients come &lfrom every role&r, and everyone needs the potions."
		"&lHow to start:&r a brewing stand + nether wart + water bottles is the base. Blaze powder is the fuel."
		"&lTip:&r every potion recipe is in EMI (&lU&r on a water bottle)."
	]
	quest.4ADED478BA38BECC.title: "The Alchemist's Cauldron"
	quest.4ADED478BA38BECC.quest_subtitle: "Iron's Spells"
	quest.4ADED478BA38BECC.quest_desc: [
		"The alchemist's cauldron brews potions in big batches and makes &link&r for scrolls. Put it over a fire."
		"&lValued by:&r Iron's mages — no ink, no new scrolls."
	]
	quest.1B9EEE85EBDBA92D.title: "Potion of Quiet"
	quest.1B9EEE85EBDBA92D.quest_subtitle: "The world doesn't notice you"
	quest.1B9EEE85EBDBA92D.quest_desc: [
		"&lEffect:&r hostile mobs ignore you for 8 minutes — until you strike first."
		"&lRecipe:&r water bottle + lavender (from the &lgardener&r) + feather (from the &lbreeder&r) + amethyst shard."
		"Brew it and tick the quest. The best gift for those who'd rather stroll than fight."
	]
	quest.67BE72A396A69007.title: "Potion of the Sea Wolf"
	quest.67BE72A396A69007.quest_subtitle: "For the angler"
	quest.67BE72A396A69007.quest_desc: [
		"Fishing luck, water breathing and night vision for 8 minutes."
		"&lRecipe:&r water + raw fish (from the &langler&r) + prismarine crystals + glow ink sac."
	]
	quest.3B96C193ACA277A9.title: "Potion of Fertility"
	quest.3B96C193ACA277A9.quest_subtitle: "For the gardener"
	quest.3B96C193ACA277A9.quest_desc: [
		"Crops around you grow faster for 5 minutes. Walk your fields and watch the harvest ripen."
		"&lRecipe:&r water + honey (from the &lbeekeeper&r) + bone meal + organic compost (from the &lcook&r)."
	]
	quest.1051DF3F4385D339.title: "Potion of Beast Trust"
	quest.1051DF3F4385D339.quest_subtitle: "For the breeder"
	quest.1051DF3F4385D339.quest_desc: [
		"Young animals near you grow up much faster for 8 minutes."
		"&lRecipe:&r water + koi (from the &langler&r) + golden carrot + wheat."
	]
	quest.2674C9B3CA6719CA.title: "Potion of Forge Heat"
	quest.2674C9B3CA6719CA.quest_subtitle: "For the engineer"
	quest.2674C9B3CA6719CA.quest_desc: [
		"Fire resistance and Haste II for 8 minutes — working by lava and smelters becomes a pleasure."
		"&lRecipe:&r water + blaze powder + ancient metal nugget (from the &lexplorer&r of Cataclysm ruins) + magma cream."
	]
	quest.5D3473C41AD56DA7.title: "Potion of Clean Breath"
	quest.5D3473C41AD56DA7.quest_subtitle: "Against smog and acid rain"
	quest.5D3473C41AD56DA7.quest_desc: [
		"For 10 minutes it shields you from poison, nausea, wither and blindness — what smog and acid rain inflict."
		"&lRecipe:&r water + source gem (from the &lmage&r) + moss block + kelp."
	]
	quest.30B0F5FAE9A6FB57.title: "Potion of Lead Blood"
	quest.30B0F5FAE9A6FB57.quest_subtitle: "Flushes radiation"
	quest.30B0F5FAE9A6FB57.quest_desc: [
		"Every 10 seconds some radiation leaves your body — for 3 minutes. Keep a couple of bottles by the reactor."
		"&lRecipe:&r water + lead ingot (from the &lengineer&r) + source gem (from the &lmage&r) + milk bucket."
	]
	quest.3C60CB78B824B591.title: "Potion of Star Sight"
	quest.3C60CB78B824B591.quest_subtitle: "See danger through walls"
	quest.3C60CB78B824B591.quest_desc: [
		"For 5 minutes hostile creatures within 48 blocks glow through walls. Indispensable in dungeons."
		"&lRecipe:&r water + eye of ender (from the &lwarrior&r) + glowstone dust + spyglass."
	]
	quest.31625BC464DBB176.title: "The Alchemist's Shop"
	quest.31625BC464DBB176.quest_subtitle: "Potions for the whole group"
	quest.31625BC464DBB176.quest_desc: [
		"Set up a potion display for your friends. Everyone needs you — from cook to warrior."
		"&lTip:&r milk clears every effect, good or bad. Carry a bucket for emergencies."
	]
	quest.11474F8C95A5E393.title: "The Potion of Healing"
	quest.11474F8C95A5E393.quest_desc: [
		"Glistering melon (from the gardener) → healing potions. A must in every warrior's bag."
	]
	quest.7C9D175FDA380D93.title: "Fire Resistance"
	quest.7C9D175FDA380D93.quest_desc: [
		"Magma cream → fire resistance. Your pass to the Nether and lava fishing."
	]
	quest.4FB4B154BE3A7A58.title: "Night Vision"
	quest.4FB4B154BE3A7A58.quest_desc: [
		"Golden carrot → night vision. Miners and anglers will thank you."
	]
	quest.4D893299F364F7FE.title: "Longer and Stronger"
	quest.4D893299F364F7FE.quest_desc: [
		"Redstone extends a potion, glowstone strengthens it, gunpowder makes it splash, dragon's breath makes it linger."
	]
	quest.4FCD47C6DC0C521C.title: "Milk, the Universal Cure"
	quest.4FCD47C6DC0C521C.quest_desc: [
		"A bucket of milk clears every effect. Every world debuff has at least two counters — and milk is always one of them."
	]
	quest.51730512DD377681.title: "The Witch's Cauldron"
	quest.51730512DD377681.quest_desc: [
		"Toil and Trouble turns the plain cauldron into an alchemical one: fill it with milk, honey or slime and brew mixtures."
	]
	chapter.7D28E0E94CE0CCF8.title: "Adventure"
	chapter.7D28E0E94CE0CCF8.chapter_subtitle: [
		"Dungeons, dimensions and bosses — when you want them"
	]
	quest.483595C3466D106D.title: "On the Road"
	quest.483595C3466D106D.quest_subtitle: "Sword, shield and food"
	quest.483595C3466D106D.quest_desc: [
		"&lWhat:&r this chapter is for adventure seekers. Everything here is in &lzones 2–3&r: wilds, dungeons, dimensions."
		"&lHow to prepare:&r sword, shield, armour, buff food from the cook, potions from the alchemist, a return scroll."
		"Chest loot is per player — go as a group."
	]
	quest.11213DE6310C1D6A.title: "The First Dungeon"
	quest.11213DE6310C1D6A.quest_subtitle: "YUNG's, When Dungeons Arise, Dungeons and Taverns"
	quest.11213DE6310C1D6A.quest_desc: [
		"Dozens of new structures dot the world: dungeons, towers, ships, temples, taverns."
		"Find any of them and empty at least one chest. Taverns are safe — rest there."
	]
	quest.16E1CA1EF5B21B46.title: "The Nether's Heat"
	quest.16E1CA1EF5B21B46.quest_subtitle: "Zone 3"
	quest.16E1CA1EF5B21B46.quest_desc: [
		"Build an obsidian portal and step through. Inside: blazes for Create, quartz for AE2, nether cuisine and fortresses."
		"&lTip:&r fire resistance (or Forge Heat) saves lives."
	]
	quest.739285040B5B0234.title: "The Twilight Forest"
	quest.739285040B5B0234.quest_subtitle: "Eternal dusk and a chain of bosses"
	quest.739285040B5B0234.quest_desc: [
		"&lHow to get there:&r throw a diamond into a pool ringed with flowers — a portal opens."
		"The Twilight Forest is a whole dimension with progression: Naga → Lich → Hydra → Minoshroom → Knight Phantoms → Ur-Ghast → Yeti → Snow Queen."
		"Each boss unlocks the next part of the forest."
	]
	quest.5435E49C41CDE3FF.title: "The Naga"
	quest.5435E49C41CDE3FF.quest_subtitle: "The first guardian"
	quest.5435E49C41CDE3FF.quest_desc: [
		"A giant serpent in a stone courtyard. Stay clear of her charge and hit her sides."
	]
	quest.4B8828721D42DE2A.title: "The Lich"
	quest.4B8828721D42DE2A.quest_subtitle: "The dark mage's tower"
	quest.4B8828721D42DE2A.quest_desc: [
		"The Lich hides behind shields and decoys. Break the shields — then hit the real one. Your group's mages shine here."
	]
	quest.3407660309397086.title: "The Hydra"
	quest.3407660309397086.quest_subtitle: "The fire swamp"
	quest.3407660309397086.quest_desc: [
		"A three-headed hydra in the fire swamp. Fire resistance is a must. The reward: fiery blood for the forest's best armour."
	]
	quest.29EFEF68F03D66A9.title: "The Aether"
	quest.29EFEF68F03D66A9.quest_subtitle: "Islands in the sky"
	quest.29EFEF68F03D66A9.quest_desc: [
		"&lHow to get there:&r a glowstone frame and a water bucket. The Aether is a sky of clouds and floating islands."
		"It has its own ores, rideable moas and sky dungeons with Valkyries."
	]
	quest.3020E46100BB3368.title: "The Slider"
	quest.3020E46100BB3368.quest_subtitle: "The bronze dungeon"
	quest.3020E46100BB3368.quest_desc: [
		"The stone cube guarding the bronze dungeon. Don't stand in its way."
	]
	quest.22E49A43159B2841.title: "The Undergarden"
	quest.22E49A43159B2841.quest_subtitle: "A world below"
	quest.22E49A43159B2841.quest_desc: [
		"A gloomy underground dimension of giant fungi and strange beasts. The portal uses stone bricks and a catalyst."
	]
	quest.241D0F92C3E12524.title: "The Otherside"
	quest.241D0F92C3E12524.quest_subtitle: "Deeper and Darker"
	quest.241D0F92C3E12524.quest_desc: [
		"Beyond the portal in an Ancient City lies the sculk dimension. Quiet: here, every step is heard."
	]
	quest.5191867CC65E64EB.title: "The Bee Dimension"
	quest.5191867CC65E64EB.quest_subtitle: "The Bumblezone"
	quest.5191867CC65E64EB.quest_desc: [
		"Throw an ender pearl into a bee nest — and you're in a world of honey and comb. Don't anger the bees!"
	]
	quest.256C62572DAB7621.title: "Cataclysm"
	quest.256C62572DAB7621.quest_subtitle: "L_Ender's Cataclysm bosses"
	quest.256C62572DAB7621.quest_desc: [
		"Giant bosses in special structures: the Netherite Monstrosity, Ignis, the Ender Guardian, the Leviathan…"
		"The peak of the combat branch. Prepare seriously: best armour, food, potions, friends."
	]
	quest.662910273F2B230B.title: "The Iron Knight"
	quest.662910273F2B230B.quest_subtitle: "Mowzie's Mobs"
	quest.662910273F2B230B.quest_desc: [
		"The Ferrous Wroughtnaut sleeps in an underground hall. Hit his back when his axe gets stuck in the floor."
	]
	quest.38AEAB79267D768C.title: "The Ice Sea"
	quest.38AEAB79267D768C.quest_subtitle: "Aquamirae"
	quest.38AEAB79267D768C.quest_desc: [
		"Ghost ships stand in the frozen seas. Captain Cornelia waits on one of them. Cold, scary, beautiful."
	]
	quest.5814EB842FA7B370.title: "The End"
	quest.5814EB842FA7B370.quest_subtitle: "The dragon awaits"
	quest.5814EB842FA7B370.quest_desc: [
		"Find a stronghold with an End portal. The dragon is the classic trial; beyond it lie the End islands with chorus and shulkers."
	]
	quest.20B6AA7E95CCB7D5.title: "Hero of Arkhaven"
	quest.20B6AA7E95CCB7D5.quest_subtitle: "Three worlds conquered"
	quest.20B6AA7E95CCB7D5.quest_desc: [
		"The Nether, the Twilight Forest and the Aether are behind you. Boss trophies feed the &lGreat Works&r — bring them home."
	]
	quest.1957C1B40843F000.title: "A Roadside Tavern"
	quest.1957C1B40843F000.quest_desc: [
		"Dungeons and Taverns: the world has taverns with traders and maps to dungeons. A safe place to rest."
	]
	quest.5A77759DFBE67C95.title: "Living Villages"
	quest.5A77759DFBE67C95.quest_desc: [
		"CTOV villages differ in every biome, and MCA villagers have names and personalities. Make friends."
	]
	quest.1259337CB58F1C9E.title: "Ironwood"
	quest.1259337CB58F1C9E.quest_desc: [
		"Ironwood ingots make the Twilight Forest's first armour."
	]
	quest.2E1D43BB1E766B59.title: "The Minoshroom"
	quest.2E1D43BB1E766B59.quest_desc: [
		"A labyrinth under the swamp, and at its heart the Minoshroom. Its axe is a great weapon."
	]
	quest.3900D125095728FD.title: "The Knight Phantoms"
	quest.3900D125095728FD.quest_desc: [
		"The phantom knights' stronghold. Knightmetal makes the forest's toughest armour."
	]
	quest.5AA2916146AB0FE5.title: "The Ur-Ghast"
	quest.5AA2916146AB0FE5.quest_desc: [
		"The Dark Tower and its weeping guardian. Its tears forge fiery ingots."
	]
	quest.78AFBA41AFAA0319.title: "The Twilight Snows"
	quest.78AFBA41AFAA0319.quest_desc: [
		"The Alpha Yeti and the Snow Queen — the finale of the forest's frozen lands."
	]
	quest.73113DD67E148277.title: "Zanite"
	quest.73113DD67E148277.quest_desc: [
		"The Aether's blue gemstone. Zanite tools get stronger as they wear."
	]
	quest.0B1C9822CA3D917F.title: "The Valkyrie Queen"
	quest.0B1C9822CA3D917F.quest_desc: [
		"The silver dungeon and its queen. Her lance strikes from far away."
	]
	quest.13F13D09D97F5AFC.title: "The Sun Spirit"
	quest.13F13D09D97F5AFC.quest_desc: [
		"The Aether's gold dungeon and its fiery master. The sky world's finale."
	]
	quest.7D35BB7FBDAEF93B.title: "Undergarden Metals"
	quest.7D35BB7FBDAEF93B.quest_desc: [
		"Cloggrum, froststeel and forgotten metal — they make weapons against Undergarden beasts."
	]
	quest.3D37C20ACFC1671F.title: "The Reinforced Echo Shard"
	quest.3D37C20ACFC1671F.quest_desc: [
		"The Otherside's most precious prize. It makes gear stronger than netherite."
	]
	quest.20D49507FD947801.title: "Ignis"
	quest.20D49507FD947801.quest_desc: [
		"The flaming knight of the Burning Arena. Ignitium armour — fire resistance forever."
	]
	quest.665F15D3591B91CB.title: "The Ender Guardian"
	quest.665F15D3591B91CB.quest_desc: [
		"An ancient golem guards ruins in the End. Go as a group."
	]
	quest.591B863A25456EA2.title: "The Leviathan"
	quest.591B863A25456EA2.quest_desc: [
		"The monster of the sunken city. Don't go without Sea Wolf and water breathing."
	]
	quest.5CDB9F3F46E94031.title: "The Frostmaw"
	quest.5CDB9F3F46E94031.quest_desc: [
		"A giant snow beast sleeps in the frozen wastes. Its ice crystal grants frost breath."
	]
	quest.34C186A7C66EB616.title: "Umvuthi"
	quest.34C186A7C66EB616.quest_desc: [
		"The chief of masks in the savanna. The Sol Visage unleashes solar strikes."
	]
	quest.2D00EB21A23B01B1.title: "Lord Pumpkinhead"
	quest.2D00EB21A23B01B1.quest_desc: [
		"Born in Chaos: a Halloween rider appears in the wilds at night. Scary and fun."
	]
	quest.1079865D0DAE982A.title: "Honey Crystals"
	quest.1079865D0DAE982A.quest_desc: [
		"Honey crystals grow in the Bumblezone — for decor and potions."
	]
	chapter.6C18F64911A2B1CF.title: "Bosses"
	chapter.6C18F64911A2B1CF.chapter_subtitle: [
		"Every boss in the pack by difficulty: where, how, and what they drop"
	]
	quest.4410202D5D65CC82.title: "How to Go Boss Hunting"
	quest.4410202D5D65CC82.quest_subtitle: "Preparation wins"
	quest.4410202D5D65CC82.quest_desc: [
		"&lFood:&r buff dishes from «Kitchen» (+health, +regeneration) matter more than armour."
		"&lPotions:&r Arkhaven alchemy: Fire Skin, Sea Wolf, Star Sight."
		"&lTeam:&r most bosses are tuned for 2–4 players; voice chat: hold Caps Lock."
		"&lDeath isn't scary:&r your items stay in a grave (Gravestone), shown on the map."
		"The first bosses (Naga, Lich, Hydra…) are in «Adventure»; here are the rest, from easy to terrifying."
	]
	quest.1F2BDC9B56A66070.title: "Elder Guardian"
	quest.1F2BDC9B56A66070.quest_subtitle: "Ocean monument (YUNG's)"
	quest.1F2BDC9B56A66070.quest_desc: [
		"&lWhere:&r the ocean monument, now large and mazy (YUNG's Better Ocean Monuments)."
		"&lHow:&r water breathing + Sea Wolf potion, an Efficiency pickaxe against Mining Fatigue."
		"&lDrops:&r sponges and the way to the gold vault."
	]
	quest.7FDA77FBFA63A374.title: "Sea Cliff Naga"
	quest.7FDA77FBFA63A374.quest_subtitle: "Mowzie's Mobs"
	quest.7FDA77FBFA63A374.quest_desc: [
		"&lWhere:&r sea cliffs on coasts: a flying serpent that spits acid."
		"&lHow:&r a bow or a gun: you can't reach it in melee. When it lands after a volley, strike."
		"&lDrops:&r a naga fang: a dagger that hits twice as hard from behind."
	]
	quest.6D48B66E9EDD2995.title: "The Harbinger"
	quest.6D48B66E9EDD2995.quest_subtitle: "L_Ender's Cataclysm"
	quest.6D48B66E9EDD2995.quest_desc: [
		"&lWhere:&r the Ancient Factory deep underground. A mechanical challenge with a mechanical answer."
		"&lHow:&r keep distance and hide behind pillars from missiles; enchanted arrows and the Create potato cannon work well."
		"&lDrops:&r a shoulder launcher that fires wither missiles."
	]
	quest.1FE4D8FDD4016F78.title: "Ancient Remnant"
	quest.1FE4D8FDD4016F78.quest_subtitle: "Cursed Pyramid"
	quest.1FE4D8FDD4016F78.quest_desc: [
		"&lWhere:&r the Cursed Pyramid in the desert, past poison dart traps and cave-ins."
		"&lHow:&r jump over sand shockwaves; a shield against the summoned rhino charge."
		"&lDrops:&r the desert necklace and Wrath of the Desert: a sandstorm in a bottle."
	]
	quest.5EB85EE4DB2B3D9C.title: "Maledictus"
	quest.5EB85EE4DB2B3D9C.quest_subtitle: "Frosted Prison"
	quest.5EB85EE4DB2B3D9C.quest_desc: [
		"&lWhere:&r the Frosted Prison in snowy mountains."
		"&lHow:&r fire weapons and Fire Skin; he teleports behind you: listen for the sound."
		"&lDrops:&r the cursed bow and materials for cursium armour."
	]
	quest.3EB7C64998CAB5DA.title: "Scylla"
	quest.3EB7C64998CAB5DA.quest_subtitle: "The Acropolis in a storm"
	quest.3EB7C64998CAB5DA.quest_desc: [
		"&lWhere:&r the Acropolis, an island in the ocean. The fight happens in a thunderstorm: lightning hits the water."
		"&lHow:&r stay out of the water during the storm and keep away from her trident."
		"&lDrops:&r Ceraunus: a lightning harpoon."
	]
	quest.2255F1DB63D8BF05.title: "Forgotten Guardian"
	quest.2255F1DB63D8BF05.quest_subtitle: "The Undergarden"
	quest.2255F1DB63D8BF05.quest_desc: [
		"&lWhere:&r the Undergarden catacombs: a faceless stone giant."
		"&lHow:&r only heavy weapons crack its armour; step back when it raises its arm."
		"&lDrops:&r forgotten ingots, the best metal of the Undergarden."
	]
	quest.398E5ED307D56633.title: "The Warden"
	quest.398E5ED307D56633.quest_subtitle: "The Ancient City"
	quest.398E5ED307D56633.quest_desc: [
		"&lYou can skip the fight:&r the Warden is blind and hunts by sound. Wool on the floor, sneaking, and it won't hear you."
		"&lIf you do fight:&r 500 health, armour-piercing hits and a sonic boom through walls. Team only, with strength potions."
		"&lDrops:&r the Warden carapace: Deeper Darker armour that muffles your steps."
	]
	quest.722992FA95424743.title: "The Stalker"
	quest.722992FA95424743.quest_subtitle: "The Otherside"
	quest.722992FA95424743.quest_desc: [
		"&lWhere:&r the Ancient Temple on the Otherside (Deeper Darker): a Warden's relative that can see."
		"&lHow:&r light and noise are useless against it, only force. Resonarium weapons cut through sculk."
		"&lDrops:&r the way to soul elytra: wings that take off by themselves."
	]
	quest.5674AA37716E1DFD.title: "Lord of Flame"
	quest.5674AA37716E1DFD.quest_subtitle: "Iron's Spells"
	quest.5674AA37716E1DFD.quest_desc: [
		"&lWhere:&r the pyromancer tower (Iron's Spells): watch your map."
		"&lHow:&r ice and water spells, Fire Skin and a shield against fireballs."
		"&lDrops:&r high-tier fire school spellbooks."
	]
	quest.41A4DAE8E0472BDE.title: "Wilden Chimera"
	quest.41A4DAE8E0472BDE.quest_subtitle: "Ars Nouveau"
	quest.41A4DAE8E0472BDE.quest_desc: [
		"&lWhere:&r summoned by the Wilden Summon ritual: the fight is in your back yard, if you like."
		"&lHow:&r Harm + Amplify spells, step aside from the charge; the chimera has three phases."
		"&lDrops:&r the Wilden Tribute, key to archmage relics."
	]
	quest.0469A33BAB569676.title: "The Headless Lord"
	quest.0469A33BAB569676.quest_subtitle: "Born in Chaos"
	quest.0469A33BAB569676.quest_desc: [
		"&lWhere:&r a rare night rider of the wilds: zone rules keep him away from spawn and bases."
		"&lHow:&r light and holy weapons; his steed is stronger than the rider: take the horse first."
		"&lDrops:&r Soulbane, a life-stealing sword."
	]
	quest.176452C5B53F2D70.title: "The Maw of the Ice Sea"
	quest.176452C5B53F2D70.quest_subtitle: "Aquamirae"
	quest.176452C5B53F2D70.quest_desc: [
		"&lWhere:&r the icy seas of Aquamirae, where the ghost ships sail."
		"&lHow:&r from a Small Ships ship, with cannons; better not jump into the water with it."
		"&lDrops:&r abyssal amethyst for abyssal armour."
	]
	quest.221D262C7B1A153F.title: "Monster Hunter"
	quest.221D262C7B1A153F.quest_subtitle: "Eight great victories"
	quest.221D262C7B1A153F.quest_desc: [
		"You've beaten the ones they tell stories about in taverns. Hang a trophy (Handcrafted) in your hall so newcomers know whom to ask for advice."
		"&lRematch:&r the Boss Respawner (Cataclysm) brings a beaten boss back to its lair."
	]
	chapter.67DBF023F7901684.title: "Dungeons and Structures"
	chapter.67DBF023F7901684.chapter_subtitle: [
		"Find it, enter it, survive: personal loot in every chest"
	]
	quest.124FA016AD13E65C.title: "How to Find Dungeons"
	quest.124FA016AD13E65C.quest_subtitle: "Maps, Lootr and zones"
	quest.124FA016AD13E65C.quest_desc: [
		"&lWhy:&r dungeons hold the best gear without grinding: spellbooks, gunpowder, steel, rare seeds."
		"&lHow to find them:&r cartographers sell maps, Xaero marks what you've found, and wandering is more fun than a compass."
		"&lLootr:&r a chest looks shared, but each player gets their own loot. Came second? You still find yours."
		"&lA quest completes&r when you stand inside the structure."
	]
	quest.398D7D0D31B16A8C.title: "A Roadside Tavern"
	quest.398D7D0D31B16A8C.quest_subtitle: "Dungeons & Taverns"
	quest.398D7D0D31B16A8C.quest_desc: [
		"A safe spot: an innkeeper, a cartographer and a board of maps to nearby dungeons. A good first travel goal."
		"Taverns appear in every forest; the oak one counts for this quest."
	]
	quest.3DC14FDAB04AB0DE.title: "Skeleton Crypt"
	quest.3DC14FDAB04AB0DE.quest_subtitle: "YUNG's Better Dungeons"
	quest.3DC14FDAB04AB0DE.quest_desc: [
		"An underground crypt with several halls and spawners. &lTip:&r break the spawner or light it up all around."
		"Good practice before the big dungeons."
	]
	quest.1DD3D00D98540144.title: "Abandoned Mineshaft"
	quest.1DD3D00D98540144.quest_subtitle: "YUNG's Better Mineshafts"
	quest.1DD3D00D98540144.quest_desc: [
		"Mineshafts are big now: loot minecarts, ladders, cave-ins. Ores show in the walls: bring a good pickaxe."
	]
	quest.14590C32AE474724.title: "Illager Camp"
	quest.14590C32AE474724.quest_subtitle: "TaCZ shooters"
	quest.14590C32AE474724.quest_desc: [
		"Camp illagers are often armed with &lfirearms&r (TaCZ NPCs): pistols and rifles. Approach from cover."
		"&lLoot:&r their gun sometimes drops: a free firearm."
	]
	quest.24FE42BA2A7CCC9B.title: "Illager Fort"
	quest.24FE42BA2A7CCC9B.quest_subtitle: "When Dungeons Arise"
	quest.24FE42BA2A7CCC9B.quest_desc: [
		"A fortress with towers and dozens of illagers, more than half with guns. This is an assault: bring a team, healing and armour."
		"&lTactics:&r pick off the wall shooters from afar (a TaCZ sniper), then breach the gate."
	]
	quest.6A4762E3C93C0B5B.title: "Illager Galley"
	quest.6A4762E3C93C0B5B.quest_subtitle: "Boarding"
	quest.6A4762E3C93C0B5B.quest_desc: [
		"An illager ship on the open sea. Sail up in your Small Ships ship, fire a broadside and board it (grappling hook from «Weapons»)."
	]
	quest.6EBAA1CC314A251D.title: "Bandit Village"
	quest.6EBAA1CC314A251D.quest_subtitle: "When Dungeons Arise"
	quest.6EBAA1CC314A251D.quest_desc: [
		"Bandits have taken a village on stilts. Shooters on the roofs, traps on the walkways. Loot: gunpowder, steel, gold."
	]
	quest.1AA7A9B0DC93023F.title: "Mining System"
	quest.1AA7A9B0DC93023F.quest_subtitle: "When Dungeons Arise"
	quest.1AA7A9B0DC93023F.quest_desc: [
		"A huge mine with lifts and minecarts. Spiders and zombie miners inside, and rich chests of ore and tools at the end."
	]
	quest.67026509AEC7D314.title: "The Foundry"
	quest.67026509AEC7D314.quest_subtitle: "Fire and lava"
	quest.67026509AEC7D314.quest_desc: [
		"An abandoned steelworks: lava streams and fire mobs. &lBring:&r Fire Skin or fire resistance."
		"&lReward:&r ingots and metal blocks, a boost for engineers."
	]
	quest.33B479E1E8E88664.title: "Monastery"
	quest.33B479E1E8E88664.quest_subtitle: "When Dungeons Arise"
	quest.33B479E1E8E88664.quest_desc: [
		"A mountain monastery with a library. &lFor mages:&r enchanted books and Ars Nouveau ingredients."
	]
	quest.68FD7B1F449B1EB6.title: "Plague Asylum"
	quest.68FD7B1F449B1EB6.quest_subtitle: "Bring an antidote"
	quest.68FD7B1F449B1EB6.quest_desc: [
		"A grim hospital in the swamp: poison at every step. &lBring:&r milk and Clean Breath from Arkhaven alchemy."
	]
	quest.0829E4B42B4D1A82.title: "Thornborn Towers"
	quest.0829E4B42B4D1A82.quest_subtitle: "When Dungeons Arise"
	quest.0829E4B42B4D1A82.quest_desc: [
		"Towers wrapped in thorns, and their guardians. The climb itself is a trial: a grappling hook helps a lot."
	]
	quest.1BAE5339A9DDE90E.title: "Heavenly Challenger"
	quest.1BAE5339A9DDE90E.quest_subtitle: "A dungeon in the clouds"
	quest.1BAE5339A9DDE90E.quest_desc: [
		"A flying fortress far above the ground. Reach it by airship, plane or elytra: there's only a drop below."
	]
	quest.0DD810CD0C1C7B8F.title: "Undead Pirate Ship"
	quest.0DD810CD0C1C7B8F.quest_subtitle: "When Dungeons Arise"
	quest.0DD810CD0C1C7B8F.quest_desc: [
		"A ghost pirate ship crewed by skeletons. The captain's cabin holds the best treasure of the sea."
	]
	quest.322941DAB346E48E.title: "Shiraz Palace"
	quest.322941DAB346E48E.quest_subtitle: "The richest dungeon"
	quest.322941DAB346E48E.quest_desc: [
		"A huge desert palace: several floors, guards, traps and a treasury. Go with at least three."
	]
	quest.2F44F8C0075501B1.title: "Mage Catacombs"
	quest.2F44F8C0075501B1.quest_subtitle: "Iron's Spells"
	quest.2F44F8C0075501B1.quest_desc: [
		"Underground catacombs with necromancers. Scrolls and spellbooks: the main loot for mages."
	]
	quest.31BFEC0EEAA7251A.title: "The Citadel"
	quest.31BFEC0EEAA7251A.quest_subtitle: "The Dead King's lair"
	quest.31BFEC0EEAA7251A.quest_desc: [
		"A dark citadel, home of the Dead King (quest in the «Iron's Spells» chapter). Loot: rare runes and mithril scrolls."
	]
	quest.682C987E312106E8.title: "Sunken City"
	quest.682C987E312106E8.quest_subtitle: "The Leviathan's lair"
	quest.682C987E312106E8.quest_desc: [
		"A city on the ocean floor, with the way to the Leviathan. &lBring:&r water breathing for the whole team and a trident."
	]
	quest.65DEA3AA471B1627.title: "Ancient Factory"
	quest.65DEA3AA471B1627.quest_subtitle: "The Harbinger's lair"
	quest.65DEA3AA471B1627.quest_desc: [
		"A mechanical dungeon deep underground: the road to the Harbinger from the «Bosses» chapter."
	]
	quest.1D9ABAB93B21593F.title: "The Labyrinth"
	quest.1D9ABAB93B21593F.quest_subtitle: "Twilight Forest"
	quest.1D9ABAB93B21593F.quest_desc: [
		"An underground labyrinth beneath the swamp. A maze map (made from a map and a maze core) shows the way to the Minoshroom."
	]
	quest.0233DEB78E99055C.title: "Hive Temple"
	quest.0233DEB78E99055C.quest_subtitle: "Bumblezone"
	quest.0233DEB78E99055C.quest_desc: [
		"The heart of the bee dimension. Don't anger the bees: wear bee armour and keep honey handy."
	]
	quest.57FDCFE312B601D6.title: "Bronze Dungeon"
	quest.57FDCFE312B601D6.quest_subtitle: "The Aether"
	quest.57FDCFE312B601D6.quest_desc: [
		"The first Aether dungeon, home of the Slider. Its key opens the reward chest."
	]
	quest.6493D15E22B26AAA.title: "Brass Dungeon"
	quest.6493D15E22B26AAA.quest_subtitle: "Deep Aether"
	quest.6493D15E22B26AAA.quest_desc: [
		"A Deep Aether dungeon with mechanical guardians. Loot: Stormforged armour templates."
	]
	quest.41271CF75F0F514B.title: "Ancient Temple"
	quest.41271CF75F0F514B.quest_subtitle: "The Otherside"
	quest.41271CF75F0F514B.quest_desc: [
		"A temple deep in the Otherside: silence is mandatory. Loot: the Heart of the Deep and the way to the Stalker."
	]
	quest.18D1F60CD2B50700.title: "End Castle"
	quest.18D1F60CD2B50700.quest_subtitle: "Dungeons & Taverns"
	quest.18D1F60CD2B50700.quest_desc: [
		"A castle on the far End islands: shulkers, chests, and a road to elytra if you haven't found an End city yet."
	]
	quest.5A9C5F24AD35D296.title: "Tomb Raider"
	quest.5A9C5F24AD35D296.quest_subtitle: "Nine great dungeons"
	quest.5A9C5F24AD35D296.quest_desc: [
		"You've seen the heavens and the depths of this world. Share your finds on the map (Xaero → waypoints → share) so friends can follow."
	]
	chapter.710611A423EC0104.title: "Twilight Forest"
	chapter.710611A423EC0104.chapter_subtitle: [
		"Through the barriers: from the Naga to the Snow Queen"
	]
	quest.5B22481D0318449C.title: "Through the Portal"
	quest.5B22481D0318449C.quest_desc: [
		"&lWhy:&r A 2x2 water pool ringed with flowers plus a diamond. Barriers block the way until you beat the previous boss."
		"Enter the mysterious, magical woodlands: the Twilight Forest"
	]
	quest.52D600F6F6A4599B.title: "Magic Map"
	quest.52D600F6F6A4599B.quest_desc: [
		"&lWhy:&r Shows biomes and the forest's main structures."
	]
	quest.25582DEA26794926.title: "Local Wildlife"
	quest.25582DEA26794926.quest_desc: [
		"&lWhy:&r Deer, boars and ravens: meat and feathers."
		"Hunt some of the local wildlife"
	]
	quest.1734937E7EF0E1D9.title: "Hollow Hill"
	quest.1734937E7EF0E1D9.quest_desc: [
		"&lWhy:&r Hills full of ore, chests and spawners."
	]
	quest.22269FB2349988D1.title: "Hedge Maze"
	quest.22269FB2349988D1.quest_desc: [
		"&lWhy:&r The hedge hurts; follow the paths to the chests."
		"Defeat a spider in a Hedge Maze"
	]
	quest.712F29F5428CEECD.title: "Quest Grove"
	quest.712F29F5428CEECD.quest_desc: [
		"&lWhy:&r Feed the ram wool of all 16 colours for a reward."
	]
	quest.1BC6272C15A5B674.title: "Uncrafting Table"
	quest.1BC6272C15A5B674.quest_desc: [
		"&lWhy:&r Breaks items back into ingredients for XP."
	]
	quest.56E5F7DCFEDB31C1.title: "Gifts of the Dusk"
	quest.56E5F7DCFEDB31C1.quest_desc: [
		"&lWhy:&r Glowing torchberries and dusk fruit."
	]
	quest.1B7C490BEBCBA745.title: "Twilight Dining"
	quest.1B7C490BEBCBA745.quest_desc: [
		"&lWhy:&r Venison and maze wafers."
		"Eat every edible item type exclusive to Twilight Forest"
	]
	quest.3B6772C9A9CA5C7B.title: "Naga Courtyard"
	quest.3B6772C9A9CA5C7B.quest_desc: [
		"&lWhy:&r Hit the head, dodge the charges."
	]
	quest.6842664BD760C6E6.title: "Naga Scale Armor"
	quest.6842664BD760C6E6.quest_desc: [
		"&lWhy:&r Iron-level protection from naga scales."
	]
	quest.78B04B9BD214FBFF.title: "Naga Trophy"
	quest.78B04B9BD214FBFF.quest_desc: [
		"&lWhy:&r The Naga's head, your first trophy."
	]
	quest.245DA7E979F6C2D3.title: "Lich Tower"
	quest.245DA7E979F6C2D3.quest_desc: [
		"&lWhy:&r Break his shields with ranged hits first."
		"[An explorer's notebook, gnawed on by monsters]"
		""
		"I have begun examining the strange aura surrounding this tower. The bricks of the tower are protected by a curse, stronger than any I've seen before. The magic from the curse is boiling off into the"
	]
	quest.7009BDB5B2408FBD.title: "The Four Scepters"
	quest.7009BDB5B2408FBD.quest_desc: [
		"&lWhy:&r Bolts, life drain, zombie allies and shields."
		"Acquire all four scepters of power"
	]
	quest.64915B3C86849449.title: "Twilight Lich Trophy"
	quest.64915B3C86849449.quest_desc: [
		"&lWhy:&r The Lich's trophy."
	]
	quest.5EED486251257C86.title: "Ironwood Armor"
	quest.5EED486251257C86.quest_desc: [
		"&lWhy:&r Comes pre-enchanted with protection."
	]
	quest.1687CDE75715D2CD.title: "Steeleaf Armor"
	quest.1687CDE75715D2CD.quest_desc: [
		"&lWhy:&r Steel-hard leaves; armor with projectile protection."
	]
	quest.6D0E11901BC3FCDC.title: "Steeleaf Tools"
	quest.6D0E11901BC3FCDC.quest_desc: [
		"&lWhy:&r Pre-enchanted: looting sword, fortune pickaxe."
	]
	quest.710A35AF9F139298.title: "Minotaur Labyrinth"
	quest.710A35AF9F139298.quest_desc: [
		"The mosquitoes in this swamp are vexing, but strange. The vast majority of them seem to have no natural source, nor do they seem to have a role in the local ecology. I have begun to suspect that they are"
	]
	quest.3153879318778022.title: "Maze Map Focus"
	quest.3153879318778022.quest_desc: [
		"&lWhy:&r Shows the corridors around you."
	]
	quest.51CE9E909CC7B4F6.title: "Mazebreaker Pickaxe"
	quest.51CE9E909CC7B4F6.quest_desc: [
		"&lWhy:&r Breaks mazestone easily; found in a secret vault."
	]
	quest.322A3A6F03A9EB1C.title: "Diamond Minotaur Axe"
	quest.322A3A6F03A9EB1C.quest_desc: [
		"&lWhy:&r Double damage while charging."
	]
	quest.0F22E50464FBE6F6.title: "Meef Stroganoff"
	quest.0F22E50464FBE6F6.quest_desc: [
		"&lWhy:&r Eat it to endure the Fire Swamp's heat."
		"Eat the Meef Stroganoff to acclimatize your body to the dangerous heat of the Fire Swamp"
	]
	quest.7912A8A04775CD18.title: "Hydra Lair"
	quest.7912A8A04775CD18.quest_desc: [
		"&lWhy:&r Hit the open mouths. Fire resistance required."
		"Fire is a trivial obstacle for a master explorer such as myself. I have traversed seas of fire, and swam through oceans of lava. The burning air here is an interesting variation, but"
	]
	quest.39DA916EDD2A66FD.title: "Fiery Blood"
	quest.39DA916EDD2A66FD.quest_desc: [
		"&lWhy:&r Hydra blood + iron = fiery ingots; tools auto-smelt."
	]
	quest.7985B158A5E6EAF7.title: "Fiery Armor"
	quest.7985B158A5E6EAF7.quest_desc: [
		"&lWhy:&r Burns attackers, protects from fire."
		"Wield a fiery tool or weapon while having at least one piece of fiery armor in your inventory"
	]
	quest.5B20F48F05BC37DF.title: "Fiery Sword"
	quest.5B20F48F05BC37DF.quest_desc: [
		"&lWhy:&r The pickaxe smelts ore as you mine; the sword burns."
	]
	quest.667F2107796C111B.title: "Hydra Chop"
	quest.667F2107796C111B.quest_desc: [
		"&lWhy:&r The best food in the forest."
	]
	quest.5DE4AEAAD0DE1486.title: "Knight Stronghold"
	quest.5DE4AEAAD0DE1486.quest_desc: [
		"&lWhy:&r Goblin knights drop knightmetal; phantoms wait below."
		"The tendrils of darkness surrounding this area are just a manifestation of a protective spell over the entire dark forest. The spell causes blindness, which is quite vexing. I have seen several"
	]
	quest.02A3EC03F9F3600A.title: "Knightmetal"
	quest.02A3EC03F9F3600A.quest_desc: [
		"&lWhy:&r Armor shards become knightmetal, a step past diamond."
	]
	quest.2AB70EA80310259B.title: "Knightmetal Armor"
	quest.2AB70EA80310259B.quest_desc: [
		"&lWhy:&r Very durable, softens heavy hits."
	]
	quest.3CC46684DEE45058.title: "Knightmetal Weapons"
	quest.3CC46684DEE45058.quest_desc: [
		"&lWhy:&r Block and chain: a thrown flail."
	]
	quest.216E95B531E571C4.title: "Phantom Armor"
	quest.216E95B531E571C4.quest_desc: [
		"&lWhy:&r Phantom armor stays with you on death."
	]
	quest.0F634CBEAFED965C.title: "Dark Tower"
	quest.0F634CBEAFED965C.quest_desc: [
		"&lWhy:&r A tower of carminite devices; the Ur-Ghast waits on top."
		"This tower clearly has mechanisms that are not responding to me. Their magic almost yearns to acknowledge my touch, but it cannot. It is if the devices of the tower are being"
	]
	quest.4760190435A8BE43.title: "Carminite"
	quest.4760190435A8BE43.quest_desc: [
		"&lWhy:&r Tower mechanisms: builders, vanishing blocks, reactor."
	]
	quest.64A9365315B0B355.title: "Ghast Trap"
	quest.64A9365315B0B355.quest_desc: [
		"&lWhy:&r Kill ghastlings near the trap, then trigger it to pull the Ur-Ghast down."
	]
	quest.3B0D69B7E270A57F.title: "Fiery Tears"
	quest.3B0D69B7E270A57F.quest_desc: [
		"&lWhy:&r A powerful ingredient for potions and magic."
	]
	quest.564955218D8CB2E5.title: "Yeti Cave"
	quest.564955218D8CB2E5.quest_desc: [
		"&lWhy:&r The Alpha Yeti throws ice; the blizzard stops when he falls."
		"The blizzard surrounding these snowy lands is unceasing. This is no ordinary snowfall--this is a magical phenomenon. I will have to conduct experiments to find what is capable of"
	]
	quest.008082A7AC999C27.title: "Yeti Armor"
	quest.008082A7AC999C27.quest_desc: [
		"&lWhy:&r Freezes attackers, keeps you warm."
	]
	quest.694E1A3473B96593.title: "Arctic Armor"
	quest.694E1A3473B96593.quest_desc: [
		"&lWhy:&r Arctic fox fur; dyeable."
		"Dye four unique pieces of Arctic armor"
	]
	quest.7CCD3B6DD5A72524.title: "Aurora Palace"
	quest.7CCD3B6DD5A72524.quest_desc: [
		"I overcame one blizzard, only to run into this terrible ice storm atop the glacier. My explorations have shown me the splendor of an ice palace, shining with the colors of the"
	]
	quest.34293E6276A6679F.title: "Ice Weapons"
	quest.34293E6276A6679F.quest_desc: [
		"&lWhy:&r Ice bow and sword slow enemies."
	]
	quest.4CD79C11522B3390.title: "Troll Caves"
	quest.4CD79C11522B3390.quest_desc: [
		"&lWhy:&r Find the Lamp of Cinders to burn the thorns."
		"There seems to be no way to protect myself from the toxic rainstorm surrounding this area. In my brief excursions, I have also encountered another protection spell, similar to the others I have"
	]
	quest.2B33E7A7AEAF57F9.title: "Lamp of Cinders"
	quest.2B33E7A7AEAF57F9.quest_desc: [
		"&lWhy:&r The lamp burns away the thorns."
	]
	quest.45F6B9C684D4968C.title: "Magic Beans"
	quest.45F6B9C684D4968C.quest_desc: [
		"&lWhy:&r Magic beans grow a beanstalk to the giants' castle."
	]
	quest.034F8716B7A5345E.title: "Giant's Tools"
	quest.034F8716B7A5345E.quest_desc: [
		"&lWhy:&r The giant pickaxe digs huge areas."
	]
	quest.38165F9BAFDE679A.title: "Charms"
	quest.38165F9BAFDE679A.quest_desc: [
		"&lWhy:&r Charm of life saves you once; keeping keeps items on death."
	]
	quest.609281F46703D192.title: "Twilight Bows"
	quest.609281F46703D192.quest_desc: [
		"&lWhy:&r Triple shot, homing and swap-teleport bows."
	]
	quest.486074F0E4534C30.title: "Ore Magnet"
	quest.486074F0E4534C30.quest_desc: [
		"&lWhy:&r Pulls an ore vein to you through stone."
	]
	quest.19553E461865AD4A.title: "Crumble Horn"
	quest.19553E461865AD4A.quest_desc: [
		"&lWhy:&r Crumbles nearby stone to clear a path."
	]
	quest.39F6AD01902D01FD.title: "Peacock Feather Fan"
	quest.39F6AD01902D01FD.quest_desc: [
		"&lWhy:&r Blows mobs and projectiles away."
	]
	quest.5B6B7B16E2215B92.title: "Moonworm Queen"
	quest.5B6B7B16E2215B92.quest_desc: [
		"&lWhy:&r Throws glowing moonworms: light without torches."
	]
	quest.3A156ED0C031D524.title: "Traveller's Gear"
	quest.3A156ED0C031D524.quest_desc: [
		"&lWhy:&r Traveller's gear takes modifiers."
		"Craft a piece of traveller's gear"
		"Add a modifier to a piece of traveller's gear"
	]
	quest.1A53A3D446A56369.title: "Bug Jars"
	quest.1A53A3D446A56369.quest_desc: [
		"&lWhy:&r Cozy decor and lanterns."
	]
	quest.42FE5D9C0791AD9E.title: "Trophy Pedestal"
	quest.42FE5D9C0791AD9E.quest_desc: [
		"&lWhy:&r Place a trophy on the pedestal to earn your title."
		"Claim your title by placing a trophy on the pedestal in the Dark Forest ruins"
	]
	quest.17FD3681EA08ECEB.title: "Trophy Hall"
	quest.17FD3681EA08ECEB.quest_desc: [
		"&lWhy:&r Show off boss heads in your town hall."
	]
	quest.40167F02FC81A8A0.title: "Final Castle"
	quest.40167F02FC81A8A0.quest_desc: [
		"&lWhy:&r The end of the path, for now."
		"Anything past this point in the Highlands is a work in progress. It will be finished in the future"
	]
	quest.0E3645CB18E6DF1E.title: "Conqueror of the Twilight"
	quest.0E3645CB18E6DF1E.quest_desc: [
		"All barriers lifted, all bosses down."
	]
	chapter.3E92433C873CD4AC.title: "Other Worlds"
	chapter.3E92433C873CD4AC.chapter_subtitle: [
		"What to gather in each dimension, and why to come back"
	]
	quest.2D77445198E97346.title: "A Map of Worlds"
	quest.2D77445198E97346.quest_subtitle: "Where and why"
	quest.2D77445198E97346.quest_desc: [
		"&lThe Aether&r (sky islands): light metals, flight, gentle animals. &lDeep Aether&r extends it with its own ores."
		"&lThe Undergarden&r (below bedrock): dark caves, the best armour metals."
		"&lThe Bumblezone&r: bees, honey, royal jelly."
		"&lThe Otherside&r (through a sculk portal): dangerous, but it has Warden armour."
		"&lThe Twilight Forest&r: a chain of bosses («Adventure»). &lThe End&r: elytra, shulkers, the void."
	]
	quest.330A2A98C519162A.title: "Skyjade"
	quest.330A2A98C519162A.quest_subtitle: "Deep Aether"
	quest.330A2A98C519162A.quest_desc: [
		"A Deep Aether ore. It makes light, fast tools and armour, a step between zanite and stormforged gear."
	]
	quest.266F8321887A4C29.title: "Stratus"
	quest.266F8321887A4C29.quest_subtitle: "Cloud armour"
	quest.266F8321887A4C29.quest_desc: [
		"Stratus armour makes you faster in the sky. Good for exploring the Aether by airship or on foot over the clouds."
	]
	quest.2F5CB4C9BE71E92E.title: "Aerwhale Saddle"
	quest.2F5CB4C9BE71E92E.quest_subtitle: "A flying mount"
	quest.2F5CB4C9BE71E92E.quest_desc: [
		"The Aether's aerwhale drifts peacefully through the air. With a saddle you can ride it: slow, but beautiful."
	]
	quest.41B2832A942564A8.title: "Cloggrum"
	quest.41B2832A942564A8.quest_subtitle: "The Undergarden"
	quest.41B2832A942564A8.quest_desc: [
		"The Undergarden's first metal, sturdier than iron. Next come froststeel and utherium, each with a bonus against local monsters."
	]
	quest.4A7C65037569EC58.title: "Utherium"
	quest.4A7C65037569EC58.quest_subtitle: "Against the rotten"
	quest.4A7C65037569EC58.quest_desc: [
		"Utherium weapons hit Undergarden rotspawn harder: take one to the catacombs."
	]
	quest.557D7ED45056F22C.title: "Gloomgourd"
	quest.557D7ED45056F22C.quest_subtitle: "Food without sun"
	quest.557D7ED45056F22C.quest_desc: [
		"There's no sun in the Undergarden, but it has its own crops. The gloomgourd is the base of local cuisine (pie!) and food variety."
	]
	quest.1AD3AAF02A0AEC65.title: "Royal Jelly"
	quest.1AD3AAF02A0AEC65.quest_subtitle: "Bumblezone"
	quest.1AD3AAF02A0AEC65.quest_desc: [
		"The Bumblezone's most valuable prize. Used for bee armour and tonics, and Productive Bees keepers need it for rare breeds."
	]
	quest.538CE3778B5E486F.title: "Bee Armour"
	quest.538CE3778B5E486F.quest_subtitle: "One of the hive"
	quest.538CE3778B5E486F.quest_desc: [
		"Bee armour calms the bees and helps you stay airborne (details in the item tooltips). The full set is your pass to the deepest hives."
	]
	quest.327022E9A286F5E3.title: "Essence of the Bees"
	quest.327022E9A286F5E3.quest_subtitle: "Sanctum trials"
	quest.327022E9A286F5E3.quest_desc: [
		"Bumblezone sanctums run trials: beat one and you get an essence. Its effect is in the item tooltip."
	]
	quest.774EC0F3488A630B.title: "Reinforced Echo Shard"
	quest.774EC0F3488A630B.quest_subtitle: "Deeper Darker"
	quest.774EC0F3488A630B.quest_desc: [
		"Echo shards from the Otherside: material for portals and upgrades. Gather them quietly: any noise calls the sculk guardians."
	]
	quest.07ACEBF0D34DBEB0.title: "Resonarium"
	quest.07ACEBF0D34DBEB0.quest_subtitle: "A sound metal"
	quest.07ACEBF0D34DBEB0.quest_desc: [
		"A metal that resonates with sound. Resonarium tools cut sculk, and the armour muffles your steps."
	]
	quest.7C11137082F10408.title: "Warden Armour"
	quest.7C11137082F10408.quest_subtitle: "Better than netherite"
	quest.7C11137082F10408.quest_desc: [
		"An upgrade of netherite armour at a smithing table (recipe in EMI). Tougher than netherite, and it makes you quieter."
	]
	quest.3CC5C3F80E21EBE7.title: "Shulker Shells"
	quest.3CC5C3F80E21EBE7.quest_subtitle: "The End"
	quest.3CC5C3F80E21EBE7.quest_desc: [
		"Shulker boxes are portable chests. Everyone loves them: builders, miners, travellers. Hunt in End cities and Dungeons & Taverns castles."
	]
	quest.1CC4A7924CB673E5.title: "Elytra"
	quest.1CC4A7924CB673E5.quest_subtitle: "Wings"
	quest.1CC4A7924CB673E5.quest_desc: [
		"Elytra from an End ship. Rockets, Mending, and you fly anywhere. The End islands are more varied now (Nullscape): search far from the centre."
	]
	quest.2B5661B8607D6510.title: "World Wanderer"
	quest.2B5661B8607D6510.quest_subtitle: "Been everywhere, seen everything"
	quest.2B5661B8607D6510.quest_desc: [
		"Sky, abyss, hive, silence and void. Put a waystone at every portal: the next traveller will thank you."
	]
	chapter.1D555EC874F7223F.title: "The Aether"
	chapter.1D555EC874F7223F.chapter_subtitle: [
		"Sky islands, three dungeons, Valkyries and the Sun Spirit"
	]
	quest.57CB4834EABEA660.title: "The Paradise Above"
	quest.57CB4834EABEA660.quest_desc: [
		"&lWhy:&r A glowstone frame lit with water. Falling off an island is deadly — bring a parachute."
	]
	quest.26BEBF6342A10D42.title: "Book of Lore"
	quest.26BEBF6342A10D42.quest_desc: [
		"&lWhy:&r Put any Aether item in to learn about it."
	]
	quest.1F092A54F8037433.title: "Skyroot"
	quest.1F092A54F8037433.quest_desc: [
		"&lWhy:&r Skyroot tools double drops from Aether blocks."
	]
	quest.60F580AC00BE4892.title: "Holystone"
	quest.60F580AC00BE4892.quest_desc: [
		"&lWhy:&r Holystone tools sometimes drop ambrosium."
	]
	quest.654D5A55BB42444A.title: "Ambrosium Shard"
	quest.654D5A55BB42444A.quest_desc: [
		"&lWhy:&r The Aether's fuel; also heals."
	]
	quest.53D2345AC89B0835.title: "Altar"
	quest.53D2345AC89B0835.quest_desc: [
		"&lWhy:&r Enchants and repairs Aether items."
	]
	quest.1B815D468F9CCF79.title: "Freezer"
	quest.1B815D468F9CCF79.quest_desc: [
		"&lWhy:&r Freezes Aether items into ice gear."
	]
	quest.18AA7F9B9C17BCE1.title: "Incubator"
	quest.18AA7F9B9C17BCE1.quest_desc: [
		"&lWhy:&r Hatches moa eggs on ambrosium."
	]
	quest.5DBD02C687182C9D.title: "Moa Egg"
	quest.5DBD02C687182C9D.quest_desc: [
		"&lWhy:&r Hatch a moa: a mount with double jump."
	]
	quest.13BDFCE86BC9783F.title: "Zanite Pickaxe"
	quest.13BDFCE86BC9783F.quest_desc: [
		"&lWhy:&r Zanite gets stronger as it wears."
	]
	quest.44624303E124B5EA.title: "Zanite Armor"
	quest.44624303E124B5EA.quest_desc: [
		"&lWhy:&r Zanite armor improves as it wears."
	]
	quest.6194BCE15C5C9CDF.title: "Zanite Gloves"
	quest.6194BCE15C5C9CDF.quest_desc: [
		"&lWhy:&r An extra glove slot for armor."
	]
	quest.664A653B9D0CF6A3.title: "Rings and Pendants"
	quest.664A653B9D0CF6A3.quest_desc: [
		"&lWhy:&r Zanite accessories speed up mining."
	]
	quest.40971DC17C102818.title: "Ice Ring"
	quest.40971DC17C102818.quest_desc: [
		"&lWhy:&r Freezes water and lava underfoot."
	]
	quest.61C6A0E5798C1DB8.title: "Cold Parachute"
	quest.61C6A0E5798C1DB8.quest_desc: [
		"&lWhy:&r Open it when falling off an island."
	]
	quest.1539B08B133CF2D3.title: "Golden Parachute"
	quest.1539B08B133CF2D3.quest_desc: [
		"&lWhy:&r Lasts longer than the cold one."
	]
	quest.6E4AF6B8A4CB34FC.title: "Dart Shooters"
	quest.6E4AF6B8A4CB34FC.quest_desc: [
		"&lWhy:&r Ranged option against zephyrs."
	]
	quest.3CABA48D07FA839C.title: "Poison Dart Shooter"
	quest.3CABA48D07FA839C.quest_desc: [
		"&lWhy:&r Poison paralyses the target."
	]
	quest.108F62A4DB1634B5.title: "Swet Ball"
	quest.108F62A4DB1634B5.quest_desc: [
		"&lWhy:&r Swets grab you; their goo is Aether glue."
	]
	quest.4C37B1D77C5A365C.title: "Blue Berry"
	quest.4C37B1D77C5A365C.quest_desc: [
		"&lWhy:&r The white apple cures Aether poison."
	]
	quest.0DC27AF0BD968B69.title: "Enchanted Berry"
	quest.0DC27AF0BD968B69.quest_desc: [
		"&lWhy:&r Best food and fuel; made at the altar."
	]
	quest.42179C47C3563FA4.title: "Blue Gummy Swet"
	quest.42179C47C3563FA4.quest_desc: [
		"&lWhy:&r Restores health."
	]
	quest.665F084C83DDEBDD.title: "Quicksoil"
	quest.665F084C83DDEBDD.quest_desc: [
		"&lWhy:&r Slippery soil and seamless glass."
	]
	quest.33A6E21A49B8E8B1.title: "Aerclouds"
	quest.33A6E21A49B8E8B1.quest_desc: [
		"&lWhy:&r Cold clouds stop falls, blue ones bounce."
	]
	quest.30BC81A05184506E.title: "Golden Oak"
	quest.30BC81A05184506E.quest_desc: [
		"&lWhy:&r Golden oaks give amber."
	]
	quest.3D36C44D5BEEED71.title: "Sky Storms"
	quest.3D36C44D5BEEED71.quest_desc: [
		"&lWhy:&r Zephyrs knock you off islands; fight them from range."
	]
	quest.5E911E344FEBFB3D.title: "Bronze Dungeon"
	quest.5E911E344FEBFB3D.quest_desc: [
		"&lWhy:&r Hit the Slider only with a pickaxe when it stops."
	]
	quest.08086AD3C37DBF74.title: "Bronze Key"
	quest.08086AD3C37DBF74.quest_desc: [
		"&lWhy:&r Opens the bronze dungeon's treasure room."
	]
	quest.6214182AE1EB9618.title: "Gravitite"
	quest.6214182AE1EB9618.quest_desc: [
		"&lWhy:&r Floating ore; enchant it on the altar."
	]
	quest.228AA03EF355CEA5.title: "Gravitite Armor"
	quest.228AA03EF355CEA5.quest_desc: [
		"&lWhy:&r Full set: high jump and no fall damage."
	]
	quest.35C60B398E091F84.title: "Gravitite Pickaxe"
	quest.35C60B398E091F84.quest_desc: [
		"&lWhy:&r Right-click to lift blocks."
	]
	quest.4972C6A445A2CAEE.title: "Silver Dungeon"
	quest.4972C6A445A2CAEE.quest_desc: [
		"&lWhy:&r Clear the guards before facing the Valkyrie Queen."
	]
	quest.5FB905FDDDDB793E.title: "Valkyrie Armor"
	quest.5FB905FDDDDB793E.quest_desc: [
		"&lWhy:&r With the Valkyrie cape: flight."
	]
	quest.4A7E9FD340472574.title: "Valkyrie Lance"
	quest.4A7E9FD340472574.quest_desc: [
		"&lWhy:&r Long reach, strong when falling."
	]
	quest.4A5EB7F6A0A09202.title: "Neptune Armor"
	quest.4A5EB7F6A0A09202.quest_desc: [
		"&lWhy:&r Fast swimming, water breathing."
	]
	quest.177262B1FF8AD54B.title: "Gold Dungeon"
	quest.177262B1FF8AD54B.quest_desc: [
		"&lWhy:&r Reflect his fireballs. Bring fire resistance."
	]
	quest.163831DD11F3A1A3.title: "Phoenix Armor"
	quest.163831DD11F3A1A3.quest_desc: [
		"&lWhy:&r Fire and lava immunity."
	]
	quest.7450698EFDB0FBE4.title: "Phoenix Bow"
	quest.7450698EFDB0FBE4.quest_desc: [
		"&lWhy:&r Ignites arrows."
	]
	quest.6031406EF6D183DA.title: "Obsidian Chestplate"
	quest.6031406EF6D183DA.quest_desc: [
		"&lWhy:&r Cooled phoenix armor: very tough."
	]
	quest.745340AAF59D8E96.title: "Legendary Swords"
	quest.745340AAF59D8E96.quest_desc: [
		"&lWhy:&r Fire, lightning and holy swords."
	]
	quest.57E53AF056CC6DBF.title: "Vampire Blade"
	quest.57E53AF056CC6DBF.quest_desc: [
		"&lWhy:&r Heals you with a part of damage dealt."
	]
	quest.7DFA457CE94E0AA2.title: "Hammer of Kingbdogz"
	quest.7DFA457CE94E0AA2.quest_desc: [
		"&lWhy:&r Knocks enemies far away."
	]
	quest.5FC480D7CEC234B7.title: "Aether Staves"
	quest.5FC480D7CEC234B7.quest_desc: [
		"&lWhy:&r Cloud and nature staves."
	]
	quest.10F015CF2C87093B.title: "Capes"
	quest.10F015CF2C87093B.quest_desc: [
		"&lWhy:&r Step-up and invisibility capes."
	]
	quest.6DAC0BEF66AC01E2.title: "Shield of Repulsion"
	quest.6DAC0BEF66AC01E2.quest_desc: [
		"&lWhy:&r Reflects projectiles while you stand still."
	]
	quest.003213FD869C4D94.title: "Regeneration Stone"
	quest.003213FD869C4D94.quest_desc: [
		"&lWhy:&r Slow healing as an accessory."
	]
	quest.2E3DBCFA30BA66B0.title: "Life Shard"
	quest.2E3DBCFA30BA66B0.quest_desc: [
		"&lWhy:&r Adds a permanent heart."
	]
	quest.767EE34F585E0751.title: "Victory Medal"
	quest.767EE34F585E0751.quest_desc: [
		"&lWhy:&r Ten medals let you challenge the Queen."
	]
	quest.3864AD324F7C2EAD.title: "Keeper of the Skies"
	quest.3864AD324F7C2EAD.quest_desc: [
		"Three dungeons cleared, the Sun Spirit defeated."
	]
	chapter.5C3C5449885B5EAF.title: "Cataclysm"
	chapter.5C3C5449885B5EAF.chapter_subtitle: [
		"Ignis, the Monstrosity, the Leviathan and weapons forged from their hearts"
	]
	quest.6B0239F4A91328CE.title: "Boss Eyes"
	quest.6B0239F4A91328CE.quest_desc: [
		"&lWhy:&r Each boss sleeps in its own structure; craft its eye to find it. Go as a team."
	]
	quest.72271F44CF818EB3.title: "Eye of Monstrous"
	quest.72271F44CF818EB3.quest_desc: [
		"&lWhy:&r Leads to the Soul Blacksmith in the Nether."
	]
	quest.2702FC0751B9D94C.title: "Soul Blacksmith"
	quest.2702FC0751B9D94C.quest_desc: [
		"&lWhy:&r A forge deep in the Nether; the Monstrosity sleeps by the furnace."
	]
	quest.0D409B1B1A356229.title: "Netherite Monstrosity"
	quest.0D409B1B1A356229.quest_desc: [
		"&lWhy:&r Slow but devastating; stay at its side and dodge the lava slams."
	]
	quest.37EB413D543566D3.title: "Monstrous Helm"
	quest.37EB413D543566D3.quest_desc: [
		"While worn, if you fall below half health knock back nearby entities"
	]
	quest.358CC6629333345D.title: "Infernal Forge"
	quest.358CC6629333345D.quest_desc: [
		"&lWhy:&r The Monstrosity's hammer: area slams."
		"When in your main hand, right click at a block to cause AOE damage"
	]
	quest.78D65F1F74044D75.title: "Mechanical Fusion Anvil"
	quest.78D65F1F74044D75.quest_desc: [
		"&lWhy:&r Fuses top-tier Cataclysm gear."
	]
	quest.7FE08E26172BFAF6.title: "Netherite Effigy"
	quest.7FE08E26172BFAF6.quest_desc: [
		"Summon Netherite Ministrosity, can be tamed through Lava Power Cell"
	]
	quest.4AF2C26F2B218882.title: "Eye of Flame"
	quest.4AF2C26F2B218882.quest_desc: [
		"&lWhy:&r Leads to the Burning Arena."
	]
	quest.4E4236D28AFB6F57.title: "Burning Arena"
	quest.4E4236D28AFB6F57.quest_desc: [
		"&lWhy:&r Light the fire altar to summon Ignis."
	]
	quest.2F1F7F34A0DEFF5C.title: "Ignis"
	quest.2F1F7F34A0DEFF5C.quest_desc: [
		"&lWhy:&r Three phases; parry with a shield to open him up."
	]
	quest.707A85C111EC71EB.title: "Ignitium"
	quest.707A85C111EC71EB.quest_desc: [
		"&lWhy:&r The template upgrades netherite to ignitium."
	]
	quest.7060B6E399DF7354.title: "Ignitium Armor"
	quest.7060B6E399DF7354.quest_desc: [
		"&lWhy:&r Lava sight, lava walking; the chestplate merges with elytra."
	]
	quest.566410A2772CF7C9.title: "Ignitium Elytra Chestplate"
	quest.566410A2772CF7C9.quest_desc: [
		"&lWhy:&r Fly without giving up the chestplate."
	]
	quest.5509C355B2E51C5B.title: "Bulwark of the Flame"
	quest.5509C355B2E51C5B.quest_desc: [
		"Release while sneaking to charge forward and damage entities in front"
	]
	quest.3282A9FFAF120EDC.title: "The Incinerator"
	quest.3282A9FFAF120EDC.quest_desc: [
		"&lWhy:&r Fire pillars; they burn dropped items."
	]
	quest.501F5D9A88B3077C.title: "Blazing Grips"
	quest.501F5D9A88B3077C.quest_desc: [
		"On hit, there is a chance to apply Blazing Brand to the target"
	]
	quest.7CF748B04341886A.title: "Void Core"
	quest.7CF748B04341886A.quest_desc: [
		"Right click to summon Void Runes"
	]
	quest.170AB93D557D27B5.title: "Gauntlet of Guard"
	quest.170AB93D557D27B5.quest_desc: [
		"When in your main hand, right click to pull entities"
	]
	quest.2C17B18E5893B7D2.title: "Void Forge"
	quest.2C17B18E5893B7D2.quest_desc: [
		"When in main hand, right click at a block to summon Void Runes in a fan shape"
	]
	quest.19870AAD7C79C411.title: "Ender Golem"
	quest.19870AAD7C79C411.quest_desc: [
		"&lWhy:&r Avoid the glowing void runes under your feet."
	]
	quest.076817D007F75FDD.title: "Enderite Ingot"
	quest.076817D007F75FDD.quest_desc: [
		"&lWhy:&r Material for void weapons."
	]
	quest.5347C81AEB9C341D.title: "Eye of Abyss"
	quest.5347C81AEB9C341D.quest_desc: [
		"&lWhy:&r Leads to the sunken city."
	]
	quest.63FE96C2B6606DA9.title: "Tidal Claws"
	quest.63FE96C2B6606DA9.quest_desc: [
		"&lWhy:&r A grappling hook to pull yourself in."
		"Right click to fire a grappling hook"
	]
	quest.7A3FEBF83761CC7A.title: "Abyssal Egg"
	quest.7A3FEBF83761CC7A.quest_desc: [
		"&lWhy:&r Hatches a tame baby Leviathan."
	]
	quest.14111229BDEAED1D.title: "Coralssus"
	quest.14111229BDEAED1D.quest_desc: [
		"&lWhy:&r A coral giant; sidestep its charge."
	]
	quest.35B16BE62398D658.title: "Coral Weapons"
	quest.35B16BE62398D658.quest_desc: [
		"&lWhy:&r Good weapons for underwater fights."
	]
	quest.3ECC2C58C7C1444E.title: "Azure Sea Shield"
	quest.3ECC2C58C7C1444E.quest_desc: [
		"&lWhy:&r Scylla's shield."
	]
	quest.19559516FB1134F0.title: "Ceraunus"
	quest.19559516FB1134F0.quest_desc: [
		"You can Throw the Anchor"
	]
	quest.5070203F7A73344C.title: "Astrape"
	quest.5070203F7A73344C.quest_desc: [
		"Right click to shoot a Lightning Spear"
	]
	quest.65641002583081AD.title: "Eye of Mech"
	quest.65641002583081AD.quest_desc: [
		"&lWhy:&r Leads to the ancient factory."
	]
	quest.72A78A25DF757261.title: "The Prowler"
	quest.72A78A25DF757261.quest_desc: [
		"&lWhy:&r A laser-firing mech spider; use the pillars."
	]
	quest.5D9ECE38934C5D09.title: "Wither Assault Shoulder Weapon"
	quest.5D9ECE38934C5D09.quest_desc: [
		"Right click to shoot Wither Missiles"
	]
	quest.294B560EDD7DA424.title: "Laser Gatling"
	quest.294B560EDD7DA424.quest_desc: [
		"You can reload with the Redstone in your inventory"
	]
	quest.2BDDCFE4B8CD8AFB.title: "Witherite Ingot"
	quest.2BDDCFE4B8CD8AFB.quest_desc: [
		"&lWhy:&r Alloy for missile weapons."
	]
	quest.4AD5119537D623EF.title: "Eye of Desert"
	quest.4AD5119537D623EF.quest_desc: [
		"&lWhy:&r Leads to the cursed pyramid."
	]
	quest.36BCC059E4D54458.title: "Cursed Pyramid"
	quest.36BCC059E4D54458.quest_desc: [
		"&lWhy:&r Traps everywhere: falling sand, fire, darts."
	]
	quest.48DBA50CE351F9F1.title: "Necklace of the desert"
	quest.48DBA50CE351F9F1.quest_desc: [
		"It looks like you can wake something up......"
	]
	quest.30E1574759A1ED41.title: "Wrath of the Desert"
	quest.30E1574759A1ED41.quest_desc: [
		"&lWhy:&r Sandstorm bow and bottled storms."
		"Fires three cursed sandstorms"
	]
	quest.249DF8692D6AF727.title: "Khopesh"
	quest.249DF8692D6AF727.quest_desc: [
		"&lWhy:&r Fast sweeping desert blade."
	]
	quest.640839E0F72CBF82.title: "Kobolediator"
	quest.640839E0F72CBF82.quest_desc: [
		"&lWhy:&r Kill the thieving koboldeons first."
	]
	quest.53870F00F00B36B8.title: "Sticky Gloves"
	quest.53870F00F00B36B8.quest_desc: [
		"Block the looting of Koboleton"
	]
	quest.6FA277D6E33EEF1D.title: "Wadjet"
	quest.6FA277D6E33EEF1D.quest_desc: [
		"&lWhy:&r Poison spit: bring milk."
	]
	quest.51E02638B5244131.title: "Eye of Curse"
	quest.51E02638B5244131.quest_desc: [
		"&lWhy:&r Leads to the Frosted Prison."
	]
	quest.6E68BAC601531C7F.title: "Frosted Prison"
	quest.6E68BAC601531C7F.quest_desc: [
		"&lWhy:&r An icy prison full of draugr."
	]
	quest.1CE2BA9020BFB2BE.title: "Aptrgangr"
	quest.1CE2BA9020BFB2BE.quest_desc: [
		"&lWhy:&r Slow wide swings: step back, not aside."
	]
	quest.294AF5BCD22280CE.title: "Cursium"
	quest.294AF5BCD22280CE.quest_desc: [
		"&lWhy:&r The template upgrades netherite armor to cursium."
	]
	quest.756DA255BF7A86EB.title: "Cursium Armor"
	quest.756DA255BF7A86EB.quest_desc: [
		"&lWhy:&r Ghost sight, dodge, featherfall, and a chestplate that revives you."
	]
	quest.0D8A50688B12EBBC.title: "Soul Render"
	quest.0D8A50688B12EBBC.quest_desc: [
		"You can Rush of Render"
	]
	quest.3CE0C222EE372367.title: "Cursed Bow"
	quest.3CE0C222EE372367.quest_desc: [
		"You can shoot 3 Phantom Arrows"
	]
	quest.73C5B755D851E8D3.title: "The Annihilator"
	quest.73C5B755D851E8D3.quest_desc: [
		"&lWhy:&r Huge crits, area attack two-handed."
	]
	quest.1AE098A84FEE3785.title: "Amethyst Crab"
	quest.1AE098A84FEE3785.quest_desc: [
		"&lWhy:&r Its blessed meat protects from Darkness."
	]
	quest.3C370B783F2158A4.title: "Blessed Amethyst Crab Meat"
	quest.3C370B783F2158A4.quest_desc: [
		"Be affected by the blessing effect. It is immune to darkness, abyssal fear and abyssal burn during the blessing effect"
	]
	quest.29F7DF699536A40D.title: "Bloom Stone Pauldrons"
	quest.29F7DF699536A40D.quest_desc: [
		"&lWhy:&r Release a swarm of amethyst shards."
	]
	quest.0C911114C0E16E1C.title: "Cataclysm Survivor"
	quest.0C911114C0E16E1C.quest_desc: [
		"Every Cataclysm boss has fallen; their hearts are in your armor."
	]
	chapter.4499A461977E88CA.title: "Weapons & Gear"
	chapter.4499A461977E88CA.chapter_subtitle: [
		"Swords, guns, cannons and grappling hooks"
	]
	quest.2840277D460DBE04.title: "Combat with Flair"
	quest.2840277D460DBE04.quest_subtitle: "Better Combat + Simply Swords"
	quest.2840277D460DBE04.quest_desc: [
		"&lWhat:&r attacks here are animated with combos: a longsword sweeps wide, a dagger is quick, a hammer is heavy."
		"A &lroll&r (Combat Roll) dodges a blow — check its key in &oControls&r."
		"Try different weapons: katana, glaive, scythe, twinblades…"
	]
	quest.124CE8EC4DA83696.title: "The Greathammer"
	quest.124CE8EC4DA83696.quest_subtitle: "Slow but loud"
	quest.124CE8EC4DA83696.quest_desc: [
		"A two-handed hammer hits an area. Great against crowds, poor against fast enemies."
	]
	quest.2EFA1764B6C5AA28.title: "The Gunsmith's Workshop"
	quest.2EFA1764B6C5AA28.quest_subtitle: "TaCZ"
	quest.2EFA1764B6C5AA28.quest_desc: [
		"&lWhat:&r firearms — pistols, rifles, shotguns — with scopes, attachments and reloading."
		"The &lgunsmith table&r builds guns, ammo and attachments. Metal and powder come from the &lengineer&r."
		"&lNote:&r PvP is off — guns are for mobs and bosses."
	]
	quest.00E19FD18B738F02.title: "An Ammo Box"
	quest.00E19FD18B738F02.quest_subtitle: "Don't carry them loose"
	quest.00E19FD18B738F02.quest_desc: [
		"An ammo box holds one calibre and feeds it on reload. Saves inventory space."
	]
	quest.0CFB5AA571596797.title: "A Big Cannon"
	quest.0CFB5AA571596797.quest_subtitle: "Create Big Cannons"
	quest.0CFB5AA571596797.quest_desc: [
		"Cannons are cast in moulds, assembled on a mount and loaded with shot and powder charges. Aiming uses Create rotation."
		"Put one on an airship and you have a &lwarship&r. Great for defending a colony from raids, too."
	]
	quest.1E2EBF13C6F879A0.title: "The Grappling Hook"
	quest.1E2EBF13C6F879A0.quest_subtitle: "An early hook"
	quest.1E2EBF13C6F879A0.quest_desc: [
		"Fire the hook at a block and pull yourself up. Cliffs, ravines, rooftops are no longer obstacles."
		"&lUpgrades&r (at the modifier station): longer rope, double hook, rocket, swing."
	]
	quest.4744E2D0A9C2BFAD.title: "Spider-Style"
	quest.4744E2D0A9C2BFAD.quest_subtitle: "The double hook"
	quest.4744E2D0A9C2BFAD.quest_desc: [
		"With two hooks you can swing between trees and sail over a river. Practise over water!"
	]
	quest.325CD1C1DC34FC14.title: "Board Her!"
	quest.325CD1C1DC34FC14.quest_subtitle: "Hook + airship"
	quest.325CD1C1DC34FC14.quest_desc: [
		"Hook a friend's passing airship and pull yourself aboard. Create ropes also let you build a &lcable car&r"
		"between towers. Tick the quest once you've pulled it off."
	]
	quest.547E7AB1EA5FB62E.title: "The Full Set"
	quest.547E7AB1EA5FB62E.quest_subtitle: "Armour set bonuses"
	quest.547E7AB1EA5FB62E.quest_desc: [
		"A full set of one armour type grants a &lbonus&r: ironwood gives regeneration, knightmetal and steel give resistance, cloggrum gives haste."
		"The bonus is shown in the armour tooltip."
	]
	quest.56E88A8B20052C07.title: "Armed and Dangerous"
	quest.56E88A8B20052C07.quest_subtitle: "Sword, gun, cannon, hook"
	quest.56E88A8B20052C07.quest_desc: [
		"You're ready for anything. Remember the calm zones: home is peaceful; adventure is where you go looking for it."
	]
	quest.2B3DDC04AF68D471.title: "The Katana"
	quest.2B3DDC04AF68D471.quest_desc: [
		"Fast strikes and long combos. For those who love speed."
	]
	quest.50FA3AD9E3473F0B.title: "The Glaive"
	quest.50FA3AD9E3473F0B.quest_desc: [
		"A long polearm — strikes from afar and hits several foes."
	]
	quest.43419A8748AA7E13.title: "The Twinblade"
	quest.43419A8748AA7E13.quest_desc: [
		"Spinning strikes all around you. Good against crowds."
	]
	quest.4E186D831A313D5E.title: "A Diamond Blade"
	quest.4E186D831A313D5E.quest_desc: [
		"Every Simply Swords weapon comes in iron, diamond and netherite. Unique blades hide in dungeons."
	]
	quest.45F020A202618B2C.title: "A Netherite Blade"
	quest.45F020A202618B2C.quest_desc: [
		"An upgrade template + netherite — and a weapon for life."
	]
	quest.508564D2E50AB706.title: "Ammunition"
	quest.508564D2E50AB706.quest_desc: [
		"Ammo is made at the gunsmith table from brass and gunpowder. Ask the engineer to set up a Create line. Tick the box once you have a stock (every calibre is its own model inside the item, so the quest can't detect it)."
	]
	quest.1428749F03E36AA4.title: "Shot and Charges"
	quest.1428749F03E36AA4.quest_desc: [
		"A cannon needs shot and powder charges. More charges mean a longer shot."
	]
	quest.18BE845C1AC2CF5A.title: "The Rocket Hook"
	quest.18BE845C1AC2CF5A.quest_desc: [
		"A rocket pulls you along the rope even faster. Flying over a canyon — unforgettable."
	]
	quest.35DC60B73DD268F7.title: "Long Fall Boots"
	quest.35DC60B73DD268F7.quest_desc: [
		"No fall damage. With a hook — freedom in the mountains."
	]
	chapter.775CEE25F56DFD3E.title: "Firearms and War"
	chapter.775CEE25F56DFD3E.chapter_subtitle: [
		"TaCZ guns, gunner NPCs, artillery, drones"
	]
	quest.3A4404A355E47B8F.title: "Your First Gun"
	quest.3A4404A355E47B8F.quest_subtitle: "TaCZ"
	quest.3A4404A355E47B8F.quest_desc: [
		"&lWhat:&r TaCZ adds realistic guns: pistols, rifles, shotguns, snipers. Recoil, reloads, scopes."
		"&lHow:&r gunsmith table → pick a model → you need steel, gunpowder and parts. Tick the box when you've built one (every gun is its own model inside the item, so the quest can't detect it by itself)."
		"&lControls:&r right click to aim, R to reload, G for fire mode, H to inspect, Z for attachments (rebindable in settings)."
		"Guns hurt friends too: PvP is on, mind your line of fire."
	]
	quest.68228C2E9955C382.title: "Shooting Range"
	quest.68228C2E9955C382.quest_subtitle: "Zeroing in"
	quest.68228C2E9955C382.quest_desc: [
		"A target shows damage and distance. Zero in a new gun before taking it into a dungeon: every model has its own spread."
	]
	quest.0C06F2D583FF781C.title: "Attachments"
	quest.0C06F2D583FF781C.quest_subtitle: "Scopes, suppressors, grips"
	quest.0C06F2D583FF781C.quest_desc: [
		"Attachments change stats: a suppressor hides shots from mobs, a red dot speeds up aiming, a grip reduces recoil."
		"Fit them in the attachment menu (Z key)."
	]
	quest.4D1B1A33E90955B0.title: "Ammo Box"
	quest.4D1B1A33E90955B0.quest_subtitle: "The logistics of war"
	quest.4D1B1A33E90955B0.quest_desc: [
		"The box stores ammo and reloads from your inventory. &lAutomation:&r gunpowder and casings can come from a Create line: a mechanical crafter assembles ammo by itself."
	]
	quest.1F01CF3B5A2B8693.title: "Illager Gunners"
	quest.1F01CF3B5A2B8693.quest_subtitle: "TaCZ NPCs"
	quest.1F01CF3B5A2B8693.quest_desc: [
		"Illagers in outposts, camps and forts often carry guns. They take cover and fire bursts like players do."
		"&lWhere:&r only in the wilds: no gunners near spawn and bases."
		"&lLoot:&r sometimes their gun drops."
	]
	quest.6DD0F70D9DDC8C7B.title: "The Mercenary"
	quest.6DD0F70D9DDC8C7B.quest_subtitle: "An armed NPC"
	quest.6DD0F70D9DDC8C7B.quest_desc: [
		"Lone fighters in full gear roam the far lands. Not all are hostile: some stay neutral until you shoot first."
		"Beat one and see what they carried."
	]
	quest.4DDC25AF5DB52DB2.title: "Molotov Cocktail"
	quest.4DDC25AF5DB52DB2.quest_subtitle: "Immersive Petroleum"
	quest.4DDC25AF5DB52DB2.quest_desc: [
		"A bottle of gasoline with a rag, for dungeon crowds. &lCareful:&r fire spreads: don't throw it near other people's houses."
	]
	quest.4740D6790661887D.title: "Flamethrower"
	quest.4740D6790661887D.quest_subtitle: "TFMG"
	quest.4740D6790661887D.quest_desc: [
		"The TFMG flamethrower runs on fuel from your oil rig. TFMG also has copper grenades and a napalm potato cannon."
		"&lRoles meet:&r fuel from the oil worker, steel from the smelter, and the warrior pulls the trigger."
	]
	quest.72E937A5DCECDADE.title: "Steel Artillery"
	quest.72E937A5DCECDADE.quest_subtitle: "Create Big Cannons"
	quest.72E937A5DCECDADE.quest_desc: [
		"Cast iron cannons are step one; steel barrels take more powder and fire further. Cast them in moulds or with the cannon builder."
		"&lWhy:&r against the Leviathan from the shore, against illager forts, and for base defence."
	]
	quest.78978271E0B00221.title: "Autocannon"
	quest.78978271E0B00221.quest_subtitle: "Rapid fire"
	quest.78978271E0B00221.quest_desc: [
		"The autocannon fires bursts of small shells: great air defence for an airship and protection against raids."
	]
	quest.0261EF9E1DEBACDE.title: "Ship Guns"
	quest.0261EF9E1DEBACDE.quest_subtitle: "Small Ships"
	quest.0261EF9E1DEBACDE.quest_desc: [
		"Cannons mount on Small Ships ship sides. Cannonballs, chain shot (tears sails) and grapeshot (against boarders)."
	]
	quest.4334303B4E6E48AE.title: "Wing Gun"
	quest.4334303B4E6E48AE.quest_subtitle: "Immersive Aircraft"
	quest.4334303B4E6E48AE.quest_desc: [
		"The rotary cannon mounts on a plane or gyrodyne. There's a bomb bay too, for those who like levelling illager forts from above."
	]
	quest.2BE9CE783253AEBB.title: "FPV Drone"
	quest.2BE9CE783253AEBB.quest_subtitle: "Create Droneworks"
	quest.2BE9CE783253AEBB.quest_desc: [
		"&lWhat:&r a drone you build yourself from Aeronautics blocks: a drone core, propellers, a camera. Fly it first-person with a remote."
		"&lWhy:&r scout dungeons and forts without risk, deliver cargo, and with a payload it's a kamikaze drone (TNT or a potato cannon on board)."
		"&lHow:&r core + 4 propellers + camera, assemble on a physics assembler and bind the remote."
		"⚠ The mod is young (alpha): keep a schematic of your drone; if it misbehaves, tell the admin."
	]
	quest.3569848A2294DF70.title: "Command Post"
	quest.3569848A2294DF70.quest_subtitle: "Several drones"
	quest.3569848A2294DF70.quest_desc: [
		"A drone hub and a commander seat let you switch between drones: a scout, a hauler and a striker in one team."
	]
	quest.533A846AC076473A.title: "General"
	quest.533A846AC076473A.quest_subtitle: "Land, sea, sky"
	quest.533A846AC076473A.quest_desc: [
		"Infantry, navy, air force and drones. Time to build barracks (Minecolonies) and train guards: nobody takes your colony now."
	]
	chapter.6B5C9EE747778BF3.title: "Elements & Defence"
	chapter.6B5C9EE747778BF3.chapter_subtitle: [
		"A living world — and shelter from all of it"
	]
	quest.7235EB4484D39CEF.title: "How Events Work"
	quest.7235EB4484D39CEF.quest_subtitle: "Fair rules"
	quest.7235EB4484D39CEF.quest_desc: [
		"Events run &lonly while someone is online&r. The first 7 in-game days are quiet, and disasters (meteor strikes, rifts, tornadoes) happen &lat most once every 3 real days&r."
		"No dangerous event &lstarts&r until you finish its \"Meet\" quest here — and the first one is always a tutorial."
		"The &lStar Atlas&r (reward) shows tonight's forecast. An admin can turn on \"vacation\" and the world rests."
	]
	quest.4285D3CEDD0D99B4.title: "The Hearth Stone"
	quest.4285D3CEDD0D99B4.quest_subtitle: "A home enemies don't visit"
	quest.4285D3CEDD0D99B4.quest_desc: [
		"Place the &lHearth Stone&r (reward) by your home — no hostile mobs spawn on their own within 48 blocks."
		"Claims (map → \"Claim\") work the same way. One stone per player: a new one moves the old one."
	]
	quest.3D8147435B400249.title: "The Meteor Shower"
	quest.3D8147435B400249.quest_subtitle: "Meet the event"
	quest.3D8147435B400249.quest_desc: [
		"&lWhat:&r some nights the sky is streaked with meteors. Most burn up; small ones land in &lthe wilds&r."
		"&lWhat to do:&r enjoy the view and look for fallen stones — they hold &lmeteorite ore&r. If one lands in water, a &lstar carp&r may be there."
		"This event is a gift — nothing to fear."
	]
	quest.3E90DEC686D69116.title: "Sky Dust"
	quest.3E90DEC686D69116.quest_subtitle: "Meteorite ore"
	quest.3E90DEC686D69116.quest_desc: [
		"Mine meteorite ore with an iron pickaxe for &lmeteoric dust&r. It makes meteoric iron and &lward crystals&r."
		"&lValued by:&r everyone. It's the explorer's best trade good."
	]
	quest.5A0CC55134D58E8D.title: "The Ward Crystal"
	quest.5A0CC55134D58E8D.quest_subtitle: "Fuel for protection"
	quest.5A0CC55134D58E8D.quest_desc: [
		"Amethyst + meteoric dust: in a heated &lCreate mixer&r (engineer) or an &lArs imbuement chamber&r (mage)."
		"Tier II crystals need both tech and magic — that's where friendship pays off."
	]
	quest.48E5FD47C52B6084.title: "The Ward Generator"
	quest.48E5FD47C52B6084.quest_subtitle: "A dome over your home"
	quest.48E5FD47C52B6084.quest_desc: [
		"&lWhat it does:&r within 32 blocks (II — 64, III — 128) explosions break nothing, meteors burn up mid-air, and from tier II rifts can't open."
		"&lHow:&r place it at your base and insert a crystal (right-click). Fuel burns only while someone is near or an event is running."
		"A redstone signal turns it off. Click with an empty hand for status."
	]
	quest.16A477416AFD3D59.title: "The Meteor Strike"
	quest.16A477416AFD3D59.quest_subtitle: "Meet the event (enables it)"
	quest.16A477416AFD3D59.quest_desc: [
		"&lHow to tell:&r &l10 minutes&r before impact — a title, a bell, a countdown bar and a &lglowing column in the sky&r above the impact site."
		"&lWhat to do:&r don't stand there. A ward over your base burns the meteor up. On gentle intensity (1) it lands near your base, never in claims."
		"&lReward for courage:&r a crater full of meteorite ore. Tick the quest and meteors start falling (the first is a far-off tutorial)."
	]
	quest.3E10FDC1DC810AC2.title: "Rift Night"
	quest.3E10FDC1DC810AC2.quest_subtitle: "Meet the event (enables it)"
	quest.3E10FDC1DC810AC2.quest_desc: [
		"&lWhat:&r some nights &lrifts&r open 60–130 blocks from players. Mobs pour out — but stay within ~30 blocks."
		"&lProtection:&r rifts never open in safe zones or near a &ltier II ward&r. Their mobs vanish at dawn."
		"&lWhy go there:&r when a rift closes it leaves &lrift shards&r — valuable for magic."
	]
	quest.33AFEE95B7509AD8.title: "The Blood Moon"
	quest.33AFEE95B7509AD8.quest_subtitle: "Enhanced Celestials"
	quest.33AFEE95B7509AD8.quest_desc: [
		"&lHow to tell:&r the moon turns red, with a warning at dusk. More mobs that night — but &lonly in the wilds&r."
		"&lWhat to do:&r stay home by the hearth. Or, for the brave, hunt rare drops. There are also &lharvest&r (crop growth) and &lblue&r (luck) moons."
	]
	quest.4ABB671FB9CEB4DA.title: "Storms and Tornadoes"
	quest.4ABB671FB9CEB4DA.quest_subtitle: "Weather, Storms & Tornadoes"
	quest.4ABB671FB9CEB4DA.quest_desc: [
		"&lWhat:&r storm fronts, downpours and &ltornadoes&r roam the world. A tornado lifts blocks and mobs."
		"&lHow to tell:&r a &lweather forecast&r station shows fronts on radar; a &ltornado siren&r howls as one approaches."
		"On gentle intensity tornadoes are rare and weak."
	]
	quest.7749B36585890F81.title: "The Weather Deflector"
	quest.7749B36585890F81.quest_subtitle: "Tornadoes go around your base"
	quest.7749B36585890F81.quest_desc: [
		"The deflector dissolves tornadoes and storms that approach your base. Put it in the middle and sleep soundly."
		"&lTip:&r a tornado siren next to your bed wakes you if something's coming."
	]
	quest.11670169A7E1CD13.title: "Smog and Acid Rain"
	quest.11670169A7E1CD13.quest_subtitle: "Airborne"
	quest.11670169A7E1CD13.quest_desc: [
		"&lHow to tell:&r a grey haze over factories, sickly crops, coughing animals."
		"&lProtection:&r the &lClean Breath&r potion (alchemist), trees and flowers around the factory, electricity instead of diesel."
		"A long-term goal: the &lClear Sky&r project in \"Great Works\"."
	]
	quest.740E2F91D6262E0A.title: "Radiation"
	quest.740E2F91D6262E0A.quest_subtitle: "Mekanism"
	quest.740E2F91D6262E0A.quest_desc: [
		"&lHow to tell:&r the Geiger counter crackles. Radiation only comes from &lnuclear waste&r and reactor accidents."
		"&lProtection:&r a hazmat suit, waste barrels, and the &lLead Blood&r potion flushes your dose."
	]
	quest.0B6B1DDB206465F7.title: "A Colony Raid"
	quest.0B6B1DDB206465F7.quest_subtitle: "MineColonies"
	quest.0B6B1DDB206465F7.quest_desc: [
		"&lHow to tell:&r a growing colony attracts barbarians, pirates and mummies. The town hall tracks raids and announces them in chat."
		"&lProtection:&r &lguard towers&r and barracks with guards, walls, Create Big Cannons."
	]
	quest.7A50C60518C1E203.title: "Keeper of the Base"
	quest.7A50C60518C1E203.quest_subtitle: "A tier II ward"
	quest.7A50C60518C1E203.quest_desc: [
		"A tier II ward protects 64 blocks, blocks rifts and needs crystals made from &ltech and magic&r — engineer and mage together."
		"The world is still alive, but it no longer scares you."
	]
	quest.48D3C139931CF8D9.title: "The Tornado Siren"
	quest.48D3C139931CF8D9.quest_desc: [
		"Wails when a tornado approaches the base. Put it by your bed — it'll wake you in time."
	]
	quest.58D49D8AFEC2510E.title: "The Tornado Sensor"
	quest.58D49D8AFEC2510E.quest_desc: [
		"Gives a redstone signal during a tornado: close shutters, send the airship to the hangar automatically."
	]
	quest.5623D930DF18775A.title: "The Wind"
	quest.5623D930DF18775A.quest_desc: [
		"The anemometer and wind vane show wind strength and direction. Wind matters for pilots and for air pollution."
	]
	quest.0E97B1CB5F5C32BD.title: "The Lightning Rod"
	quest.0E97B1CB5F5C32BD.quest_desc: [
		"Draws lightning to itself — your wooden roof won't burn in a storm."
	]
	quest.4C62FFBDC832EB2C.title: "The Great Ward"
	quest.4C62FFBDC832EB2C.quest_desc: [
		"A tier III ward protects 128 blocks — a whole town. Fuel: crystals made with exotic matter from the collider."
	]
	chapter.6FA4DB5D74373B8B.title: "The Town"
	chapter.6FA4DB5D74373B8B.chapter_subtitle: [
		"A colony, villagers and a village of your own"
	]
	quest.601F1AB7F25BCE3E.title: "The Settlers' Camp"
	quest.601F1AB7F25BCE3E.quest_subtitle: "MineColonies"
	quest.601F1AB7F25BCE3E.quest_desc: [
		"&lWhat:&r MineColonies is your own town with worker citizens: builders, farmers, cooks, miners, guards."
		"&lHow to start:&r place a &lsupply camp&r (or a supply ship by water) — its chest holds a town hall."
		"Details: the MineColonies guide and the &lscan tool&r for blueprints. No rush: a town grows over weeks."
	]
	quest.0961E98A888A1F6F.title: "The Town Hall"
	quest.0961E98A888A1F6F.quest_subtitle: "The heart of the colony"
	quest.0961E98A888A1F6F.quest_desc: [
		"Place the town hall with the &lbuild tool&r — pick a style (medieval, Byzantine, modern…)."
		"The town hall sets the &lcolony borders&r — enemies don't spawn on their own inside them."
	]
	quest.68A40D4402EEB3F1.title: "The Builder"
	quest.68A40D4402EEB3F1.quest_subtitle: "Your first worker"
	quest.68A40D4402EEB3F1.quest_desc: [
		"The builder's hut comes first. The builder raises every other building if you bring materials."
		"&lTip:&r a warehouse with couriers saves you from running around with chests."
	]
	quest.6CF67932543F364E.title: "The Colony Needs a Cook"
	quest.6CF67932543F364E.quest_subtitle: "Well-fed citizens work better"
	quest.6CF67932543F364E.quest_desc: [
		"Citizens eat. The higher their house level, the &lmore varied&r the food they want: soups, pies, Farmer's Delight dishes."
		"&lWho helps:&r your group's cook is the town's main supplier. One of the pack's key handshakes."
	]
	quest.2448820009AD4703.title: "The Colony Farmer"
	quest.2448820009AD4703.quest_subtitle: "Fields without you"
	quest.2448820009AD4703.quest_desc: [
		"The farmer ploughs, plants and harvests on his own. Give him seeds — tomatoes, cabbage, rice — and the cook never runs out."
	]
	quest.18D3669431D9E42A.title: "The Guard"
	quest.18D3669431D9E42A.quest_subtitle: "The guard tower"
	quest.18D3669431D9E42A.quest_desc: [
		"Guards protect the colony from raids. Give them armour and weapons — &lyour group's smith&r will be needed."
		"More on raids in \"Elements & Defence\"."
	]
	quest.15EA1D5A0184FB40.title: "The University"
	quest.15EA1D5A0184FB40.quest_subtitle: "Colony research"
	quest.15EA1D5A0184FB40.quest_desc: [
		"At the university citizens research upgrades: faster building, better healing, stronger defence."
	]
	quest.3128D00D510F86AC.title: "The Tavern"
	quest.3128D00D510F86AC.quest_subtitle: "New citizens arrive by themselves"
	quest.3128D00D510F86AC.quest_desc: [
		"The tavern attracts travellers who become new citizens. It also simply looks lovely."
	]
	quest.5E28B4759F897AD5.title: "Villagers with Character"
	quest.5E28B4759F897AD5.quest_subtitle: "MCA Reborn"
	quest.5E28B4759F897AD5.quest_desc: [
		"Villagers here are people: names, personalities, families and moods. Talk to them, befriend them, hire them."
		"&lTip:&r gifts improve relationships. MCA smiths and farmers sell useful things."
	]
	quest.1A706D39C73346D7.title: "Dream Town"
	quest.1A706D39C73346D7.quest_subtitle: "A level 5 town hall"
	quest.1A706D39C73346D7.quest_desc: [
		"Tick this once the town hall reaches &llevel 5&r. It's a whole-group project — cooks feed, engineers build roads, mages enchant."
		"Next: the \"Great Works\" chapter."
	]
	quest.31629F0187879119.title: "The Builder's Sceptre"
	quest.31629F0187879119.quest_desc: [
		"Scans builds into blueprints and places them via the colony builder. Copy your house into the town."
	]
	quest.0C500D94482BC31D.title: "Warehouse and Couriers"
	quest.0C500D94482BC31D.quest_desc: [
		"The warehouse holds everything, couriers deliver materials to workers. Without them the colony drowns in chests."
	]
	quest.2A25F70A883FD806.title: "The Lumberjack"
	quest.2A25F70A883FD806.quest_desc: [
		"The lumberjack fells trees and replants. The builder always needs logs."
	]
	quest.35775EEABB31E72C.title: "The Colony Miner"
	quest.35775EEABB31E72C.quest_desc: [
		"The miner digs a shaft level by level and brings back ore and stone."
	]
	quest.75EC4D5698FC2F8A.title: "The Colony Fisher"
	quest.75EC4D5698FC2F8A.quest_desc: [
		"The fisher catches fish for the canteen. Needs water nearby."
	]
	quest.709BD9478FFC95A5.title: "The Herders"
	quest.709BD9478FFC95A5.quest_desc: [
		"The cowhand and shepherd raise cows and sheep for the colony. The breeder knows where to get the first animals."
	]
	quest.6D716CFDB6533D8D.title: "Smeltery and Blacksmith"
	quest.6D716CFDB6533D8D.quest_desc: [
		"The smelter smelts ore, the blacksmith makes tools and armour for guards."
	]
	quest.215D51C751B21BDD.title: "The Hospital"
	quest.215D51C751B21BDD.quest_desc: [
		"Heals citizens of illness. Without it an epidemic stops all work."
	]
	quest.6E16091A853C2E58.title: "The Library"
	quest.6E16091A853C2E58.quest_desc: [
		"Citizens study and level their skills faster."
	]
	quest.032164E8868189BE.title: "The Colony Enchanter"
	quest.032164E8868189BE.quest_desc: [
		"Enchants books from citizens' experience. A steady book supply for mages."
	]
	quest.2EDF7718966F865E.title: "The Colony Alchemist"
	quest.2EDF7718966F865E.quest_desc: [
		"Brews potions for the guards. Your group's alchemist can share recipes."
	]
	quest.5FF1BE65A592559C.title: "The Barracks"
	quest.5FF1BE65A592559C.quest_desc: [
		"Barracks with towers house a whole guard company. Raids won't get through."
	]
	quest.7DF2E728DC9D5076.title: "A Village Wedding"
	quest.7DF2E728DC9D5076.quest_desc: [
		"In MCA you can marry a villager and raise a family. Children can learn to work the farm."
	]
	quest.076FE4C58EDAB8E3.title: "Villagers in Your Pocket"
	quest.076FE4C58EDAB8E3.quest_desc: [
		"Easy Villagers: pick up a villager as an item and place it in a trader block. A compact market without huge pens."
	]
	quest.0FD8FAF0813FFD2A.title: "Residence"
	quest.0FD8FAF0813FFD2A.quest_desc: [
		"Your citizens need a place to live! Build them a House - each level houses one citizen."
		"The House is where your citizens will live. For every level of the House, the building will house one citizen. You will need multiple houses to house everyone. The only citizens that will not live in a House are your Guards."
	]
	quest.031569B36F8A9A21.title: "Bakery"
	quest.031569B36F8A9A21.quest_desc: [
		"Your citizens need some grains in their diet. Build a Bakery so the Baker can craft baked goods for them!"
		"The Baker is part of the food production of your colony. They will bake bread, cookies, pumpkin pie, and/or cake. On page two of the Bakery GUI, you can select which items you want them to make."
	]
	quest.3B062B23874F55A0.title: "Chef's Kitchen"
	quest.3B062B23874F55A0.quest_desc: [
		"&lWhy:&r More cooks for a growing colony."
	]
	quest.7559DB448E569963.title: "Composter's Hut"
	quest.7559DB448E569963.quest_desc: [
		"A Composter will take your leftover saplings, leaves, and like items and expose them to the elements to make fertilizer."
		"The Composter is part of the crafting line of your colony. The Composter will turn items into compost for Farmers and Florists to use."
	]
	quest.72D923C815DFEA86.title: "Plantation"
	quest.72D923C815DFEA86.quest_desc: [
		"&lWhy:&r Grows cane, cactus, bamboo and more."
	]
	quest.25460C176D191862.title: "Flower Shop"
	quest.25460C176D191862.quest_desc: [
		"The Flower Shop will use compost or other types of \"bonemeal\" to grow flowers."
	]
	quest.550B68541BA21A5F.title: "Apiary"
	quest.550B68541BA21A5F.quest_desc: [
		"&lWhy:&r Collects honey from hives."
	]
	quest.1F9880AEC67EF7B7.title: "Chicken Farmer's Hut"
	quest.1F9880AEC67EF7B7.quest_desc: [
		"Build a Chicken Farmer's Hut to bring in some eggs and meat. Remember to bring the chickens to the hut."
		"The Chicken Farmer is part of the food production of your colony. The Chicken Farmer breeds, raises, and butchers chickens. They will collect eggs, feathers, and meat, as well as any drops from other mods. The Chicken Farmer will keep two chickens alive per level of their hut."
	]
	quest.1E035F3D1994FFE2.title: "Swineherd's Hut"
	quest.1E035F3D1994FFE2.quest_desc: [
		"Bacon - a meat eater's dream. Build a Swineherd's Hut so your citizens don't miss out."
		"The Swineherd is part of the food production of your colony. The Swineherd breeds, raises, and butchers pigs. They will collect the meat, as well as any drops from other mods. The Swineherd will keep two pigs alive per level of their hut."
	]
	quest.68A74DE8645E4D01.title: "Rabbit Hutch"
	quest.68A74DE8645E4D01.quest_desc: [
		"&lWhy:&r Rabbit meat and hides."
	]
	quest.69B005DB7BEA8175.title: "Stable"
	quest.69B005DB7BEA8175.quest_desc: [
		"&lWhy:&r Horses for guards and citizens."
	]
	quest.2631D1F7D578FA91.title: "Sawmill"
	quest.2631D1F7D578FA91.quest_desc: [
		"With the Courier by your side, you can utilise crafters! Build the Sawmill to start your crafting experience."
	]
	quest.628B0898C1C9008C.title: "Stonemason's Hut"
	quest.628B0898C1C9008C.quest_desc: [
		"A Stonemason can craft 3x3 recipes using stone as their main ingredient. Build one to take advantage of their skill!"
	]
	quest.5A2B342F6DAC08FD.title: "Brick yard"
	quest.5A2B342F6DAC08FD.quest_desc: [
		"Build a Brick Yard to automate the forging of stone and more for other crafters"
	]
	quest.6A6B9866D4981CA1.title: "Crusher"
	quest.6A6B9866D4981CA1.quest_desc: [
		"Build a Crusher's Hut to get things like gravel from cobblestone!"
	]
	quest.1A19CE3AE1C9EE6B.title: "Sifter"
	quest.1A19CE3AE1C9EE6B.quest_desc: [
		"Build a Sifter's Hut to take advantage of extra resources hiding in blocks"
	]
	quest.1DA2F0A4360E14A8.title: "Glassblower's Hut"
	quest.1DA2F0A4360E14A8.quest_desc: [
		"&lWhy:&r Makes glass for the colony's windows."
	]
	quest.073523D80B8B4CF5.title: "Dyer's Hut"
	quest.073523D80B8B4CF5.quest_desc: [
		"&lWhy:&r Dyes wool, glass and terracotta."
	]
	quest.5E5A9A560271FE5D.title: "Concrete Mixer's Hut"
	quest.5E5A9A560271FE5D.quest_desc: [
		"&lWhy:&r Makes concrete for tall buildings."
	]
	quest.508844C01F0CA98B.title: "Fletcher's Hut"
	quest.508844C01F0CA98B.quest_desc: [
		"&lWhy:&r Bows and arrows for archers."
	]
	quest.4BE21434F371AE4E.title: "Mechanic's Hut"
	quest.4BE21434F371AE4E.quest_desc: [
		"&lWhy:&r Redstone parts, rails and carts."
	]
	quest.00B201D2CB365B8B.title: "School"
	quest.00B201D2CB365B8B.quest_desc: [
		"&lWhy:&r Children grow up smarter."
	]
	quest.6ACFC7FF1495BE58.title: "Archery"
	quest.6ACFC7FF1495BE58.quest_desc: [
		"Give your Knights some backup. Build an Archery to train Archers."
	]
	quest.1D98419730E30EC8.title: "Combat Academy"
	quest.1D98419730E30EC8.quest_desc: [
		"Battle is dangerous. Build a Combat Academy and assign a citizen to train there without the risk of losing their life!"
	]
	quest.37E062B0495F7922.title: "Barracks Tower"
	quest.37E062B0495F7922.quest_desc: [
		"Build the Barracks Towers inside your new Barracks. These towers are locked to the same level as the Barracks and will increase their max Guards every level!"
		"The Barracks Tower is the heart of your military defense. Each Barracks Tower employs 1 Guard per level for a total of 5. However, the Guards will also live in the tower, freeing up beds for more citizens."
		"There are two different types of Guards, Knights and Archers. Knights use swords, while Archers use bows."
	]
	quest.107C3FDC298F433A.title: "Gatehouse"
	quest.107C3FDC298F433A.quest_desc: [
		"&lWhy:&r Gates that open only for citizens."
	]
	quest.70BF3B831544AF3D.title: "Graveyard"
	quest.70BF3B831544AF3D.quest_desc: [
		"The Graveyard is the resting place of your fallen citizens!"
		""
		"Without it, you'll still be able to manually collect fallen citizens' graves, but your colony will mourn longer."
		""
		"Each Graveyard needs an Undertaker, who collects graves within the city."
	]
	quest.070DE4F43FA71987.title: "Nether Mine"
	quest.070DE4F43FA71987.quest_desc: [
		"&lWhy:&r A citizen who raids the Nether for you."
	]
	quest.0587D8CD66473A53.title: "Mystical Site"
	quest.0587D8CD66473A53.quest_desc: [
		"A Mystical Site may be pointless. It will only make your citizens proud. But you want one, so you should research and build one!"
	]
	quest.2D5C32063F6E6D85.title: "Field"
	quest.2D5C32063F6E6D85.quest_desc: [
		"&lWhy:&r A field for your farmer."
	]
	quest.15CD6B6F746E5979.title: "A City That Runs Itself"
	quest.15CD6B6F746E5979.quest_desc: [
		"Your colony feeds, builds and defends itself."
	]
	chapter.6C67AEF364E06285.title: "Building"
	chapter.6C67AEF364E06285.chapter_subtitle: [
		"Decor, tools and beautiful homes"
	]
	quest.1FC1E9E294DB3C6B.title: "The Building Gadget"
	quest.1FC1E9E294DB3C6B.quest_subtitle: "Walls in a second"
	quest.1FC1E9E294DB3C6B.quest_desc: [
		"&lWhat:&r the gadget places a row, wall or floor of the chosen block at once. It runs on energy."
		"There are also &lexchanging&r (swap blocks), &lcopy-paste&r (move a build) and &ldestruction&r gadgets."
	]
	quest.08468A16A473B47D.title: "Swapping Blocks"
	quest.08468A16A473B47D.quest_subtitle: "Redecorate a house in a minute"
	quest.08468A16A473B47D.quest_desc: [
		"The exchanging gadget swaps blocks for the chosen one: stone to brick, oak to spruce. Perfect for restyling builds."
	]
	quest.7402AF2B28E1AB7A.title: "Framed Blocks"
	quest.7402AF2B28E1AB7A.quest_subtitle: "FramedBlocks"
	quest.7402AF2B28E1AB7A.quest_desc: [
		"A framed block takes the look of any other: glass stairs, wool slabs, copper slopes."
	]
	quest.40339AC01B286C60.title: "A Cosy Home"
	quest.40339AC01B286C60.quest_subtitle: "Handcrafted, Macaw's, Another Furniture"
	quest.40339AC01B286C60.quest_desc: [
		"Tables, chairs, wardrobes, lamps, windows, doors, roofs, bridges — hundreds of decorative blocks."
		"Every wood type is covered (Every Compat). Browse EMI: &l@handcrafted&r, &l@mcw&r."
	]
	quest.1FBC13A5E0BD957F.title: "Blueprints"
	quest.1FBC13A5E0BD957F.quest_subtitle: "Save it and build it again"
	quest.1FBC13A5E0BD957F.quest_desc: [
		"Create schematics save and share builds. Make a \"standard cottage\" and build it for your friends."
	]
	quest.3E5505B24DA3089B.title: "Beautiful!"
	quest.3E5505B24DA3089B.quest_subtitle: "Take a photo of your home"
	quest.3E5505B24DA3089B.quest_desc: [
		"Turn on shaders, find a nice angle and take a screenshot (&lF2&r). Share it with friends — and tick the quest."
	]
	quest.7B52108951988BE5.title: "Copy-Paste"
	quest.7B52108951988BE5.quest_desc: [
		"Copies an area and places a copy. A row of identical houses in a minute."
	]
	quest.0681C2FB1DAC97D3.title: "The Destruction Gadget"
	quest.0681C2FB1DAC97D3.quest_desc: [
		"Clears a volume of blocks — prep a building site in seconds."
	]
	quest.2FEDA2D18C4D62F6.title: "Roofs, Windows, Doors"
	quest.2FEDA2D18C4D62F6.quest_desc: [
		"Macaw's: roofs of every shape, nice windows and doors. A house suddenly looks like a home."
	]
	quest.15BAB63916C275B3.title: "Bridges"
	quest.15BAB63916C275B3.quest_desc: [
		"Ready-made bridges for rivers and ravines. Link bases with a lovely road."
	]
	quest.3D8B8BAB6142D975.title: "Cosy Details"
	quest.3D8B8BAB6142D975.quest_desc: [
		"Jars, sacks, a globe, a wind vane, ropes — Supplementaries adds a hundred pleasant touches."
	]
	quest.3603241567DE82A5.title: "Industrial Style"
	quest.3603241567DE82A5.quest_desc: [
		"Create Deco: catwalks, railings, containers, sheet metal — for factories you want to admire."
	]
	quest.5AC27D5E66DB6566.title: "Copycat Blocks"
	quest.5AC27D5E66DB6566.quest_desc: [
		"Copycats+: stairs, panels and layers that take the look of any block. Fine work for detailed builds."
	]
	quest.121BFA9789E6622A.title: "Seats on Trains"
	quest.121BFA9789E6622A.quest_desc: [
		"Create: Interiors adds chairs and sofas you can sit on even aboard a moving train or airship."
	]
	chapter.05D02B5570337DC5.title: "Home and Comfort"
	chapter.05D02B5570337DC5.chapter_subtitle: [
		"Furniture, lights, roofs, paths: hundreds of blocks for a beautiful home"
	]
	quest.0CC807686064633F.title: "Why Comfort"
	quest.0CC807686064633F.quest_subtitle: "Pretty is gameplay too"
	quest.0CC807686064633F.quest_desc: [
		"&lWhy:&r a beautiful home is a reason to visit, and a Minecolonies colony grows faster when its people are happy."
		"&lHow:&r almost all furniture is crafted from planks of the right wood: search EMI for «chair», «table», «lamp»."
		"&lTip:&r many Macaw's blocks come in variants: check EMI, one piece often yields several shapes."
	]
	quest.68CF4A141555C824.title: "A Desk"
	quest.68CF4A141555C824.quest_subtitle: "Macaw's Furniture"
	quest.68CF4A141555C824.quest_desc: [
		"Desks, wardrobes, drawers, chairs: in Macaw's, furniture is functional too: wardrobes and drawers store items."
	]
	quest.6C85FF8C153880DC.title: "A Chandelier"
	quest.6C85FF8C153880DC.quest_subtitle: "Macaw's Lights"
	quest.6C85FF8C153880DC.quest_desc: [
		"Lighting matters: chandeliers, sconces, tiki torches, ceiling fan lights. A well-lit home also keeps mobs out."
	]
	quest.06224B94B88795AF.title: "A Thatch Roof"
	quest.06224B94B88795AF.quest_subtitle: "Macaw's Roofs"
	quest.06224B94B88795AF.quest_desc: [
		"Roofs of every pitch and material: no more stair-step roofs. Thatch for a village cottage, tiles for a town."
	]
	quest.04FE1259A9EC7260.title: "A Paved Path"
	quest.04FE1259A9EC7260.quest_subtitle: "Macaw's Paths"
	quest.04FE1259A9EC7260.quest_desc: [
		"Patterned paving and flagstones: a path from your door to the waystone makes a base feel lived-in."
	]
	quest.5AD48020E2594F58.title: "Windows and Doors"
	quest.5AD48020E2594F58.quest_subtitle: "Macaw's Doors & Windows"
	quest.5AD48020E2594F58.quest_desc: [
		"Doors in many styles (Japanese, cottage, barn) and mullioned windows. Curtains on a rod open with right click."
	]
	quest.277BEE78FED39A51.title: "A Bridge over the Stream"
	quest.277BEE78FED39A51.quest_subtitle: "Macaw's Bridges"
	quest.277BEE78FED39A51.quest_desc: [
		"Bridges snap together from segments and adjust to length. Rope for ravines, stone for rivers."
	]
	quest.484124C4B32D2CAB.title: "A Sofa"
	quest.484124C4B32D2CAB.quest_subtitle: "Another Furniture"
	quest.484124C4B32D2CAB.quest_desc: [
		"Sofas, stools, shelves, flower boxes. You can &lsit&r on sofas and chairs: right click."
	]
	quest.2D523083489AE02E.title: "A Wall Trophy"
	quest.2D523083489AE02E.quest_subtitle: "Handcrafted"
	quest.2D523083489AE02E.quest_desc: [
		"Trophy heads of beasts and mobs: hang them over the fireplace. The warrior hunts, the builder hangs: roles meet."
	]
	quest.7FB9BA113738A36B.title: "Dream Kitchen"
	quest.7FB9BA113738A36B.quest_subtitle: "Handcrafted + Cooking for Blockheads"
	quest.7FB9BA113738A36B.quest_desc: [
		"A Handcrafted hood and oven next to Cooking for Blockheads work blocks: a kitchen you can cook in and show off."
	]
	quest.01E55988ADE92D20.title: "Secret Stash"
	quest.01E55988ADE92D20.quest_subtitle: "Framed Blocks"
	quest.01E55988ADE92D20.quest_desc: [
		"A framed block takes the look of any other, and the secret storage also holds items. A safe behind the bookshelf."
	]
	quest.1D0381CAEC065F43.title: "Architect's Cutter"
	quest.1D0381CAEC065F43.quest_subtitle: "Domum Ornamentum"
	quest.1D0381CAEC065F43.quest_desc: [
		"Makes timber frames, shingles and pillars from any two materials. Minecolonies builds its houses with it; you can too."
	]
	quest.20879EC69322B31B.title: "Notice Board"
	quest.20879EC69322B31B.quest_subtitle: "Supplementaries"
	quest.20879EC69322B31B.quest_desc: [
		"Pin a book on the board and every passer-by can read it. Shelves display items, jars hold liquids and fireflies."
		"&lIdea:&r a board at spawn with the server rules and news."
	]
	quest.2B022A0B2B672C60.title: "A Cosy Nest"
	quest.2B022A0B2B672C60.quest_subtitle: "A home worth coming back to"
	quest.2B022A0B2B672C60.quest_desc: [
		"Lights, roof, furniture, trophies and a stash. Invite friends to a housewarming, and take a screenshot with shaders on."
	]
	chapter.34F136AADF95EE95.title: "Great Works"
	chapter.34F136AADF95EE95.chapter_subtitle: [
		"Megaprojects for the whole group"
	]
	quest.0709903C70BF2FE2.title: "Bigger Together"
	quest.0709903C70BF2FE2.quest_subtitle: "What this chapter is for"
	quest.0709903C70BF2FE2.quest_desc: [
		"These are projects &lno one finishes alone&r: each needs several roles to chip in."
		"Agree who does what — and build. The rewards here are the most generous."
	]
	quest.65D41835C2EFE544.title: "The Flying Citadel"
	quest.65D41835C2EFE544.quest_subtitle: "Engineer, mage, builder, breeder"
	quest.65D41835C2EFE544.quest_desc: [
		"The &lCitadel Heart&r combines waxed canvas (breeder), dragon plating, a tier II ward crystal (engineer + mage) and pearlescent levitite."
		"Build a floating island with a garden, kitchen and workshop, set the Heart at its centre — and tick the quest once it rises above the clouds."
	]
	quest.5E25791A3DFA2FDB.title: "The Nuclear Power Plant"
	quest.5E25791A3DFA2FDB.quest_subtitle: "Engineer + gardener"
	quest.5E25791A3DFA2FDB.quest_desc: [
		"A fission reactor, boiler and turbine — a power plant for the whole server. Start-up needs a &lbio-fuel&r generator (the gardener's crops)."
		"Tick when the plant powers every base."
	]
	quest.467F31F4129D2736.title: "The Ring Collider"
	quest.467F31F4129D2736.quest_subtitle: "Every role"
	quest.467F31F4129D2736.quest_desc: [
		"SPS antimatter, ward crystals, source blocks and nether stars make &lexotic matter&r — the material for tier III wards and the pack's finale."
		"For now it's crafted at a table; a future version adds a huge ring multiblock."
	]
	quest.084CEBE01C3352F1.title: "The Grand Restaurant"
	quest.084CEBE01C3352F1.quest_subtitle: "Cook, gardener, breeder, angler"
	quest.084CEBE01C3352F1.quest_desc: [
		"Build a restaurant with a Cooking for Blockheads kitchen and serve five signature dishes from every corner of the world: dragon stew, fugu, cheese, noir wine and honey-glazed ham."
	]
	quest.4C988FF056779288.title: "The Nature Reserve"
	quest.4C988FF056779288.quest_subtitle: "Breeder, angler, explorer"
	quest.4C988FF056779288.quest_desc: [
		"Half the fish journal, 10 bee species and 3 dragon breeds — in one reserve with enclosures and ponds. Tick once you have them all."
	]
	quest.19E75AA8929A563A.title: "Dream City"
	quest.19E75AA8929A563A.quest_subtitle: "The mayor and everyone"
	quest.19E75AA8929A563A.quest_desc: [
		"A colony with a level 5 town hall, roads, a train and a market. Everyone contributed something. Throw a party!"
	]
	quest.09CABD5281435C1C.title: "Clear Sky"
	quest.09CABD5281435C1C.quest_subtitle: "Engineer, gardener, mage"
	quest.09CABD5281435C1C.quest_desc: [
		"Make sure no base sits under smog: electricity instead of diesel, absorbing forests, tall stacks."
		"Check the Airborne pollution map — and tick the quest once the air is clean."
	]
	chapter.40644DABCF408CC6.title: "Collections"
	chapter.40644DABCF408CC6.chapter_subtitle: [
		"For those who love collecting everything"
	]
	quest.3BAB07B21B1282E9.title: "40 Dishes"
	quest.3BAB07B21B1282E9.quest_subtitle: "Spice of Life"
	quest.3BAB07B21B1282E9.quest_desc: [
		"Taste 40 different dishes. Every milestone in the food book is a new heart."
	]
	quest.743FC4A70C4CBD86.title: "80 Dishes"
	quest.743FC4A70C4CBD86.quest_subtitle: "A true gourmet"
	quest.743FC4A70C4CBD86.quest_desc: [
		"80 dishes means the cuisines of every world: nether, sea, dragon, alpine."
	]
	quest.27144F338FDF2C08.title: "Half the Journal"
	quest.27144F338FDF2C08.quest_subtitle: "Half of all fish species"
	quest.27144F338FDF2C08.quest_desc: [
		"Fill half the angler's journal. Hints for the missing ones are in the journal itself."
	]
	quest.265FF61074550E28.title: "The Star Carp"
	quest.265FF61074550E28.quest_subtitle: "A legend of the meteor shower"
	quest.265FF61074550E28.quest_desc: [
		"They say when a meteor falls into water, a star carp can be found there. A dinner of it brings luck."
	]
	quest.00665D425DD344B3.title: "10 Bee Species"
	quest.00665D425DD344B3.quest_subtitle: "Beekeeper"
	quest.00665D425DD344B3.quest_desc: [
		"Collect 10 different bee species. The mutation guide is in EMI."
	]
	quest.5AA3BFEE086967DC.title: "Three Dragon Breeds"
	quest.5AA3BFEE086967DC.quest_subtitle: "Dragon nursery"
	quest.5AA3BFEE086967DC.quest_desc: [
		"Hatch dragons of three different breeds. Where an egg hatches decides who is born."
	]
	quest.5B7AA6799E31A9A7.title: "Monster Hunter"
	quest.5B7AA6799E31A9A7.quest_subtitle: "Five great bosses"
	quest.5B7AA6799E31A9A7.quest_desc: [
		"Hydra, Ur-Ghast, Ignis, the Wither and the Ender Dragon. The pinnacle of glory — and trophies for the Great Works."
	]
	chapter.150EE076426FF539.title: "Welcome Back!"
	chapter.150EE076426FF539.chapter_subtitle: [
		"A checklist after a break and what's new"
	]
	quest.49541EF8D509C102.title: "We Missed You"
	quest.49541EF8D509C102.quest_subtitle: "Always open"
	quest.49541EF8D509C102.quest_desc: [
		"Been a while? The world didn't fall apart: events don't run without you, and the farms waited."
		"Run through the checklist below and you'll remember where you left off. The quest book remembers your progress."
	]
	quest.37E56430316C85AA.title: "Power"
	quest.37E56430316C85AA.quest_subtitle: "Generators and fuel"
	quest.37E56430316C85AA.quest_desc: [
		"Check generators, fuel and storage. Did the reactor shut down? Do the &lwards&r have enough crystals?"
	]
	quest.472B11224C43FE15.title: "Farms and Stores"
	quest.472B11224C43FE15.quest_subtitle: "Harvest, bees, food"
	quest.472B11224C43FE15.quest_desc: [
		"Collect harvest from pots and chests, check the hives and food stores. What season is it? (calendar)"
	]
	quest.5AF8ABD2B98E1392.title: "The Colony"
	quest.5AF8ABD2B98E1392.quest_subtitle: "Citizen happiness"
	quest.5AF8ABD2B98E1392.quest_desc: [
		"Visit the town hall: happiness, citizen requests, any need for food."
	]
	quest.59275DD9BDBB6DD3.title: "The Air"
	quest.59275DD9BDBB6DD3.quest_subtitle: "The pollution map"
	quest.59275DD9BDBB6DD3.quest_desc: [
		"Has smog built up around the factories? If so, the Clear Sky project is waiting."
	]
	quest.09C5B09C586913C2.title: "The Forecast"
	quest.09C5B09C586913C2.quest_subtitle: "The Star Atlas"
	quest.09C5B09C586913C2.quest_desc: [
		"Open the Star Atlas (or &o/arkhaven forecast&r) — what does tonight hold?"
	]
	quest.3DD6552F19EF0458.title: "What's New: 0.1.0"
	quest.3DD6552F19EF0458.quest_subtitle: "The first Arkhaven release"
	quest.3DD6552F19EF0458.quest_desc: [
		"Arkhaven is open! ~250 mods, 23 quest chapters, alchemist potions, the Ward Generator, meteor showers and strikes."
		"Tell us in chat what you loved and what broke — the next version will take it into account."
	]
	chapter.0DC5789BB7E8D3AF.title: "Festivals"
	chapter.0DC5789BB7E8D3AF.chapter_subtitle: [
		"Seasonal and repeatable — come back every season"
	]
	quest.28921ED5601F390E.title: "The Festival Calendar"
	quest.28921ED5601F390E.quest_subtitle: "A festival for every season"
	quest.28921ED5601F390E.quest_desc: [
		"The season changes about every 24 in-game days. Each season has its festival with &lrepeatable&r quests."
		"Do them in their season (check the calendar) — the rewards can be earned again and again."
	]
	quest.084AB0193213DB26.title: "🌸 The Sowing Festival"
	quest.084AB0193213DB26.quest_subtitle: "Spring"
	quest.084AB0193213DB26.quest_desc: [
		"In spring everything is planted. Gather seeds for a shared festival field and sow it together."
	]
	quest.219DF824BFD97F6F.title: "🌸 Spring Honey"
	quest.219DF824BFD97F6F.quest_subtitle: "Spring"
	quest.219DF824BFD97F6F.quest_desc: [
		"The bees are awake. Gather combs for the festival — the cook will bake honey cookies for everyone."
	]
	quest.7B357B4253B80201.title: "☀️ The Crafts Fair"
	quest.7B357B4253B80201.quest_subtitle: "Summer"
	quest.7B357B4253B80201.quest_desc: [
		"Summer brings a show of machines and ships. Bring your best builds to the square and race planes around the Haven."
		"Tick the quest after the fair."
	]
	quest.26456503909C0515.title: "☀️ Cool Down"
	quest.26456503909C0515.quest_subtitle: "Summer"
	quest.26456503909C0515.quest_desc: [
		"It's hot! Make melon popsicles for the whole group."
	]
	quest.5263804B39A8E916.title: "🍂 The Harvest Festival"
	quest.5263804B39A8E916.quest_subtitle: "Autumn"
	quest.5263804B39A8E916.quest_desc: [
		"Autumn means a great dinner: stuffed pumpkin and wine from the new harvest. Set a shared table!"
	]
	quest.5F568FA0D1D7F62E.title: "❄️ Winter Lights"
	quest.5F568FA0D1D7F62E.quest_subtitle: "Winter"
	quest.5F568FA0D1D7F62E.quest_desc: [
		"In winter the town is decked with lights. Hang lanterns along the Haven's streets — and launch fireworks (reward)."
	]
	quest.3B8FD62542482159.title: "❄️ Ice Fishing"
	quest.3B8FD62542482159.quest_subtitle: "Winter"
	quest.3B8FD62542482159.quest_desc: [
		"Cut a hole in the ice and fish. Fresh salmon for the festive table."
	]
}
