{
	chapter.013D59C2990EDE7A.title: "Welcome to Arkhaven"
	chapter.013D59C2990EDE7A.chapter_subtitle: [
		"Where to start and how things work here"
	]
	quest.0B8F53D58538E0EF.title: "You're in the Haven"
	quest.0B8F53D58538E0EF.quest_subtitle: "Tick the box to begin"
	quest.0B8F53D58538E0EF.quest_desc: [
		"&lArkhaven&r is a pack for a group of friends where everyone finds their thing: cooking, gardening, animals, machines, magic, adventure, towns."
		"It's &lcalm&r here: hostile mobs don't spawn near spawn or inside your claims."
		"Danger is opt-in: the wilds, dungeons and other dimensions."
		"This book is your guide. Every quest answers three questions: &owhat is it, why care, how to start&r."
	]
	quest.04E0C8297145FA0D.title: "Who Are You Today?"
	quest.04E0C8297145FA0D.quest_subtitle: "Eight roles — pick one or all of them"
	quest.04E0C8297145FA0D.quest_desc: [
		"🍳 &lCook&r — Farmer's Delight, Let's Do wine and cheese. 🌱 &lGardener&r — seasons, greenhouses, essences."
		"🐄 &lBreeder&r — bees, dragons, fishing. ⚙️ &lEngineer&r — Create, airships, nuclear power."
		"🔮 &lMage&r — Ars Nouveau, Iron's Spells, Occultism. ⚔️ &lWarrior&r — dungeons and bosses."
		"🏛 &lTown builder&r — MineColonies. ⚗️ &lAlchemist&r — cauldrons and potions."
		"Every role works solo, but mid-game &lteaming up pays off&r: \"Valued by…\" hints show who needs your goods."
	]
	quest.5561BDBA9D7A940F.title: "How to Find Any Recipe"
	quest.5561BDBA9D7A940F.quest_subtitle: "EMI: the R and U keys"
	quest.5561BDBA9D7A940F.quest_desc: [
		"&lWhat:&r the list on the right of your inventory is every item in the pack (EMI)."
		"&lHow:&r hover an item and press &lR&r for how to make it, &lU&r for what it's used in."
		"The search bar understands &l@mod&r: &o@create&r shows only Create items."
		"&lTip:&r the loot tab shows where an item drops."
	]
	quest.7364572739F8EBFD.title: "Living Tooltips"
	quest.7364572739F8EBFD.quest_subtitle: "Ponder (W) and Jade"
	quest.7364572739F8EBFD.quest_desc: [
		"Hover a &lCreate&r block in your inventory and &lhold W&r — an animated scene shows how it works."
		"Look at any block in the world and the &lJade&r popup at the top tells you what it is and which mod it's from."
		"Many mods have their own guide book — quests will tell you where to get it."
	]
	quest.0CD6F0E34FDE881D.title: "Maps and Waypoints"
	quest.0CD6F0E34FDE881D.quest_subtitle: "M for the world map, B for a new waypoint"
	quest.0CD6F0E34FDE881D.quest_desc: [
		"The minimap lives in the corner of your screen. &lM&r opens the world map, &lB&r adds a waypoint."
		"Your death point is marked automatically and your items wait in a &lgravestone&r."
		"&lTip:&r you can share a waypoint with friends in chat from the waypoint menu."
	]
	quest.6AEEBF70D9410C91.title: "Mine the Whole Vein"
	quest.6AEEBF70D9410C91.quest_subtitle: "FTB Ultimine — hold ` (backtick)"
	quest.6AEEBF70D9410C91.quest_desc: [
		"&lHold the ` key&r (left of 1) and break a block — the whole ore vein or the whole tree goes at once."
		"It saves hours: no need to dig out every coal block one by one."
		"It also works with a hoe (till a field) and an axe."
	]
	quest.7D0113D5251D8308.title: "Talk Out Loud"
	quest.7D0113D5251D8308.quest_subtitle: "Simple Voice Chat — V"
	quest.7D0113D5251D8308.quest_desc: [
		"Proximity voice chat: people nearby hear you, quieter the farther they are."
		"&lV&r opens the voice menu (mic, volume, groups). By default you talk by holding &lCaps Lock&r."
		"&lTip:&r create a group and you'll hear each other at any distance."
	]
	quest.61956A5E82AB7C9F.title: "The Danger Atlas"
	quest.61956A5E82AB7C9F.quest_subtitle: "Where to stroll and where to keep your sword ready"
	quest.61956A5E82AB7C9F.quest_desc: [
		"&lZone 0 — safe:&r the Haven (256 blocks around spawn), your claims, colonies, Mega Torch radius. No enemies spawn."
		"&lZone 1 — calm:&r up to ~1500 blocks from spawn. A few vanilla mobs at night."
		"&lZone 2 — the wilds:&r beyond that, dark forests, swamps, deep caves. Modded enemies and elites."
		"&lZone 3 — dangerous:&r dungeons, the Nether, the Twilight Forest, blood moons. Bosses."
		"Entering a new place, the title card shows its danger level in stars ★."
	]
	quest.0AB73893D32D29B0.title: "A Living World That Plays Fair"
	quest.0AB73893D32D29B0.quest_subtitle: "Storms, meteors, blood moons"
	quest.0AB73893D32D29B0.quest_desc: [
		"Sometimes the world stages &levents&r: tornadoes, meteor showers, blood moons, rifts."
		"The rules are fair: events happen &lonly while you're online&r, come &lwith a warning&r, and each has a defence."
		"Before the first event of each kind, the \"Elements & Defence\" chapter teaches you how to stay safe."
		"The reward for bravery: meteoric iron, rare drops and great screenshots."
	]
	quest.6FCCA553E617BD3B.title: "One Team"
	quest.6FCCA553E617BD3B.quest_subtitle: "Shared quest progress"
	quest.6FCCA553E617BD3B.quest_desc: [
		"Everyone on the server is in one team, &lArkhaven&r: a quest your friend completes counts for you too."
		"Everyone claims rewards for themselves, so no one misses out."
		"Want to compete? An admin can split teams with &o/ftbteams&r."
	]
	quest.5921FC2BA0B77A22.title: "Pretty or Fast"
	quest.5921FC2BA0B77A22.quest_subtitle: "Shaders and graphics presets"
	quest.5921FC2BA0B77A22.quest_desc: [
		"Toggle shaders with &lK&r (Iris shader menu — &lO&r). Low FPS? Turn them off or pick a lighter preset."
		"Switch graphics presets with the \"Arkhaven — graphics\" desktop shortcut."
		"&lTip:&r if FPS is low, lower render distance to 8–10 chunks — it has the biggest impact."
	]
	quest.43626AEC27FFE561.title: "Language"
	quest.43626AEC27FFE561.quest_subtitle: "Russian by default, English in settings"
	quest.43626AEC27FFE561.quest_desc: [
		"Quests and hints are written in two languages. To switch: &lOptions → Language&r."
		"The quest book follows automatically."
	]
	quest.211FE5B4A21988C5.title: "Ready for the Road"
	quest.211FE5B4A21988C5.quest_subtitle: "Next: Origins and First Steps"
	quest.211FE5B4A21988C5.quest_desc: [
		"You know the essentials. Now pick your &lorigin&r (chapter \"Origin & Path\") and set up a first home (chapter \"First Steps\")."
		"Other chapters open up as soon as you get into their topic — or peek into any of them right now."
	]
	chapter.3FC26F62283432CD.title: "Player Memo"
	chapter.3FC26F62283432CD.chapter_subtitle: [
		"Short answers to common questions: a 5-minute read"
	]
	quest.797D0E483FA8CEEB.title: "Meteors, Tornadoes, Rifts"
	quest.797D0E483FA8CEEB.quest_subtitle: "How to protect yourself from disasters"
	quest.797D0E483FA8CEEB.quest_desc: [
		"&lWhen:&r only while someone is online; the first 7 in-game days are calm; big disasters come &lat most once every 3 real days&r. Each one first arrives as a tutorial, after the «First Meeting» quest in the «Elements» chapter."
		"&lWarning:&r 10 minutes before a meteor: a title, a bell and a glowing pillar over the impact site. The &lStar Atlas&r shows the night's forecast; so does `/arkhaven forecast`."
		"&l☄ Meteor:&r a ward generator (crystal: amethyst + meteor dust): within 32/64/128 blocks meteors burn up and explosions don't break blocks."
		"&l🌪 Tornadoes and storms:&r a weather deflector breaks them up near your base, a siren wakes you, a sensor gives a redstone signal (close shutters, park the airship). A lightning rod prevents fires."
		"&l🌀 Rifts:&r never open in the safe zone, near a Hearth Stone or next to a tier II ward."
		"&l🧟 Monsters:&r a Hearth Stone (48 blocks) and claims stop mobs from spawning. Creepers never break blocks anywhere."
		"Details: the «Elements» chapter."
	]
	quest.5A2C5F9CF1420CA0.title: "Can I Craft a Gun and a Plane?"
	quest.5A2C5F9CF1420CA0.quest_subtitle: "Yes: almost everything is craftable"
	quest.5A2C5F9CF1420CA0.quest_desc: [
		"&lGuns (TaCZ):&r gunsmith table → model → steel, gunpowder, parts. Ammo and attachments there too. «Firearms and War» chapter."
		"&lCannons:&r Create Big Cannons (on land), Small Ships broadside cannons, the Immersive Aircraft rotary cannon."
		"&lPlanes (Immersive Aircraft):&r biplane, gyrodyne, quadrocopter, airship: from an engine, hull and propeller at a crafting table. «Sky» chapter."
		"&lYour own aircraft (Create Aeronautics):&r build from blocks with propellers and a wheel, any shape. «Sky» chapter."
		"&lShips (Small Ships):&r cog, brig, galleon, drakkar. &lTrains:&r Create + Steam 'n' Rails. &lFPV drones:&r Create Droneworks. «Transport» chapter."
		"&lFinding a recipe:&r hover an item in EMI and press &lR&r (recipe) or &lU&r (uses)."
	]
	quest.1438069491CE0496.title: "Main Keys"
	quest.1438069491CE0496.quest_subtitle: "Cheat sheet"
	quest.1438069491CE0496.quest_desc: [
		"&lL&r quests · &lP&r skills · &lM&r map · &lB&r backpack · &lCaps Lock&r (hold) voice, &lV&r its settings"
		"&lW&r over a Create block: Ponder tutorial · &lR / U&r in EMI: recipe / uses"
		"&lUltimine&r: hold its key (see Controls) and mine: the whole vein"
		"&lYour character&r: change race/class with an Orb of Origin (costs XP)."
	]
	quest.00EB4BACA0AC0845.title: "If You Die"
	quest.00EB4BACA0AC0845.quest_subtitle: "Your items are safe"
	quest.00EB4BACA0AC0845.quest_desc: [
		"All your items stay in a &lgrave&r where you died: the death point is marked on the Xaero map."
		"Without a bed you respawn at spawn. If you appear in water, the pack moves you to the nearest dry land."
	]
	quest.6287ECAD55E7E7A0.title: "Claims and PvP"
	quest.6287ECAD55E7E7A0.quest_subtitle: "What's yours is protected"
	quest.6287ECAD55E7E7A0.quest_desc: [
		"&lClaim:&r map (M) → select chunks → «Claim». Inside a claim nobody breaks blocks, opens chests or uses machines without your permission. Add friends to a Party."
		"&lPvP is on&r, and guns hit through a crowd: mind your line of fire. Attacking players without agreement isn't nice."
		"&lDungeon chests&r are personal (Lootr): everyone gets their own loot."
	]
	quest.24DEEB4CF1811863.title: "Where It's Dangerous"
	quest.24DEEB4CF1811863.quest_subtitle: "A calm world, danger by choice"
	quest.24DEEB4CF1811863.quest_desc: [
		"&lNear spawn&r (up to ~250 blocks), inside claims and near a Hearth Stone monsters don't spawn. &lFurther out&r there are more, and bosses, gunners and &lelite mobs&r (armoured, triple health) live &lpast ~1500 blocks&r, in dungeons and other worlds."
		"Want a fight? Head into the wilds. Want to build? Settle closer to spawn."
	]
	quest.78F07D05EA3AF586.title: "Food and Seasons"
	quest.78F07D05EA3AF586.quest_subtitle: "Variety = health"
	quest.78F07D05EA3AF586.quest_desc: [
		"Try new dishes: every few &ldifferent&r foods grant +2 hearts of health (Spice of Life: Carrot Edition)."
		"&lSeasons&r change every few in-game weeks: in winter outdoor crops don't grow, so build a greenhouse (glass over your beds)."
	]
	quest.54FFA2AF231F36C6.title: "Playing Together"
	quest.54FFA2AF231F36C6.quest_subtitle: "Roles and quests"
	quest.54FFA2AF231F36C6.quest_desc: [
		"Quests can be done &las a team&r: create an FTB Teams party and progress is shared. Pick roles: engineer, mage, cook, warrior, builder, mayor."
		"«Handshake» quests need items from different branches: more fun that way."
	]
	quest.0C6CC72CF1D60E84.title: "Ready!"
	quest.0C6CC72CF1D60E84.quest_subtitle: "Next: «The Arkhaven Path»"
	quest.0C6CC72CF1D60E84.quest_desc: [
		"You know the essentials. Open &l«The Arkhaven Path»&r: it guides you through the pack step by step."
	]
	chapter.153AE3239EBFC45C.title: "The Arkhaven Path"
	chapter.153AE3239EBFC45C.chapter_subtitle: [
		"Where to go next: one line through every chapter"
	]
	quest.04E65EA9D232B59D.title: "How to Read the Path"
	quest.04E65EA9D232B59D.quest_subtitle: "One line, many roads"
	quest.04E65EA9D232B59D.quest_desc: [
		"&lWhat:&r the main line of the pack. Every step is a milestone that opens new chapters."
		"&lWhy:&r there are hundreds of mods; the Path shows a sensible order: food → tools → machines → electricity → networks → atoms → bosses and other worlds."
		"&lHow:&r do the steps here and read the details in the chapter named in each description. You can branch off any time: the Path never locks other chapters."
	]
	quest.5989F710ABA29FD2.title: "Settle Down"
	quest.5989F710ABA29FD2.quest_subtitle: "Chapter «First Steps»"
	quest.5989F710ABA29FD2.quest_desc: [
		"A bed, a chest, a claim and a waystone: your first home. Near spawn and bases the world is calm; fights are optional, out in the wilds."
		"&lNext:&r «First Steps» teaches claiming land (Open Parties and Claims) and carrying a backpack."
	]
	quest.14E673074E384ED8.title: "Well Fed Means Strong"
	quest.14E673074E384ED8.quest_subtitle: "Chapters «Kitchen» and «Garden»"
	quest.14E673074E384ED8.quest_desc: [
		"&lWhy:&r varied food grants extra health (Spice of Life), and dishes give buffs that last for hours."
		"&lHow:&r a Farmer's Delight cooking pot plus beds from «Garden». Seasons (Serene Seasons) change what grows: greenhouse in winter."
	]
	quest.006C91045BBCADB4.title: "The Iron Age"
	quest.006C91045BBCADB4.quest_subtitle: "Ores, furnaces, first tools"
	quest.006C91045BBCADB4.quest_desc: [
		"An iron pickaxe unlocks nearly every modded ore: zinc (Create), osmium (Mekanism), yellorite (Extreme Reactors), lead and bauxite (TFMG)."
		"&lTip:&r hold the Ultimine key to mine a whole vein."
	]
	quest.3CA4B560AE561B3E.title: "Pick a Calling"
	quest.3CA4B560AE561B3E.quest_subtitle: "Roles and skills"
	quest.3CA4B560AE561B3E.quest_desc: [
		"You don't have to do everything. &lEngineer&r: Create and Mekanism; &lmage&r: Ars Nouveau and Iron's Spells; &lcook/farmer&r: kitchen and garden; &lwarrior&r: weapons and bosses; &lmayor&r: a Minecolonies colony."
		"The best parts are where roles meet: «handshake» quests need a neighbour from another role. Skill points: &lP&r key."
	]
	quest.13E77B47518CF45C.title: "Mechanics"
	quest.13E77B47518CF45C.quest_subtitle: "Chapter «Create»"
	quest.13E77B47518CF45C.quest_desc: [
		"&lWhat:&r Create runs on rotation instead of electricity: shafts, cogs, press, mixer, belts."
		"&lWhy:&r almost the whole pack leans on Create: food, armour, guns, airships and even reactors are made on its lines."
		"&lHow:&r andesite alloy → casing → water wheel. Hold &lW&r over a block: Ponder shows how it works."
	]
	quest.68172BA2AE32DFEF.title: "Brass"
	quest.68172BA2AE32DFEF.quest_subtitle: "The key to tier two"
	quest.68172BA2AE32DFEF.quest_desc: [
		"Brass (copper + zinc in a heated mixer) unlocks smart machinery: precision assembly, deployers, logistics, trains."
		"&lNext:&r «Create: Add-ons»: batteries, Big Cannons steel, experience enchanting."
	]
	quest.21FBC8C7F82B336A.title: "Steel"
	quest.21FBC8C7F82B336A.quest_subtitle: "Chapter «Steel and Oil»"
	quest.21FBC8C7F82B336A.quest_desc: [
		"Steel has three roads: the Immersive Engineering coke oven and blast furnace, the TFMG steelworks, or Mekanism. Pick any: Almost Unified turns all steel into one ingot."
		"&lWhy:&r steel makes TaCZ guns, ship cannons, reactor casings and turbines."
	]
	quest.1A928072C549EAF5.title: "Electricity"
	quest.1A928072C549EAF5.quest_subtitle: "Chapters «Mekanism» and «Steel and Oil»"
	quest.1A928072C549EAF5.quest_desc: [
		"Energy (FE) powers Mekanism, Immersive Engineering and AE2 machines. Create Addition alternators turn rotation into power: the bridge between worlds."
		"&lTip:&r start with solar panels or a biofuel generator: they make no smog."
	]
	quest.39B9D7211C3AD114.title: "A Network of Things"
	quest.39B9D7211C3AD114.quest_subtitle: "Chapters «Storage» and «AE2: Deeper»"
	quest.39B9D7211C3AD114.quest_desc: [
		"&lWhy:&r when there are too many chests, AE2 turns them into one digital base with search and autocrafting."
		"&lHow:&r meteorite → presses → processors → controller. Channels are unlimited in Arkhaven: no wiring headaches."
	]
	quest.4693C34C08702F13.title: "The Atom"
	quest.4693C34C08702F13.quest_subtitle: "Chapter «The Atom»"
	quest.4693C34C08702F13.quest_desc: [
		"Reactors power the hungriest machines: the SPS, fusion, mega cells."
		"&lGentle road:&r Extreme Reactors: no radiation, no pollution. &lRisky road:&r the Mekanism fission reactor: stronger, but a meltdown contaminates the area (only that area)."
	]
	quest.5F1BA5A3E0A5735B.title: "Magic"
	quest.5F1BA5A3E0A5735B.quest_subtitle: "Chapters «Ars Nouveau», «Iron's Spells», «Occultism»"
	quest.5F1BA5A3E0A5735B.quest_desc: [
		"Magic runs parallel to tech: flight and teleport spells, automation by familiars and spirits."
		"It doesn't have to be yours, but a mage on the team makes an engineer's life easier (and vice versa)."
	]
	quest.050C8B0EB9425EC7.title: "Hit the Road"
	quest.050C8B0EB9425EC7.quest_subtitle: "Chapter «Transport»"
	quest.050C8B0EB9425EC7.quest_desc: [
		"Ships (Small Ships), trains (Steam 'n' Rails), planes (Immersive Aircraft), airships and FPV drones (Aeronautics): choose how you travel."
		"Far lands hold ores, dungeons and bosses."
	]
	quest.39A56463E8C5A7F8.title: "Arms"
	quest.39A56463E8C5A7F8.quest_subtitle: "Chapters «Weapons» and «Firearms»"
	quest.39A56463E8C5A7F8.quest_desc: [
		"The TaCZ gunsmith table builds firearms from steel and gunpowder. Bandit fortresses and illager camps hold shooters with the same guns, and their loot."
	]
	quest.576B9EB277FB4903.title: "The First Boss"
	quest.576B9EB277FB4903.quest_subtitle: "Chapters «Adventure» and «Bosses»"
	quest.576B9EB277FB4903.quest_desc: [
		"The Naga in the Twilight Forest is a fair first boss: slow, loud, it teaches you to dodge."
		"&lNext:&r the «Bosses» chapter lists them all by difficulty, from the Naga to the Leviathan."
	]
	quest.012668B87D0FA2D0.title: "Dungeons"
	quest.012668B87D0FA2D0.quest_subtitle: "Chapter «Dungeons and Structures»"
	quest.012668B87D0FA2D0.quest_desc: [
		"Dungeon chests are personal (Lootr): every player gets their own loot, nobody robs anybody."
		"Bandit Towers are a good start: shooters, traps, chests with gunpowder and steel."
	]
	quest.6767449E51F712DE.title: "Other Worlds"
	quest.6767449E51F712DE.quest_subtitle: "Chapter «Other Worlds»"
	quest.6767449E51F712DE.quest_desc: [
		"The Aether above, the Undergarden below, the Bumblezone, the Otherside past the Warden, the End: every world has its own ores and bosses."
	]
	quest.5BDC466474828798.title: "A Town"
	quest.5BDC466474828798.quest_subtitle: "Chapter «Town»"
	quest.5BDC466474828798.quest_desc: [
		"A Minecolonies colony works for you: builders, farmers, miners. It eats your resources and returns them many times over."
	]
	quest.63BC6F90D1FCE215.title: "Peaks Need Friends"
	quest.63BC6F90D1FCE215.quest_subtitle: "One part from another branch"
	quest.63BC6F90D1FCE215.quest_desc: [
		"The pack's strongest items ask for &lone&r part from another role: no long chains, but faster together:"
		"&lGunsmith table&r: steel and a Create precision mechanism (smelter + engineer)."
		"&lME controller&r (AE2): a Create precision mechanism."
		"&lAircraft engine&r: aero lubricant (the angler's fish oil or the oil worker's lubricant)."
		"&lReinforced reactor&r: a Mekanism elite circuit."
		"&lMEGA 256M cell&r: a reinforced echo shard from the Otherside (explorer)."
		"&lFusion controller&r: a nether star (beating the Wither, warrior)."
	]
	quest.4AD95969A43AE499.title: "Elites of the Wilds"
	quest.4AD95969A43AE499.quest_subtitle: "The further, the scarier"
	quest.4AD95969A43AE499.quest_desc: [
		"Beyond &l1500 blocks&r from spawn some monsters spawn as &lelites&r: in chainmail, with double or triple health and a heavy hit."
		"Beyond &l3000 blocks&r, in the Nether, Twilight Forest, Undergarden, Otherside and End there are more elites, in iron and tougher still."
		"&lReward:&r meteor dust, emeralds, sometimes a diamond or a rift shard, and plenty of XP. Elite armour never drops."
		"Spawners and eggs never make elites: only the wild does."
	]
	quest.1F4F10227DA0EDBC.title: "Great Works"
	quest.1F4F10227DA0EDBC.quest_subtitle: "Chapter «Great Works»"
	quest.1F4F10227DA0EDBC.quest_desc: [
		"You've walked every road. The finale: the server's shared projects: a sky citadel, a fusion plant, a nature reserve, a city."
		"It isn't a race: great works are built together, over months."
	]
	chapter.037CC61EABB1B7C0.title: "Origin & Path"
	chapter.037CC61EABB1B7C0.chapter_subtitle: [
		"Your race, your skills and how you grow"
	]
	quest.778DA091C9349444.title: "What You Were Born As"
	quest.778DA091C9349444.quest_subtitle: "An origin is a style, not a sentence"
	quest.778DA091C9349444.quest_desc: [
		"&lWhat:&r on first join you pick an &lorigin&r — a race with perks and drawbacks."
		"Some see in the dark, some breathe underwater, some are slower but sturdier."
		"&lWhy:&r it changes &ohow&r you play, not &ohow much&r you can do. No origin is weak."
		"No selection screen? Grab an &lOrb of Origin&r — this quest's reward."
	]
	quest.6914A21F92128873.title: "Changed Your Mind?"
	quest.6914A21F92128873.quest_subtitle: "Switching origins"
	quest.6914A21F92128873.quest_desc: [
		"The first switch is &lfree&r: use the Orb of Origin from the previous quest."
		"After that it costs an expensive rebirth potion (chapter \"Alchemy\")."
		"&lTip:&r play a couple of evenings before switching — many abilities take time to shine."
	]
	quest.73257FF3447BD0B1.title: "What Can I Do?"
	quest.73257FF3447BD0B1.quest_subtitle: "The origin info screen"
	quest.73257FF3447BD0B1.quest_desc: [
		"Active origin abilities sit on the &lskill&r keys (see &oOptions → Controls → NeoOrigins&r)."
		"There you'll also find \"View Origin Info\": every passive bonus and weakness in one list."
	]
	quest.465EB2685CD40729.title: "You Grow by Doing"
	quest.465EB2685CD40729.quest_subtitle: "Skill trees — the P key"
	quest.465EB2685CD40729.quest_desc: [
		"&lWhat:&r every activity has its own skill tree: miner, cook, farmer, warrior, mage…"
		"&lHow to level:&r just do the thing. Cooking grows Cooking, digging grows Mining."
		"Press &lP&r to open the trees and spend points. No class prisons: you can grow a bit of everything."
	]
	quest.1899A2B09262FA6D.title: "Your First Point"
	quest.1899A2B09262FA6D.quest_subtitle: "Open a tree and pick a skill"
	quest.1899A2B09262FA6D.quest_desc: [
		"Mine some stone or ore, cook something — then look at your trees (&lP&r)."
		"Pick a first skill near the centre. Tick the quest when it's done."
		"&lTip:&r skills can be reset — alchemists brew a special potion for that."
	]
	quest.7D83C31C7DE03358.title: "Trees of the Magic Schools"
	quest.7D83C31C7DE03358.quest_subtitle: "Fire, ice, nature, blood…"
	quest.7D83C31C7DE03358.quest_desc: [
		"If Iron's Spells is your thing, each school of magic has its own tree."
		"Cast that school's spells and its tree grows: more damage, less mana."
		"More in the \"Iron's Spells\" chapter."
	]
	quest.5E88CA63A0373FF4.title: "Peace Is Your Choice"
	quest.5E88CA63A0373FF4.quest_subtitle: "The Mega Torch and quiet places"
	quest.5E88CA63A0373FF4.quest_desc: [
		"Want a farm or the road to the next village to always be safe? Place a &lMega Torch&r —"
		"hostile mobs won't spawn in a big radius around it."
		"Your claims and the Haven are already protected — this is for new places."
	]
	quest.0EECEE5A77DBE4F4.title: "The Miner's Path"
	quest.0EECEE5A77DBE4F4.quest_desc: [
		"The mining tree: dig faster, more ore, night vision underground. Grows by mining ore."
	]
	quest.49A24043E10608D2.title: "The Cook's Path"
	quest.49A24043E10608D2.quest_desc: [
		"The cooking tree: dishes buff for longer, food fills more. Grows by cooking."
	]
	quest.0665A88330D8BDE5.title: "The Farmer's Path"
	quest.0665A88330D8BDE5.quest_desc: [
		"The farming tree: bigger harvests, double-drop chance, faster growth around you."
	]
	quest.417847C383096E06.title: "The Warrior's Path"
	quest.417847C383096E06.quest_desc: [
		"The combat tree: more damage, health and armour. Grows by fighting enemies."
	]
	quest.49609C8E1769CAB2.title: "The Traveler's Charm"
	quest.49609C8E1769CAB2.quest_desc: [
		"While the charm is in your inventory, enemies notice you at half the distance. For walkers, not fighters."
		"Recipe: string, lavender, emerald, feather."
	]
	chapter.189EA59915A6A7C6.title: "First Steps"
	chapter.189EA59915A6A7C6.chapter_subtitle: [
		"Home, food, tools — and no rush"
	]
	quest.71A312E68F5D5D95.title: "Log by Log"
	quest.71A312E68F5D5D95.quest_subtitle: "Any wood works… but the task wants oak"
	quest.71A312E68F5D5D95.quest_desc: [
		"Everything starts with wood. Hold &l`&r and break a trunk — the whole tree comes down."
		"No oak nearby? Come back later — use whatever wood you have for your own needs."
	]
	quest.25244ED318CF1CC2.title: "The Workbench"
	quest.25244ED318CF1CC2.quest_subtitle: "Where every craft begins"
	quest.25244ED318CF1CC2.quest_desc: [
		"Forgot a recipe? Hover the item in the EMI list on the right and press &lR&r."
		"EMI search understands both Russian and English names."
	]
	quest.0A20243FB3DE57EE.title: "The Stone Age"
	quest.0A20243FB3DE57EE.quest_subtitle: "Your first pickaxe"
	quest.0A20243FB3DE57EE.quest_desc: [
		"A stone pickaxe opens the way underground. Caves near spawn are calm, but a torch never hurts."
	]
	quest.493C04C72C252AE1.title: "Fire in the Hearth"
	quest.493C04C72C252AE1.quest_subtitle: "A furnace for ore and food"
	quest.493C04C72C252AE1.quest_desc: [
		"A furnace smelts ore and cooks meat. Later Create and Mekanism will do it dozens of times faster."
	]
	quest.21B4E617FBC154C7.title: "The Iron Age"
	quest.21B4E617FBC154C7.quest_subtitle: "Veins here run rich"
	quest.21B4E617FBC154C7.quest_desc: [
		"Find iron ore and break it with &l`&r — you'll dig out the whole vein."
		"Everyone needs iron: engineers, cooks (pots!), farmers."
	]
	quest.7D055965B59E433F.title: "A Serious Pickaxe"
	quest.7D055965B59E433F.quest_subtitle: "Diamonds, redstone, gold"
	quest.7D055965B59E433F.quest_desc: [
		"An iron pickaxe mines almost everything. Diamonds are deep — below height zero."
		"Remember: deep caves count as &lthe wilds&r (zone 2)."
	]
	quest.18F86F97AA42687E.title: "A Place of Your Own"
	quest.18F86F97AA42687E.quest_subtitle: "A bed sets your respawn point"
	quest.18F86F97AA42687E.quest_desc: [
		"You don't have to sleep — no mobs spawn near spawn. But a bed remembers where you respawn."
		"To skip the night, only &lhalf&r the players need to be in bed."
	]
	quest.4250898F27D30389.title: "A Sleeping Bag in Your Pack"
	quest.4250898F27D30389.quest_subtitle: "Camp out without moving your home point"
	quest.4250898F27D30389.quest_desc: [
		"A &lsleeping bag&r lets you sleep through the night on the road and &ldoesn't&r change your respawn point."
		"There's also a &lhammock&r for a daytime nap."
	]
	quest.7FFC8E5E8083B094.title: "This Is Mine"
	quest.7FFC8E5E8083B094.quest_subtitle: "Claiming land (Open Parties and Claims)"
	quest.7FFC8E5E8083B094.quest_desc: [
		"&lWhat:&r a claim protects your blocks from others and makes the place &lsafe&r: no enemies spawn there."
		"&lHow:&r open the map (&lM&r), right-click chunks → \"Claim\". Or press &l'&r for the claims menu."
		"Add friends to your &lparty&r so they can build at your place too."
	]
	quest.5FDAC3643835B9B1.title: "A Backpack"
	quest.5FDAC3643835B9B1.quest_subtitle: "You can never have too many pockets"
	quest.5FDAC3643835B9B1.quest_desc: [
		"A backpack sits on your back and takes &lupgrades&r: item pickup, auto-smelting, auto-feeding."
		"Upgrades go in the side slots — check them in EMI (&lU&r on the backpack)."
	]
	quest.2D3F975CD04C8DA2.title: "Order in the Chests"
	quest.2D3F975CD04C8DA2.quest_subtitle: "Sophisticated Storage"
	quest.2D3F975CD04C8DA2.quest_desc: [
		"Barrels and chests that upgrade just like the backpack: more space, sorting, filters."
		"Later you can wire it all into an AE2 digital network (chapter \"Storage\")."
	]
	quest.41D73599EA517F03.title: "Waystones"
	quest.41D73599EA517F03.quest_subtitle: "Teleport between places you've found"
	quest.41D73599EA517F03.quest_desc: [
		"&lWaystones&r stand in villages. Click one and it's remembered — you can travel back to it from any other."
		"You can also craft your own for your home. Return scrolls are a quick way home from a trip."
	]
	quest.641414C5D00BB68B.title: "If Things Go Wrong"
	quest.641414C5D00BB68B.quest_subtitle: "A gravestone keeps your items"
	quest.641414C5D00BB68B.quest_desc: [
		"When you die your items don't scatter — they rest in a &lgravestone&r. Its spot is marked on the map."
		"Walk up and click it — everything returns to your inventory. Other players can't open your grave."
	]
	quest.1E45B54AE1AE0643.title: "Variety Is the Heart"
	quest.1E45B54AE1AE0643.quest_subtitle: "Spice of Life: new dishes = new hearts"
	quest.1E45B54AE1AE0643.quest_desc: [
		"Every &lnew&r dish you taste brings you closer to an extra &lheart&r."
		"The food book shows what you've eaten. Your best friend here is your group's &lcook&r."
		"Valued by: everyone. Especially before bosses."
	]
	quest.13724199B13ED6C5.title: "Chests for Everyone"
	quest.13724199B13ED6C5.quest_subtitle: "Everyone gets their own loot"
	quest.13724199B13ED6C5.quest_desc: [
		"Chests in dungeons and ruins are &lper player&r: a friend opened it first — you still get yours."
		"So explore together without elbowing each other at the chest."
	]
	quest.3167C5A5C262D22D.title: "A Home, and a World Waiting"
	quest.3167C5A5C262D22D.quest_subtitle: "Pick your road"
	quest.3167C5A5C262D22D.quest_desc: [
		"The basics are done. Open any chapter next — kitchen, garden, machines, magic, adventure — each has its own thing."
		"You don't have to do everything. Do what you enjoy and &ldrop by your friends&r — they probably need your help."
	]
	quest.7BD784A262A4F208.title: "A Shield"
	quest.7BD784A262A4F208.quest_desc: [
		"A shield blocks hits and arrows. Useful even in the calm lands — just in case."
	]
	quest.04645A8752811DB8.title: "A Diamond Pickaxe"
	quest.04645A8752811DB8.quest_desc: [
		"Diamonds lie deep, below height zero. Remember: deep caves are &lthe wilds&r."
	]
	quest.1A2098FF68A8F3F1.title: "Backpack Upgrades"
	quest.1A2098FF68A8F3F1.quest_desc: [
		"Pickup puts loot straight into the backpack, the magnet pulls items in. Digging gets easier."
	]
	quest.73D46902670D5A7C.title: "Auto-Feeding"
	quest.73D46902670D5A7C.quest_desc: [
		"The backpack feeds you from its contents when you get hungry."
	]
	quest.4A13AADDAB2AE3C8.title: "The Iron Backpack"
	quest.4A13AADDAB2AE3C8.quest_desc: [
		"More slots and more upgrade space. Next come gold, diamond and netherite."
	]
	quest.7C58537A359FA5A6.title: "The Warp Stone"
	quest.7C58537A359FA5A6.quest_desc: [
		"A reusable teleport to any waystone you've found. The handiest way home."
	]
	quest.01DD1D53DF25CA6A.title: "Carry a Chest"
	quest.01DD1D53DF25CA6A.quest_desc: [
		"Carry On: crouch with empty hands and click a chest or animal — you'll pick it up whole."
	]
	quest.1D2C45BEDF6DAD9C.title: "The Hammock"
	quest.1D2C45BEDF6DAD9C.quest_desc: [
		"Nap through the day until evening. For night-walk lovers."
	]
	chapter.62C3EC2B524D9932.title: "Kitchen & Tavern"
	chapter.62C3EC2B524D9932.chapter_subtitle: [
		"Food that heals, energises and grants hearts"
	]
	quest.63A6743396745987.title: "The Cook's Knife"
	quest.63A6743396745987.quest_subtitle: "Where Farmer's Delight begins"
	quest.63A6743396745987.quest_desc: [
		"&lWhat:&r a knife cuts meat, veggies and fish on a cutting board and harvests straw from grass."
		"&lWhy:&r almost every dish starts with chopping. And dishes here mean &lbuffs&r and &lextra hearts&r."
		"&lTip:&r the flint knife is a starter; an iron one lasts much longer."
	]
	quest.7337BE2DD2237031.title: "The Cutting Board"
	quest.7337BE2DD2237031.quest_subtitle: "Place an ingredient and strike with a knife"
	quest.7337BE2DD2237031.quest_desc: [
		"Right-click an item onto the board, then click it with a knife to slice it."
		"That's how you get chicken cuts, fish slices, minced beef, cabbage leaves."
		"Later an &lautomatic slicer&r (Create: Slice & Dice) takes over."
	]
	quest.5238FD9DA6380669.title: "A Pot Over the Fire"
	quest.5238FD9DA6380669.quest_subtitle: "The heart of the kitchen"
	quest.5238FD9DA6380669.quest_desc: [
		"&lHow:&r set the pot on a heat source — a campfire, a Farmer's Delight stove or magma."
		"Add up to 6 ingredients plus a container — the pot cooks stews, soups and pasta by itself."
		"Recipes: press &lU&r on the pot in EMI. A heated pot shows steam underneath."
	]
	quest.35985DCC77D18802.title: "The Skillet"
	quest.35985DCC77D18802.quest_subtitle: "Fry — and defend yourself"
	quest.35985DCC77D18802.quest_desc: [
		"A skillet fries food held over fire or placed on a stove."
		"It's also a decent weapon. Tasty and loud."
	]
	quest.18D9ECC67E2FC089.title: "Your First Stew"
	quest.18D9ECC67E2FC089.quest_subtitle: "Fullness and Nourishment"
	quest.18D9ECC67E2FC089.quest_desc: [
		"Pot dishes grant &lNourishment&r: your hunger barely drops."
		"Soups grant &lComfort&r: shields you from cold and slowly heals."
		"&lValued by:&r miners and warriors — pack some for the road."
	]
	quest.559D4C6BCF8BCEB9.title: "Rice Grows in Water"
	quest.559D4C6BCF8BCEB9.quest_subtitle: "Plant it in shallow water"
	quest.559D4C6BCF8BCEB9.quest_desc: [
		"Rice is planted straight into one-block-deep water. Find wild rice near swamps and rivers."
		"It goes into rolls, fried rice and rice balls — and gardeners use it for compost."
	]
	quest.2ACE3EA7C75F5792.title: "A Feast for All"
	quest.2ACE3EA7C75F5792.quest_subtitle: "A block-sized dish that feeds the group"
	quest.2ACE3EA7C75F5792.quest_desc: [
		"&lFeasts&r are placed on a table as a block: everyone walks up and takes a serving."
		"Honey-glazed ham, stuffed pumpkin, roasts — one pot feeds the whole team before a boss."
	]
	quest.0501C9B22779C6E3.title: "Dream Kitchen"
	quest.0501C9B22779C6E3.quest_subtitle: "Cooking for Blockheads"
	quest.0501C9B22779C6E3.quest_desc: [
		"The &lcooking table&r sees everything in the adjacent cupboards, fridge and counters."
		"It shows only the dishes you can make &lright now&r and cooks them in one click."
		"Put a table, fridge, oven and sink together and you have a multiblock kitchen."
	]
	quest.1D2EF124557ECDB4.title: "The Fridge"
	quest.1D2EF124557ECDB4.quest_subtitle: "Your kitchen remembers its stock"
	quest.1D2EF124557ECDB4.quest_desc: [
		"A fridge stores ingredients and links to the cooking table. Stack two for a fridge-freezer."
		"&lTip:&r a sink gives endless water for recipes, an oven gives heat for frying."
	]
	quest.1BBF63337B27B478.title: "The Oven"
	quest.1BBF63337B27B478.quest_subtitle: "Nine dishes at once"
	quest.1BBF63337B27B478.quest_desc: [
		"The oven bakes nine items at once and links into the kitchen. Add a heating unit to speed it up."
	]
	quest.16CFEF89533B0A8C.title: "The Cheese That Waited"
	quest.16CFEF89533B0A8C.quest_subtitle: "Let's Do Meadow"
	quest.16CFEF89533B0A8C.quest_desc: [
		"&lWhat:&r a cheese form — pour in milk with rennet and some time later you have a whole wheel."
		"Goat, sheep and buffalo milk make different cheeses. Alpine animals are raised by &lbreeders&r."
		"&lWhy:&r cheese is a tavern staple and colonists love it."
	]
	quest.0466BE55A60FEE69.title: "A Whole Wheel"
	quest.0466BE55A60FEE69.quest_subtitle: "Slice it up"
	quest.0466BE55A60FEE69.quest_desc: [
		"Place the cheese wheel and slice it with a knife. Cheese goes into tarts, sandwiches, cheesy sausages."
		"&lValued by:&r everyone. Especially those collecting new dishes for hearts."
	]
	quest.45AAADFE7F430492.title: "The Vineyard"
	quest.45AAADFE7F430492.quest_subtitle: "Let's Do Vinery"
	quest.45AAADFE7F430492.quest_desc: [
		"&lWhat:&r grapes grow on trellises; the press turns them into juice, and a barrel turns juice into wine."
		"Different biomes, different grapes: red, white, savanna, taiga, jungle."
		"&lTip:&r wines grant special effects — from luck to night vision. Check them in EMI."
	]
	quest.54B6204A21417774.title: "The Fermentation Barrel"
	quest.54B6204A21417774.quest_subtitle: "Patience is the main ingredient"
	quest.54B6204A21417774.quest_desc: [
		"Put in juice, sugar and bottles — some time later you have wine. The longer wine ages on a rack, the stronger it gets."
	]
	quest.37C38BE393F08BE9.title: "The First Bottle"
	quest.37C38BE393F08BE9.quest_subtitle: "To friendship!"
	quest.37C38BE393F08BE9.quest_desc: [
		"Red wine is ready. Put it on a wine rack and let it age."
		"&lValued by:&r mages (some rituals like wine) and the mayor — colonists cheer up in the tavern."
	]
	quest.17AC84486D9AD8A3.title: "The Keg"
	quest.17AC84486D9AD8A3.quest_subtitle: "Brewin' and Chewin': beer, mead, cheese"
	quest.17AC84486D9AD8A3.quest_desc: [
		"The &lkeg&r brews drinks: beer, mead, cider. The surrounding temperature matters — see the hint in the keg window."
		"The Tipsy effect reduces accuracy — drink after work, not before."
	]
	quest.05D32CBE23FE1E77.title: "Something Frothy"
	quest.05D32CBE23FE1E77.quest_subtitle: "The tavern is open"
	quest.05D32CBE23FE1E77.quest_desc: [
		"Beer's ready. Put tankards on a table, call your friends — that's a tavern."
		"&lTip:&r Brewin' drinks grant Tipsy-adjacent buffs like damage resistance."
	]
	quest.5FDA2B7EE1F27453.title: "The Kettle"
	quest.5FDA2B7EE1F27453.quest_subtitle: "Farmer's Respite and HerbalBrews"
	quest.5FDA2B7EE1F27453.quest_desc: [
		"Tea and coffee grant handy effects: &lcoffee&r gives speed, &lgreen tea&r clears effects, &lrose hip&r gives regeneration."
		"Gardeners grow tea bushes. The kettle sits on heat just like the pot."
	]
	quest.4ACB5F2996AE60FF.title: "Mornings Start with Coffee"
	quest.4ACB5F2996AE60FF.quest_subtitle: "Speed, digging, energy"
	quest.4ACB5F2996AE60FF.quest_desc: [
		"One cup and the miner digs faster and the traveller runs farther."
		"&lValued by:&r engineers and miners. Make a stash — it'll be gone fast."
	]
	quest.7355D37F5F004689.title: "A Country Kitchen"
	quest.7355D37F5F004689.quest_subtitle: "Let's Do Farm & Charm"
	quest.7355D37F5F004689.quest_desc: [
		"Farm & Charm adds flour, dough, corn, oats, barley and rustic dishes."
		"A stove, a mixing bowl and a roaster — everything for a cosy farmhouse kitchen."
	]
	quest.37DF5212B0B993C4.title: "Farmer's Bread"
	quest.37DF5212B0B993C4.quest_subtitle: "Flour → dough → bread"
	quest.37DF5212B0B993C4.quest_desc: [
		"Grain becomes flour, flour with water becomes dough, dough in the oven becomes bread. Simple and filling."
	]
	quest.6D36E2C0372C448B.title: "Hell's Kitchen"
	quest.6D36E2C0372C448B.quest_subtitle: "My Nether's Delight"
	quest.6D36E2C0372C448B.quest_desc: [
		"You can cook the Nether too: hoglins, striders, ghasts, burning peppers."
		"Spicy dishes grant fire resistance — just what you need for a Nether trip."
	]
	quest.25B96A73086279BC.title: "Gifts of the Sea"
	quest.25B96A73086279BC.quest_subtitle: "Ocean's Delight"
	quest.25B96A73086279BC.quest_desc: [
		"Squid, guardians, pufferfish — seafood. Fish come from &langlers&r (chapter \"Fishing\")."
		"&lCareful:&r unskilled fugu is poison. Slice it on the board!"
	]
	quest.6365AAAF7F5090A9.title: "Dinner at the End of the World"
	quest.6365AAAF7F5090A9.quest_subtitle: "End's Delight"
	quest.6365AAAF7F5090A9.quest_desc: [
		"Chorus, shulkers and even dragon meat. The strongest dishes in the pack — for those who reached the End."
	]
	quest.0E783133843C22F0.title: "Gourmet"
	quest.0E783133843C22F0.quest_subtitle: "Taste 20 different dishes"
	quest.0E783133843C22F0.quest_desc: [
		"Open the food book (Spice of Life) and see how many dishes you've tried."
		"Each milestone grants a &lheart&r. Twenty dishes and you're noticeably tougher."
		"Tick the quest once the book shows 20+ dishes."
	]
	quest.22F67D677FBB6DC6.title: "A Kitchen of Cogs"
	quest.22F67D677FBB6DC6.quest_subtitle: "Create: Slice & Dice"
	quest.22F67D677FBB6DC6.quest_desc: [
		"The &lslicer&r is a mechanical cutting board: a knife on a Create shaft slices whatever passes by."
		"With a mechanical mixer and a Farmer's Delight pot, the kitchen runs itself."
		"&lWho helps:&r the engineer handles shafts, the cook handles recipes. A two-person job!"
	]
	quest.4F947AD7FACA9BC3.title: "A Better Knife"
	quest.4F947AD7FACA9BC3.quest_desc: [
		"An iron knife lasts longer and cuts faster. Later come diamond and netherite."
		"A knife is also a weapon: quick strikes, great against small critters."
	]
	quest.0C3B5AE748A47953.title: "The Stove"
	quest.0C3B5AE748A47953.quest_desc: [
		"A stove is an everlasting flame for the pot and skillet. You can also grill right on top: put meat on it."
		"Made of bricks and a furnace — pretty and safer than a campfire."
	]
	quest.4B552557EC185A3E.title: "Kitchen Cabinets"
	quest.4B552557EC185A3E.quest_desc: [
		"Cabinets are storage that looks like a real kitchen. Available in every wood type."
	]
	quest.00F65B21E2465E69.title: "Three Soups"
	quest.00F65B21E2465E69.quest_desc: [
		"Vegetable, pumpkin and chicken — soups grant Comfort: warmth and slow healing."
		"Perfect before a trip to snowy lands."
	]
	quest.45CEAF11E8EBFDB2.title: "Pasta with Meatballs"
	quest.45CEAF11E8EBFDB2.quest_desc: [
		"A hearty dish of raw pasta and minced beef. Grants &lHealth Boost&r for 10 minutes — a warrior favourite."
	]
	quest.5733BC9DDB8BF2F2.title: "The Miner's Pie"
	quest.5733BC9DDB8BF2F2.quest_desc: [
		"In Arkhaven shepherd's pie grants &lHaste II&r for 5 minutes — miners dig twice as fast."
		"Valued by: engineers and miners."
	]
	quest.2BD21258DE662010.title: "Rice Dishes"
	quest.2BD21258DE662010.quest_desc: [
		"Fried rice and mushroom rice. In Arkhaven mushroom rice grants night vision — a gift for cavers."
	]
	quest.76C0023FD5EBA6FC.title: "Rolls"
	quest.76C0023FD5EBA6FC.quest_desc: [
		"Rice + fish from the angler = rolls. Quick to make and varied — great for your food book."
	]
	quest.01C12854E8F1B593.title: "Pies"
	quest.01C12854E8F1B593.quest_desc: [
		"A pie is placed whole on a table and served in slices. A great treat for a shared kitchen."
	]
	quest.6DD2CF16ED7E2503.title: "Roast Chicken"
	quest.6DD2CF16ED7E2503.quest_desc: [
		"Another feast for the whole table. Lovely after coming back from a dungeon."
	]
	quest.5FAC855B23FEA2BD.title: "Stuffed Pumpkin"
	quest.5FAC855B23FEA2BD.quest_desc: [
		"An autumn dish and the star of the Harvest Festival. Pumpkins come from the gardener."
	]
	quest.49B4C548F631D1A2.title: "The Cheese Shop"
	quest.49B4C548F631D1A2.quest_desc: [
		"Goat, sheep and buffalo cheese — the milk of three alpine animals."
		"The breeder brings the herd, the cook makes the cheese. A job for two."
	]
	quest.414B31268F62EAEE.title: "Cheese Dishes"
	quest.414B31268F62EAEE.quest_desc: [
		"A cheese tart grants regeneration. A sandwich is quick food for the road."
	]
	quest.6B63BF6B84A13FC1.title: "The Wine List"
	quest.6B63BF6B84A13FC1.quest_desc: [
		"Noir, cherry, apple — each wine has its own effect. Check them in EMI and pick a favourite."
	]
	quest.29929BA10B235878.title: "The Wine Cellar"
	quest.29929BA10B235878.quest_desc: [
		"Wine on a rack grows stronger with age. Build a cellar under the tavern."
	]
	quest.5EBE9D2E71E7566A.title: "Mead"
	quest.5EBE9D2E71E7566A.quest_desc: [
		"Honey from the breeder's bees + a keg = mead. A drink for vikings and good parties."
	]
	quest.4C618506D5B94FF6.title: "Fiery Fondue"
	quest.4C618506D5B94FF6.quest_desc: [
		"Cheese + fire. Grants fire resistance for 8 minutes — just what you need before the Nether."
	]
	quest.618210C3D04CE26C.title: "The Tea Ceremony"
	quest.618210C3D04CE26C.quest_desc: [
		"In Arkhaven green tea restores Iron's Spells mana. Black tea perks you up, lavender calms you."
		"Valued by: mages."
	]
	quest.070D89334A3257F9.title: "The Sink"
	quest.070D89334A3257F9.quest_desc: [
		"Endless water for every kitchen recipe. No more running around with buckets."
	]
	quest.32F8FC9DC50D1AD8.title: "Counters"
	quest.32F8FC9DC50D1AD8.quest_desc: [
		"Counters are ingredient storage the cooking table can see. The more you have, the more one-click recipes."
	]
	quest.02DC973247274ED0.title: "Keeper of the Tavern"
	quest.02DC973247274ED0.quest_subtitle: "Wine, cheese, mead and a feast"
	quest.02DC973247274ED0.quest_desc: [
		"You have everything for a real tavern. Invite your friends and watch their hearts grow."
		"Next: the Grand Restaurant in Great Works."
	]
	chapter.6B2FA039D6C53884.title: "Brewery and Winery"
	chapter.6B2FA039D6C53884.chapter_subtitle: [
		"Beer, wine, rum and vodka: with buffs, in moderation"
	]
	quest.5486FB52402473EA.title: "How Drinking Works Here"
	quest.5486FB52402473EA.quest_subtitle: "Brewin' and Chewin', Vinery, Herbal Brews"
	quest.5486FB52402473EA.quest_desc: [
		"&lWhat:&r drinks are brewed in a keg (Brewin' and Chewin'), wine is aged in barrels (Vinery), tea and coffee in a kettle (Herbal Brews, Farmer's Respite)."
		"&lWhy:&r every drink grants its own buff (see the item tooltip): strength, resistance, speed, warmth in winter."
		"&lTipsiness:&r strong drinks make you Tipsy: a couple of mugs perk you up, too many sway the camera. Know your limit."
		"&lTip:&r a keg has a temperature: some drinks ferment warm (fire, heating cask), others cold (ice crate). The recipe in EMI shows which."
	]
	quest.7DD48C8425292F88.title: "Tankards"
	quest.7DD48C8425292F88.quest_subtitle: "No mug, no drink"
	quest.7DD48C8425292F88.quest_desc: [
		"Keg drinks are poured into tankards. Keep a stack, for yourself and for tavern guests."
	]
	quest.50F75DDCB799AF7E.title: "Steel Toe Stout"
	quest.50F75DDCB799AF7E.quest_subtitle: "A miner's drink"
	quest.50F75DDCB799AF7E.quest_desc: [
		"Dark beer for those who work with their hands. Its buff helps in the mine: check the tooltip for which one."
	]
	quest.32CE37C4439EBF06.title: "Strongroot Ale"
	quest.32CE37C4439EBF06.quest_subtitle: "A warrior's drink"
	quest.32CE37C4439EBF06.quest_desc: [
		"Brewed with root vegetables: drink a mug before a boss fight, together with a dish from «Kitchen»."
	]
	quest.62B9319C01B84D25.title: "Saccharine Rum"
	quest.62B9319C01B84D25.quest_subtitle: "A sailor's drink"
	quest.62B9319C01B84D25.quest_desc: [
		"Rum from sugar cane: no Small Ships captain sets sail without it."
	]
	quest.091CA59FFEDBA284.title: "Vodka"
	quest.091CA59FFEDBA284.quest_subtitle: "Strong stuff"
	quest.091CA59FFEDBA284.quest_desc: [
		"Made from potatoes. Strong: sip it, and check the tooltip for its buff."
	]
	quest.6910FEE1E367ED56.title: "Bloody Mary"
	quest.6910FEE1E367ED56.quest_subtitle: "A cocktail"
	quest.6910FEE1E367ED56.quest_desc: [
		"Vodka + tomatoes from «Garden». Your first cocktail, for the tavern bar."
	]
	quest.07CB93262CD3754E.title: "Rice Wine"
	quest.07CB93262CD3754E.quest_subtitle: "From Farmer's Delight rice"
	quest.07CB93262CD3754E.quest_desc: [
		"Rice from your paddy goes into the keg. «Garden» meets «Brewery»: no farmer, no wine."
	]
	quest.65E7D3DC2B1E7814.title: "Heating Cask"
	quest.65E7D3DC2B1E7814.quest_subtitle: "Warmth for the keg"
	quest.65E7D3DC2B1E7814.quest_desc: [
		"A heat source for the keg: warm-brewed drinks ferment even in winter. For cold ones, use an ice crate."
	]
	quest.61EBEE973BA8D5C1.title: "Cheese Wheel"
	quest.61EBEE973BA8D5C1.quest_subtitle: "It ferments too"
	quest.61EBEE973BA8D5C1.quest_desc: [
		"Brewin' and Chewin' cheese matures in the keg like beer. Sliced, it's the best snack for ale."
	]
	quest.191DFF76FFDB55DB.title: "Wine Box"
	quest.191DFF76FFDB55DB.quest_subtitle: "Vinery: ageing"
	quest.191DFF76FFDB55DB.quest_desc: [
		"Vinery wine improves with time: the longer a bottle rests, the stronger its effect. The box stores bottles and shows the vintage."
	]
	quest.5EEBE11F73184DB4.title: "Apple Cider"
	quest.5EEBE11F73184DB4.quest_subtitle: "From the Vinery press"
	quest.5EEBE11F73184DB4.quest_desc: [
		"Apples into the press, juice into the barrel: cider. Apples grow on Let's Do trees: plant an orchard."
	]
	quest.7DECAA9F406D6656.title: "Eiswein"
	quest.7DECAA9F406D6656.quest_subtitle: "A rare wine"
	quest.7DECAA9F406D6656.quest_desc: [
		"Eiswein is a rare, pricey Vinery wine. The recipe and grape variety are in EMI."
	]
	quest.6FE0B5D606E2BDD2.title: "Copper Tea Kettle"
	quest.6FE0B5D606E2BDD2.quest_subtitle: "Herbal Brews"
	quest.6FE0B5D606E2BDD2.quest_desc: [
		"The alcohol-free branch: green, oolong, rooibos, mate, hibiscus and lavender tea, each with its own buff. Coffee perks you up and speeds up work."
	]
	quest.427DBC1360C65E19.title: "Hot Chocolate"
	quest.427DBC1360C65E19.quest_subtitle: "Create Confectionery"
	quest.427DBC1360C65E19.quest_desc: [
		"Chocolate from a Create mixer, bottled. Restores you without tipsiness. The colony kids will love it."
	]
	quest.0E78C4B235C0F0A3.title: "Tavern Keeper"
	quest.0E78C4B235C0F0A3.quest_subtitle: "The drinks menu is ready"
	quest.0E78C4B235C0F0A3.quest_desc: [
		"Beer, wine, spirits, tea and chocolate. Open a tavern (Minecolonies or your own build) so players come to you after an expedition."
	]
	chapter.62164B6D488C1BD6.title: "Garden, Seasons, Harvest"
	chapter.62164B6D488C1BD6.chapter_subtitle: [
		"From a seed to resources for everyone"
	]
	quest.427EBED79260B8FF.title: "The First Bed"
	quest.427EBED79260B8FF.quest_subtitle: "A hoe and some water nearby"
	quest.427EBED79260B8FF.quest_desc: [
		"&lWhat:&r gardening here isn't just food. Through &lessences&r the garden yields iron, copper, even diamonds."
		"&lHow to start:&r till soil near water. Hold &l`&r and the hoe tills a whole field at once."
		"&lValued by:&r the cook (veggies), the breeder (feed), the mage (Source from plants)."
	]
	quest.7241DEBF5CA44DB8.title: "The Seasons"
	quest.7241DEBF5CA44DB8.quest_subtitle: "Serene Seasons"
	quest.7241DEBF5CA44DB8.quest_desc: [
		"&lWhat:&r the world goes through spring, summer, autumn and winter. Each crop grows only in its seasons."
		"&lHow to tell:&r seeds show \"Growing seasons\" in their tooltip. A calendar shows the current season."
		"&lTip:&r winter brings snow, but under glass in a &lgreenhouse&r everything grows all year."
	]
	quest.51B628DF436AF763.title: "The Greenhouse"
	quest.51B628DF436AF763.quest_subtitle: "Summer under glass"
	quest.51B628DF436AF763.quest_desc: [
		"Plants under a glass roof (up to 15 blocks above) ignore the seasons and always grow."
		"Make it pretty: Create framed glass, frames, lanterns. It's one of the nicest builds in the pack."
	]
	quest.65FFF886EE6B1875.title: "A Vegetable Patch"
	quest.65FFF886EE6B1875.quest_subtitle: "Tomatoes, cabbage, onions"
	quest.65FFF886EE6B1875.quest_desc: [
		"Wild crops grow in the world — pick them for seeds. The cook welcomes every harvest."
		"&lTip:&r Farmer's Delight compost turns into rich soil — crops grow faster on it."
	]
	quest.088D8FACF9F9DAAA.title: "Rich Soil"
	quest.088D8FACF9F9DAAA.quest_subtitle: "Compost → black earth"
	quest.088D8FACF9F9DAAA.quest_desc: [
		"Organic compost turns into &lrich soil&r over time. Plants grow faster on it,"
		"and mushrooms spread into colonies."
	]
	quest.4D54840C4041EC3A.title: "A Garden in a Pot"
	quest.4D54840C4041EC3A.quest_subtitle: "Botany Pots"
	quest.4D54840C4041EC3A.quest_desc: [
		"A &lpot&r grows any plant without water or seasons: add soil, plant a seed."
		"A hopper pot drops the harvest &lby itself&r into the chest below. Ten pots and the cook never runs out of tomatoes."
	]
	quest.27F654BD0954779C.title: "Inferium"
	quest.27F654BD0954779C.quest_subtitle: "Mystical Agriculture: resources grow in a field"
	quest.27F654BD0954779C.quest_desc: [
		"&lWhat:&r inferium ore is found underground. Its essence grows &lresource seeds&r."
		"&lWhy:&r iron, copper, coal, quartz — without a mine. Miners sleep, gardeners work."
		"More in EMI on any Mystical Agriculture seed (&lU&r)."
	]
	quest.1B1006BAB8E24DB6.title: "Seeds from Nothing"
	quest.1B1006BAB8E24DB6.quest_subtitle: "Inferium grows itself"
	quest.1B1006BAB8E24DB6.quest_desc: [
		"Inferium seeds yield more essence — that's how you save up for valuable seeds."
		"&lTip:&r on &linferium farmland&r (special soil) more essence drops."
	]
	quest.67BC52F22FD0E4BF.title: "The Infusion Crystal"
	quest.67BC52F22FD0E4BF.quest_subtitle: "The gardener-alchemist's tool"
	quest.67BC52F22FD0E4BF.quest_desc: [
		"The crystal goes into every seed recipe. It isn't consumed — it just wears down."
		"Find &lprosperity&r — the pale ore deep underground — the crystal needs it."
	]
	quest.2F5070961E1FFE98.title: "An Iron Field"
	quest.2F5070961E1FFE98.quest_subtitle: "Iron without a mine"
	quest.2F5070961E1FFE98.quest_desc: [
		"Plant iron seeds — in time you'll have essence; 8 essence makes ingots."
		"&lValued by:&r engineers. A whole field of iron is a gift nobody refuses."
	]
	quest.3BE440186F9F12A4.title: "Copper Sprouts"
	quest.3BE440186F9F12A4.quest_subtitle: "Create loves copper"
	quest.3BE440186F9F12A4.quest_desc: [
		"Create eats copper by the stack — pipes, tanks, gears. Gift the engineer your harvest."
	]
	quest.52922CDBEA05738F.title: "Steps of Mastery"
	quest.52922CDBEA05738F.quest_subtitle: "Prudentium, tertium, imperium…"
	quest.52922CDBEA05738F.quest_desc: [
		"Inferium essence can be upgraded to prudentium and beyond. Each tier unlocks new seeds."
		"The most valuable (diamonds, netherite) need tiers 4–5 — a long-term gardener goal."
	]
	quest.78E30C72A34F8162.title: "The Watering Can"
	quest.78E30C72A34F8162.quest_subtitle: "Speeds up growth"
	quest.78E30C72A34F8162.quest_desc: [
		"Water a field and plants grow noticeably faster. Better cans cover a bigger area."
	]
	quest.4D95235DFCDB4BB6.title: "Automatic Watering"
	quest.4D95235DFCDB4BB6.quest_subtitle: "The Slice & Dice sprinkler"
	quest.4D95235DFCDB4BB6.quest_desc: [
		"A sprinkler on a Create pipe waters the field for you. Feed it water — or fertiliser for double speed."
		"&lWho helps:&r gardener + engineer = a farm that runs without you."
	]
	quest.642C7E8CAB83E54C.title: "A Tea Plantation"
	quest.642C7E8CAB83E54C.quest_subtitle: "Tea and coffee for the tavern"
	quest.642C7E8CAB83E54C.quest_desc: [
		"Wild coffee bushes grow near stone in hot biomes, tea bushes in forests. Pick them and plant them at home."
		"The cook turns the harvest into buff drinks."
	]
	quest.718C1E915828D752.title: "The Vine"
	quest.718C1E915828D752.quest_subtitle: "Grapes on trellises"
	quest.718C1E915828D752.quest_desc: [
		"Plant a vine by a trellis and in a couple of days it gives bunches. Different biomes grow different grapes."
	]
	quest.72B5ECDBCD5107D7.title: "Green Hands"
	quest.72B5ECDBCD5107D7.quest_subtitle: "You have a greenhouse, pots and resource fields"
	quest.72B5ECDBCD5107D7.quest_desc: [
		"You feed the group and supply its metal. Next up: bees (chapter \"Animals\") and"
		"the Terraformer in \"Great Works\": it changes the biome of whole districts."
	]
	quest.7CB48C4FD3A9F3DF.title: "The Season Sensor"
	quest.7CB48C4FD3A9F3DF.quest_desc: [
		"Gives a redstone signal depending on the season. Open the greenhouse in winter or start sprinklers in summer automatically."
	]
	quest.21945C96E7DA4646.title: "Country Crops"
	quest.21945C96E7DA4646.quest_desc: [
		"Corn, barley, oats, strawberries — Farm & Charm. Wild plants grow in meadows; harvest them for seeds."
		"Oats and barley also feed livestock."
	]
	quest.51F81B7358F45A59.title: "The Scarecrow"
	quest.51F81B7358F45A59.quest_desc: [
		"Keeps crows and rabbits away from your beds. And looks lovely in the middle of a field."
	]
	quest.0D9885D7100AC406.title: "The Plough"
	quest.0D9885D7100AC406.quest_desc: [
		"A horse-drawn plough tills a wide strip. The good old way to work a big field."
	]
	quest.159B0875B4B3DB6C.title: "Fertiliser"
	quest.159B0875B4B3DB6C.quest_desc: [
		"Fertiliser speeds growth more than bone meal and keeps soil fertile for a long time."
	]
	quest.5FC48417FEF5D55A.title: "Inferium Farmland"
	quest.5FC48417FEF5D55A.quest_desc: [
		"Special soil: Mystical Agriculture plants on it yield more essence. It upgrades along with the tiers."
	]
	quest.1B78140E6F7A62BD.title: "Tertium"
	quest.1B78140E6F7A62BD.quest_desc: [
		"The third tier. Unlocks gold, redstone, lapis, quartz and much more."
	]
	quest.315AD198F9D70C16.title: "A Golden Field"
	quest.315AD198F9D70C16.quest_desc: [
		"Gold grows in a bed. Valued by: engineers (electronics) and mages (rituals)."
	]
	quest.4A2580C75ABA966B.title: "Imperium"
	quest.4A2580C75ABA966B.quest_desc: [
		"The fourth tier: diamonds, emeralds, rare modded metals. Needs the &linfusion altar&r with pedestals."
	]
	quest.5D15BA5A782800D0.title: "The Infusion Altar"
	quest.5D15BA5A782800D0.quest_desc: [
		"An altar and eight pedestals — ritual crafting of the strongest seeds. The gardener becomes a bit of a mage."
	]
	quest.243227B8EF08F684.title: "The Diamond Garden"
	quest.243227B8EF08F684.quest_desc: [
		"Diamonds grow. Miners weep, the gardener smiles."
	]
	quest.627590F45B4E0068.title: "The Growth Accelerator"
	quest.627590F45B4E0068.quest_desc: [
		"Placed under a bed, it speeds up the plants above. Higher tiers are faster."
	]
	quest.33A17CFAEB1BE951.title: "The Harvester"
	quest.33A17CFAEB1BE951.quest_desc: [
		"Collects crops around itself into a chest. A hands-free essence farm."
	]
	quest.1DD56AA69632697C.title: "Mob Souls"
	quest.1DD56AA69632697C.quest_desc: [
		"Soul jars collect mob souls with a special dagger. They grow mob seeds: leather, feathers, string — no hunting."
		"You'll need a warrior's help."
	]
	quest.6C8A77DB5B4722EE.title: "Bio-Fuel"
	quest.6C8A77DB5B4722EE.quest_desc: [
		"Crops in a Mekanism crusher become bio-fuel for the bio-generator. The gardener feeds the power plant."
	]
	chapter.2C295B34DEBBAD70.title: "Animals, Bees, Dragons"
	chapter.2C295B34DEBBAD70.chapter_subtitle: [
		"Breed, tame, discover"
	]
	quest.58A5F95E7247AE74.title: "On a Lead"
	quest.58A5F95E7247AE74.quest_subtitle: "The start of a farm"
	quest.58A5F95E7247AE74.quest_desc: [
		"&lWhy:&r animals give milk, wool, eggs, meat — and rare materials for potions and armour."
		"Bring a pair of cows or sheep home on a lead and feed them — they'll have young."
		"&lValued by:&r the cook (milk → cheese), the alchemist (rare drops), colonists (food)."
	]
	quest.4990A38E7AFA20D8.title: "A Feeding Trough"
	quest.4990A38E7AFA20D8.quest_subtitle: "Farm & Charm"
	quest.4990A38E7AFA20D8.quest_desc: [
		"A trough feeds animals by itself — they stay fed and fertile while you're busy."
		"Fill it with fodder: hay, oats, barley. A chicken coop and a nest give eggs without the chase."
	]
	quest.2AADB93EE520A6DB.title: "Alpine Livestock"
	quest.2AADB93EE520A6DB.quest_subtitle: "Let's Do Meadow"
	quest.2AADB93EE520A6DB.quest_desc: [
		"Mountains are home to alpine cows, goats, sheep and buffalo. Their milk makes different cheeses."
		"A milk can is the best gift for a Meadow cook."
	]
	quest.398471DFFDDBAAF0.title: "Bee Genetics"
	quest.398471DFFDDBAAF0.quest_subtitle: "Productive Bees"
	quest.398471DFFDDBAAF0.quest_desc: [
		"&lWhat:&r dozens of bee species, each makes its own combs: iron, copper, redstone, even diamond."
		"&lHow to start:&r catch a bee in a cage from a nest in the world (nests appear in stone, sand, snow, wood)."
		"The bee guide is in EMI: search \"bee\" and check the mutations (&lR&r)."
	]
	quest.1473A8EBD1BA9240.title: "A Serious Hive"
	quest.1473A8EBD1BA9240.quest_subtitle: "The advanced beehive"
	quest.1473A8EBD1BA9240.quest_desc: [
		"An advanced hive holds more bees, and their combs can be pulled out with a hopper."
		"Put an &lexpansion box&r on top for even more room."
	]
	quest.1171779A20E89BC0.title: "The Centrifuge"
	quest.1171779A20E89BC0.quest_subtitle: "Combs → honey, wax and resources"
	quest.1171779A20E89BC0.quest_desc: [
		"The centrifuge spins combs into honey, wax and useful dusts or ingots."
		"&lTip:&r the mechanical one runs on Create rotation, the powered one on energy."
	]
	quest.0367AB6113664DF8.title: "Crossbreeding"
	quest.0367AB6113664DF8.quest_subtitle: "New bee species"
	quest.0367AB6113664DF8.quest_desc: [
		"Two bees of different species + a &lhoney treat&r = a chance at a new bee."
		"Mutations are listed in EMI. The goal: a bee for the resource you need — iron, copper, gold…"
		"&lValued by:&r engineers and mages — a bee gives a resource forever."
	]
	quest.74361E94132C2418.title: "Genes"
	quest.74361E94132C2418.quest_subtitle: "Productivity, endurance, temper"
	quest.74361E94132C2418.quest_desc: [
		"Bees have genes: productivity, endurance, behaviour. Extract them into bottles and splice them into your best bee."
		"A few generations later your bees work twice as well — even in rain and at night."
	]
	quest.0E9DB92921EFC049.title: "The Zoologist"
	quest.0E9DB92921EFC049.quest_subtitle: "The Alex's Mobs encyclopedia"
	quest.0E9DB92921EFC049.quest_desc: [
		"&lWhat:&r the world holds over a hundred new animals, from hummingbirds to elephants. Many give unique materials."
		"The encyclopedia covers each one: habitat, food, drops."
		"The &lcapture net&r (reward) catches butterflies and small critters — release them in your garden."
	]
	quest.0064456F4405DB56.title: "A Friend on Your Shoulder"
	quest.0064456F4405DB56.quest_subtitle: "Pets"
	quest.0064456F4405DB56.quest_desc: [
		"Otters, ferrets, dragonflies, red pandas — they can be tamed. Pets ride on your shoulder, help in fights or just make you smile."
		"&lTip:&r tamed pets don't attack friends and aren't hurt by stray hits from your team."
	]
	quest.6ACD4387091E4FF3.title: "A Dragon Egg"
	quest.6ACD4387091E4FF3.quest_subtitle: "Dragon Mounts: Remastered"
	quest.6ACD4387091E4FF3.quest_desc: [
		"&lWhat:&r dragon eggs are found in dungeons and dangerous lands. The &lbreed&r depends on where it hatches."
		"Fire near lava, water in the ocean, forest in forests, ice in the snow…"
		"Raise the dragon and you can ride it through the sky."
	]
	quest.57ADB4BD729FE83D.title: "The Whistle"
	quest.57ADB4BD729FE83D.quest_subtitle: "Call your dragon"
	quest.57ADB4BD729FE83D.quest_desc: [
		"A whistle binds to your dragon and calls it from afar. The colour is just for style."
	]
	quest.37E6738A6C282F33.title: "Dragon Armour"
	quest.37E6738A6C282F33.quest_subtitle: "A winged tank"
	quest.37E6738A6C282F33.quest_desc: [
		"Dragon armour protects your pet in battle. It takes a lot of metal — ask the &lengineer&r or a &lgardener&r with resource fields."
	]
	quest.08258F26A6CD43D5.title: "Lord of Beasts"
	quest.08258F26A6CD43D5.quest_subtitle: "Bees, beasts and a dragon"
	quest.08258F26A6CD43D5.quest_desc: [
		"You've got bees, the encyclopedia and a dragon egg. Next: the \"Collections\" chapter —"
		"every bee species, every dragon breed and rare beasts."
	]
	quest.01F1978AF428CF7A.title: "A Herd of Your Own"
	quest.01F1978AF428CF7A.quest_desc: [
		"Breed cows, sheep, pigs and chickens — at least a pair each. Fence them in so no one wanders off."
		"Tick once you have all four."
	]
	quest.64D3410CC19B67C9.title: "The Chicken Coop"
	quest.64D3410CC19B67C9.quest_desc: [
		"A coop collects eggs by itself — no more hunting for them around the yard."
	]
	quest.476E92FC8FA01BD2.title: "Wool for Everyone"
	quest.476E92FC8FA01BD2.quest_desc: [
		"Wool goes to builders (decor), engineers (airship envelopes) and into waxed canvas. Dye sheep for coloured wool straight away."
	]
	quest.62A1724CA0AF2D93.title: "Honey"
	quest.62A1724CA0AF2D93.quest_desc: [
		"Honey goes to the cook (baking, mead) and the alchemist (Fertility potion). Collect it from a hive with bottles."
	]
	quest.2EB248A3855853E5.title: "Beeswax"
	quest.2EB248A3855853E5.quest_desc: [
		"Wax is the key ingredient of &lwaxed canvas&r for airships. Valued by: engineers."
		"This is where the breeder becomes essential to the sky."
	]
	quest.5B230BCEB3D60F81.title: "Finding Nests"
	quest.5B230BCEB3D60F81.quest_desc: [
		"The locator points to the nearest nest of the chosen type. Stone, sand, snow, nether — each has its own bees."
	]
	quest.5D23827FB88F8BB2.title: "The Bee Catcher"
	quest.5D23827FB88F8BB2.quest_desc: [
		"The catcher traps passing bees in cages by itself. Handy for collecting new species."
	]
	quest.7AEC96EC3DFA61E1.title: "The Honey Generator"
	quest.7AEC96EC3DFA61E1.quest_desc: [
		"Honey becomes electricity. The apiary powers machines — another handshake with the engineer."
	]
	quest.260142089968250C.title: "The Incubator"
	quest.260142089968250C.quest_desc: [
		"Larvae in the incubator hatch into new bees of the chosen species."
	]
	quest.31A649466EC5B0A1.title: "Crocodile Scutes"
	quest.31A649466EC5B0A1.quest_desc: [
		"Crocodiles live in swamps and mangroves. Their scutes are the base of &ldragon plating&r for warships."
		"Valued by: warriors and engineers. Careful — they bite."
	]
	quest.1F6B650E813930CE.title: "Bear Fur"
	quest.1F6B650E813930CE.quest_desc: [
		"Grizzlies roam the forests. Their fur makes warm clothing and decor."
	]
	quest.660352F7C57C7229.title: "Fish Oil"
	quest.660352F7C57C7229.quest_desc: [
		"Fish oil is raw material for Aeronautics &laero lubricant&r. The angler and breeder supply the sky."
	]
	quest.2CB166812FBDDB4A.title: "Deer Antlers"
	quest.2CB166812FBDDB4A.quest_desc: [
		"Naturalist deer shed antlers in spring — nobody gets hurt. Antlers go into decor and tools."
	]
	quest.7B663457FD4E47AC.title: "Butterflies in the Garden"
	quest.7B663457FD4E47AC.quest_desc: [
		"Catch a butterfly with a net and release it by your beds — butterflies pollinate plants and crops grow faster."
	]
	quest.1958E45AF97140BD.title: "A Dragonfly Pet"
	quest.1958E45AF97140BD.quest_desc: [
		"A dragonfly can be tamed and even armoured. It looks beautiful flying over a pond."
	]
	quest.035FE318376C81BB.title: "The Copper Golem"
	quest.035FE318376C81BB.quest_desc: [
		"Friends & Foes: the copper golem presses copper buttons — a little helper for contraptions. Build it from a copper block and a pumpkin."
	]
	chapter.0BD79D79E7D32154.title: "Bestiary and Companions"
	chapter.0BD79D79E7D32154.chapter_subtitle: [
		"Beasts, pets and villagers: whom to tame, whom to study"
	]
	quest.13CF20102D7B78A9.title: "The Naturalist's Net"
	quest.13CF20102D7B78A9.quest_subtitle: "Naturalist"
	quest.13CF20102D7B78A9.quest_desc: [
		"&lWhat:&r hundreds of new creatures live in the world (Naturalist, Alex's Mobs, Friends & Foes, Critters & Companions). Most are peaceful."
		"&lWhy:&r each is useful: materials, help, a pet. This chapter covers the most useful ones."
		"&lThe net&r catches butterflies, fireflies and other small things: release them near home."
	]
	quest.1C77C072846E22DB.title: "Firefly"
	quest.1C77C072846E22DB.quest_subtitle: "A living lantern"
	quest.1C77C072846E22DB.quest_desc: [
		"Fireflies glow in swamps at night. Catch some and release them in your garden: pretty, and you can see the way home."
	]
	quest.55964F7444DDA930.title: "Snail Shell"
	quest.55964F7444DDA930.quest_subtitle: "A natural material"
	quest.55964F7444DDA930.quest_desc: [
		"Snails leave shells: a crafting material (see EMI for what they make)."
	]
	quest.3EDAFB99296BD41D.title: "Penguin Feather"
	quest.3EDAFB99296BD41D.quest_subtitle: "Friends & Foes"
	quest.3EDAFB99296BD41D.quest_desc: [
		"Penguins live on icy shores. Their feathers go into arrows and clothing."
	]
	quest.5866BB61BDFE6005.title: "Crab Claw"
	quest.5866BB61BDFE6005.quest_subtitle: "Long arms"
	quest.5866BB61BDFE6005.quest_desc: [
		"A potion from a crab claw extends your reach: builders can touch distant blocks."
	]
	quest.4F8BAF5FD1792F61.title: "A Copper Friend"
	quest.4F8BAF5FD1792F61.quest_subtitle: "Friends & Foes"
	quest.4F8BAF5FD1792F61.quest_desc: [
		"The copper golem is built from a copper block and a lightning rod. It presses copper buttons and oxidises over time: a waxed lightning rod suits its little house."
	]
	quest.033B1D9A70472766.title: "Totem of Illusion"
	quest.033B1D9A70472766.quest_subtitle: "From the illusioner"
	quest.033B1D9A70472766.quest_desc: [
		"The illusioner drops a totem that spawns copies of you when hit: enemies get confused. Good against illager gunners."
	]
	quest.2402F75EF7C35548.title: "Wildfire Crown"
	quest.2402F75EF7C35548.quest_subtitle: "A Nether mini-boss"
	quest.2402F75EF7C35548.quest_desc: [
		"The Wildfire is the blaze queen of bastions. Her crown protects against fire: useful in the Foundry and against Ignis."
	]
	quest.329BCF45C9315052.title: "Koi"
	quest.329BCF45C9315052.quest_subtitle: "Critters & Companions"
	quest.329BCF45C9315052.quest_desc: [
		"A decorative fish for a garden pond. Koi near your bed bring luck, they say (and nice screenshots)."
	]
	quest.32002160EE532F37.title: "Dragonfly Wing"
	quest.32002160EE532F37.quest_subtitle: "An ingredient"
	quest.32002160EE532F37.quest_desc: [
		"Dragonflies live near water. Their wings go into tonics and armour for pet dragonflies."
	]
	quest.3B2210219FF0E30D.title: "Silk"
	quest.3B2210219FF0E30D.quest_subtitle: "From cocoons"
	quest.3B2210219FF0E30D.quest_desc: [
		"Silkworms spin cocoons; they become silk for a silk lead (it doesn't snap) and fabrics."
	]
	quest.339ADBA3BE321FC3.title: "Family Tree"
	quest.339ADBA3BE321FC3.quest_subtitle: "Minecraft Comes Alive"
	quest.339ADBA3BE321FC3.quest_desc: [
		"MCA villagers are alive: names, personalities, families. The tree shows who's related, including your own children if you married in the village."
	]
	quest.54CA79F1B0C4FC67.title: "Engagement"
	quest.54CA79F1B0C4FC67.quest_subtitle: "Not just for villagers"
	quest.54CA79F1B0C4FC67.quest_desc: [
		"Give a ring to a villager who likes you, or to another player. A wedding in the tavern is a reason to gather the server."
	]
	quest.6AC6020BC3187145.title: "Naturalist"
	quest.6AC6020BC3187145.quest_subtitle: "A living world"
	quest.6AC6020BC3187145.quest_desc: [
		"You know who lives around you and what they're good for. Suggest a nature reserve: it's one of the Great Works."
	]
	chapter.57DD3485DB076FB1.title: "Fishing"
	chapter.57DD3485DB076FB1.chapter_subtitle: [
		"A hundred fish, quiet water and the star carp"
	]
	quest.3A9539897B1176C1.title: "Your First Rod"
	quest.3A9539897B1176C1.quest_subtitle: "Tide: fishing with a mini-game"
	quest.3A9539897B1176C1.quest_desc: [
		"&lWhat:&r fishing here is a little game. When it bites, keep the fish in the green zone until the bar fills."
		"&lWhy:&r over a hundred fish — for food, potions, rituals and your collection. The cosiest pastime in the pack."
		"Different fish live in different biomes, depths, times of day and weather."
	]
	quest.21F0682242876677.title: "The Angler's Journal"
	quest.21F0682242876677.quest_subtitle: "Who bites where"
	quest.21F0682242876677.quest_desc: [
		"The journal records every fish you catch and hints where to find the rest."
		"&lTip:&r night fishing in the rain is the best time for rare species."
	]
	quest.1D087548C817D51D.title: "First Catch"
	quest.1D087548C817D51D.quest_subtitle: "Eight cod"
	quest.1D087548C817D51D.quest_desc: [
		"Just fish from the shore. Fresh cod goes to the cook for soup and rolls."
	]
	quest.27EA82321637535F.title: "Bait"
	quest.27EA82321637535F.quest_subtitle: "Luck and faster bites"
	quest.27EA82321637535F.quest_desc: [
		"Bait speeds up bites and raises the odds of rare fish. Craft it from worms, berries, glow berries."
		"Put it in the rod through its window (right-click the rod in your inventory)."
	]
	quest.78B9356D937BFE4F.title: "A Sturdier Rod"
	quest.78B9356D937BFE4F.quest_subtitle: "Line, hook, bobber"
	quest.78B9356D937BFE4F.quest_desc: [
		"An iron rod holds fish better. Swappable &lhooks&r open special waters:"
		"the fiery hook for lava, the permafrost hook under ice, the void hook in the End."
	]
	quest.4E0C0B6EE4FBB412.title: "Lava Fishing"
	quest.4E0C0B6EE4FBB412.quest_subtitle: "The lavaproof hook"
	quest.4E0C0B6EE4FBB412.quest_desc: [
		"Nether lava holds fire fish — needed for alchemy and fire-resistant dishes."
		"Remember: the Nether is &lzone 3&r. Bring a warrior friend."
	]
	quest.7852E1FD4535E319.title: "A Crate from the Deep"
	quest.7852E1FD4535E319.quest_subtitle: "Treasure on the hook"
	quest.7852E1FD4535E319.quest_desc: [
		"Sometimes you hook a crate of loot: books, coins, rare items. Better rods mean richer crates."
	]
	quest.36CEBA9F196FF2E6.title: "Fillets"
	quest.36CEBA9F196FF2E6.quest_subtitle: "Aquaculture"
	quest.36CEBA9F196FF2E6.quest_desc: [
		"A fillet knife turns fish into fillets — easier for the cook, and big fish give many servings."
		"A tackle box keeps hooks and bait together."
	]
	quest.2C267C60B4B16E10.title: "The Old Angler"
	quest.2C267C60B4B16E10.quest_subtitle: "Fill a third of the journal"
	quest.2C267C60B4B16E10.quest_desc: [
		"Tick the quest once a third of the species are in the journal. Legendary fish wait in \"Collections\"."
		"&lValued by:&r alchemists and mages — rare fish go into their recipes."
	]
	quest.5F473F9F3E8F5EF4.title: "The Angling Table"
	quest.5F473F9F3E8F5EF4.quest_desc: [
		"Here you build a rod: pole, line, hook and bobber. Each part changes how the tackle behaves."
	]
	quest.45CF406C62919035.title: "The Golden Rod"
	quest.45CF406C62919035.quest_desc: [
		"Raises the chance of rare fish and treasure."
	]
	quest.47531F258913D839.title: "The Diamond Rod"
	quest.47531F258913D839.quest_desc: [
		"Fish slip off less often, legendary species bite more."
	]
	quest.2CAAF7B984EE8DCE.title: "Ice Fishing"
	quest.2CAAF7B984EE8DCE.quest_desc: [
		"The permafrost hook fishes under ice. Cold waters hold their own special fish."
	]
	quest.1A48F0C1E0815E52.title: "Void Fishing"
	quest.1A48F0C1E0815E52.quest_desc: [
		"The void hook fishes the End's abyss. The strangest fish in the world."
	]
	quest.1FB9BA2B85926335.title: "Neptunium"
	quest.1FB9BA2B85926335.quest_desc: [
		"From Neptune's Bounty chests comes neptunium. Underwater armour and weapons."
	]
	quest.18B2199085A4FF74.title: "The Tackle Box"
	quest.18B2199085A4FF74.quest_desc: [
		"Holds hooks, bait and line. An angler's order."
	]
	chapter.42BEE9E4256E795A.title: "Create: Mechanics"
	chapter.42BEE9E4256E795A.chapter_subtitle: [
		"Rotation that does everything"
	]
	quest.3AD12F9A22C2B78E.title: "Andesite Alloy"
	quest.3AD12F9A22C2B78E.quest_subtitle: "The core material of early mechanics"
	quest.3AD12F9A22C2B78E.quest_desc: [
		"&lWhat:&r Create is all about rotation. Shafts, gears and machines turning each other."
		"&lWhy:&r automate everything: ore crushing, farms, kitchens, lifts, trains, ships."
		"&lHow to start:&r andesite + iron nuggets (or zinc) = andesite alloy. Almost every early part uses it."
	]
	quest.7600D492D41F2A33.title: "Engineer's Goggles"
	quest.7600D492D41F2A33.quest_subtitle: "See the invisible"
	quest.7600D492D41F2A33.quest_desc: [
		"Goggles show rotation speed and network &lstress&r when you look at a machine."
		"Overload the network and everything stops. Goggles show where you lack power."
		"&lReminder:&r hold &lW&r on any Create block — Ponder shows how it works."
	]
	quest.296FB32E35848D1D.title: "The Wheel That Turns Everything"
	quest.296FB32E35848D1D.quest_subtitle: "Your first rotational power"
	quest.296FB32E35848D1D.quest_desc: [
		"&lHow:&r place a water wheel in flowing water and connect a shaft. Each wheel gives a little power — line several up."
		"&lTip:&r a windmill made of sails gives more, a steam engine even more."
	]
	quest.20FAD4E8DA79E2D4.title: "The Mechanical Press"
	quest.20FAD4E8DA79E2D4.quest_subtitle: "Ingots → sheets"
	quest.20FAD4E8DA79E2D4.quest_desc: [
		"The press flattens ingots into sheets and, with a basin, compacts ingredients."
		"Put an item on a &ldepot&r under it or run a &lbelt&r beneath — the press works by itself."
	]
	quest.34E945325D85CA7B.title: "The Conveyor"
	quest.34E945325D85CA7B.quest_subtitle: "Items move by themselves"
	quest.34E945325D85CA7B.quest_desc: [
		"A belt connects two shafts and carries items. Presses, fans, saws and depots all work on belts."
		"&lTip:&r funnels at the ends pull from and push into chests."
	]
	quest.55D84A0552C38733.title: "Crushing Wheels"
	quest.55D84A0552C38733.quest_subtitle: "Ore doubling"
	quest.55D84A0552C38733.quest_desc: [
		"Two wheels spinning toward each other crush ore into &lcrushed ore&r, which smelts into more ingots."
		"Wash it with a fan through water and you get nuggets on top."
		"&lValued by:&r anyone who needs metal. Which is everyone."
	]
	quest.2447D5B34A8A9577.title: "The Fan"
	quest.2447D5B34A8A9577.quest_subtitle: "Wash, smelt, smoke"
	quest.2447D5B34A8A9577.quest_desc: [
		"A fan blows through whatever is in front of it: through water it &lwashes&r, through lava it &lsmelts&r, through fire it &lsmokes&r food."
		"Run a belt through the stream and you won't need a furnace."
	]
	quest.3F74EE2573975D1F.title: "Mixer and Basin"
	quest.3F74EE2573975D1F.quest_subtitle: "Alloys, dough, dyes"
	quest.3F74EE2573975D1F.quest_desc: [
		"A mixer above a basin combines ingredients. That's how you make &lbrass&r (copper + zinc), dough, concrete."
		"With a &lblaze burner&r under the basin you can do heated mixes."
	]
	quest.157A9338DC294AEA.title: "The Brass Age"
	quest.157A9338DC294AEA.quest_subtitle: "Copper + zinc + heat"
	quest.157A9338DC294AEA.quest_desc: [
		"Brass unlocks smart logistics: brass funnels with filters, smart chutes, precision mechanisms."
		"You need a &lblaze burner&r — catch a blaze in the Nether with an empty burner (or ask a warrior)."
	]
	quest.51A00B20682F60A0.title: "The Precision Mechanism"
	quest.51A00B20682F60A0.quest_subtitle: "Step-by-step assembly"
	quest.51A00B20682F60A0.quest_desc: [
		"A precision mechanism is assembled on a belt in several steps: press, deployers, repeat."
		"It's your first \"assembly line\" — EMI shows the recipe step by step."
	]
	quest.40070ED0DEB601C3.title: "A Mechanical Hand"
	quest.40070ED0DEB601C3.quest_subtitle: "The deployer does what you would"
	quest.40070ED0DEB601C3.quest_desc: [
		"A deployer clicks with whatever it holds: plants, hits, uses, assembles parts. These are your factory's hands."
	]
	quest.16E227013AEA622A.title: "Steam!"
	quest.16E227013AEA622A.quest_subtitle: "Boiler and steam engine"
	quest.16E227013AEA622A.quest_desc: [
		"A tank boiler + burners + water = steam. Steam engines on the tank give &lhuge&r rotational power."
		"Check Ponder — tank size and burner count set the boiler level."
	]
	quest.5F0E571DB9523C4F.title: "Moving Builds"
	quest.5F0E571DB9523C4F.quest_subtitle: "Bearings, pistons, glue"
	quest.5F0E571DB9523C4F.quest_desc: [
		"Glue blocks together, mount them on a bearing or piston — and they'll move or spin."
		"That's how you make windmills, gates, lifts, bridges — and later, flying ships."
	]
	quest.6BFCC5C406BD8E53.title: "The Drill"
	quest.6BFCC5C406BD8E53.quest_subtitle: "It digs by itself"
	quest.6BFCC5C406BD8E53.quest_desc: [
		"A drill on a piston or a moving frame digs tunnels and quarries stone on its own."
		"Later it becomes part of a tunnel-boring machine on Aeronautics tracks."
	]
	quest.337822115DCCE924.title: "The Harvester"
	quest.337822115DCCE924.quest_subtitle: "A farm that harvests itself"
	quest.337822115DCCE924.quest_desc: [
		"A harvester on a moving frame passes over a field and collects crops, leaving the plants."
		"&lWho helps:&r the gardener. It's a joint project — build the farm together."
	]
	quest.189B47E1DFEF15C5.title: "Pipes and Tanks"
	quest.189B47E1DFEF15C5.quest_subtitle: "Fluids move too"
	quest.189B47E1DFEF15C5.quest_desc: [
		"A pump pushes fluid through pipes: water, lava, honey, chocolate, oil. A &lspout&r fills bottles and buckets."
	]
	quest.3BE63B3331C9B9B8.title: "Tracks and a Station"
	quest.3BE63B3331C9B9B8.quest_subtitle: "Create trains"
	quest.3BE63B3331C9B9B8.quest_desc: [
		"Create trains run on tracks of any shape, on schedules, between stations."
		"Assemble a carriage at a station, add train controls — and the train is yours."
		"&lTip:&r Steam 'n' Rails adds narrow and wide gauge, couplers and nicer carriages."
	]
	quest.5A15E86CEF89EA05.title: "All Aboard!"
	quest.5A15E86CEF89EA05.quest_subtitle: "A train on a schedule"
	quest.5A15E86CEF89EA05.quest_desc: [
		"A schedule tells the train where to go and how long to wait. A train between friends' bases is the best gift."
	]
	quest.347C760F79CA6686.title: "A Warehouse in Parcels"
	quest.347C760F79CA6686.quest_subtitle: "Create 6 logistics"
	quest.347C760F79CA6686.quest_desc: [
		"Packagers wrap items into parcels, frogports carry them, and a &lstock ticker&r orders what you need from storage."
		"One-click ordering without a digital network."
	]
	quest.5856C39EACDC4542.title: "The Building Cannon"
	quest.5856C39EACDC4542.quest_subtitle: "Schematics"
	quest.5856C39EACDC4542.quest_desc: [
		"Save a build as a &lschematic&r and the &lschematicannon&r builds it again, block by block, from a chest of materials."
		"Share ready-made buildings with friends and build them anywhere."
	]
	quest.5975871C2753E3AA.title: "A Bridge to Electricity"
	quest.5975871C2753E3AA.quest_subtitle: "Create Crafts & Additions"
	quest.5975871C2753E3AA.quest_desc: [
		"An alternator turns rotation into FE energy — the same power Mekanism, AE2 and IE use."
		"An &lelectric motor&r does the reverse. Mechanics and electrics become one system."
	]
	quest.5FBE8D5CCCE83C71.title: "Chief Mechanic"
	quest.5FBE8D5CCCE83C71.quest_subtitle: "Steam, trains and farms"
	quest.5FBE8D5CCCE83C71.quest_desc: [
		"You have steam, a train and an automated farm. Next step: &lthe sky&r — chapter \"Sky & Roads\" for planes and airships."
	]
	quest.7861F972337E213A.title: "The Millstone"
	quest.7861F972337E213A.quest_desc: [
		"A millstone grinds wheat into flour, bones into bone meal, gravel into flint. A simple first machine."
	]
	quest.45E52B7675E48E3D.title: "The Depot"
	quest.45E52B7675E48E3D.quest_desc: [
		"A stand under a press or deployer. Drop an ingot in, take a sheet out. The base of manual lines."
	]
	quest.087DF855D6631721.title: "Funnels and Chutes"
	quest.087DF855D6631721.quest_desc: [
		"A funnel moves items between a belt and a chest, a chute drops items downward. With them the line runs hands-free."
	]
	quest.50FDEED93633617E.title: "Ore Washing"
	quest.50FDEED93633617E.quest_desc: [
		"Crushed ore washed by a fan through water yields bonus nuggets. Together with crushing — nearly triple the output."
	]
	quest.6EFA612B7E06CDA1.title: "The Mechanical Saw"
	quest.6EFA612B7E06CDA1.quest_desc: [
		"On a belt a saw cuts logs into planks; on a moving frame it fells trees. An automatic lumber mill in half an hour."
	]
	quest.4842E7CF7AF8A692.title: "Clutch and Gearshift"
	quest.4842E7CF7AF8A692.quest_desc: [
		"A clutch disconnects a shaft on a redstone signal, a gearshift reverses it. That's how lifts and gates are controlled."
	]
	quest.492AF3B3494FC98F.title: "The Elevator"
	quest.492AF3B3494FC98F.quest_desc: [
		"An elevator pulley + floor contacts = a real lift with buttons. Perfect for a mage's tower or a mine shaft."
	]
	quest.0918D6D0D5C847D6.title: "The Item Vault"
	quest.0918D6D0D5C847D6.quest_desc: [
		"A vault grows by blocks: place a 2×2×4 and you have a huge chest for belts."
	]
	quest.4031E8667755DC63.title: "Spout and Drain"
	quest.4031E8667755DC63.quest_desc: [
		"The spout fills bottles and buckets on a belt, the drain empties them. Honey, milk, chocolate — all automatic."
	]
	quest.626D50B98EDCF165.title: "The Chocolate Factory"
	quest.626D50B98EDCF165.quest_desc: [
		"Cocoa, milk and sugar in the mixer — and a river of chocolate. Create Confectionery adds candy and gingerbread."
	]
	quest.77513643791B2DE5.title: "The Mechanical Crafter"
	quest.77513643791B2DE5.quest_desc: [
		"A grid of mechanical crafters builds big recipes by itself. Needed for cannons, rockets and large machines."
	]
	quest.4CF9CAB1D7B00C1A.title: "Diving Gear"
	quest.4CF9CAB1D7B00C1A.quest_desc: [
		"A copper backtank of compressed air and a helmet — breathe underwater for ages. The tank also powers Create tools."
	]
	quest.7D91FDAB52BA16A2.title: "The Extendo Grip"
	quest.7D91FDAB52BA16A2.quest_desc: [
		"The grip extends your reach — building at height becomes much easier."
	]
	quest.7FB122966F58C63E.title: "The Toolbox"
	quest.7FB122966F58C63E.quest_desc: [
		"A toolbox holds your tools and a hotkey pulls them from anywhere nearby. Order in the workshop."
	]
	quest.5375F9873F5AC43D.title: "The Display Board"
	quest.5375F9873F5AC43D.quest_desc: [
		"A display link shows storage contents, train schedules, machine speed. Build a station with an arrivals board!"
	]
	quest.5C4FE191A3A807BE.title: "Signals"
	quest.5C4FE191A3A807BE.quest_desc: [
		"Signals split tracks into blocks so trains don't collide. Needed as soon as there's more than one train."
	]
	quest.51969B0301BA1EDC.title: "Steam 'n' Rails"
	quest.51969B0301BA1EDC.quest_desc: [
		"Semaphores, the conductor's whistle, couplers and different gauges. Call a train to you with the whistle!"
	]
	quest.46F98B846DE095EC.title: "The Potato Cannon"
	quest.46F98B846DE095EC.quest_desc: [
		"It shoots food. The stranger the food, the stranger the effect. A joke that works."
	]
	quest.5B1D8C7DB03F8655.title: "Industrial Enchanting"
	quest.5B1D8C7DB03F8655.quest_desc: [
		"Create Enchantment Industry turns XP into a liquid and enchants items on a belt. No grinding at the enchanting table."
	]
	quest.2B6BA5EF7AFE7EFB.title: "The Chunk Loader"
	quest.2B6BA5EF7AFE7EFB.quest_desc: [
		"Create: Power Loader keeps a chunk loaded while its loader gets rotation — the factory runs when you're away."
	]
	chapter.771C1FF49C38AFE7.title: "Create: Add-ons"
	chapter.771C1FF49C38AFE7.chapter_subtitle: [
		"Batteries, power, experience enchanting, smart gearing"
	]
	quest.7D38C871CC211EF9.title: "Create Is a Platform"
	quest.7D38C871CC211EF9.quest_subtitle: "Add-ons extend the base"
	quest.7D38C871CC211EF9.quest_desc: [
		"These mods add what Create lacks: &lstored rotation&r, &lelectricity&r, &lexperience as a fluid&r, handy gearing and disguise blocks."
		"Every quest here explains which problem a part solves."
	]
	quest.5F3C221590C6A560.title: "Smart Gearboxes"
	quest.5F3C221590C6A560.quest_subtitle: "Create Connected"
	quest.5F3C221590C6A560.quest_desc: [
		"The six-way and parallel gearboxes send rotation where a plain gearbox can't. Fewer shafts, tidier factory."
	]
	quest.30C19E71E43D8B9A.title: "Kinetic Battery"
	quest.30C19E71E43D8B9A.quest_subtitle: "Stored rotation"
	quest.30C19E71E43D8B9A.quest_desc: [
		"&lProblem:&r your wheel turns all night while windmills stall in calm weather. &lSolution:&r the battery stores rotation when there's plenty and gives it back when there's little."
	]
	quest.7DE779C4EADEE227.title: "Overload Protection"
	quest.7DE779C4EADEE227.quest_subtitle: "Shear pin and clutch"
	quest.7DE779C4EADEE227.quest_desc: [
		"When the network is overstressed, the shear pin breaks and keeps the other machines running. The overstress clutch disconnects a branch and reconnects it on its own."
	]
	quest.5B9945A1D0B3302F.title: "Item Silo"
	quest.5B9945A1D0B3302F.quest_subtitle: "Multiblock storage"
	quest.5B9945A1D0B3302F.quest_desc: [
		"Silo blocks merge into one big container, like a Create vault but for bulk crops and ore."
	]
	quest.389037C19D27671B.title: "Fan Catalysts"
	quest.389037C19D27671B.quest_subtitle: "New processing types"
	quest.389037C19D27671B.quest_desc: [
		"A plain fan washes, smelts and smokes. Catalysts add sanding, freezing, withering and more: less manual work."
	]
	quest.3B2387F2822A0C64.title: "Alternator"
	quest.3B2387F2822A0C64.quest_subtitle: "Create Addition"
	quest.3B2387F2822A0C64.quest_desc: [
		"&lThe bridge between worlds:&r the alternator turns Create rotation into FE for Mekanism, AE2 and IE. The electric motor does the reverse."
		"Your water wheels now power Mekanism machines too."
	]
	quest.2B5EED31BF242AD9.title: "Overhead Wires"
	quest.2B5EED31BF242AD9.quest_subtitle: "Power over distance"
	quest.2B5EED31BF242AD9.quest_desc: [
		"A copper wire spool and connectors: a power line from your plant to a neighbour. Pretty and cheap."
	]
	quest.350DF99E7C5AC08F.title: "Modular Accumulator"
	quest.350DF99E7C5AC08F.quest_subtitle: "An energy store"
	quest.350DF99E7C5AC08F.quest_desc: [
		"Place blocks side by side and the capacity grows. Stores power overnight for solar panels."
	]
	quest.370722D32BE17EBE.title: "Tesla Coil"
	quest.370722D32BE17EBE.quest_subtitle: "Item charging"
	quest.370722D32BE17EBE.quest_desc: [
		"Charges energy items on a belt, and zaps mobs if you put it in their path."
	]
	quest.3A0D66D736400BB4.title: "Experience in Buckets"
	quest.3A0D66D736400BB4.quest_subtitle: "Create Enchantment Industry"
	quest.3A0D66D736400BB4.quest_desc: [
		"&lWhat:&r experience becomes a fluid you pump through pipes and store in tanks."
		"&lWhy:&r send experience from a mob farm straight into the enchanter, no standing at the spawner."
	]
	quest.7371DE8B2A53A740.title: "Blaze Enchanter"
	quest.7371DE8B2A53A740.quest_subtitle: "Enchanting on a belt"
	quest.7371DE8B2A53A740.quest_desc: [
		"A blaze with an enchanting template applies the chosen enchantment to everything on the belt. No more enchanting-table lottery."
	]
	quest.2F54F645102E13EE.title: "Printer"
	quest.2F54F645102E13EE.quest_subtitle: "Book copies"
	quest.2F54F645102E13EE.quest_desc: [
		"Prints copies of books: enchanted, written, even guides. Handy for the colony library."
	]
	quest.2C8B1662D32860D4.title: "Dragon's Breath"
	quest.2C8B1662D32860D4.quest_subtitle: "Create: Dragons Plus"
	quest.2C8B1662D32860D4.quest_desc: [
		"Dragon's breath in a bucket: a fluid for fans, whose «ending» process turns items into their End variants."
	]
	quest.7AF22375ED6E4E3A.title: "Disguise"
	quest.7AF22375ED6E4E3A.quest_subtitle: "Copycats+"
	quest.7AF22375ED6E4E3A.quest_desc: [
		"Copycat blocks take the look of any block: slopes, steps, beams. Hide your factory behind a pretty facade."
	]
	quest.20B5B4A0BD67576A.title: "Jetpack"
	quest.20B5B4A0BD67576A.quest_subtitle: "Create Jetpack"
	quest.20B5B4A0BD67576A.quest_desc: [
		"The jetpack flies on compressed air from a Create backtank. Refill at a compressor at base. Indispensable on building sites."
	]
	quest.08B90679F2712DC1.title: "Master Mechanic"
	quest.08B90679F2712DC1.quest_subtitle: "Create to the full"
	quest.08B90679F2712DC1.quest_desc: [
		"Rotation is stored, turned into power, enchants books and hides behind pretty walls. Show the factory to your neighbours so they can learn."
	]
	chapter.75D3C2A26C328D05.title: "Sky & Roads"
	chapter.75D3C2A26C328D05.chapter_subtitle: [
		"Cars, planes, airships, citadels"
	]
	quest.4B1734BD66CA871A.title: "A Build That Lives"
	quest.4B1734BD66CA871A.quest_subtitle: "Create Aeronautics and Sable physics"
	quest.4B1734BD66CA871A.quest_desc: [
		"&lWhat:&r the physics assembler turns any build into a &lreal physical object&r: it falls, floats, drives, flies."
		"Heavy things sink, light things float, wheels grip the ground. Build as usual — then bring it to life."
		"More: Ponder (&lW&r) on the assembler."
	]
	quest.6B4F8E536E588C89.title: "Four Wheels"
	quest.6B4F8E536E588C89.quest_subtitle: "Your first car"
	quest.6B4F8E536E588C89.quest_desc: [
		"Wheel mounts + tyres + a motor (Create rotation) = a car. A &lsteering wheel&r turns the front wheels."
		"&lTip:&r start with a small cart, then build a truck for ore."
	]
	quest.7266207763E94952.title: "Behind the Wheel"
	quest.7266207763E94952.quest_subtitle: "Steering wheel and throttle"
	quest.7266207763E94952.quest_desc: [
		"Take the wheel — WASD drives. The throttle lever changes rotation speed."
		"Works? Drive to a friend and honk."
	]
	quest.0679B41EE5CEA5EE.title: "The Propeller"
	quest.0679B41EE5CEA5EE.quest_subtitle: "Thrust"
	quest.0679B41EE5CEA5EE.quest_desc: [
		"A propeller on its bearing pushes the build forward — or up. Faster rotation, more thrust."
		"Light materials (wood, wool) are your friends in the sky."
	]
	quest.7AF169EE9ACAE9A5.title: "The Sky Is Calling"
	quest.7AF169EE9ACAE9A5.quest_subtitle: "First flight"
	quest.7AF169EE9ACAE9A5.quest_desc: [
		"Build a light plane: propeller, wings (sails), controls — and take off. Tick the quest after landing."
		"&lTip:&r aviator's goggles show altitude and speed. Scared? Land near a Waystone."
	]
	quest.57F2358A447DEBD0.title: "The Floating Stone"
	quest.57F2358A447DEBD0.quest_subtitle: "Levitite"
	quest.57F2358A447DEBD0.quest_desc: [
		"&lLevitite&r is stone that pulls upward. Enough of it and a build hangs in the air without propellers."
		"&lValued by:&r mages — they make it easier to get. It's the first engineer-mage handshake."
	]
	quest.453103DB798973F2.title: "The Airship"
	quest.453103DB798973F2.quest_subtitle: "Burner and envelope"
	quest.453103DB798973F2.quest_desc: [
		"An adjustable burner heats the air in the envelope — the airship rises. Less heat, it sinks."
		"Build a gondola with a bed and chests — you have a &lmobile base&r. Tick the quest once you're airborne."
	]
	quest.69E9F652F112C896.title: "The Flying Citadel"
	quest.69E9F652F112C896.quest_subtitle: "A megaproject for the whole group"
	quest.69E9F652F112C896.quest_desc: [
		"A sky island with a garden, kitchen, workshop and mage tower. Built by everyone — each has something to bring."
		"More, with rewards, in the \"Great Works\" chapter."
	]
	quest.3BAC276E3AB02105.title: "A Biplane for the Impatient"
	quest.3BAC276E3AB02105.quest_subtitle: "Immersive Aircraft"
	quest.3BAC276E3AB02105.quest_desc: [
		"Don't feel like building a plane from blocks? Ready-made &lbiplanes, gyrodynes and airships&r from Immersive Aircraft are crafted at a table."
		"A great way to explore before you master Create."
	]
	quest.7D7D4CC48CC8985C.title: "The Jetpack"
	quest.7D7D4CC48CC8985C.quest_subtitle: "Create Jetpack"
	quest.7D7D4CC48CC8985C.quest_desc: [
		"A jetpack running on compressed air from a copper backtank. Recharge at a compressor — and up you go!"
	]
	quest.288B24A597910CC4.title: "Ropes and Winches"
	quest.288B24A597910CC4.quest_subtitle: "Towing, lifts, cable cars"
	quest.288B24A597910CC4.quest_desc: [
		"A winch with a rope pulls one build toward another: tows a car, lowers cargo from an airship, holds a bridge."
		"Boarding and cable-car quests are in the \"Weapons & Gear\" chapter."
	]
	quest.4B89702C281986E7.title: "Big Wheels"
	quest.4B89702C281986E7.quest_desc: [
		"Large tyres carry heavy vehicles off-road: a truck, an all-terrain rover, a mobile base."
	]
	quest.408A8ED8412F2D83.title: "The Tunnel Borer"
	quest.408A8ED8412F2D83.quest_desc: [
		"A borehead on a wheeled machine cuts through mountains. Dig a tunnel between bases — then run a train through it."
	]
	quest.0E9340588AEF41F4.title: "The Engine"
	quest.0E9340588AEF41F4.quest_desc: [
		"An engine assembly needs &laero lubricant&r: fish oil (angler) or TFMG/IE lubricant (engineer). No powerful planes without it."
	]
	quest.14BB3D3AFFEE65C9.title: "The Smart Propeller"
	quest.14BB3D3AFFEE65C9.quest_desc: [
		"A gyro-stabilised propeller keeps the build level. Without it a big ship sways and spins."
	]
	quest.410A0B4DB02A6E21.title: "Airship Envelope"
	quest.410A0B4DB02A6E21.quest_desc: [
		"Envelopes hold hot air. &lWaxed canvas&r (the breeder's beeswax) makes three times as many."
	]
	quest.6A34014B73F8BCC2.title: "The Altitude Sensor"
	quest.6A34014B73F8BCC2.quest_desc: [
		"Signals by altitude — an autopilot keeps the airship at the height you want."
	]
	quest.17ACF815BAF33888.title: "The Navigation Table"
	quest.17ACF815BAF33888.quest_desc: [
		"Plots a course to a point — the ship flies itself. Haul cargo between bases on a schedule."
	]
	quest.28AADDB1A7758B1D.title: "Docking"
	quest.28AADDB1A7758B1D.quest_desc: [
		"Docking connectors lock a ship to a dock or another ship. Build a port in the sky."
	]
	quest.04820B0D68A5E446.title: "The Gyrodyne"
	quest.04820B0D68A5E446.quest_desc: [
		"A pedal-powered flyer — it runs on your own effort. Funny and useful."
	]
	quest.17868DEAA2C48847.title: "A Ready-Made Airship"
	quest.17868DEAA2C48847.quest_desc: [
		"The Immersive Aircraft airship — slow but roomy and simple. Great for first expeditions."
	]
	quest.0AD4DFA0CA5501B3.title: "The Warship"
	quest.0AD4DFA0CA5501B3.quest_desc: [
		"Create Big Cannons on an airship, plated with dragon armour. Tick when the ship fires its first broadside."
	]
	chapter.250C907E46C379E8.title: "Transport"
	chapter.250C907E46C379E8.chapter_subtitle: [
		"Ships, trains, teleports: conquering distance"
	]
	quest.6984D699D2660B8F.title: "How to Travel"
	quest.6984D699D2660B8F.quest_subtitle: "Choose your way"
	quest.6984D699D2660B8F.quest_desc: [
		"&lSea&r: Small Ships ships carry cargo and fire cannons."
		"&lRails&r: Create trains + Steam 'n' Rails: automatic logistics between bases."
		"&lSky&r: planes and airships («Sky» chapter), FPV drones («Firearms and War» chapter)."
		"&lInstant&r: waystones and warp scrolls, but you must find and activate them first."
	]
	quest.4DC0F06F77F4E8D0.title: "Sails"
	quest.4DC0F06F77F4E8D0.quest_subtitle: "Small Ships"
	quest.4DC0F06F77F4E8D0.quest_desc: [
		"Every Small Ships ship needs sails (recipe in EMI): the bigger the ship, the more sails."
		"&lControls:&r W/S raise/lower the sails, A/D steer. The wind is real: sailing into it is slower."
	]
	quest.5088E3C71CA9EAB9.title: "The Cog"
	quest.5088E3C71CA9EAB9.quest_subtitle: "Your first ship"
	quest.5088E3C71CA9EAB9.quest_desc: [
		"A cog is a small cargo ship for a couple of people and some cargo. Faster than a boat, holds the waves."
		"&lWhy:&r islands, far coasts and ocean dungeons are now within reach."
	]
	quest.4A924D0C915569ED.title: "The Brig"
	quest.4A924D0C915569ED.quest_subtitle: "Fast and armed"
	quest.4A924D0C915569ED.quest_desc: [
		"A brig is a medium ship: room for broadside cannons and a cargo hold. Good for hunting illager galleys."
	]
	quest.3B06282EB819370D.title: "The Galleon"
	quest.3B06282EB819370D.quest_subtitle: "Flagship"
	quest.3B06282EB819370D.quest_desc: [
		"The biggest sailing ship: many cannons, a huge hold, room for the whole crew. A floating base for expeditions to the Sunken City and the ship graveyard."
	]
	quest.1F8568D64C4D85D9.title: "The Drakkar"
	quest.1F8568D64C4D85D9.quest_subtitle: "Oars instead of wind"
	quest.1F8568D64C4D85D9.quest_desc: [
		"A drakkar rows: it doesn't need wind. Great for rivers and narrow straits."
	]
	quest.36AF2E60F7B656EB.title: "Sail or Motor?"
	quest.36AF2E60F7B656EB.quest_subtitle: "Small Ships vs Immersive Petroleum"
	quest.36AF2E60F7B656EB.quest_desc: [
		"The IP speedboat is fast but drinks gasoline and carries no cargo. A ship is slower but free, and has cannons. A good base keeps both."
	]
	quest.17DADFF13634DB04.title: "Handcar"
	quest.17DADFF13634DB04.quest_subtitle: "Steam 'n' Rails"
	quest.17DADFF13634DB04.quest_desc: [
		"The handcar is the smallest «train» on Create tracks: for short trips to the mine or a neighbour."
	]
	quest.7CFEDCB56F3C85D9.title: "Steam Locomotive"
	quest.7CFEDCB56F3C85D9.quest_subtitle: "Pretty trains"
	quest.7CFEDCB56F3C85D9.quest_desc: [
		"Steam 'n' Rails adds smokestacks, boilers and locometal: the train looks like a real steam engine. Traction comes from Create rotation."
	]
	quest.6D7CC78BAD7C139E.title: "Couplers and Semaphores"
	quest.6D7CC78BAD7C139E.quest_subtitle: "A railway network"
	quest.6D7CC78BAD7C139E.quest_desc: [
		"The coupler joins and splits trains on the move; semaphores show signals. That's how a network grows: freight trains between players' bases."
		"&lRoles meet:&r the railway is a shared project: the farmer ships food, the miner ore, the engineer machines."
	]
	quest.631B95D917C4FF14.title: "Monorail"
	quest.631B95D917C4FF14.quest_subtitle: "Above the town"
	quest.631B95D917C4FF14.quest_desc: [
		"A monorail runs through the air above the roofs: a metro for your Minecolonies colony."
	]
	quest.466444CD9C2D77D4.title: "Warp Scroll"
	quest.466444CD9C2D77D4.quest_subtitle: "Waystones"
	quest.466444CD9C2D77D4.quest_desc: [
		"A single-use scroll takes you to any activated waystone."
		"&lWhy:&r get back from an expedition without dropping your loot. &lWhy not always:&r scrolls cost resources, and the road is part of the adventure."
	]
	quest.59FE438CCB6B63CB.title: "Warp Stone"
	quest.59FE438CCB6B63CB.quest_subtitle: "Reusable"
	quest.59FE438CCB6B63CB.quest_desc: [
		"The warp stone is a reusable pocket portal with a cooldown. Your own waystone at home + the stone = freedom to explore."
	]
	quest.79CAC370B6DC53A9.title: "Quadrocopter"
	quest.79CAC370B6DC53A9.quest_subtitle: "Immersive Aircraft"
	quest.79CAC370B6DC53A9.quest_desc: [
		"Slow, but it hovers: perfect for building tall towers and surveying land."
	]
	quest.69A1D02B4D7A4EFC.title: "Transport Empire"
	quest.69A1D02B4D7A4EFC.quest_subtitle: "Sea, rails, sky"
	quest.69A1D02B4D7A4EFC.quest_desc: [
		"You've tied the world together. Suggest a shared station at spawn so every line meets in one place."
	]
	chapter.78D5E7433029BED0.title: "Mekanism & the Atom"
	chapter.78D5E7433029BED0.chapter_subtitle: [
		"From the enrichment chamber to fusion"
	]
	quest.245608597F69080B.title: "Osmium"
	quest.245608597F69080B.quest_subtitle: "Mekanism's metal"
	quest.245608597F69080B.quest_desc: [
		"&lWhat:&r Mekanism is electric industry: ore processing, chemistry, nuclear power, an exosuit."
		"&lHow to start:&r find osmium ore (bluish) and smelt ingots. Osmium is in every first machine."
		"Mekanism reference: &lU&r on any block in EMI."
	]
	quest.47C67B75E3CB3CF3.title: "Steel"
	quest.47C67B75E3CB3CF3.quest_subtitle: "The metallurgic infuser"
	quest.47C67B75E3CB3CF3.quest_desc: [
		"The infuser blends iron with coal into enriched iron, then steel."
		"Steel is shared: Mekanism, Immersive Engineering and TFMG all use it (Almost Unified merges them into one)."
	]
	quest.625415B7F4D63866.title: "Electricity"
	quest.625415B7F4D63866.quest_subtitle: "The heat generator"
	quest.625415B7F4D63866.quest_desc: [
		"The heat generator burns fuel or draws heat from nearby lava. Power for your first machines."
		"&lTip:&r solar panels and wind turbines run free, and the Create alternator turns rotation into power."
	]
	quest.77688562BA6E2F2C.title: "Ore Doubling"
	quest.77688562BA6E2F2C.quest_subtitle: "The enrichment chamber"
	quest.77688562BA6E2F2C.quest_desc: [
		"The enrichment chamber turns ore into 2 dust — twice the ingots. It's the first of five tiers."
		"Next: purification (×3), chemical injection (×4), acid dissolution (×5)."
	]
	quest.6ADA9E43D1CB61AE.title: "Control Circuits"
	quest.6ADA9E43D1CB61AE.quest_subtitle: "The brains of machines"
	quest.6ADA9E43D1CB61AE.quest_desc: [
		"Circuits go into upgrades and advanced machines. Basic ones are osmium and redstone."
	]
	quest.6FB9DD22E96511CF.title: "Tripling"
	quest.6FB9DD22E96511CF.quest_subtitle: "Purification chamber + oxygen"
	quest.6FB9DD22E96511CF.quest_desc: [
		"A purification chamber fed with oxygen gives 3 ingots per ore. Oxygen comes from an electrolytic separator (water → hydrogen + oxygen)."
	]
	quest.552270423C6CD2BE.title: "Factories"
	quest.552270423C6CD2BE.quest_subtitle: "Many operations at once"
	quest.552270423C6CD2BE.quest_desc: [
		"A factory is a machine with several slots: smelts, crushes or enriches 3–9 items at once. Upgrade it with a tier installer."
	]
	quest.6B07DF1CDC5F216D.title: "The Hydrogen Jetpack"
	quest.6B07DF1CDC5F216D.quest_subtitle: "Fly on water"
	quest.6B07DF1CDC5F216D.quest_desc: [
		"The Mekanism jetpack is fuelled with hydrogen from the electrolytic separator. It stays up longer than you'd think."
	]
	quest.6E06D49078E7978C.title: "Radiation Is Serious"
	quest.6E06D49078E7978C.quest_subtitle: "Geiger counter and hazmat suit"
	quest.6E06D49078E7978C.quest_desc: [
		"Before the atom — protection. Radiation &laccumulates&r in your body and hurts at high doses."
		"The Geiger counter shows the background, the dosimeter your dose. A hazmat suit blocks almost all of it."
		"More on protection and cleanup in \"Elements & Defence\"."
	]
	quest.6C6A40C7728A898A.title: "Splitting the Atom"
	quest.6C6A40C7728A898A.quest_subtitle: "The fission reactor"
	quest.6C6A40C7728A898A.quest_desc: [
		"A fission reactor means huge power and huge responsibility. &lCooling&r comes first: watch the temperature."
		"Start at a low burn rate (0.1 mB/t) and wire an emergency SCRAM with a logic adapter."
		"&lTip:&r build the reactor on an \"island\", away from bases and farms."
	]
	quest.14BEE4BDABDB075B.title: "The Turbine"
	quest.14BEE4BDABDB075B.quest_subtitle: "Steam → electricity"
	quest.14BEE4BDABDB075B.quest_desc: [
		"The reactor heats sodium or water, the boiler makes steam, the turbine turns steam into power."
		"A huge, handsome structure — make it the centrepiece of your power plant."
	]
	quest.673E8013AF5960AA.title: "Waste"
	quest.673E8013AF5960AA.quest_subtitle: "Don't pour it in the river!"
	quest.673E8013AF5960AA.quest_desc: [
		"Nuclear waste goes into a radioactive waste barrel, which slowly neutralises it."
		"Later the waste becomes &lplutonium&r and &lpolonium&r — fuel for the SPS and antimatter."
	]
	quest.474E9801152A6673.title: "The Accelerator"
	quest.474E9801152A6673.quest_subtitle: "SPS and antimatter"
	quest.474E9801152A6673.quest_desc: [
		"The supercritical phase shifter (SPS) turns polonium into antimatter. It's part of"
		"the \"Ring Collider\" megaproject in \"Great Works\"."
	]
	quest.1152DA7E951B01C8.title: "A Sun in a Box"
	quest.1152DA7E951B01C8.quest_subtitle: "The fusion reactor"
	quest.1152DA7E951B01C8.quest_desc: [
		"Deuterium and tritium, a laser ignition — and a star in your basement. Safer than fission and stronger."
	]
	quest.547A2E63CB89901D.title: "The Exosuit"
	quest.547A2E63CB89901D.quest_subtitle: "MekaSuit"
	quest.547A2E63CB89901D.quest_desc: [
		"Modular armour: flight, night vision, radiation shielding, auto-feeding. Modules go in at the modification station."
		"The peak of the engineering branch — and a great gift for your group's warrior."
	]
	quest.202B14FABDF1BEBE.title: "The Crusher"
	quest.202B14FABDF1BEBE.quest_desc: [
		"Crushes ingots into dust, cobble into gravel, crops into bio-fuel. Metal dust smelts into ingots."
	]
	quest.4CF40E8C8033E8A3.title: "The Energized Smelter"
	quest.4CF40E8C8033E8A3.quest_desc: [
		"Smelts quickly without coal. With speed upgrades — very quickly."
	]
	quest.49875A981F07E924.title: "Cables and Storage"
	quest.49875A981F07E924.quest_desc: [
		"Universal cable carries energy, the cube stores it. The configurator sets which side inputs and which outputs."
	]
	quest.3B9CF5DEF05B0975.title: "The Configurator"
	quest.3B9CF5DEF05B0975.quest_desc: [
		"Mekanism's main tool: sets machine sides, rotates blocks, empties contents."
	]
	quest.16088EC8A05113FC.title: "Machine Upgrades"
	quest.16088EC8A05113FC.quest_desc: [
		"Speed upgrades go faster, energy upgrades cut usage. They fit any Mekanism machine."
	]
	quest.27072E7F71AB537A.title: "Logistical Transporters"
	quest.27072E7F71AB537A.quest_desc: [
		"Mekanism pipes move items with filters and colour tags. An alternative to Create belts."
	]
	quest.5085E51AFD3E356C.title: "Solar Power"
	quest.5085E51AFD3E356C.quest_desc: [
		"Quiet, clean daytime power. No air pollution — the gardener approves."
	]
	quest.6C0D1DCA5D7B6BBA.title: "The Wind Generator"
	quest.6C0D1DCA5D7B6BBA.quest_desc: [
		"The higher it stands, the more power. Put it on a mountain or a floating island."
	]
	quest.1ECF6115162FDEAE.title: "The Bio-Generator"
	quest.1ECF6115162FDEAE.quest_desc: [
		"Burns the gardener's bio-fuel. No smog — and no mine."
	]
	quest.27FE97C313BB88D2.title: "Electrolysis"
	quest.27FE97C313BB88D2.quest_desc: [
		"Splits water into hydrogen and oxygen. Oxygen triples ore; hydrogen fuels the jetpack and a generator."
	]
	quest.43AA10D65F8C95AE.title: "Ore Quadrupling"
	quest.43AA10D65F8C95AE.quest_desc: [
		"The chemical injection chamber with hydrogen chloride gives 4 ingots per ore. Needs a chemistry line: salt → brine → chlorine."
	]
	quest.1CB53BC48DEE6135.title: "The Digital Miner"
	quest.1CB53BC48DEE6135.quest_desc: [
		"Mines chosen ores in a huge radius and leaves the surface untouched. The king of mine automation."
	]
	quest.13E7AADECF1DA346.title: "The Teleporter"
	quest.13E7AADECF1DA346.quest_desc: [
		"A Mekanism portal frame carries you between bases — even across dimensions."
	]
	quest.1B8A663F3567C4BB.title: "QIO"
	quest.1B8A663F3567C4BB.quest_desc: [
		"Mekanism's quantum storage — an alternative to AE2 without channels. Pick what suits your group."
	]
	quest.467A309FB47AF4E3.title: "The Atomic Disassembler"
	quest.467A309FB47AF4E3.quest_desc: [
		"An all-in-one tool: pickaxe, axe, shovel and sword. Runs on energy."
	]
	quest.5AEFDCFC36E4DDA2.title: "The Induction Matrix"
	quest.5AEFDCFC36E4DDA2.quest_desc: [
		"A huge energy store — the heart of the whole group's power grid."
	]
	quest.31249669C0F62F41.title: "The Thermoelectric Boiler"
	quest.31249669C0F62F41.quest_desc: [
		"Superheated sodium from the reactor boils water in the boiler — steam goes to the turbine. A classic nuclear plant."
	]
	quest.098450DFBC4F0224.title: "The Paxel"
	quest.098450DFBC4F0224.quest_subtitle: "Mekanism Tools"
	quest.098450DFBC4F0224.quest_desc: [
		"A pickaxe, axe and shovel in one tool: less swapping in the mine. A steel paxel outlasts iron and nearly matches diamond."
	]
	quest.3000FF6EC8D61578.title: "Osmium Armour"
	quest.3000FF6EC8D61578.quest_subtitle: "Heavy and tough"
	quest.3000FF6EC8D61578.quest_desc: [
		"Osmium is a heavy metal: its armour takes hits better than iron. An alternative for those short on diamonds."
	]
	quest.5E40C59EA1D4B28B.title: "Refined Obsidian"
	quest.5E40C59EA1D4B28B.quest_subtitle: "Mekanism Tools' best armour"
	quest.5E40C59EA1D4B28B.quest_desc: [
		"Refined obsidian is made in Mekanism from obsidian and diamond dust. Its armour is netherite-tier without a trip for ancient debris."
	]
	quest.328AF20751E40D18.title: "Refined Glowstone"
	quest.328AF20751E40D18.quest_subtitle: "Fast tools"
	quest.328AF20751E40D18.quest_desc: [
		"Refined glowstone tools are the fastest in Mekanism Tools."
	]
	chapter.1D269465AE61C05E.title: "The Atom"
	chapter.1D269465AE61C05E.chapter_subtitle: [
		"Extreme Reactors and Mekanism fission: lots of power, little harm"
	]
	quest.385179001FCC35DD.title: "Yellorite"
	quest.385179001FCC35DD.quest_subtitle: "Extreme Reactors"
	quest.385179001FCC35DD.quest_desc: [
		"&lWhat:&r Extreme Reactors (formerly Big Reactors): multiblock reactors and turbines you build at any size."
		"&lWhy:&r one medium reactor powers a whole base. &lNo radiation, no pollution&r: a peaceful atom for home."
		"&lHow to start:&r yellorite ore lies deep underground. Smelt it into yellorium ingots: the fuel."
	]
	quest.00B5A7E9699DCF0C.title: "Graphite"
	quest.00B5A7E9699DCF0C.quest_subtitle: "Moderator and casing"
	quest.00B5A7E9699DCF0C.quest_desc: [
		"Graphite is smelted from coal or charcoal. It makes the reactor casing and fuel rods."
		"&lTip:&r put a Create fan-smelting line on a belt: coal turns into graphite by itself."
	]
	quest.42035AA943CCC666.title: "Reactor Casing"
	quest.42035AA943CCC666.quest_subtitle: "At least 3×3×3"
	quest.42035AA943CCC666.quest_desc: [
		"The smallest reactor is a 3×3×3 cube: casing edges, casing or glass faces, a fuel rod inside."
		"You need 26 casing blocks (fewer if some faces are glass)."
	]
	quest.6016A6F923D9EEAD.title: "Rods"
	quest.6016A6F923D9EEAD.quest_subtitle: "Fuel and control"
	quest.6016A6F923D9EEAD.quest_desc: [
		"A &lfuel rod&r is a column from floor to ceiling. On top sits a &lcontrol rod&r: it sets the power (0–100 %)."
		"More rods in a checkerboard pattern give more energy per unit of fuel."
	]
	quest.1773A8F8F5018FEC.title: "The First Reactor"
	quest.1773A8F8F5018FEC.quest_subtitle: "Controller + power tap"
	quest.1773A8F8F5018FEC.quest_desc: [
		"Controller on a face, a power tap to your cables. Load yellorium into an access port, switch the controller on."
		"&lSafe:&r overheating only lowers output. No explosions, no radiation."
		"&lWaste&r is cyanite: reprocess it back into fuel (the reprocessor)."
	]
	quest.03A29457CE8D2345.title: "The Turbine"
	quest.03A29457CE8D2345.quest_subtitle: "Steam → energy, several times more"
	quest.03A29457CE8D2345.quest_desc: [
		"Switch the reactor to water cooling (a fluid port): it starts producing &lsteam&r. Steam into a turbine gives 3–5 times more energy."
		"Rotor blades are made of steel: your steel mill pays off here."
	]
	quest.0AECD052E87EA63D.title: "The Reprocessor"
	quest.0AECD052E87EA63D.quest_subtitle: "Cyanite back into fuel"
	quest.0AECD052E87EA63D.quest_desc: [
		"The reprocessor turns cyanite (waste) and water into blutonium: a stronger fuel than yellorium. A closed loop with no garbage."
	]
	quest.0C2DA46EC2979143.title: "Reinforced Reactor"
	quest.0C2DA46EC2979143.quest_subtitle: "Big sizes"
	quest.0C2DA46EC2979143.quest_desc: [
		"Reinforced blocks allow reactors up to 32×32×48. That's a power plant for the whole server: agree with neighbours on who maintains it."
	]
	quest.7352B03F0E567940.title: "Two Roads to the Atom"
	quest.7352B03F0E567940.quest_subtitle: "Extreme Reactors vs Mekanism"
	quest.7352B03F0E567940.quest_desc: [
		"&lExtreme Reactors&r is safe: it never explodes, and waste is reprocessed."
		"&lThe Mekanism fission reactor&r is stronger and yields plutonium and polonium for the SPS and fusion, but if it overheats it &lexplodes and contaminates the area&r (radiation stays at the accident site; the rest of the world is untouched). Wear a hazmat suit and use sensors."
		"Your choice: the server never forces you to take risks."
	]
	quest.0679515BD8C61681.title: "A Star in a Box"
	quest.0679515BD8C61681.quest_subtitle: "Fusion"
	quest.0679515BD8C61681.quest_desc: [
		"The Mekanism fusion reactor is the peak of power: deuterium + tritium, ignited by laser. Safe, but it needs everything you've built before."
		"&lGreat work:&r «Fusion Plant» in the Great Works chapter."
	]
	chapter.3609E2F89D752FA6.title: "Steel & Oil"
	chapter.3609E2F89D752FA6.chapter_subtitle: [
		"Immersive Engineering, Petroleum, TFMG — and the air we breathe"
	]
	quest.0210AA1ED353DB24.title: "The Engineer's Hammer"
	quest.0210AA1ED353DB24.quest_subtitle: "Immersive Engineering"
	quest.0210AA1ED353DB24.quest_desc: [
		"&lWhat:&r IE is huge, handsome multiblocks: coke ovens, blast furnaces, excavators, oil derricks."
		"&lHow:&r build the structure block by block from the &lEngineer's Manual&r and strike it with the hammer — it comes alive."
		"It's all in the book: keep it handy."
	]
	quest.42529685BB61068A.title: "The Coke Oven"
	quest.42529685BB61068A.quest_subtitle: "Your first multiblock"
	quest.42529685BB61068A.quest_desc: [
		"27 coke bricks in a 3×3×3 cube and a hammer strike. Coal turns into &lcoke&r and creosote."
		"Creosote treats planks for windmills and posts."
	]
	quest.450EFCA7DA0C32C3.title: "The Blast Furnace"
	quest.450EFCA7DA0C32C3.quest_subtitle: "Iron + coke = steel"
	quest.450EFCA7DA0C32C3.quest_desc: [
		"A blast furnace of fire bricks turns iron and coke into steel. Slow, but needs no power."
	]
	quest.7BACE05C294403E1.title: "Windmill and Dynamo"
	quest.7BACE05C294403E1.quest_subtitle: "IE power"
	quest.7BACE05C294403E1.quest_desc: [
		"A big windmill turns a kinetic dynamo — and power flows along wires on posts."
		"IE wires are pretty: string a power line between bases."
	]
	quest.1A07CB4F99214042.title: "Core Samples"
	quest.1A07CB4F99214042.quest_subtitle: "The core sample drill and the excavator"
	quest.1A07CB4F99214042.quest_desc: [
		"The core sample drill finds &lmineral veins&r deep underground. A giant excavator over the vein mines ore forever."
	]
	quest.0487C41259C69160.title: "Where's the Oil?"
	quest.0487C41259C69160.quest_subtitle: "Immersive Petroleum seismic survey"
	quest.0487C41259C69160.quest_desc: [
		"The seismic survey finds an &loil reservoir&r beneath you. Build a derrick and a pumpjack over it."
	]
	quest.7F7D4CF8C56466A4.title: "Black Gold"
	quest.7F7D4CF8C56466A4.quest_subtitle: "Derrick and pumpjack"
	quest.7F7D4CF8C56466A4.quest_desc: [
		"First the derrick drills a well, then the pumpjack draws oil. Crude goes into a &ldistillation tower&r."
		"&lImportant:&r oil machines &lpollute the air&r — see the \"Air\" quest below."
	]
	quest.3E617B5D12B1FC24.title: "Distillation"
	quest.3E617B5D12B1FC24.quest_subtitle: "Diesel, gasoline, lubricant"
	quest.3E617B5D12B1FC24.quest_desc: [
		"The tower splits crude into fractions: diesel for generators, gasoline for vehicles, lubricant for machines, asphalt for roads."
	]
	quest.3DEC14AC13120A77.title: "The Factory Must Grow"
	quest.3DEC14AC13120A77.quest_subtitle: "TFMG: steel and oil, Create-style"
	quest.3DEC14AC13120A77.quest_desc: [
		"TFMG is heavy industry for Create: coke oven, blast furnace, casting, diesel engines."
		"If IE isn't your style, this is another road to steel and fuel, entirely on rotation."
	]
	quest.1A020305E1D3E7EE.title: "The Diesel Engine"
	quest.1A020305E1D3E7EE.quest_subtitle: "Power for huge machines"
	quest.1A020305E1D3E7EE.quest_desc: [
		"Cylinders, a gearbox and a controller — and the engine drives a whole factory or a heavy Aeronautics vehicle."
	]
	quest.294E4669A44B8A90.title: "The Air"
	quest.294E4669A44B8A90.quest_subtitle: "Airborne: pollution"
	quest.294E4669A44B8A90.quest_desc: [
		"&lWhat:&r factories, diesel and steam engines emit &lsmog&r. Wind spreads it; it harms crops and animals."
		"&lHow to fight it:&r forests and flowers absorb pollution; filters and tall stacks disperse it; electricity is cleaner than diesel."
		"&lTip:&r keep heavy industry far from the gardener's farm — and the friendship survives."
	]
	quest.2AD96C483D33D856.title: "Treated Wood"
	quest.2AD96C483D33D856.quest_desc: [
		"Planks soaked in creosote from the coke oven. Used for power poles, windmills and handsome industrial builds."
	]
	quest.7AFF934DCA0E6570.title: "Wires and Connectors"
	quest.7AFF934DCA0E6570.quest_desc: [
		"String copper wire between connectors and power flows through the air. Wire cutters take it down again."
	]
	quest.4FBD2D0E83BE60B4.title: "The Capacitor"
	quest.4FBD2D0E83BE60B4.quest_desc: [
		"Stores IE power. Place it between generator and consumers to smooth out the wind."
	]
	quest.5483FBF5D1816A4C.title: "Engineering Components"
	quest.5483FBF5D1816A4C.quest_desc: [
		"Iron and steel components — gears and springs for IE multiblocks. Made at the engineer's workbench."
	]
	quest.328FDBEF228A8FFE.title: "Engineering Blocks"
	quest.328FDBEF228A8FFE.quest_desc: [
		"Light and heavy engineering blocks — the bricks of big machines: the press, arc furnace, excavator."
	]
	quest.5C46F0227CB6505C.title: "The IE Crusher"
	quest.5C46F0227CB6505C.quest_desc: [
		"A huge crusher doubles ore and grinds everything. Build it from the manual and tick the quest."
	]
	quest.3E2D9D8E886F6C84.title: "The Arc Furnace"
	quest.3E2D9D8E886F6C84.quest_desc: [
		"Smelts alloys and ore with electricity and graphite electrodes. IE's most spectacular machine."
	]
	quest.2F616E00AAE960B1.title: "The Excavator"
	quest.2F616E00AAE960B1.quest_desc: [
		"A giant wheel over an ore vein mines forever. Worth building as a whole group."
	]
	quest.59FAF5536B9FD537.title: "The Engineer's Revolver"
	quest.59FAF5536B9FD537.quest_desc: [
		"IE's upgradeable revolver with barrels and cylinders. Ammo is made at an assembler."
	]
	quest.3046392D71FAC550.title: "The Skyhook"
	quest.3046392D71FAC550.quest_desc: [
		"Hook onto a wire and ride it like a zip line. Wires between bases become roads."
	]
	quest.1329CEFC5DE03CC2.title: "The Diesel Generator"
	quest.1329CEFC5DE03CC2.quest_desc: [
		"A big generator burning diesel. Powerful — but it &lpollutes the air&r. Think about filters and trees around it."
	]
	quest.5C51AE40CD1103E9.title: "Asphalt"
	quest.5C51AE40CD1103E9.quest_desc: [
		"Asphalt roads speed you up. Lay a highway between bases."
	]
	quest.2C47CC784D3B70E5.title: "The Speedboat"
	quest.2C47CC784D3B70E5.quest_desc: [
		"A fast gasoline boat. With an icebreaker it handles ice too."
	]
	quest.35E236DBFB93865C.title: "TFMG Steel"
	quest.35E236DBFB93865C.quest_desc: [
		"TFMG's blast furnace with a stove pours molten steel into moulds. Steel is shared — Almost Unified makes it one item across mods."
	]
	quest.6E091F8E2D5D5FBC.title: "Plastic"
	quest.6E091F8E2D5D5FBC.quest_desc: [
		"Oil fractions make plastic. Needed for electronics and modern machines."
	]
	quest.64C0EDFF9ABD667E.title: "Lithium"
	quest.64C0EDFF9ABD667E.quest_desc: [
		"Lithium ore — for TFMG batteries and electric motors."
	]
	quest.0A4D3CC8580A871B.title: "TFMG Coke Oven"
	quest.0A4D3CC8580A871B.quest_subtitle: "Create: The Factory Must Grow"
	quest.0A4D3CC8580A871B.quest_desc: [
		"&lWhat:&r TFMG is heavy industry on Create: coke, steel, oil, plastic, electrics."
		"&lWhy coke:&r no coke, no TFMG steel. The coke oven is a multiblock; vent the smoke outside (watch the smog, «Elements» chapter)."
	]
	quest.3159A577DDBB09A3.title: "Bauxite"
	quest.3159A577DDBB09A3.quest_subtitle: "The road to aluminium"
	quest.3159A577DDBB09A3.quest_desc: [
		"Bauxite is aluminium ore. Aluminium pipes and cogs are lighter and carry more than copper and andesite."
	]
	quest.587BA5DC216ED50E.title: "Reinforced Concrete"
	quest.587BA5DC216ED50E.quest_subtitle: "For real factories"
	quest.587BA5DC216ED50E.quest_desc: [
		"Concrete with rebar withstands blasts better than stone. A foundation for a reactor or a powder store."
	]
	quest.594F228266507B1D.title: "Circuit Board"
	quest.594F228266507B1D.quest_subtitle: "TFMG electronics"
	quest.594F228266507B1D.quest_desc: [
		"Plastic + copper → a board. Boards make electric motors, transistors, traffic lights: the TFMG electric branch."
	]
	quest.34A6CC13D56A641D.title: "TFMG Electric Motor"
	quest.34A6CC13D56A641D.quest_subtitle: "Power → rotation"
	quest.34A6CC13D56A641D.quest_desc: [
		"The motor turns Create shafts from electricity: run your factory off a reactor instead of windmills."
	]
	quest.6D88123A2F5C4016.title: "Pumpjack"
	quest.6D88123A2F5C4016.quest_subtitle: "TFMG oil"
	quest.6D88123A2F5C4016.quest_desc: [
		"The TFMG pumpjack draws oil from deposits underground: the same resource as Immersive Petroleum, but on Create mechanics."
	]
	quest.2914A07238F4FC3A.title: "Industrialisation"
	quest.2914A07238F4FC3A.quest_subtitle: "The factory must grow"
	quest.2914A07238F4FC3A.quest_desc: [
		"Coke, steel, aluminium, concrete, plastic and electronics. Mind the smog: filters and trees around the plant keep the sky clear."
	]
	chapter.1CB608F08E9C4FA8.title: "Storage"
	chapter.1CB608F08E9C4FA8.chapter_subtitle: [
		"AE2: from a chest to autocrafting"
	]
	quest.7CE32C7F71CB05D8.title: "A Meteorite with a Secret"
	quest.7CE32C7F71CB05D8.quest_subtitle: "Applied Energistics 2"
	quest.7CE32C7F71CB05D8.quest_desc: [
		"&lWhat:&r AE2 turns items into &ldata&r and stores thousands of stacks in small cells. Find anything from one terminal."
		"&lHow to start:&r find a fallen AE2 meteorite (a meteorite compass helps) — inside are processor presses and quartz."
		"The AE2 guide book is this quest's reward."
	]
	quest.17F6CA0CCFC34634.title: "Fluix"
	quest.17F6CA0CCFC34634.quest_subtitle: "Charged quartz + redstone + water"
	quest.17F6CA0CCFC34634.quest_desc: [
		"Drop charged quartz, redstone and quartz into water — they fuse into &lfluix&r. Cables and networks are made from it."
		"&lTip:&r the AE2 charger charges quartz with power."
	]
	quest.3A74454EECFAF6CA.title: "The Inscriber"
	quest.3A74454EECFAF6CA.quest_subtitle: "Processors"
	quest.3A74454EECFAF6CA.quest_desc: [
		"The inscriber with the meteorite presses prints circuits and assembles &lprocessors&r: logic, calculation, engineering."
	]
	quest.4886C83968921E76.title: "Your First Network"
	quest.4886C83968921E76.quest_subtitle: "Drive, terminal, cell"
	quest.4886C83968921E76.quest_desc: [
		"A drive with cells, a terminal and an energy acceptor wired together — and you have a digital warehouse."
		"Put everything into the terminal and find it by search."
	]
	quest.0B0790571127F00F.title: "The Controller"
	quest.0B0790571127F00F.quest_subtitle: "Channels and a big network"
	quest.0B0790571127F00F.quest_desc: [
		"Without a controller a network holds 8 devices. With one, hundreds. Cables carry &lchannels&r: normal 8, dense 32."
	]
	quest.6DE7C0C959612D5B.title: "Autocrafting"
	quest.6DE7C0C959612D5B.quest_subtitle: "Patterns and assemblers"
	quest.6DE7C0C959612D5B.quest_desc: [
		"Encode a recipe into a pattern, slot it into a molecular assembler next to a crafting CPU — and the network makes a hundred."
		"Patterns also drive Create, Mekanism and IE machines through an interface."
	]
	quest.595F1264AFC77E3A.title: "A Warehouse in Your Pocket"
	quest.595F1264AFC77E3A.quest_subtitle: "The wireless terminal"
	quest.595F1264AFC77E3A.quest_desc: [
		"A wireless terminal opens the network from afar. With the AE2 Wireless Terminals addon — even from another dimension."
	]
	quest.768779FCB55BCD1C.title: "Chemistry on the Network"
	quest.768779FCB55BCD1C.quest_subtitle: "Applied Mekanistics"
	quest.768779FCB55BCD1C.quest_desc: [
		"With Applied Mekanistics the network stores Mekanism &lgases and chemicals&r. Autocraft osmium, steel and fuel without running around."
	]
	quest.36C60720F4EA9E96.title: "The Meteorite Compass"
	quest.36C60720F4EA9E96.quest_desc: [
		"The compass points to the nearest AE2 meteorite. Inside are the processor presses. AE2 can't start without them."
	]
	quest.653961AE9D19159C.title: "The Charger"
	quest.653961AE9D19159C.quest_desc: [
		"Charges quartz with energy. Charged quartz is needed for fluix."
	]
	quest.48D500566B41A653.title: "Smart Cable"
	quest.48D500566B41A653.quest_desc: [
		"Smart cable shows used channels with lights. You can see at a glance where the network is full."
	]
	quest.7717FF8FC0B79B80.title: "Network Power"
	quest.7717FF8FC0B79B80.quest_desc: [
		"An energy cell stores AE2 network power — handy during outages."
	]
	quest.75C0981B7AE66C1D.title: "Buses"
	quest.75C0981B7AE66C1D.quest_desc: [
		"Import pulls from machines into the network, export pushes out, a storage bus plugs ordinary chests into the network."
	]
	quest.03E39F53E8961A2C.title: "The Level Emitter"
	quest.03E39F53E8961A2C.quest_desc: [
		"Signals when an item falls below a set amount — the way to run farms and machines on demand."
	]
	quest.131997C73B90D11E.title: "A 64k Cell"
	quest.131997C73B90D11E.quest_desc: [
		"Cells grow: 1k, 4k, 16k, 64k, 256k. The MEGA Cells addon goes even bigger."
	]
	quest.612AB2506CB12DF7.title: "The Pattern Provider"
	quest.612AB2506CB12DF7.quest_desc: [
		"A provider sends ingredients into any machine — Create crusher, Mekanism enricher, furnace — and waits for the result."
	]
	quest.00AEBF840B10042D.title: "Crafting Accelerators"
	quest.00AEBF840B10042D.quest_desc: [
		"Accelerators let the crafting CPU run many steps in parallel."
	]
	quest.2455CEB25DAAB7EF.title: "P2P Tunnels"
	quest.2455CEB25DAAB7EF.quest_desc: [
		"A tunnel carries channels, energy or fluids through one cable. Magic for a tidy base."
	]
	quest.6C6304EB044AF2D3.title: "MEGA Cells"
	quest.6C6304EB044AF2D3.quest_desc: [
		"MEGA cell housings store millions of items. The end of storage problems."
	]
	quest.1D7B9B84D2EEFDDE.title: "The Extended Provider"
	quest.1D7B9B84D2EEFDDE.quest_desc: [
		"ExtendedAE: a provider with 36 patterns. For huge factories."
	]
	quest.4441866ED74046FB.title: "Universal Terminal"
	quest.4441866ED74046FB.quest_subtitle: "AE2 Wireless Terminals"
	quest.4441866ED74046FB.quest_desc: [
		"&lWhy:&r one terminal instead of three wireless ones (items, crafting, patterns). Switch with the mouse wheel."
		"&lHow:&r craft the universal terminal and combine the others into it at a crafting table."
	]
	quest.143D342AC339D4C8.title: "Magnet Card"
	quest.143D342AC339D4C8.quest_subtitle: "Loot straight into the network"
	quest.143D342AC339D4C8.quest_desc: [
		"The card in your terminal pulls nearby items in and can send them straight into the ME network. Miners never walk home to unload again."
	]
	quest.2834497140F06F0A.title: "Quantum Bridge Card"
	quest.2834497140F06F0A.quest_subtitle: "A terminal without limits"
	quest.2834497140F06F0A.quest_desc: [
		"Links the terminal to your network through a quantum bridge: access your base from anywhere, even other dimensions."
	]
	quest.7957233924B56D96.title: "Extended Drive"
	quest.7957233924B56D96.quest_subtitle: "ExtendedAE"
	quest.7957233924B56D96.quest_desc: [
		"Holds twice as many cells as a normal ME drive. Fewer blocks, a more compact server room."
	]
	quest.69B1C9286584E909.title: "Assembler Matrix"
	quest.69B1C9286584E909.quest_subtitle: "Hundreds of crafts at once"
	quest.69B1C9286584E909.quest_desc: [
		"A multiblock matrix replaces a wall of molecular assemblers. Autocrafting thousands of items stops lagging."
	]
	quest.75C66A8AEA94F189.title: "Infinite Water"
	quest.75C66A8AEA94F189.quest_subtitle: "A source cell"
	quest.75C66A8AEA94F189.quest_desc: [
		"A cell whose water never runs out. For autocrafting that needs water: concrete, clay, farms."
	]
	quest.3DFC5F9E59155713.title: "MEGA Crafting CPU"
	quest.3DFC5F9E59155713.quest_subtitle: "MEGA Cells"
	quest.3DFC5F9E59155713.quest_desc: [
		"1M–256M crafting storage and mega accelerators: a crafting CPU that handles a whole reactor in one order."
	]
	quest.38B7049903894594.title: "Bulk Cell"
	quest.38B7049903894594.quest_subtitle: "One item, no limit"
	quest.38B7049903894594.quest_desc: [
		"Stores &lone&r item type in nearly unlimited amounts. Perfect for cobblestone, dirt and farm ore."
	]
	quest.20FE08C0C7302ACA.title: "Chemicals in the Network"
	quest.20FE08C0C7302ACA.quest_subtitle: "Applied Mekanistics"
	quest.20FE08C0C7302ACA.quest_desc: [
		"Mekanism gases and chemicals (hydrogen, oxygen, chlorine) are stored in AE2 like items. No more mazes of tanks and pipes."
	]
	quest.4EDD0BB5CDE3E9DF.title: "Data Architect"
	quest.4EDD0BB5CDE3E9DF.quest_subtitle: "The whole base in one terminal"
	quest.4EDD0BB5CDE3E9DF.quest_desc: [
		"Your network knows everything, crafts everything and reaches everywhere. Connect neighbours through a shared interface so the server trades through your network."
	]
	chapter.40872413A59558AE.title: "Ars Nouveau"
	chapter.40872413A59558AE.chapter_subtitle: [
		"Magic you build yourself"
	]
	quest.653C10B3F4E99952.title: "The Novice Spellbook"
	quest.653C10B3F4E99952.quest_subtitle: "Spells made of glyphs"
	quest.653C10B3F4E99952.quest_desc: [
		"&lWhat:&r in Ars Nouveau you &lbuild&r spells from glyphs: a form (projectile, touch, self) + effects."
		"\"Projectile + Break\" mines from afar. \"Self + Heal\" heals. Thousands of combinations."
		"The mod's guide is the &lWorn Notebook&r — you get one on first join."
	]
	quest.22E3A91D0CD8AF70.title: "Source Gems"
	quest.22E3A91D0CD8AF70.quest_subtitle: "Amethyst + lapis"
	quest.22E3A91D0CD8AF70.quest_desc: [
		"Source gems come from amethyst and lapis in an &limbuement chamber&r, or crafted early on."
		"Source is the fuel for all Ars magic."
	]
	quest.2EA1CE047C193DCE.title: "The Scribe's Table"
	quest.2EA1CE047C193DCE.quest_subtitle: "Learning new glyphs"
	quest.2EA1CE047C193DCE.quest_desc: [
		"At the scribe's table you write glyphs into your book. Each new glyph opens new tricks."
		"&lTip:&r grab Projectile, Break, Light and Leap first — life gets easier."
	]
	quest.5664F89936D9EBEF.title: "The Source Jar"
	quest.5664F89936D9EBEF.quest_subtitle: "Storage for magical energy"
	quest.5664F89936D9EBEF.quest_desc: [
		"Jars store Source. &lSourcelinks&r fill them — blocks that turn various activities into Source."
	]
	quest.7055B3AF6E8AB129.title: "Magic from Food"
	quest.7055B3AF6E8AB129.quest_subtitle: "The mycelial sourcelink"
	quest.7055B3AF6E8AB129.quest_desc: [
		"The &lmycelial sourcelink&r turns &lfood&r into Source. The more filling the dish, the more magic."
		"&lWho helps:&r this is where the mage and the cook become best friends. Ask the tavern for feast leftovers."
	]
	quest.285AF3BB0E17A1D1.title: "Garden Magic"
	quest.285AF3BB0E17A1D1.quest_subtitle: "The agronomic sourcelink"
	quest.285AF3BB0E17A1D1.quest_desc: [
		"Plants growing near an agronomic sourcelink produce Source. Place it by the gardener's beds."
	]
	quest.339F37A57CCF42F6.title: "The Enchanting Apparatus"
	quest.339F37A57CCF42F6.quest_subtitle: "Ritual crafting"
	quest.339F37A57CCF42F6.quest_desc: [
		"The apparatus on an arcane core, surrounded by pedestals, assembles complex magic items: rings, belts, the apprentice book."
	]
	quest.728DE8639046E9C8.title: "The Apprentice"
	quest.728DE8639046E9C8.quest_subtitle: "More mana, stronger spells"
	quest.728DE8639046E9C8.quest_desc: [
		"The apprentice book unlocks tier-two glyphs and more slots. Next comes the archmage book."
	]
	quest.5005922F7F263D60.title: "The Starbuncle Courier"
	quest.5005922F7F263D60.quest_subtitle: "Magical logistics"
	quest.5005922F7F263D60.quest_desc: [
		"A starbuncle moves items from chest to chest. Cute, quiet, cable-free."
		"There are other helpers too: wixies craft, drygmies collect mob drops, whirlisprigs speed up growth."
	]
	quest.07D1DF3649F23B99.title: "The Ritual of Flight"
	quest.07D1DF3649F23B99.quest_subtitle: "Fly near the brazier"
	quest.07D1DF3649F23B99.quest_desc: [
		"The flight ritual on a brazier grants flight to everyone nearby. Priceless for building tall towers."
		"&lValued by:&r builders and airship engineers."
	]
	quest.091A81DFA2C750F9.title: "Portals"
	quest.091A81DFA2C750F9.quest_subtitle: "The stable warp scroll"
	quest.091A81DFA2C750F9.quest_desc: [
		"Bind a scroll to a place and it opens a portal there. Scrolls make permanent portals between bases."
	]
	quest.74DB104AC5A8EE45.title: "Magic and Cogs"
	quest.74DB104AC5A8EE45.quest_subtitle: "Ars Creo"
	quest.74DB104AC5A8EE45.quest_desc: [
		"With Ars Creo starbuncles turn Create wheels and spells work inside contraptions."
		"It's a bridge between the mage's tower and the engineer's workshop. Build something together!"
	]
	quest.677C27BAE7F82E5C.title: "The Dowsing Rod"
	quest.677C27BAE7F82E5C.quest_desc: [
		"The rod highlights nearby Source blocks — helps find where to put sourcelinks."
	]
	quest.6B1AE1B499DAEBEF.title: "Magebloom"
	quest.6B1AE1B499DAEBEF.quest_desc: [
		"Magebloom grows like an ordinary crop. Its fibre makes mage robes. A gardener can grow it for you."
	]
	quest.2B62BAEEEC251847.title: "The Four Elements"
	quest.2B62BAEEEC251847.quest_desc: [
		"Fire, water, earth and air essences come from the imbuement chamber. They go into glyphs and gear."
	]
	quest.641B4C6B4F82C9E9.title: "The Imbuement Chamber"
	quest.641B4C6B4F82C9E9.quest_desc: [
		"The chamber infuses items with Source: lapis → source gem, amethyst → ward crystal."
		"It also makes &llevitite&r for engineers!"
	]
	quest.03B748F649B91F40.title: "The Volcanic Sourcelink"
	quest.03B748F649B91F40.quest_desc: [
		"Source from burning fuel and nearby lava."
	]
	quest.58097CE85FFDA488.title: "The Vitalic Sourcelink"
	quest.58097CE85FFDA488.quest_desc: [
		"Source from animals being born nearby. Place it by the breeder's pens and magic flows."
	]
	quest.0FD04222AFCD4D58.title: "The Alchemical Sourcelink"
	quest.0FD04222AFCD4D58.quest_desc: [
		"Source from potions. The alchemist gives spare potions, the mage gets mana."
	]
	quest.7228CAAC64556133.title: "The Relay"
	quest.7228CAAC64556133.quest_desc: [
		"Moves Source between jars at a distance. Magical wiring."
	]
	quest.6E24501F5DDB485C.title: "Archmage"
	quest.6E24501F5DDB485C.quest_desc: [
		"The archmage book unlocks tier-three glyphs and maximum mana. The peak of Ars Nouveau."
	]
	quest.658707DB87E893AB.title: "The Wixie"
	quest.658707DB87E893AB.quest_desc: [
		"A wixie crafts items and potions from a sample. A little alchemist on call."
	]
	quest.6B966748AE6AB149.title: "The Drygmy"
	quest.6B966748AE6AB149.quest_desc: [
		"A drygmy collects mob drops from a pen without killing. A peaceful resource farm."
	]
	quest.12E80AFF249EC3C8.title: "The Whirlisprig"
	quest.12E80AFF249EC3C8.quest_desc: [
		"Speeds up plant growth around it and makes Source. The gardener's best friend."
	]
	quest.0CD69A9B09F54808.title: "Magical Jewellery"
	quest.0CD69A9B09F54808.quest_desc: [
		"Rings and amulets raise your mana pool and lower spell costs."
	]
	quest.09E9C69607F1C726.title: "The Belt of Levitation"
	quest.09E9C69607F1C726.quest_desc: [
		"Crouch in mid-air and you hover. Tower builders will love it."
	]
	quest.75F214C699D14F96.title: "The Wilden"
	quest.75F214C699D14F96.quest_desc: [
		"Horn, spike and wing of Ars wilden creatures — for the ritual that summons the Wilden Chimera. The mage's boss."
	]
	quest.26441D1B5F1BFDE4.title: "An Elemental Focus"
	quest.26441D1B5F1BFDE4.quest_desc: [
		"Ars Elemental: a school focus empowers spells of one element. Pick yours."
	]
	chapter.543CD5142769B82D.title: "Iron's Spells"
	chapter.543CD5142769B82D.chapter_subtitle: [
		"Schools of battle magic"
	]
	quest.52131970F0AF37EB.title: "A Spell Scroll"
	quest.52131970F0AF37EB.quest_subtitle: "Find one or buy one"
	quest.52131970F0AF37EB.quest_desc: [
		"&lWhat:&r Iron's Spells is magic with &lschools&r: fire, ice, lightning, holy, blood, nature, ender, evocation."
		"Spells are stored in &lscrolls&r: find them in dungeon chests or buy them from wandering mages."
		"You can cast a scroll without a book — once."
	]
	quest.062A4C4223BD9574.title: "A Spellbook"
	quest.062A4C4223BD9574.quest_subtitle: "Forever"
	quest.062A4C4223BD9574.quest_desc: [
		"A book (in an accessory slot) keeps spells forever. Better books have more slots."
		"Choose a spell with the wheel key and cast it — see &oControls → Iron's Spells&r for the bindings."
	]
	quest.2689CA1241CB0BE8.title: "The Inscription Table"
	quest.2689CA1241CB0BE8.quest_subtitle: "Scroll → book"
	quest.2689CA1241CB0BE8.quest_desc: [
		"At the inscription table a spell moves from a scroll into your book. The scroll is used up."
	]
	quest.1807C290BC564799.title: "The Scroll Forge"
	quest.1807C290BC564799.quest_subtitle: "Make your own scrolls"
	quest.1807C290BC564799.quest_desc: [
		"The forge makes a scroll of the spell &lyou choose&r from paper, ink and a school focus. Rarer ink means a stronger spell."
		"&lValued by:&r alchemists — ink is brewed in their cauldron."
	]
	quest.64D45646DD838107.title: "Arcane Essence"
	quest.64D45646DD838107.quest_subtitle: "Break down spare scrolls"
	quest.64D45646DD838107.quest_desc: [
		"Spare scrolls break down into arcane essence — used for runes, upgrades and books."
	]
	quest.710E1FB9C0AF78C8.title: "School Runes"
	quest.710E1FB9C0AF78C8.quest_subtitle: "Fire, ice, lightning…"
	quest.710E1FB9C0AF78C8.quest_desc: [
		"A school rune is needed for its foci and upgrades. Pick a favourite school — its skill tree grows as you cast."
	]
	quest.20EF7614A84A8044.title: "The Wizard's Robes"
	quest.20EF7614A84A8044.quest_subtitle: "More mana"
	quest.20EF7614A84A8044.quest_desc: [
		"Mage armour grants mana and school power. The wizard hat is also a fine photo opportunity."
	]
	quest.26E181A4C50935DA.title: "Upgrades"
	quest.26E181A4C50935DA.quest_subtitle: "The arcane anvil"
	quest.26E181A4C50935DA.quest_desc: [
		"On the arcane anvil, upgrade orbs add mana, school power and cooldown reduction to armour."
	]
	quest.3A9E5FDFBAC6AAC3.title: "The Warlock's Tower"
	quest.3A9E5FDFBAC6AAC3.quest_subtitle: "Mage bosses"
	quest.3A9E5FDFBAC6AAC3.quest_desc: [
		"Towers and camps of hostile mages dot the world — necromancers, pyromancers, cultists. This is &lzone 3&r."
		"Beating them yields rare books, inks and school trophies. Go as a group and bring food."
	]
	quest.59DAC3A798675F2C.title: "Mithril"
	quest.59DAC3A798675F2C.quest_desc: [
		"Mithril ore lies deep underground. It makes the best spellbooks and mage armour."
	]
	quest.4C4770E1F9711E9D.title: "The Arcane Ingot"
	quest.4C4770E1F9711E9D.quest_desc: [
		"Mithril + arcane essence = an arcane ingot. The base of advanced books."
	]
	quest.0BE46ED673E89342.title: "School Books"
	quest.0BE46ED673E89342.quest_desc: [
		"The fire, ice and druidic books each boost their school. Pick one for your favourite spells."
	]
	quest.79520F0703E2D1D3.title: "Mage Rings"
	quest.79520F0703E2D1D3.quest_desc: [
		"Mana ring, cooldown ring, affinity ring — accessory slots for mages."
	]
	quest.4881E593675BEAC3.title: "Rare Ink"
	quest.4881E593675BEAC3.quest_desc: [
		"Better ink makes stronger scrolls. Ink is brewed in the alchemist's cauldron from common ink and essences."
	]
	quest.3990DF9B5753B506.title: "The Teleportation Amulet"
	quest.3990DF9B5753B506.quest_desc: [
		"Strengthens movement spells. An instant dash across a ravine — priceless."
	]
	quest.62EC5608FBE429B5.title: "The Dead King"
	quest.62EC5608FBE429B5.quest_desc: [
		"The undead king sleeps in a crypt underground. Defeating him is the magic branch's greatest trophy."
	]
	quest.161358A8E5F7983F.title: "The Jewelcrafting Station"
	quest.161358A8E5F7983F.quest_desc: [
		"Iron's Jewelry: rings and necklaces set with rubies, sapphires and topaz — each with its own bonus."
	]
	chapter.38CD7CF2D4519A5D.title: "Occultism"
	chapter.38CD7CF2D4519A5D.chapter_subtitle: [
		"Rituals and spirit workers"
	]
	quest.01CE06E57550BE24.title: "The Dictionary of Spirits"
	quest.01CE06E57550BE24.quest_subtitle: "The Occultism guide"
	quest.01CE06E57550BE24.quest_desc: [
		"&lWhat:&r Occultism is rituals with chalk and sacrificial bowls, summoning spirit servants and magical storage."
		"&lWhy:&r spirits work for you: chop trees, move items, clean up, run machines."
		"It's all in the Dictionary of Spirits — start with \"Getting Started\"."
	]
	quest.5D53F6CD01048766.title: "Datura"
	quest.5D53F6CD01048766.quest_subtitle: "Seeing the Otherworld"
	quest.5D53F6CD01048766.quest_desc: [
		"Datura grows from seeds dropped by grass. It makes &lDemon's Dream&r —"
		"after which you can see hidden Otherworld ores and trees."
		"&lValued by:&r gardeners — help the mage with a bed."
	]
	quest.3249B651AE7FF470.title: "Chalk and Bowl"
	quest.3249B651AE7FF470.quest_subtitle: "Your first pentacle"
	quest.3249B651AE7FF470.quest_desc: [
		"A ritual is drawn on the floor in chalk following the Dictionary's diagram, a golden sacrificial bowl in the centre, ingredient bowls around it."
		"&lTip:&r build the ritual room pretty from the start — candles and skulls are part of the pattern."
	]
	quest.6BBDBFD07168218A.title: "The Foliot"
	quest.6BBDBFD07168218A.quest_subtitle: "Your first spirit servant"
	quest.6BBDBFD07168218A.quest_desc: [
		"Bind a foliot in a book, then summon it with a ritual. A foliot can become a lumberjack, a cleaner or an item carrier."
	]
	quest.1429288ACE921923.title: "The Lumberjack"
	quest.1429288ACE921923.quest_subtitle: "A spirit fells the forest"
	quest.1429288ACE921923.quest_desc: [
		"A lumberjack spirit chops trees in its area, replants saplings and stacks logs in a chest. Builders will be thrilled."
	]
	quest.7DF2700D3B654BFD.title: "The Djinni"
	quest.7DF2700D3B654BFD.quest_subtitle: "Stronger and smarter"
	quest.7DF2700D3B654BFD.quest_desc: [
		"A djinni is the next rank of spirit. It runs machines and is needed for magical storage."
	]
	quest.2A27D09E6BCC33F9.title: "A Warehouse in a Dimension"
	quest.2A27D09E6BCC33F9.quest_subtitle: "Dimensional storage"
	quest.2A27D09E6BCC33F9.quest_desc: [
		"Occultism's storage keeps items in a pocket dimension. It's the magical answer to AE2 —"
		"pick one storage path for the group or build both for style."
	]
	quest.33B194723B40588C.title: "The Afrit"
	quest.33B194723B40588C.quest_subtitle: "A spirit of fire"
	quest.33B194723B40588C.quest_desc: [
		"The afrit is a dangerous, powerful spirit. Summoning it is a trial; the reward is access to the strongest rituals."
	]
	quest.4F522F244FA7F524.title: "Demon's Dream"
	quest.4F522F244FA7F524.quest_desc: [
		"Eat it and you see the Otherworld: hidden ores and trees. The effect lasts a few minutes."
	]
	quest.23BB481071838C9B.title: "Otherworld Goggles"
	quest.23BB481071838C9B.quest_desc: [
		"See the Otherworld all the time, no potion needed. Handy for mining iesnium."
	]
	quest.11F2CEF5CA17E371.title: "The Otherworld Tree"
	quest.11F2CEF5CA17E371.quest_desc: [
		"Special trees grow from the Otherworld — their wood is needed for rituals. A gardener can help grow a grove."
	]
	quest.20E03685BC9E6B17.title: "Iesnium"
	quest.20E03685BC9E6B17.quest_desc: [
		"The Otherworld's metal. It makes a pickaxe that sees hidden ores and the Occultism anvil."
	]
	quest.5B4F4EBBEDCAE623.title: "The Divination Rod"
	quest.5B4F4EBBEDCAE623.quest_desc: [
		"Finds a chosen block — ore, crystals — at long range."
	]
	quest.38FFF53198F0B11A.title: "A Familiar"
	quest.38FFF53198F0B11A.quest_desc: [
		"Summon a familiar — a spirit companion granting night vision, protection or speed. It lives in a ring."
	]
	quest.7E7BA6520B7760EB.title: "The Cleaner Spirit"
	quest.7E7BA6520B7760EB.quest_desc: [
		"Collects dropped items in its area and puts them in a chest. A tidy farm."
	]
	quest.2482B81DD409A7CA.title: "The Transporter Spirit"
	quest.2482B81DD409A7CA.quest_desc: [
		"Carries items from one chest to another. Logistics without pipes."
	]
	quest.570A419BD05A6077.title: "The Machine Djinni"
	quest.570A419BD05A6077.quest_desc: [
		"A djinni runs a machine: loads ingredients and collects results from magical storage."
	]
	chapter.6F2A8A724E748B44.title: "Alchemy"
	chapter.6F2A8A724E748B44.chapter_subtitle: [
		"Potions everyone needs"
	]
	quest.0FE6B961A2B65B01.title: "The Brewing Stand"
	quest.0FE6B961A2B65B01.quest_subtitle: "Where alchemy begins"
	quest.0FE6B961A2B65B01.quest_desc: [
		"&lWhat:&r the alchemist is the trade hub. Ingredients come &lfrom every role&r, and everyone needs the potions."
		"&lHow to start:&r a brewing stand + nether wart + water bottles is the base. Blaze powder is the fuel."
		"&lTip:&r every potion recipe is in EMI (&lU&r on a water bottle)."
	]
	quest.4ADED478BA38BECC.title: "The Alchemist's Cauldron"
	quest.4ADED478BA38BECC.quest_subtitle: "Iron's Spells"
	quest.4ADED478BA38BECC.quest_desc: [
		"The alchemist's cauldron brews potions in big batches and makes &link&r for scrolls. Put it over a fire."
		"&lValued by:&r Iron's mages — no ink, no new scrolls."
	]
	quest.1B9EEE85EBDBA92D.title: "Potion of Quiet"
	quest.1B9EEE85EBDBA92D.quest_subtitle: "The world doesn't notice you"
	quest.1B9EEE85EBDBA92D.quest_desc: [
		"&lEffect:&r hostile mobs ignore you for 8 minutes — until you strike first."
		"&lRecipe:&r water bottle + lavender (from the &lgardener&r) + feather (from the &lbreeder&r) + amethyst shard."
		"Brew it and tick the quest. The best gift for those who'd rather stroll than fight."
	]
	quest.67BE72A396A69007.title: "Potion of the Sea Wolf"
	quest.67BE72A396A69007.quest_subtitle: "For the angler"
	quest.67BE72A396A69007.quest_desc: [
		"Fishing luck, water breathing and night vision for 8 minutes."
		"&lRecipe:&r water + raw fish (from the &langler&r) + prismarine crystals + glow ink sac."
	]
	quest.3B96C193ACA277A9.title: "Potion of Fertility"
	quest.3B96C193ACA277A9.quest_subtitle: "For the gardener"
	quest.3B96C193ACA277A9.quest_desc: [
		"Crops around you grow faster for 5 minutes. Walk your fields and watch the harvest ripen."
		"&lRecipe:&r water + honey (from the &lbeekeeper&r) + bone meal + organic compost (from the &lcook&r)."
	]
	quest.1051DF3F4385D339.title: "Potion of Beast Trust"
	quest.1051DF3F4385D339.quest_subtitle: "For the breeder"
	quest.1051DF3F4385D339.quest_desc: [
		"Young animals near you grow up much faster for 8 minutes."
		"&lRecipe:&r water + koi (from the &langler&r) + golden carrot + wheat."
	]
	quest.2674C9B3CA6719CA.title: "Potion of Forge Heat"
	quest.2674C9B3CA6719CA.quest_subtitle: "For the engineer"
	quest.2674C9B3CA6719CA.quest_desc: [
		"Fire resistance and Haste II for 8 minutes — working by lava and smelters becomes a pleasure."
		"&lRecipe:&r water + blaze powder + ancient metal nugget (from the &lexplorer&r of Cataclysm ruins) + magma cream."
	]
	quest.5D3473C41AD56DA7.title: "Potion of Clean Breath"
	quest.5D3473C41AD56DA7.quest_subtitle: "Against smog and acid rain"
	quest.5D3473C41AD56DA7.quest_desc: [
		"For 10 minutes it shields you from poison, nausea, wither and blindness — what smog and acid rain inflict."
		"&lRecipe:&r water + source gem (from the &lmage&r) + moss block + kelp."
	]
	quest.30B0F5FAE9A6FB57.title: "Potion of Lead Blood"
	quest.30B0F5FAE9A6FB57.quest_subtitle: "Flushes radiation"
	quest.30B0F5FAE9A6FB57.quest_desc: [
		"Every 10 seconds some radiation leaves your body — for 3 minutes. Keep a couple of bottles by the reactor."
		"&lRecipe:&r water + lead ingot (from the &lengineer&r) + source gem (from the &lmage&r) + milk bucket."
	]
	quest.3C60CB78B824B591.title: "Potion of Star Sight"
	quest.3C60CB78B824B591.quest_subtitle: "See danger through walls"
	quest.3C60CB78B824B591.quest_desc: [
		"For 5 minutes hostile creatures within 48 blocks glow through walls. Indispensable in dungeons."
		"&lRecipe:&r water + eye of ender (from the &lwarrior&r) + glowstone dust + spyglass."
	]
	quest.31625BC464DBB176.title: "The Alchemist's Shop"
	quest.31625BC464DBB176.quest_subtitle: "Potions for the whole group"
	quest.31625BC464DBB176.quest_desc: [
		"Set up a potion display for your friends. Everyone needs you — from cook to warrior."
		"&lTip:&r milk clears every effect, good or bad. Carry a bucket for emergencies."
	]
	quest.11474F8C95A5E393.title: "The Potion of Healing"
	quest.11474F8C95A5E393.quest_desc: [
		"Glistering melon (from the gardener) → healing potions. A must in every warrior's bag."
	]
	quest.7C9D175FDA380D93.title: "Fire Resistance"
	quest.7C9D175FDA380D93.quest_desc: [
		"Magma cream → fire resistance. Your pass to the Nether and lava fishing."
	]
	quest.4FB4B154BE3A7A58.title: "Night Vision"
	quest.4FB4B154BE3A7A58.quest_desc: [
		"Golden carrot → night vision. Miners and anglers will thank you."
	]
	quest.4D893299F364F7FE.title: "Longer and Stronger"
	quest.4D893299F364F7FE.quest_desc: [
		"Redstone extends a potion, glowstone strengthens it, gunpowder makes it splash, dragon's breath makes it linger."
	]
	quest.4FCD47C6DC0C521C.title: "Milk, the Universal Cure"
	quest.4FCD47C6DC0C521C.quest_desc: [
		"A bucket of milk clears every effect. Every world debuff has at least two counters — and milk is always one of them."
	]
	quest.51730512DD377681.title: "The Witch's Cauldron"
	quest.51730512DD377681.quest_desc: [
		"Toil and Trouble turns the plain cauldron into an alchemical one: fill it with milk, honey or slime and brew mixtures."
	]
	chapter.7D28E0E94CE0CCF8.title: "Adventure"
	chapter.7D28E0E94CE0CCF8.chapter_subtitle: [
		"Dungeons, dimensions and bosses — when you want them"
	]
	quest.483595C3466D106D.title: "On the Road"
	quest.483595C3466D106D.quest_subtitle: "Sword, shield and food"
	quest.483595C3466D106D.quest_desc: [
		"&lWhat:&r this chapter is for adventure seekers. Everything here is in &lzones 2–3&r: wilds, dungeons, dimensions."
		"&lHow to prepare:&r sword, shield, armour, buff food from the cook, potions from the alchemist, a return scroll."
		"Chest loot is per player — go as a group."
	]
	quest.11213DE6310C1D6A.title: "The First Dungeon"
	quest.11213DE6310C1D6A.quest_subtitle: "YUNG's, When Dungeons Arise, Dungeons and Taverns"
	quest.11213DE6310C1D6A.quest_desc: [
		"Dozens of new structures dot the world: dungeons, towers, ships, temples, taverns."
		"Find any of them and empty at least one chest. Taverns are safe — rest there."
	]
	quest.16E1CA1EF5B21B46.title: "The Nether's Heat"
	quest.16E1CA1EF5B21B46.quest_subtitle: "Zone 3"
	quest.16E1CA1EF5B21B46.quest_desc: [
		"Build an obsidian portal and step through. Inside: blazes for Create, quartz for AE2, nether cuisine and fortresses."
		"&lTip:&r fire resistance (or Forge Heat) saves lives."
	]
	quest.739285040B5B0234.title: "The Twilight Forest"
	quest.739285040B5B0234.quest_subtitle: "Eternal dusk and a chain of bosses"
	quest.739285040B5B0234.quest_desc: [
		"&lHow to get there:&r throw a diamond into a pool ringed with flowers — a portal opens."
		"The Twilight Forest is a whole dimension with progression: Naga → Lich → Hydra → Minoshroom → Knight Phantoms → Ur-Ghast → Yeti → Snow Queen."
		"Each boss unlocks the next part of the forest."
	]
	quest.5435E49C41CDE3FF.title: "The Naga"
	quest.5435E49C41CDE3FF.quest_subtitle: "The first guardian"
	quest.5435E49C41CDE3FF.quest_desc: [
		"A giant serpent in a stone courtyard. Stay clear of her charge and hit her sides."
	]
	quest.4B8828721D42DE2A.title: "The Lich"
	quest.4B8828721D42DE2A.quest_subtitle: "The dark mage's tower"
	quest.4B8828721D42DE2A.quest_desc: [
		"The Lich hides behind shields and decoys. Break the shields — then hit the real one. Your group's mages shine here."
	]
	quest.3407660309397086.title: "The Hydra"
	quest.3407660309397086.quest_subtitle: "The fire swamp"
	quest.3407660309397086.quest_desc: [
		"A three-headed hydra in the fire swamp. Fire resistance is a must. The reward: fiery blood for the forest's best armour."
	]
	quest.29EFEF68F03D66A9.title: "The Aether"
	quest.29EFEF68F03D66A9.quest_subtitle: "Islands in the sky"
	quest.29EFEF68F03D66A9.quest_desc: [
		"&lHow to get there:&r a glowstone frame and a water bucket. The Aether is a sky of clouds and floating islands."
		"It has its own ores, rideable moas and sky dungeons with Valkyries."
	]
	quest.3020E46100BB3368.title: "The Slider"
	quest.3020E46100BB3368.quest_subtitle: "The bronze dungeon"
	quest.3020E46100BB3368.quest_desc: [
		"The stone cube guarding the bronze dungeon. Don't stand in its way."
	]
	quest.22E49A43159B2841.title: "The Undergarden"
	quest.22E49A43159B2841.quest_subtitle: "A world below"
	quest.22E49A43159B2841.quest_desc: [
		"A gloomy underground dimension of giant fungi and strange beasts. The portal uses stone bricks and a catalyst."
	]
	quest.241D0F92C3E12524.title: "The Otherside"
	quest.241D0F92C3E12524.quest_subtitle: "Deeper and Darker"
	quest.241D0F92C3E12524.quest_desc: [
		"Beyond the portal in an Ancient City lies the sculk dimension. Quiet: here, every step is heard."
	]
	quest.5191867CC65E64EB.title: "The Bee Dimension"
	quest.5191867CC65E64EB.quest_subtitle: "The Bumblezone"
	quest.5191867CC65E64EB.quest_desc: [
		"Throw an ender pearl into a bee nest — and you're in a world of honey and comb. Don't anger the bees!"
	]
	quest.256C62572DAB7621.title: "Cataclysm"
	quest.256C62572DAB7621.quest_subtitle: "L_Ender's Cataclysm bosses"
	quest.256C62572DAB7621.quest_desc: [
		"Giant bosses in special structures: the Netherite Monstrosity, Ignis, the Ender Guardian, the Leviathan…"
		"The peak of the combat branch. Prepare seriously: best armour, food, potions, friends."
	]
	quest.662910273F2B230B.title: "The Iron Knight"
	quest.662910273F2B230B.quest_subtitle: "Mowzie's Mobs"
	quest.662910273F2B230B.quest_desc: [
		"The Ferrous Wroughtnaut sleeps in an underground hall. Hit his back when his axe gets stuck in the floor."
	]
	quest.38AEAB79267D768C.title: "The Ice Sea"
	quest.38AEAB79267D768C.quest_subtitle: "Aquamirae"
	quest.38AEAB79267D768C.quest_desc: [
		"Ghost ships stand in the frozen seas. Captain Cornelia waits on one of them. Cold, scary, beautiful."
	]
	quest.5814EB842FA7B370.title: "The End"
	quest.5814EB842FA7B370.quest_subtitle: "The dragon awaits"
	quest.5814EB842FA7B370.quest_desc: [
		"Find a stronghold with an End portal. The dragon is the classic trial; beyond it lie the End islands with chorus and shulkers."
	]
	quest.20B6AA7E95CCB7D5.title: "Hero of Arkhaven"
	quest.20B6AA7E95CCB7D5.quest_subtitle: "Three worlds conquered"
	quest.20B6AA7E95CCB7D5.quest_desc: [
		"The Nether, the Twilight Forest and the Aether are behind you. Boss trophies feed the &lGreat Works&r — bring them home."
	]
	quest.1957C1B40843F000.title: "A Roadside Tavern"
	quest.1957C1B40843F000.quest_desc: [
		"Dungeons and Taverns: the world has taverns with traders and maps to dungeons. A safe place to rest."
	]
	quest.5A77759DFBE67C95.title: "Living Villages"
	quest.5A77759DFBE67C95.quest_desc: [
		"CTOV villages differ in every biome, and MCA villagers have names and personalities. Make friends."
	]
	quest.1259337CB58F1C9E.title: "Ironwood"
	quest.1259337CB58F1C9E.quest_desc: [
		"Ironwood ingots make the Twilight Forest's first armour."
	]
	quest.2E1D43BB1E766B59.title: "The Minoshroom"
	quest.2E1D43BB1E766B59.quest_desc: [
		"A labyrinth under the swamp, and at its heart the Minoshroom. Its axe is a great weapon."
	]
	quest.3900D125095728FD.title: "The Knight Phantoms"
	quest.3900D125095728FD.quest_desc: [
		"The phantom knights' stronghold. Knightmetal makes the forest's toughest armour."
	]
	quest.5AA2916146AB0FE5.title: "The Ur-Ghast"
	quest.5AA2916146AB0FE5.quest_desc: [
		"The Dark Tower and its weeping guardian. Its tears forge fiery ingots."
	]
	quest.78AFBA41AFAA0319.title: "The Twilight Snows"
	quest.78AFBA41AFAA0319.quest_desc: [
		"The Alpha Yeti and the Snow Queen — the finale of the forest's frozen lands."
	]
	quest.73113DD67E148277.title: "Zanite"
	quest.73113DD67E148277.quest_desc: [
		"The Aether's blue gemstone. Zanite tools get stronger as they wear."
	]
	quest.0B1C9822CA3D917F.title: "The Valkyrie Queen"
	quest.0B1C9822CA3D917F.quest_desc: [
		"The silver dungeon and its queen. Her lance strikes from far away."
	]
	quest.13F13D09D97F5AFC.title: "The Sun Spirit"
	quest.13F13D09D97F5AFC.quest_desc: [
		"The Aether's gold dungeon and its fiery master. The sky world's finale."
	]
	quest.7D35BB7FBDAEF93B.title: "Undergarden Metals"
	quest.7D35BB7FBDAEF93B.quest_desc: [
		"Cloggrum, froststeel and forgotten metal — they make weapons against Undergarden beasts."
	]
	quest.3D37C20ACFC1671F.title: "The Reinforced Echo Shard"
	quest.3D37C20ACFC1671F.quest_desc: [
		"The Otherside's most precious prize. It makes gear stronger than netherite."
	]
	quest.20D49507FD947801.title: "Ignis"
	quest.20D49507FD947801.quest_desc: [
		"The flaming knight of the Burning Arena. Ignitium armour — fire resistance forever."
	]
	quest.665F15D3591B91CB.title: "The Ender Guardian"
	quest.665F15D3591B91CB.quest_desc: [
		"An ancient golem guards ruins in the End. Go as a group."
	]
	quest.591B863A25456EA2.title: "The Leviathan"
	quest.591B863A25456EA2.quest_desc: [
		"The monster of the sunken city. Don't go without Sea Wolf and water breathing."
	]
	quest.5CDB9F3F46E94031.title: "The Frostmaw"
	quest.5CDB9F3F46E94031.quest_desc: [
		"A giant snow beast sleeps in the frozen wastes. Its ice crystal grants frost breath."
	]
	quest.34C186A7C66EB616.title: "Umvuthi"
	quest.34C186A7C66EB616.quest_desc: [
		"The chief of masks in the savanna. The Sol Visage unleashes solar strikes."
	]
	quest.2D00EB21A23B01B1.title: "Lord Pumpkinhead"
	quest.2D00EB21A23B01B1.quest_desc: [
		"Born in Chaos: a Halloween rider appears in the wilds at night. Scary and fun."
	]
	quest.1079865D0DAE982A.title: "Honey Crystals"
	quest.1079865D0DAE982A.quest_desc: [
		"Honey crystals grow in the Bumblezone — for decor and potions."
	]
	chapter.6C18F64911A2B1CF.title: "Bosses"
	chapter.6C18F64911A2B1CF.chapter_subtitle: [
		"Every boss in the pack by difficulty: where, how, and what they drop"
	]
	quest.4410202D5D65CC82.title: "How to Go Boss Hunting"
	quest.4410202D5D65CC82.quest_subtitle: "Preparation wins"
	quest.4410202D5D65CC82.quest_desc: [
		"&lFood:&r buff dishes from «Kitchen» (+health, +regeneration) matter more than armour."
		"&lPotions:&r Arkhaven alchemy: Fire Skin, Sea Wolf, Star Sight."
		"&lTeam:&r most bosses are tuned for 2–4 players; voice chat: hold Caps Lock."
		"&lDeath isn't scary:&r your items stay in a grave (Gravestone), shown on the map."
		"The first bosses (Naga, Lich, Hydra…) are in «Adventure»; here are the rest, from easy to terrifying."
	]
	quest.1F2BDC9B56A66070.title: "Elder Guardian"
	quest.1F2BDC9B56A66070.quest_subtitle: "Ocean monument (YUNG's)"
	quest.1F2BDC9B56A66070.quest_desc: [
		"&lWhere:&r the ocean monument, now large and mazy (YUNG's Better Ocean Monuments)."
		"&lHow:&r water breathing + Sea Wolf potion, an Efficiency pickaxe against Mining Fatigue."
		"&lDrops:&r sponges and the way to the gold vault."
	]
	quest.7FDA77FBFA63A374.title: "Sea Cliff Naga"
	quest.7FDA77FBFA63A374.quest_subtitle: "Mowzie's Mobs"
	quest.7FDA77FBFA63A374.quest_desc: [
		"&lWhere:&r sea cliffs on coasts: a flying serpent that spits acid."
		"&lHow:&r a bow or a gun: you can't reach it in melee. When it lands after a volley, strike."
		"&lDrops:&r a naga fang: a dagger that hits twice as hard from behind."
	]
	quest.6D48B66E9EDD2995.title: "The Harbinger"
	quest.6D48B66E9EDD2995.quest_subtitle: "L_Ender's Cataclysm"
	quest.6D48B66E9EDD2995.quest_desc: [
		"&lWhere:&r the Ancient Factory deep underground. A mechanical challenge with a mechanical answer."
		"&lHow:&r keep distance and hide behind pillars from missiles; enchanted arrows and the Create potato cannon work well."
		"&lDrops:&r a shoulder launcher that fires wither missiles."
	]
	quest.1FE4D8FDD4016F78.title: "Ancient Remnant"
	quest.1FE4D8FDD4016F78.quest_subtitle: "Cursed Pyramid"
	quest.1FE4D8FDD4016F78.quest_desc: [
		"&lWhere:&r the Cursed Pyramid in the desert, past poison dart traps and cave-ins."
		"&lHow:&r jump over sand shockwaves; a shield against the summoned rhino charge."
		"&lDrops:&r the desert necklace and Wrath of the Desert: a sandstorm in a bottle."
	]
	quest.5EB85EE4DB2B3D9C.title: "Maledictus"
	quest.5EB85EE4DB2B3D9C.quest_subtitle: "Frosted Prison"
	quest.5EB85EE4DB2B3D9C.quest_desc: [
		"&lWhere:&r the Frosted Prison in snowy mountains."
		"&lHow:&r fire weapons and Fire Skin; he teleports behind you: listen for the sound."
		"&lDrops:&r the cursed bow and materials for cursium armour."
	]
	quest.3EB7C64998CAB5DA.title: "Scylla"
	quest.3EB7C64998CAB5DA.quest_subtitle: "The Acropolis in a storm"
	quest.3EB7C64998CAB5DA.quest_desc: [
		"&lWhere:&r the Acropolis, an island in the ocean. The fight happens in a thunderstorm: lightning hits the water."
		"&lHow:&r stay out of the water during the storm and keep away from her trident."
		"&lDrops:&r Ceraunus: a lightning harpoon."
	]
	quest.2255F1DB63D8BF05.title: "Forgotten Guardian"
	quest.2255F1DB63D8BF05.quest_subtitle: "The Undergarden"
	quest.2255F1DB63D8BF05.quest_desc: [
		"&lWhere:&r the Undergarden catacombs: a faceless stone giant."
		"&lHow:&r only heavy weapons crack its armour; step back when it raises its arm."
		"&lDrops:&r forgotten ingots, the best metal of the Undergarden."
	]
	quest.398E5ED307D56633.title: "The Warden"
	quest.398E5ED307D56633.quest_subtitle: "The Ancient City"
	quest.398E5ED307D56633.quest_desc: [
		"&lYou can skip the fight:&r the Warden is blind and hunts by sound. Wool on the floor, sneaking, and it won't hear you."
		"&lIf you do fight:&r 500 health, armour-piercing hits and a sonic boom through walls. Team only, with strength potions."
		"&lDrops:&r the Warden carapace: Deeper Darker armour that muffles your steps."
	]
	quest.722992FA95424743.title: "The Stalker"
	quest.722992FA95424743.quest_subtitle: "The Otherside"
	quest.722992FA95424743.quest_desc: [
		"&lWhere:&r the Ancient Temple on the Otherside (Deeper Darker): a Warden's relative that can see."
		"&lHow:&r light and noise are useless against it, only force. Resonarium weapons cut through sculk."
		"&lDrops:&r the way to soul elytra: wings that take off by themselves."
	]
	quest.5674AA37716E1DFD.title: "Lord of Flame"
	quest.5674AA37716E1DFD.quest_subtitle: "Iron's Spells"
	quest.5674AA37716E1DFD.quest_desc: [
		"&lWhere:&r the pyromancer tower (Iron's Spells): watch your map."
		"&lHow:&r ice and water spells, Fire Skin and a shield against fireballs."
		"&lDrops:&r high-tier fire school spellbooks."
	]
	quest.41A4DAE8E0472BDE.title: "Wilden Chimera"
	quest.41A4DAE8E0472BDE.quest_subtitle: "Ars Nouveau"
	quest.41A4DAE8E0472BDE.quest_desc: [
		"&lWhere:&r summoned by the Wilden Summon ritual: the fight is in your back yard, if you like."
		"&lHow:&r Harm + Amplify spells, step aside from the charge; the chimera has three phases."
		"&lDrops:&r the Wilden Tribute, key to archmage relics."
	]
	quest.0469A33BAB569676.title: "The Headless Lord"
	quest.0469A33BAB569676.quest_subtitle: "Born in Chaos"
	quest.0469A33BAB569676.quest_desc: [
		"&lWhere:&r a rare night rider of the wilds: zone rules keep him away from spawn and bases."
		"&lHow:&r light and holy weapons; his steed is stronger than the rider: take the horse first."
		"&lDrops:&r Soulbane, a life-stealing sword."
	]
	quest.176452C5B53F2D70.title: "The Maw of the Ice Sea"
	quest.176452C5B53F2D70.quest_subtitle: "Aquamirae"
	quest.176452C5B53F2D70.quest_desc: [
		"&lWhere:&r the icy seas of Aquamirae, where the ghost ships sail."
		"&lHow:&r from a Small Ships ship, with cannons; better not jump into the water with it."
		"&lDrops:&r abyssal amethyst for abyssal armour."
	]
	quest.221D262C7B1A153F.title: "Monster Hunter"
	quest.221D262C7B1A153F.quest_subtitle: "Eight great victories"
	quest.221D262C7B1A153F.quest_desc: [
		"You've beaten the ones they tell stories about in taverns. Hang a trophy (Handcrafted) in your hall so newcomers know whom to ask for advice."
		"&lRematch:&r the Boss Respawner (Cataclysm) brings a beaten boss back to its lair."
	]
	chapter.67DBF023F7901684.title: "Dungeons and Structures"
	chapter.67DBF023F7901684.chapter_subtitle: [
		"Find it, enter it, survive: personal loot in every chest"
	]
	quest.124FA016AD13E65C.title: "How to Find Dungeons"
	quest.124FA016AD13E65C.quest_subtitle: "Maps, Lootr and zones"
	quest.124FA016AD13E65C.quest_desc: [
		"&lWhy:&r dungeons hold the best gear without grinding: spellbooks, gunpowder, steel, rare seeds."
		"&lHow to find them:&r cartographers sell maps, Xaero marks what you've found, and wandering is more fun than a compass."
		"&lLootr:&r a chest looks shared, but each player gets their own loot. Came second? You still find yours."
		"&lA quest completes&r when you stand inside the structure."
	]
	quest.398D7D0D31B16A8C.title: "A Roadside Tavern"
	quest.398D7D0D31B16A8C.quest_subtitle: "Dungeons & Taverns"
	quest.398D7D0D31B16A8C.quest_desc: [
		"A safe spot: an innkeeper, a cartographer and a board of maps to nearby dungeons. A good first travel goal."
		"Taverns appear in every forest; the oak one counts for this quest."
	]
	quest.3DC14FDAB04AB0DE.title: "Skeleton Crypt"
	quest.3DC14FDAB04AB0DE.quest_subtitle: "YUNG's Better Dungeons"
	quest.3DC14FDAB04AB0DE.quest_desc: [
		"An underground crypt with several halls and spawners. &lTip:&r break the spawner or light it up all around."
		"Good practice before the big dungeons."
	]
	quest.1DD3D00D98540144.title: "Abandoned Mineshaft"
	quest.1DD3D00D98540144.quest_subtitle: "YUNG's Better Mineshafts"
	quest.1DD3D00D98540144.quest_desc: [
		"Mineshafts are big now: loot minecarts, ladders, cave-ins. Ores show in the walls: bring a good pickaxe."
	]
	quest.14590C32AE474724.title: "Illager Camp"
	quest.14590C32AE474724.quest_subtitle: "TaCZ shooters"
	quest.14590C32AE474724.quest_desc: [
		"Camp illagers are often armed with &lfirearms&r (TaCZ NPCs): pistols and rifles. Approach from cover."
		"&lLoot:&r their gun sometimes drops: a free firearm."
	]
	quest.24FE42BA2A7CCC9B.title: "Illager Fort"
	quest.24FE42BA2A7CCC9B.quest_subtitle: "When Dungeons Arise"
	quest.24FE42BA2A7CCC9B.quest_desc: [
		"A fortress with towers and dozens of illagers, more than half with guns. This is an assault: bring a team, healing and armour."
		"&lTactics:&r pick off the wall shooters from afar (a TaCZ sniper), then breach the gate."
	]
	quest.6A4762E3C93C0B5B.title: "Illager Galley"
	quest.6A4762E3C93C0B5B.quest_subtitle: "Boarding"
	quest.6A4762E3C93C0B5B.quest_desc: [
		"An illager ship on the open sea. Sail up in your Small Ships ship, fire a broadside and board it (grappling hook from «Weapons»)."
	]
	quest.6EBAA1CC314A251D.title: "Bandit Village"
	quest.6EBAA1CC314A251D.quest_subtitle: "When Dungeons Arise"
	quest.6EBAA1CC314A251D.quest_desc: [
		"Bandits have taken a village on stilts. Shooters on the roofs, traps on the walkways. Loot: gunpowder, steel, gold."
	]
	quest.1AA7A9B0DC93023F.title: "Mining System"
	quest.1AA7A9B0DC93023F.quest_subtitle: "When Dungeons Arise"
	quest.1AA7A9B0DC93023F.quest_desc: [
		"A huge mine with lifts and minecarts. Spiders and zombie miners inside, and rich chests of ore and tools at the end."
	]
	quest.67026509AEC7D314.title: "The Foundry"
	quest.67026509AEC7D314.quest_subtitle: "Fire and lava"
	quest.67026509AEC7D314.quest_desc: [
		"An abandoned steelworks: lava streams and fire mobs. &lBring:&r Fire Skin or fire resistance."
		"&lReward:&r ingots and metal blocks, a boost for engineers."
	]
	quest.33B479E1E8E88664.title: "Monastery"
	quest.33B479E1E8E88664.quest_subtitle: "When Dungeons Arise"
	quest.33B479E1E8E88664.quest_desc: [
		"A mountain monastery with a library. &lFor mages:&r enchanted books and Ars Nouveau ingredients."
	]
	quest.68FD7B1F449B1EB6.title: "Plague Asylum"
	quest.68FD7B1F449B1EB6.quest_subtitle: "Bring an antidote"
	quest.68FD7B1F449B1EB6.quest_desc: [
		"A grim hospital in the swamp: poison at every step. &lBring:&r milk and Clean Breath from Arkhaven alchemy."
	]
	quest.0829E4B42B4D1A82.title: "Thornborn Towers"
	quest.0829E4B42B4D1A82.quest_subtitle: "When Dungeons Arise"
	quest.0829E4B42B4D1A82.quest_desc: [
		"Towers wrapped in thorns, and their guardians. The climb itself is a trial: a grappling hook helps a lot."
	]
	quest.1BAE5339A9DDE90E.title: "Heavenly Challenger"
	quest.1BAE5339A9DDE90E.quest_subtitle: "A dungeon in the clouds"
	quest.1BAE5339A9DDE90E.quest_desc: [
		"A flying fortress far above the ground. Reach it by airship, plane or elytra: there's only a drop below."
	]
	quest.0DD810CD0C1C7B8F.title: "Undead Pirate Ship"
	quest.0DD810CD0C1C7B8F.quest_subtitle: "When Dungeons Arise"
	quest.0DD810CD0C1C7B8F.quest_desc: [
		"A ghost pirate ship crewed by skeletons. The captain's cabin holds the best treasure of the sea."
	]
	quest.322941DAB346E48E.title: "Shiraz Palace"
	quest.322941DAB346E48E.quest_subtitle: "The richest dungeon"
	quest.322941DAB346E48E.quest_desc: [
		"A huge desert palace: several floors, guards, traps and a treasury. Go with at least three."
	]
	quest.2F44F8C0075501B1.title: "Mage Catacombs"
	quest.2F44F8C0075501B1.quest_subtitle: "Iron's Spells"
	quest.2F44F8C0075501B1.quest_desc: [
		"Underground catacombs with necromancers. Scrolls and spellbooks: the main loot for mages."
	]
	quest.31BFEC0EEAA7251A.title: "The Citadel"
	quest.31BFEC0EEAA7251A.quest_subtitle: "The Dead King's lair"
	quest.31BFEC0EEAA7251A.quest_desc: [
		"A dark citadel, home of the Dead King (quest in the «Iron's Spells» chapter). Loot: rare runes and mithril scrolls."
	]
	quest.682C987E312106E8.title: "Sunken City"
	quest.682C987E312106E8.quest_subtitle: "The Leviathan's lair"
	quest.682C987E312106E8.quest_desc: [
		"A city on the ocean floor, with the way to the Leviathan. &lBring:&r water breathing for the whole team and a trident."
	]
	quest.65DEA3AA471B1627.title: "Ancient Factory"
	quest.65DEA3AA471B1627.quest_subtitle: "The Harbinger's lair"
	quest.65DEA3AA471B1627.quest_desc: [
		"A mechanical dungeon deep underground: the road to the Harbinger from the «Bosses» chapter."
	]
	quest.1D9ABAB93B21593F.title: "The Labyrinth"
	quest.1D9ABAB93B21593F.quest_subtitle: "Twilight Forest"
	quest.1D9ABAB93B21593F.quest_desc: [
		"An underground labyrinth beneath the swamp. A maze map (made from a map and a maze core) shows the way to the Minoshroom."
	]
	quest.0233DEB78E99055C.title: "Hive Temple"
	quest.0233DEB78E99055C.quest_subtitle: "Bumblezone"
	quest.0233DEB78E99055C.quest_desc: [
		"The heart of the bee dimension. Don't anger the bees: wear bee armour and keep honey handy."
	]
	quest.57FDCFE312B601D6.title: "Bronze Dungeon"
	quest.57FDCFE312B601D6.quest_subtitle: "The Aether"
	quest.57FDCFE312B601D6.quest_desc: [
		"The first Aether dungeon, home of the Slider. Its key opens the reward chest."
	]
	quest.6493D15E22B26AAA.title: "Brass Dungeon"
	quest.6493D15E22B26AAA.quest_subtitle: "Deep Aether"
	quest.6493D15E22B26AAA.quest_desc: [
		"A Deep Aether dungeon with mechanical guardians. Loot: Stormforged armour templates."
	]
	quest.41271CF75F0F514B.title: "Ancient Temple"
	quest.41271CF75F0F514B.quest_subtitle: "The Otherside"
	quest.41271CF75F0F514B.quest_desc: [
		"A temple deep in the Otherside: silence is mandatory. Loot: the Heart of the Deep and the way to the Stalker."
	]
	quest.18D1F60CD2B50700.title: "End Castle"
	quest.18D1F60CD2B50700.quest_subtitle: "Dungeons & Taverns"
	quest.18D1F60CD2B50700.quest_desc: [
		"A castle on the far End islands: shulkers, chests, and a road to elytra if you haven't found an End city yet."
	]
	quest.5A9C5F24AD35D296.title: "Tomb Raider"
	quest.5A9C5F24AD35D296.quest_subtitle: "Nine great dungeons"
	quest.5A9C5F24AD35D296.quest_desc: [
		"You've seen the heavens and the depths of this world. Share your finds on the map (Xaero → waypoints → share) so friends can follow."
	]
	chapter.3E92433C873CD4AC.title: "Other Worlds"
	chapter.3E92433C873CD4AC.chapter_subtitle: [
		"What to gather in each dimension, and why to come back"
	]
	quest.2D77445198E97346.title: "A Map of Worlds"
	quest.2D77445198E97346.quest_subtitle: "Where and why"
	quest.2D77445198E97346.quest_desc: [
		"&lThe Aether&r (sky islands): light metals, flight, gentle animals. &lDeep Aether&r extends it with its own ores."
		"&lThe Undergarden&r (below bedrock): dark caves, the best armour metals."
		"&lThe Bumblezone&r: bees, honey, royal jelly."
		"&lThe Otherside&r (through a sculk portal): dangerous, but it has Warden armour."
		"&lThe Twilight Forest&r: a chain of bosses («Adventure»). &lThe End&r: elytra, shulkers, the void."
	]
	quest.330A2A98C519162A.title: "Skyjade"
	quest.330A2A98C519162A.quest_subtitle: "Deep Aether"
	quest.330A2A98C519162A.quest_desc: [
		"A Deep Aether ore. It makes light, fast tools and armour, a step between zanite and stormforged gear."
	]
	quest.266F8321887A4C29.title: "Stratus"
	quest.266F8321887A4C29.quest_subtitle: "Cloud armour"
	quest.266F8321887A4C29.quest_desc: [
		"Stratus armour makes you faster in the sky. Good for exploring the Aether by airship or on foot over the clouds."
	]
	quest.2F5CB4C9BE71E92E.title: "Aerwhale Saddle"
	quest.2F5CB4C9BE71E92E.quest_subtitle: "A flying mount"
	quest.2F5CB4C9BE71E92E.quest_desc: [
		"The Aether's aerwhale drifts peacefully through the air. With a saddle you can ride it: slow, but beautiful."
	]
	quest.41B2832A942564A8.title: "Cloggrum"
	quest.41B2832A942564A8.quest_subtitle: "The Undergarden"
	quest.41B2832A942564A8.quest_desc: [
		"The Undergarden's first metal, sturdier than iron. Next come froststeel and utherium, each with a bonus against local monsters."
	]
	quest.4A7C65037569EC58.title: "Utherium"
	quest.4A7C65037569EC58.quest_subtitle: "Against the rotten"
	quest.4A7C65037569EC58.quest_desc: [
		"Utherium weapons hit Undergarden rotspawn harder: take one to the catacombs."
	]
	quest.557D7ED45056F22C.title: "Gloomgourd"
	quest.557D7ED45056F22C.quest_subtitle: "Food without sun"
	quest.557D7ED45056F22C.quest_desc: [
		"There's no sun in the Undergarden, but it has its own crops. The gloomgourd is the base of local cuisine (pie!) and food variety."
	]
	quest.1AD3AAF02A0AEC65.title: "Royal Jelly"
	quest.1AD3AAF02A0AEC65.quest_subtitle: "Bumblezone"
	quest.1AD3AAF02A0AEC65.quest_desc: [
		"The Bumblezone's most valuable prize. Used for bee armour and tonics, and Productive Bees keepers need it for rare breeds."
	]
	quest.538CE3778B5E486F.title: "Bee Armour"
	quest.538CE3778B5E486F.quest_subtitle: "One of the hive"
	quest.538CE3778B5E486F.quest_desc: [
		"Bee armour calms the bees and helps you stay airborne (details in the item tooltips). The full set is your pass to the deepest hives."
	]
	quest.327022E9A286F5E3.title: "Essence of the Bees"
	quest.327022E9A286F5E3.quest_subtitle: "Sanctum trials"
	quest.327022E9A286F5E3.quest_desc: [
		"Bumblezone sanctums run trials: beat one and you get an essence. Its effect is in the item tooltip."
	]
	quest.774EC0F3488A630B.title: "Reinforced Echo Shard"
	quest.774EC0F3488A630B.quest_subtitle: "Deeper Darker"
	quest.774EC0F3488A630B.quest_desc: [
		"Echo shards from the Otherside: material for portals and upgrades. Gather them quietly: any noise calls the sculk guardians."
	]
	quest.07ACEBF0D34DBEB0.title: "Resonarium"
	quest.07ACEBF0D34DBEB0.quest_subtitle: "A sound metal"
	quest.07ACEBF0D34DBEB0.quest_desc: [
		"A metal that resonates with sound. Resonarium tools cut sculk, and the armour muffles your steps."
	]
	quest.7C11137082F10408.title: "Warden Armour"
	quest.7C11137082F10408.quest_subtitle: "Better than netherite"
	quest.7C11137082F10408.quest_desc: [
		"An upgrade of netherite armour at a smithing table (recipe in EMI). Tougher than netherite, and it makes you quieter."
	]
	quest.3CC5C3F80E21EBE7.title: "Shulker Shells"
	quest.3CC5C3F80E21EBE7.quest_subtitle: "The End"
	quest.3CC5C3F80E21EBE7.quest_desc: [
		"Shulker boxes are portable chests. Everyone loves them: builders, miners, travellers. Hunt in End cities and Dungeons & Taverns castles."
	]
	quest.1CC4A7924CB673E5.title: "Elytra"
	quest.1CC4A7924CB673E5.quest_subtitle: "Wings"
	quest.1CC4A7924CB673E5.quest_desc: [
		"Elytra from an End ship. Rockets, Mending, and you fly anywhere. The End islands are more varied now (Nullscape): search far from the centre."
	]
	quest.2B5661B8607D6510.title: "World Wanderer"
	quest.2B5661B8607D6510.quest_subtitle: "Been everywhere, seen everything"
	quest.2B5661B8607D6510.quest_desc: [
		"Sky, abyss, hive, silence and void. Put a waystone at every portal: the next traveller will thank you."
	]
	chapter.4499A461977E88CA.title: "Weapons & Gear"
	chapter.4499A461977E88CA.chapter_subtitle: [
		"Swords, guns, cannons and grappling hooks"
	]
	quest.2840277D460DBE04.title: "Combat with Flair"
	quest.2840277D460DBE04.quest_subtitle: "Better Combat + Simply Swords"
	quest.2840277D460DBE04.quest_desc: [
		"&lWhat:&r attacks here are animated with combos: a longsword sweeps wide, a dagger is quick, a hammer is heavy."
		"A &lroll&r (Combat Roll) dodges a blow — check its key in &oControls&r."
		"Try different weapons: katana, glaive, scythe, twinblades…"
	]
	quest.124CE8EC4DA83696.title: "The Greathammer"
	quest.124CE8EC4DA83696.quest_subtitle: "Slow but loud"
	quest.124CE8EC4DA83696.quest_desc: [
		"A two-handed hammer hits an area. Great against crowds, poor against fast enemies."
	]
	quest.2EFA1764B6C5AA28.title: "The Gunsmith's Workshop"
	quest.2EFA1764B6C5AA28.quest_subtitle: "TaCZ"
	quest.2EFA1764B6C5AA28.quest_desc: [
		"&lWhat:&r firearms — pistols, rifles, shotguns — with scopes, attachments and reloading."
		"The &lgunsmith table&r builds guns, ammo and attachments. Metal and powder come from the &lengineer&r."
		"&lNote:&r PvP is off — guns are for mobs and bosses."
	]
	quest.00E19FD18B738F02.title: "An Ammo Box"
	quest.00E19FD18B738F02.quest_subtitle: "Don't carry them loose"
	quest.00E19FD18B738F02.quest_desc: [
		"An ammo box holds one calibre and feeds it on reload. Saves inventory space."
	]
	quest.0CFB5AA571596797.title: "A Big Cannon"
	quest.0CFB5AA571596797.quest_subtitle: "Create Big Cannons"
	quest.0CFB5AA571596797.quest_desc: [
		"Cannons are cast in moulds, assembled on a mount and loaded with shot and powder charges. Aiming uses Create rotation."
		"Put one on an airship and you have a &lwarship&r. Great for defending a colony from raids, too."
	]
	quest.1E2EBF13C6F879A0.title: "The Grappling Hook"
	quest.1E2EBF13C6F879A0.quest_subtitle: "An early hook"
	quest.1E2EBF13C6F879A0.quest_desc: [
		"Fire the hook at a block and pull yourself up. Cliffs, ravines, rooftops are no longer obstacles."
		"&lUpgrades&r (at the modifier station): longer rope, double hook, rocket, swing."
	]
	quest.4744E2D0A9C2BFAD.title: "Spider-Style"
	quest.4744E2D0A9C2BFAD.quest_subtitle: "The double hook"
	quest.4744E2D0A9C2BFAD.quest_desc: [
		"With two hooks you can swing between trees and sail over a river. Practise over water!"
	]
	quest.325CD1C1DC34FC14.title: "Board Her!"
	quest.325CD1C1DC34FC14.quest_subtitle: "Hook + airship"
	quest.325CD1C1DC34FC14.quest_desc: [
		"Hook a friend's passing airship and pull yourself aboard. Create ropes also let you build a &lcable car&r"
		"between towers. Tick the quest once you've pulled it off."
	]
	quest.547E7AB1EA5FB62E.title: "The Full Set"
	quest.547E7AB1EA5FB62E.quest_subtitle: "Armour set bonuses"
	quest.547E7AB1EA5FB62E.quest_desc: [
		"A full set of one armour type grants a &lbonus&r: ironwood gives regeneration, knightmetal and steel give resistance, cloggrum gives haste."
		"The bonus is shown in the armour tooltip."
	]
	quest.56E88A8B20052C07.title: "Armed and Dangerous"
	quest.56E88A8B20052C07.quest_subtitle: "Sword, gun, cannon, hook"
	quest.56E88A8B20052C07.quest_desc: [
		"You're ready for anything. Remember the calm zones: home is peaceful; adventure is where you go looking for it."
	]
	quest.2B3DDC04AF68D471.title: "The Katana"
	quest.2B3DDC04AF68D471.quest_desc: [
		"Fast strikes and long combos. For those who love speed."
	]
	quest.50FA3AD9E3473F0B.title: "The Glaive"
	quest.50FA3AD9E3473F0B.quest_desc: [
		"A long polearm — strikes from afar and hits several foes."
	]
	quest.43419A8748AA7E13.title: "The Twinblade"
	quest.43419A8748AA7E13.quest_desc: [
		"Spinning strikes all around you. Good against crowds."
	]
	quest.4E186D831A313D5E.title: "A Diamond Blade"
	quest.4E186D831A313D5E.quest_desc: [
		"Every Simply Swords weapon comes in iron, diamond and netherite. Unique blades hide in dungeons."
	]
	quest.45F020A202618B2C.title: "A Netherite Blade"
	quest.45F020A202618B2C.quest_desc: [
		"An upgrade template + netherite — and a weapon for life."
	]
	quest.508564D2E50AB706.title: "Ammunition"
	quest.508564D2E50AB706.quest_desc: [
		"Ammo is made at the gunsmith table from brass and gunpowder. Ask the engineer to set up a Create line."
	]
	quest.1428749F03E36AA4.title: "Shot and Charges"
	quest.1428749F03E36AA4.quest_desc: [
		"A cannon needs shot and powder charges. More charges mean a longer shot."
	]
	quest.18BE845C1AC2CF5A.title: "The Rocket Hook"
	quest.18BE845C1AC2CF5A.quest_desc: [
		"A rocket pulls you along the rope even faster. Flying over a canyon — unforgettable."
	]
	quest.35DC60B73DD268F7.title: "Long Fall Boots"
	quest.35DC60B73DD268F7.quest_desc: [
		"No fall damage. With a hook — freedom in the mountains."
	]
	chapter.775CEE25F56DFD3E.title: "Firearms and War"
	chapter.775CEE25F56DFD3E.chapter_subtitle: [
		"TaCZ guns, gunner NPCs, artillery, drones"
	]
	quest.3A4404A355E47B8F.title: "Your First Gun"
	quest.3A4404A355E47B8F.quest_subtitle: "TaCZ"
	quest.3A4404A355E47B8F.quest_desc: [
		"&lWhat:&r TaCZ adds realistic guns: pistols, rifles, shotguns, snipers. Recoil, reloads, scopes."
		"&lHow:&r gunsmith table → pick a model → you need steel, gunpowder and parts. Any gun you build completes the quest."
		"&lControls:&r right click to aim, R to reload, G for fire mode, H to inspect, Z for attachments (rebindable in settings)."
		"Guns hurt friends too: PvP is on, mind your line of fire."
	]
	quest.68228C2E9955C382.title: "Shooting Range"
	quest.68228C2E9955C382.quest_subtitle: "Zeroing in"
	quest.68228C2E9955C382.quest_desc: [
		"A target shows damage and distance. Zero in a new gun before taking it into a dungeon: every model has its own spread."
	]
	quest.0C06F2D583FF781C.title: "Attachments"
	quest.0C06F2D583FF781C.quest_subtitle: "Scopes, suppressors, grips"
	quest.0C06F2D583FF781C.quest_desc: [
		"Attachments change stats: a suppressor hides shots from mobs, a red dot speeds up aiming, a grip reduces recoil."
		"Fit them in the attachment menu (Z key)."
	]
	quest.4D1B1A33E90955B0.title: "Ammo Box"
	quest.4D1B1A33E90955B0.quest_subtitle: "The logistics of war"
	quest.4D1B1A33E90955B0.quest_desc: [
		"The box stores ammo and reloads from your inventory. &lAutomation:&r gunpowder and casings can come from a Create line: a mechanical crafter assembles ammo by itself."
	]
	quest.1F01CF3B5A2B8693.title: "Illager Gunners"
	quest.1F01CF3B5A2B8693.quest_subtitle: "TaCZ NPCs"
	quest.1F01CF3B5A2B8693.quest_desc: [
		"Illagers in outposts, camps and forts often carry guns. They take cover and fire bursts like players do."
		"&lWhere:&r only in the wilds: no gunners near spawn and bases."
		"&lLoot:&r sometimes their gun drops."
	]
	quest.6DD0F70D9DDC8C7B.title: "The Mercenary"
	quest.6DD0F70D9DDC8C7B.quest_subtitle: "An armed NPC"
	quest.6DD0F70D9DDC8C7B.quest_desc: [
		"Lone fighters in full gear roam the far lands. Not all are hostile: some stay neutral until you shoot first."
		"Beat one and see what they carried."
	]
	quest.4DDC25AF5DB52DB2.title: "Molotov Cocktail"
	quest.4DDC25AF5DB52DB2.quest_subtitle: "Immersive Petroleum"
	quest.4DDC25AF5DB52DB2.quest_desc: [
		"A bottle of gasoline with a rag, for dungeon crowds. &lCareful:&r fire spreads: don't throw it near other people's houses."
	]
	quest.4740D6790661887D.title: "Flamethrower"
	quest.4740D6790661887D.quest_subtitle: "TFMG"
	quest.4740D6790661887D.quest_desc: [
		"The TFMG flamethrower runs on fuel from your oil rig. TFMG also has copper grenades and a napalm potato cannon."
		"&lRoles meet:&r fuel from the oil worker, steel from the smelter, and the warrior pulls the trigger."
	]
	quest.72E937A5DCECDADE.title: "Steel Artillery"
	quest.72E937A5DCECDADE.quest_subtitle: "Create Big Cannons"
	quest.72E937A5DCECDADE.quest_desc: [
		"Cast iron cannons are step one; steel barrels take more powder and fire further. Cast them in moulds or with the cannon builder."
		"&lWhy:&r against the Leviathan from the shore, against illager forts, and for base defence."
	]
	quest.78978271E0B00221.title: "Autocannon"
	quest.78978271E0B00221.quest_subtitle: "Rapid fire"
	quest.78978271E0B00221.quest_desc: [
		"The autocannon fires bursts of small shells: great air defence for an airship and protection against raids."
	]
	quest.0261EF9E1DEBACDE.title: "Ship Guns"
	quest.0261EF9E1DEBACDE.quest_subtitle: "Small Ships"
	quest.0261EF9E1DEBACDE.quest_desc: [
		"Cannons mount on Small Ships ship sides. Cannonballs, chain shot (tears sails) and grapeshot (against boarders)."
	]
	quest.4334303B4E6E48AE.title: "Wing Gun"
	quest.4334303B4E6E48AE.quest_subtitle: "Immersive Aircraft"
	quest.4334303B4E6E48AE.quest_desc: [
		"The rotary cannon mounts on a plane or gyrodyne. There's a bomb bay too, for those who like levelling illager forts from above."
	]
	quest.2BE9CE783253AEBB.title: "FPV Drone"
	quest.2BE9CE783253AEBB.quest_subtitle: "Create Droneworks"
	quest.2BE9CE783253AEBB.quest_desc: [
		"&lWhat:&r a drone you build yourself from Aeronautics blocks: a drone core, propellers, a camera. Fly it first-person with a remote."
		"&lWhy:&r scout dungeons and forts without risk, deliver cargo, and with a payload it's a kamikaze drone (TNT or a potato cannon on board)."
		"&lHow:&r core + 4 propellers + camera, assemble on a physics assembler and bind the remote."
		"⚠ The mod is young (alpha): keep a schematic of your drone; if it misbehaves, tell the admin."
	]
	quest.3569848A2294DF70.title: "Command Post"
	quest.3569848A2294DF70.quest_subtitle: "Several drones"
	quest.3569848A2294DF70.quest_desc: [
		"A drone hub and a commander seat let you switch between drones: a scout, a hauler and a striker in one team."
	]
	quest.533A846AC076473A.title: "General"
	quest.533A846AC076473A.quest_subtitle: "Land, sea, sky"
	quest.533A846AC076473A.quest_desc: [
		"Infantry, navy, air force and drones. Time to build barracks (Minecolonies) and train guards: nobody takes your colony now."
	]
	chapter.6B5C9EE747778BF3.title: "Elements & Defence"
	chapter.6B5C9EE747778BF3.chapter_subtitle: [
		"A living world — and shelter from all of it"
	]
	quest.7235EB4484D39CEF.title: "How Events Work"
	quest.7235EB4484D39CEF.quest_subtitle: "Fair rules"
	quest.7235EB4484D39CEF.quest_desc: [
		"Events run &lonly while someone is online&r. The first 7 in-game days are quiet, and disasters (meteor strikes, rifts, tornadoes) happen &lat most once every 3 real days&r."
		"No dangerous event &lstarts&r until you finish its \"Meet\" quest here — and the first one is always a tutorial."
		"The &lStar Atlas&r (reward) shows tonight's forecast. An admin can turn on \"vacation\" and the world rests."
	]
	quest.4285D3CEDD0D99B4.title: "The Hearth Stone"
	quest.4285D3CEDD0D99B4.quest_subtitle: "A home enemies don't visit"
	quest.4285D3CEDD0D99B4.quest_desc: [
		"Place the &lHearth Stone&r (reward) by your home — no hostile mobs spawn on their own within 48 blocks."
		"Claims (map → \"Claim\") work the same way. One stone per player: a new one moves the old one."
	]
	quest.3D8147435B400249.title: "The Meteor Shower"
	quest.3D8147435B400249.quest_subtitle: "Meet the event"
	quest.3D8147435B400249.quest_desc: [
		"&lWhat:&r some nights the sky is streaked with meteors. Most burn up; small ones land in &lthe wilds&r."
		"&lWhat to do:&r enjoy the view and look for fallen stones — they hold &lmeteorite ore&r. If one lands in water, a &lstar carp&r may be there."
		"This event is a gift — nothing to fear."
	]
	quest.3E90DEC686D69116.title: "Sky Dust"
	quest.3E90DEC686D69116.quest_subtitle: "Meteorite ore"
	quest.3E90DEC686D69116.quest_desc: [
		"Mine meteorite ore with an iron pickaxe for &lmeteoric dust&r. It makes meteoric iron and &lward crystals&r."
		"&lValued by:&r everyone. It's the explorer's best trade good."
	]
	quest.5A0CC55134D58E8D.title: "The Ward Crystal"
	quest.5A0CC55134D58E8D.quest_subtitle: "Fuel for protection"
	quest.5A0CC55134D58E8D.quest_desc: [
		"Amethyst + meteoric dust: in a heated &lCreate mixer&r (engineer) or an &lArs imbuement chamber&r (mage)."
		"Tier II crystals need both tech and magic — that's where friendship pays off."
	]
	quest.48E5FD47C52B6084.title: "The Ward Generator"
	quest.48E5FD47C52B6084.quest_subtitle: "A dome over your home"
	quest.48E5FD47C52B6084.quest_desc: [
		"&lWhat it does:&r within 32 blocks (II — 64, III — 128) explosions break nothing, meteors burn up mid-air, and from tier II rifts can't open."
		"&lHow:&r place it at your base and insert a crystal (right-click). Fuel burns only while someone is near or an event is running."
		"A redstone signal turns it off. Click with an empty hand for status."
	]
	quest.16A477416AFD3D59.title: "The Meteor Strike"
	quest.16A477416AFD3D59.quest_subtitle: "Meet the event (enables it)"
	quest.16A477416AFD3D59.quest_desc: [
		"&lHow to tell:&r &l10 minutes&r before impact — a title, a bell, a countdown bar and a &lglowing column in the sky&r above the impact site."
		"&lWhat to do:&r don't stand there. A ward over your base burns the meteor up. On gentle intensity (1) it lands near your base, never in claims."
		"&lReward for courage:&r a crater full of meteorite ore. Tick the quest and meteors start falling (the first is a far-off tutorial)."
	]
	quest.3E10FDC1DC810AC2.title: "Rift Night"
	quest.3E10FDC1DC810AC2.quest_subtitle: "Meet the event (enables it)"
	quest.3E10FDC1DC810AC2.quest_desc: [
		"&lWhat:&r some nights &lrifts&r open 60–130 blocks from players. Mobs pour out — but stay within ~30 blocks."
		"&lProtection:&r rifts never open in safe zones or near a &ltier II ward&r. Their mobs vanish at dawn."
		"&lWhy go there:&r when a rift closes it leaves &lrift shards&r — valuable for magic."
	]
	quest.33AFEE95B7509AD8.title: "The Blood Moon"
	quest.33AFEE95B7509AD8.quest_subtitle: "Enhanced Celestials"
	quest.33AFEE95B7509AD8.quest_desc: [
		"&lHow to tell:&r the moon turns red, with a warning at dusk. More mobs that night — but &lonly in the wilds&r."
		"&lWhat to do:&r stay home by the hearth. Or, for the brave, hunt rare drops. There are also &lharvest&r (crop growth) and &lblue&r (luck) moons."
	]
	quest.4ABB671FB9CEB4DA.title: "Storms and Tornadoes"
	quest.4ABB671FB9CEB4DA.quest_subtitle: "Weather, Storms & Tornadoes"
	quest.4ABB671FB9CEB4DA.quest_desc: [
		"&lWhat:&r storm fronts, downpours and &ltornadoes&r roam the world. A tornado lifts blocks and mobs."
		"&lHow to tell:&r a &lweather forecast&r station shows fronts on radar; a &ltornado siren&r howls as one approaches."
		"On gentle intensity tornadoes are rare and weak."
	]
	quest.7749B36585890F81.title: "The Weather Deflector"
	quest.7749B36585890F81.quest_subtitle: "Tornadoes go around your base"
	quest.7749B36585890F81.quest_desc: [
		"The deflector dissolves tornadoes and storms that approach your base. Put it in the middle and sleep soundly."
		"&lTip:&r a tornado siren next to your bed wakes you if something's coming."
	]
	quest.11670169A7E1CD13.title: "Smog and Acid Rain"
	quest.11670169A7E1CD13.quest_subtitle: "Airborne"
	quest.11670169A7E1CD13.quest_desc: [
		"&lHow to tell:&r a grey haze over factories, sickly crops, coughing animals."
		"&lProtection:&r the &lClean Breath&r potion (alchemist), trees and flowers around the factory, electricity instead of diesel."
		"A long-term goal: the &lClear Sky&r project in \"Great Works\"."
	]
	quest.740E2F91D6262E0A.title: "Radiation"
	quest.740E2F91D6262E0A.quest_subtitle: "Mekanism"
	quest.740E2F91D6262E0A.quest_desc: [
		"&lHow to tell:&r the Geiger counter crackles. Radiation only comes from &lnuclear waste&r and reactor accidents."
		"&lProtection:&r a hazmat suit, waste barrels, and the &lLead Blood&r potion flushes your dose."
	]
	quest.0B6B1DDB206465F7.title: "A Colony Raid"
	quest.0B6B1DDB206465F7.quest_subtitle: "MineColonies"
	quest.0B6B1DDB206465F7.quest_desc: [
		"&lHow to tell:&r a growing colony attracts barbarians, pirates and mummies. The town hall tracks raids and announces them in chat."
		"&lProtection:&r &lguard towers&r and barracks with guards, walls, Create Big Cannons."
	]
	quest.7A50C60518C1E203.title: "Keeper of the Base"
	quest.7A50C60518C1E203.quest_subtitle: "A tier II ward"
	quest.7A50C60518C1E203.quest_desc: [
		"A tier II ward protects 64 blocks, blocks rifts and needs crystals made from &ltech and magic&r — engineer and mage together."
		"The world is still alive, but it no longer scares you."
	]
	quest.48D3C139931CF8D9.title: "The Tornado Siren"
	quest.48D3C139931CF8D9.quest_desc: [
		"Wails when a tornado approaches the base. Put it by your bed — it'll wake you in time."
	]
	quest.58D49D8AFEC2510E.title: "The Tornado Sensor"
	quest.58D49D8AFEC2510E.quest_desc: [
		"Gives a redstone signal during a tornado: close shutters, send the airship to the hangar automatically."
	]
	quest.5623D930DF18775A.title: "The Wind"
	quest.5623D930DF18775A.quest_desc: [
		"The anemometer and wind vane show wind strength and direction. Wind matters for pilots and for air pollution."
	]
	quest.0E97B1CB5F5C32BD.title: "The Lightning Rod"
	quest.0E97B1CB5F5C32BD.quest_desc: [
		"Draws lightning to itself — your wooden roof won't burn in a storm."
	]
	quest.4C62FFBDC832EB2C.title: "The Great Ward"
	quest.4C62FFBDC832EB2C.quest_desc: [
		"A tier III ward protects 128 blocks — a whole town. Fuel: crystals made with exotic matter from the collider."
	]
	chapter.6FA4DB5D74373B8B.title: "The Town"
	chapter.6FA4DB5D74373B8B.chapter_subtitle: [
		"A colony, villagers and a village of your own"
	]
	quest.601F1AB7F25BCE3E.title: "The Settlers' Camp"
	quest.601F1AB7F25BCE3E.quest_subtitle: "MineColonies"
	quest.601F1AB7F25BCE3E.quest_desc: [
		"&lWhat:&r MineColonies is your own town with worker citizens: builders, farmers, cooks, miners, guards."
		"&lHow to start:&r place a &lsupply camp&r (or a supply ship by water) — its chest holds a town hall."
		"Details: the MineColonies guide and the &lscan tool&r for blueprints. No rush: a town grows over weeks."
	]
	quest.0961E98A888A1F6F.title: "The Town Hall"
	quest.0961E98A888A1F6F.quest_subtitle: "The heart of the colony"
	quest.0961E98A888A1F6F.quest_desc: [
		"Place the town hall with the &lbuild tool&r — pick a style (medieval, Byzantine, modern…)."
		"The town hall sets the &lcolony borders&r — enemies don't spawn on their own inside them."
	]
	quest.68A40D4402EEB3F1.title: "The Builder"
	quest.68A40D4402EEB3F1.quest_subtitle: "Your first worker"
	quest.68A40D4402EEB3F1.quest_desc: [
		"The builder's hut comes first. The builder raises every other building if you bring materials."
		"&lTip:&r a warehouse with couriers saves you from running around with chests."
	]
	quest.6CF67932543F364E.title: "The Colony Needs a Cook"
	quest.6CF67932543F364E.quest_subtitle: "Well-fed citizens work better"
	quest.6CF67932543F364E.quest_desc: [
		"Citizens eat. The higher their house level, the &lmore varied&r the food they want: soups, pies, Farmer's Delight dishes."
		"&lWho helps:&r your group's cook is the town's main supplier. One of the pack's key handshakes."
	]
	quest.2448820009AD4703.title: "The Colony Farmer"
	quest.2448820009AD4703.quest_subtitle: "Fields without you"
	quest.2448820009AD4703.quest_desc: [
		"The farmer ploughs, plants and harvests on his own. Give him seeds — tomatoes, cabbage, rice — and the cook never runs out."
	]
	quest.18D3669431D9E42A.title: "The Guard"
	quest.18D3669431D9E42A.quest_subtitle: "The guard tower"
	quest.18D3669431D9E42A.quest_desc: [
		"Guards protect the colony from raids. Give them armour and weapons — &lyour group's smith&r will be needed."
		"More on raids in \"Elements & Defence\"."
	]
	quest.15EA1D5A0184FB40.title: "The University"
	quest.15EA1D5A0184FB40.quest_subtitle: "Colony research"
	quest.15EA1D5A0184FB40.quest_desc: [
		"At the university citizens research upgrades: faster building, better healing, stronger defence."
	]
	quest.3128D00D510F86AC.title: "The Tavern"
	quest.3128D00D510F86AC.quest_subtitle: "New citizens arrive by themselves"
	quest.3128D00D510F86AC.quest_desc: [
		"The tavern attracts travellers who become new citizens. It also simply looks lovely."
	]
	quest.5E28B4759F897AD5.title: "Villagers with Character"
	quest.5E28B4759F897AD5.quest_subtitle: "MCA Reborn"
	quest.5E28B4759F897AD5.quest_desc: [
		"Villagers here are people: names, personalities, families and moods. Talk to them, befriend them, hire them."
		"&lTip:&r gifts improve relationships. MCA smiths and farmers sell useful things."
	]
	quest.1A706D39C73346D7.title: "Dream Town"
	quest.1A706D39C73346D7.quest_subtitle: "A level 5 town hall"
	quest.1A706D39C73346D7.quest_desc: [
		"Tick this once the town hall reaches &llevel 5&r. It's a whole-group project — cooks feed, engineers build roads, mages enchant."
		"Next: the \"Great Works\" chapter."
	]
	quest.31629F0187879119.title: "The Builder's Sceptre"
	quest.31629F0187879119.quest_desc: [
		"Scans builds into blueprints and places them via the colony builder. Copy your house into the town."
	]
	quest.0C500D94482BC31D.title: "Warehouse and Couriers"
	quest.0C500D94482BC31D.quest_desc: [
		"The warehouse holds everything, couriers deliver materials to workers. Without them the colony drowns in chests."
	]
	quest.2A25F70A883FD806.title: "The Lumberjack"
	quest.2A25F70A883FD806.quest_desc: [
		"The lumberjack fells trees and replants. The builder always needs logs."
	]
	quest.35775EEABB31E72C.title: "The Colony Miner"
	quest.35775EEABB31E72C.quest_desc: [
		"The miner digs a shaft level by level and brings back ore and stone."
	]
	quest.75EC4D5698FC2F8A.title: "The Colony Fisher"
	quest.75EC4D5698FC2F8A.quest_desc: [
		"The fisher catches fish for the canteen. Needs water nearby."
	]
	quest.709BD9478FFC95A5.title: "The Herders"
	quest.709BD9478FFC95A5.quest_desc: [
		"The cowhand and shepherd raise cows and sheep for the colony. The breeder knows where to get the first animals."
	]
	quest.6D716CFDB6533D8D.title: "Smeltery and Blacksmith"
	quest.6D716CFDB6533D8D.quest_desc: [
		"The smelter smelts ore, the blacksmith makes tools and armour for guards."
	]
	quest.215D51C751B21BDD.title: "The Hospital"
	quest.215D51C751B21BDD.quest_desc: [
		"Heals citizens of illness. Without it an epidemic stops all work."
	]
	quest.6E16091A853C2E58.title: "The Library"
	quest.6E16091A853C2E58.quest_desc: [
		"Citizens study and level their skills faster."
	]
	quest.032164E8868189BE.title: "The Colony Enchanter"
	quest.032164E8868189BE.quest_desc: [
		"Enchants books from citizens' experience. A steady book supply for mages."
	]
	quest.2EDF7718966F865E.title: "The Colony Alchemist"
	quest.2EDF7718966F865E.quest_desc: [
		"Brews potions for the guards. Your group's alchemist can share recipes."
	]
	quest.5FF1BE65A592559C.title: "The Barracks"
	quest.5FF1BE65A592559C.quest_desc: [
		"Barracks with towers house a whole guard company. Raids won't get through."
	]
	quest.7DF2E728DC9D5076.title: "A Village Wedding"
	quest.7DF2E728DC9D5076.quest_desc: [
		"In MCA you can marry a villager and raise a family. Children can learn to work the farm."
	]
	quest.076FE4C58EDAB8E3.title: "Villagers in Your Pocket"
	quest.076FE4C58EDAB8E3.quest_desc: [
		"Easy Villagers: pick up a villager as an item and place it in a trader block. A compact market without huge pens."
	]
	chapter.6C67AEF364E06285.title: "Building"
	chapter.6C67AEF364E06285.chapter_subtitle: [
		"Decor, tools and beautiful homes"
	]
	quest.1FC1E9E294DB3C6B.title: "The Building Gadget"
	quest.1FC1E9E294DB3C6B.quest_subtitle: "Walls in a second"
	quest.1FC1E9E294DB3C6B.quest_desc: [
		"&lWhat:&r the gadget places a row, wall or floor of the chosen block at once. It runs on energy."
		"There are also &lexchanging&r (swap blocks), &lcopy-paste&r (move a build) and &ldestruction&r gadgets."
	]
	quest.08468A16A473B47D.title: "Swapping Blocks"
	quest.08468A16A473B47D.quest_subtitle: "Redecorate a house in a minute"
	quest.08468A16A473B47D.quest_desc: [
		"The exchanging gadget swaps blocks for the chosen one: stone to brick, oak to spruce. Perfect for restyling builds."
	]
	quest.7402AF2B28E1AB7A.title: "Framed Blocks"
	quest.7402AF2B28E1AB7A.quest_subtitle: "FramedBlocks"
	quest.7402AF2B28E1AB7A.quest_desc: [
		"A framed block takes the look of any other: glass stairs, wool slabs, copper slopes."
	]
	quest.40339AC01B286C60.title: "A Cosy Home"
	quest.40339AC01B286C60.quest_subtitle: "Handcrafted, Macaw's, Another Furniture"
	quest.40339AC01B286C60.quest_desc: [
		"Tables, chairs, wardrobes, lamps, windows, doors, roofs, bridges — hundreds of decorative blocks."
		"Every wood type is covered (Every Compat). Browse EMI: &l@handcrafted&r, &l@mcw&r."
	]
	quest.1FBC13A5E0BD957F.title: "Blueprints"
	quest.1FBC13A5E0BD957F.quest_subtitle: "Save it and build it again"
	quest.1FBC13A5E0BD957F.quest_desc: [
		"Create schematics save and share builds. Make a \"standard cottage\" and build it for your friends."
	]
	quest.3E5505B24DA3089B.title: "Beautiful!"
	quest.3E5505B24DA3089B.quest_subtitle: "Take a photo of your home"
	quest.3E5505B24DA3089B.quest_desc: [
		"Turn on shaders, find a nice angle and take a screenshot (&lF2&r). Share it with friends — and tick the quest."
	]
	quest.7B52108951988BE5.title: "Copy-Paste"
	quest.7B52108951988BE5.quest_desc: [
		"Copies an area and places a copy. A row of identical houses in a minute."
	]
	quest.0681C2FB1DAC97D3.title: "The Destruction Gadget"
	quest.0681C2FB1DAC97D3.quest_desc: [
		"Clears a volume of blocks — prep a building site in seconds."
	]
	quest.2FEDA2D18C4D62F6.title: "Roofs, Windows, Doors"
	quest.2FEDA2D18C4D62F6.quest_desc: [
		"Macaw's: roofs of every shape, nice windows and doors. A house suddenly looks like a home."
	]
	quest.15BAB63916C275B3.title: "Bridges"
	quest.15BAB63916C275B3.quest_desc: [
		"Ready-made bridges for rivers and ravines. Link bases with a lovely road."
	]
	quest.3D8B8BAB6142D975.title: "Cosy Details"
	quest.3D8B8BAB6142D975.quest_desc: [
		"Jars, sacks, a globe, a wind vane, ropes — Supplementaries adds a hundred pleasant touches."
	]
	quest.3603241567DE82A5.title: "Industrial Style"
	quest.3603241567DE82A5.quest_desc: [
		"Create Deco: catwalks, railings, containers, sheet metal — for factories you want to admire."
	]
	quest.5AC27D5E66DB6566.title: "Copycat Blocks"
	quest.5AC27D5E66DB6566.quest_desc: [
		"Copycats+: stairs, panels and layers that take the look of any block. Fine work for detailed builds."
	]
	quest.121BFA9789E6622A.title: "Seats on Trains"
	quest.121BFA9789E6622A.quest_desc: [
		"Create: Interiors adds chairs and sofas you can sit on even aboard a moving train or airship."
	]
	chapter.05D02B5570337DC5.title: "Home and Comfort"
	chapter.05D02B5570337DC5.chapter_subtitle: [
		"Furniture, lights, roofs, paths: hundreds of blocks for a beautiful home"
	]
	quest.0CC807686064633F.title: "Why Comfort"
	quest.0CC807686064633F.quest_subtitle: "Pretty is gameplay too"
	quest.0CC807686064633F.quest_desc: [
		"&lWhy:&r a beautiful home is a reason to visit, and a Minecolonies colony grows faster when its people are happy."
		"&lHow:&r almost all furniture is crafted from planks of the right wood: search EMI for «chair», «table», «lamp»."
		"&lTip:&r many Macaw's blocks come in variants: check EMI, one piece often yields several shapes."
	]
	quest.68CF4A141555C824.title: "A Desk"
	quest.68CF4A141555C824.quest_subtitle: "Macaw's Furniture"
	quest.68CF4A141555C824.quest_desc: [
		"Desks, wardrobes, drawers, chairs: in Macaw's, furniture is functional too: wardrobes and drawers store items."
	]
	quest.6C85FF8C153880DC.title: "A Chandelier"
	quest.6C85FF8C153880DC.quest_subtitle: "Macaw's Lights"
	quest.6C85FF8C153880DC.quest_desc: [
		"Lighting matters: chandeliers, sconces, tiki torches, ceiling fan lights. A well-lit home also keeps mobs out."
	]
	quest.06224B94B88795AF.title: "A Thatch Roof"
	quest.06224B94B88795AF.quest_subtitle: "Macaw's Roofs"
	quest.06224B94B88795AF.quest_desc: [
		"Roofs of every pitch and material: no more stair-step roofs. Thatch for a village cottage, tiles for a town."
	]
	quest.04FE1259A9EC7260.title: "A Paved Path"
	quest.04FE1259A9EC7260.quest_subtitle: "Macaw's Paths"
	quest.04FE1259A9EC7260.quest_desc: [
		"Patterned paving and flagstones: a path from your door to the waystone makes a base feel lived-in."
	]
	quest.5AD48020E2594F58.title: "Windows and Doors"
	quest.5AD48020E2594F58.quest_subtitle: "Macaw's Doors & Windows"
	quest.5AD48020E2594F58.quest_desc: [
		"Doors in many styles (Japanese, cottage, barn) and mullioned windows. Curtains on a rod open with right click."
	]
	quest.277BEE78FED39A51.title: "A Bridge over the Stream"
	quest.277BEE78FED39A51.quest_subtitle: "Macaw's Bridges"
	quest.277BEE78FED39A51.quest_desc: [
		"Bridges snap together from segments and adjust to length. Rope for ravines, stone for rivers."
	]
	quest.484124C4B32D2CAB.title: "A Sofa"
	quest.484124C4B32D2CAB.quest_subtitle: "Another Furniture"
	quest.484124C4B32D2CAB.quest_desc: [
		"Sofas, stools, shelves, flower boxes. You can &lsit&r on sofas and chairs: right click."
	]
	quest.2D523083489AE02E.title: "A Wall Trophy"
	quest.2D523083489AE02E.quest_subtitle: "Handcrafted"
	quest.2D523083489AE02E.quest_desc: [
		"Trophy heads of beasts and mobs: hang them over the fireplace. The warrior hunts, the builder hangs: roles meet."
	]
	quest.7FB9BA113738A36B.title: "Dream Kitchen"
	quest.7FB9BA113738A36B.quest_subtitle: "Handcrafted + Cooking for Blockheads"
	quest.7FB9BA113738A36B.quest_desc: [
		"A Handcrafted hood and oven next to Cooking for Blockheads work blocks: a kitchen you can cook in and show off."
	]
	quest.01E55988ADE92D20.title: "Secret Stash"
	quest.01E55988ADE92D20.quest_subtitle: "Framed Blocks"
	quest.01E55988ADE92D20.quest_desc: [
		"A framed block takes the look of any other, and the secret storage also holds items. A safe behind the bookshelf."
	]
	quest.1D0381CAEC065F43.title: "Architect's Cutter"
	quest.1D0381CAEC065F43.quest_subtitle: "Domum Ornamentum"
	quest.1D0381CAEC065F43.quest_desc: [
		"Makes timber frames, shingles and pillars from any two materials. Minecolonies builds its houses with it; you can too."
	]
	quest.20879EC69322B31B.title: "Notice Board"
	quest.20879EC69322B31B.quest_subtitle: "Supplementaries"
	quest.20879EC69322B31B.quest_desc: [
		"Pin a book on the board and every passer-by can read it. Shelves display items, jars hold liquids and fireflies."
		"&lIdea:&r a board at spawn with the server rules and news."
	]
	quest.2B022A0B2B672C60.title: "A Cosy Nest"
	quest.2B022A0B2B672C60.quest_subtitle: "A home worth coming back to"
	quest.2B022A0B2B672C60.quest_desc: [
		"Lights, roof, furniture, trophies and a stash. Invite friends to a housewarming, and take a screenshot with shaders on."
	]
	chapter.34F136AADF95EE95.title: "Great Works"
	chapter.34F136AADF95EE95.chapter_subtitle: [
		"Megaprojects for the whole group"
	]
	quest.0709903C70BF2FE2.title: "Bigger Together"
	quest.0709903C70BF2FE2.quest_subtitle: "What this chapter is for"
	quest.0709903C70BF2FE2.quest_desc: [
		"These are projects &lno one finishes alone&r: each needs several roles to chip in."
		"Agree who does what — and build. The rewards here are the most generous."
	]
	quest.65D41835C2EFE544.title: "The Flying Citadel"
	quest.65D41835C2EFE544.quest_subtitle: "Engineer, mage, builder, breeder"
	quest.65D41835C2EFE544.quest_desc: [
		"The &lCitadel Heart&r combines waxed canvas (breeder), dragon plating, a tier II ward crystal (engineer + mage) and pearlescent levitite."
		"Build a floating island with a garden, kitchen and workshop, set the Heart at its centre — and tick the quest once it rises above the clouds."
	]
	quest.5E25791A3DFA2FDB.title: "The Nuclear Power Plant"
	quest.5E25791A3DFA2FDB.quest_subtitle: "Engineer + gardener"
	quest.5E25791A3DFA2FDB.quest_desc: [
		"A fission reactor, boiler and turbine — a power plant for the whole server. Start-up needs a &lbio-fuel&r generator (the gardener's crops)."
		"Tick when the plant powers every base."
	]
	quest.467F31F4129D2736.title: "The Ring Collider"
	quest.467F31F4129D2736.quest_subtitle: "Every role"
	quest.467F31F4129D2736.quest_desc: [
		"SPS antimatter, ward crystals, source blocks and nether stars make &lexotic matter&r — the material for tier III wards and the pack's finale."
		"For now it's crafted at a table; a future version adds a huge ring multiblock."
	]
	quest.084CEBE01C3352F1.title: "The Grand Restaurant"
	quest.084CEBE01C3352F1.quest_subtitle: "Cook, gardener, breeder, angler"
	quest.084CEBE01C3352F1.quest_desc: [
		"Build a restaurant with a Cooking for Blockheads kitchen and serve five signature dishes from every corner of the world: dragon stew, fugu, cheese, noir wine and honey-glazed ham."
	]
	quest.4C988FF056779288.title: "The Nature Reserve"
	quest.4C988FF056779288.quest_subtitle: "Breeder, angler, explorer"
	quest.4C988FF056779288.quest_desc: [
		"Half the fish journal, 10 bee species and 3 dragon breeds — in one reserve with enclosures and ponds. Tick once you have them all."
	]
	quest.19E75AA8929A563A.title: "Dream City"
	quest.19E75AA8929A563A.quest_subtitle: "The mayor and everyone"
	quest.19E75AA8929A563A.quest_desc: [
		"A colony with a level 5 town hall, roads, a train and a market. Everyone contributed something. Throw a party!"
	]
	quest.09CABD5281435C1C.title: "Clear Sky"
	quest.09CABD5281435C1C.quest_subtitle: "Engineer, gardener, mage"
	quest.09CABD5281435C1C.quest_desc: [
		"Make sure no base sits under smog: electricity instead of diesel, absorbing forests, tall stacks."
		"Check the Airborne pollution map — and tick the quest once the air is clean."
	]
	chapter.40644DABCF408CC6.title: "Collections"
	chapter.40644DABCF408CC6.chapter_subtitle: [
		"For those who love collecting everything"
	]
	quest.3BAB07B21B1282E9.title: "40 Dishes"
	quest.3BAB07B21B1282E9.quest_subtitle: "Spice of Life"
	quest.3BAB07B21B1282E9.quest_desc: [
		"Taste 40 different dishes. Every milestone in the food book is a new heart."
	]
	quest.743FC4A70C4CBD86.title: "80 Dishes"
	quest.743FC4A70C4CBD86.quest_subtitle: "A true gourmet"
	quest.743FC4A70C4CBD86.quest_desc: [
		"80 dishes means the cuisines of every world: nether, sea, dragon, alpine."
	]
	quest.27144F338FDF2C08.title: "Half the Journal"
	quest.27144F338FDF2C08.quest_subtitle: "Half of all fish species"
	quest.27144F338FDF2C08.quest_desc: [
		"Fill half the angler's journal. Hints for the missing ones are in the journal itself."
	]
	quest.265FF61074550E28.title: "The Star Carp"
	quest.265FF61074550E28.quest_subtitle: "A legend of the meteor shower"
	quest.265FF61074550E28.quest_desc: [
		"They say when a meteor falls into water, a star carp can be found there. A dinner of it brings luck."
	]
	quest.00665D425DD344B3.title: "10 Bee Species"
	quest.00665D425DD344B3.quest_subtitle: "Beekeeper"
	quest.00665D425DD344B3.quest_desc: [
		"Collect 10 different bee species. The mutation guide is in EMI."
	]
	quest.5AA3BFEE086967DC.title: "Three Dragon Breeds"
	quest.5AA3BFEE086967DC.quest_subtitle: "Dragon nursery"
	quest.5AA3BFEE086967DC.quest_desc: [
		"Hatch dragons of three different breeds. Where an egg hatches decides who is born."
	]
	quest.5B7AA6799E31A9A7.title: "Monster Hunter"
	quest.5B7AA6799E31A9A7.quest_subtitle: "Five great bosses"
	quest.5B7AA6799E31A9A7.quest_desc: [
		"Hydra, Ur-Ghast, Ignis, the Wither and the Ender Dragon. The pinnacle of glory — and trophies for the Great Works."
	]
	chapter.150EE076426FF539.title: "Welcome Back!"
	chapter.150EE076426FF539.chapter_subtitle: [
		"A checklist after a break and what's new"
	]
	quest.49541EF8D509C102.title: "We Missed You"
	quest.49541EF8D509C102.quest_subtitle: "Always open"
	quest.49541EF8D509C102.quest_desc: [
		"Been a while? The world didn't fall apart: events don't run without you, and the farms waited."
		"Run through the checklist below and you'll remember where you left off. The quest book remembers your progress."
	]
	quest.37E56430316C85AA.title: "Power"
	quest.37E56430316C85AA.quest_subtitle: "Generators and fuel"
	quest.37E56430316C85AA.quest_desc: [
		"Check generators, fuel and storage. Did the reactor shut down? Do the &lwards&r have enough crystals?"
	]
	quest.472B11224C43FE15.title: "Farms and Stores"
	quest.472B11224C43FE15.quest_subtitle: "Harvest, bees, food"
	quest.472B11224C43FE15.quest_desc: [
		"Collect harvest from pots and chests, check the hives and food stores. What season is it? (calendar)"
	]
	quest.5AF8ABD2B98E1392.title: "The Colony"
	quest.5AF8ABD2B98E1392.quest_subtitle: "Citizen happiness"
	quest.5AF8ABD2B98E1392.quest_desc: [
		"Visit the town hall: happiness, citizen requests, any need for food."
	]
	quest.59275DD9BDBB6DD3.title: "The Air"
	quest.59275DD9BDBB6DD3.quest_subtitle: "The pollution map"
	quest.59275DD9BDBB6DD3.quest_desc: [
		"Has smog built up around the factories? If so, the Clear Sky project is waiting."
	]
	quest.09C5B09C586913C2.title: "The Forecast"
	quest.09C5B09C586913C2.quest_subtitle: "The Star Atlas"
	quest.09C5B09C586913C2.quest_desc: [
		"Open the Star Atlas (or &o/arkhaven forecast&r) — what does tonight hold?"
	]
	quest.3DD6552F19EF0458.title: "What's New: 0.1.0"
	quest.3DD6552F19EF0458.quest_subtitle: "The first Arkhaven release"
	quest.3DD6552F19EF0458.quest_desc: [
		"Arkhaven is open! ~250 mods, 23 quest chapters, alchemist potions, the Ward Generator, meteor showers and strikes."
		"Tell us in chat what you loved and what broke — the next version will take it into account."
	]
	chapter.0DC5789BB7E8D3AF.title: "Festivals"
	chapter.0DC5789BB7E8D3AF.chapter_subtitle: [
		"Seasonal and repeatable — come back every season"
	]
	quest.28921ED5601F390E.title: "The Festival Calendar"
	quest.28921ED5601F390E.quest_subtitle: "A festival for every season"
	quest.28921ED5601F390E.quest_desc: [
		"The season changes about every 24 in-game days. Each season has its festival with &lrepeatable&r quests."
		"Do them in their season (check the calendar) — the rewards can be earned again and again."
	]
	quest.084AB0193213DB26.title: "🌸 The Sowing Festival"
	quest.084AB0193213DB26.quest_subtitle: "Spring"
	quest.084AB0193213DB26.quest_desc: [
		"In spring everything is planted. Gather seeds for a shared festival field and sow it together."
	]
	quest.219DF824BFD97F6F.title: "🌸 Spring Honey"
	quest.219DF824BFD97F6F.quest_subtitle: "Spring"
	quest.219DF824BFD97F6F.quest_desc: [
		"The bees are awake. Gather combs for the festival — the cook will bake honey cookies for everyone."
	]
	quest.7B357B4253B80201.title: "☀️ The Crafts Fair"
	quest.7B357B4253B80201.quest_subtitle: "Summer"
	quest.7B357B4253B80201.quest_desc: [
		"Summer brings a show of machines and ships. Bring your best builds to the square and race planes around the Haven."
		"Tick the quest after the fair."
	]
	quest.26456503909C0515.title: "☀️ Cool Down"
	quest.26456503909C0515.quest_subtitle: "Summer"
	quest.26456503909C0515.quest_desc: [
		"It's hot! Make melon popsicles for the whole group."
	]
	quest.5263804B39A8E916.title: "🍂 The Harvest Festival"
	quest.5263804B39A8E916.quest_subtitle: "Autumn"
	quest.5263804B39A8E916.quest_desc: [
		"Autumn means a great dinner: stuffed pumpkin and wine from the new harvest. Set a shared table!"
	]
	quest.5F568FA0D1D7F62E.title: "❄️ Winter Lights"
	quest.5F568FA0D1D7F62E.quest_subtitle: "Winter"
	quest.5F568FA0D1D7F62E.quest_desc: [
		"In winter the town is decked with lights. Hang lanterns along the Haven's streets — and launch fireworks (reward)."
	]
	quest.3B8FD62542482159.title: "❄️ Ice Fishing"
	quest.3B8FD62542482159.quest_subtitle: "Winter"
	quest.3B8FD62542482159.quest_desc: [
		"Cut a hole in the ice and fish. Fresh salmon for the festive table."
	]
}
